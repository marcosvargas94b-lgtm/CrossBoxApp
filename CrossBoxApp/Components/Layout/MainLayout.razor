@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div style="width: 100%; min-height: 100vh; margin: 0; padding: 0;">
    <main style="margin: 0; padding: 0;">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += AlCambiarDePagina;
        
        // 1. CONECTAR DELEGADO PARA APP EN SEGUNDO PLANO
        MauiProgram.InterceptSpotterAction = async (url) =>
        {
            await InvokeAsync(() => 
            {
                Nav.NavigateTo(url);
                StateHasChanged();
            });
        };

        // 2. REVISAR SI VENIMOS DE UN COLD START
        _ = VerificarRutaPendiente();
    }

    private async Task VerificarRutaPendiente()
    {
        // Pequeño delay para asegurar que el router de Blazor esté 100% montado
        await Task.Delay(200); 

        if (!string.IsNullOrEmpty(MauiProgram.RutaPendienteSpotter))
        {
            var rutaDestino = MauiProgram.RutaPendienteSpotter;
            MauiProgram.RutaPendienteSpotter = null; // Consumir y limpiar
            
            await InvokeAsync(() => Nav.NavigateTo(rutaDestino));
        }
    }

    private async void AlCambiarDePagina(object sender, LocationChangedEventArgs e)
    {
        try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); } catch { }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= AlCambiarDePagina;
    }
}