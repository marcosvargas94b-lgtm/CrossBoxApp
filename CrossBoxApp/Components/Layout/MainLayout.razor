@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div style="width: 100%; min-height: 100vh; margin: 0; padding: 0;">
    <main style="margin: 0; padding: 0;">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += AlCambiarDePagina;
        
        // 1. CASO APP ABIERTA O SEGUNDO PLANO: Escuchamos la orden de MAUI
        MauiProgram.InterceptSpotterAction = (url) =>
        {
            // Forzamos la navegación en el hilo principal de Blazor
            InvokeAsync(() => Nav.NavigateTo(url));
        };
    }

    // 2. CASO COLD START (App cerrada por completo): Revisamos si al abrir la app traíamos una ruta pendiente
    // Lo movemos aquí para asegurar que Blazor ya cargó su enrutador base antes de redirigir
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            if (!string.IsNullOrEmpty(MauiProgram.RutaPendienteSpotter))
            {
                var rutaDestino = MauiProgram.RutaPendienteSpotter;
                MauiProgram.RutaPendienteSpotter = null; // La limpiamos para que no se repita
                
                // Forzamos el hilo UI para la redirección inicial
                InvokeAsync(() => Nav.NavigateTo(rutaDestino));
            }
        }
    }

    private async void AlCambiarDePagina(object sender, LocationChangedEventArgs e)
    {
        try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); } catch { }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= AlCambiarDePagina;
    }
}