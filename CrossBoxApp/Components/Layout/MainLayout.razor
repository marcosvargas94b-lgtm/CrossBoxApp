@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div style="width: 100%; min-height: 100vh; margin: 0; padding: 0;">
    <main style="margin: 0; padding: 0;">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += AlCambiarDePagina;
        MauiProgram.InterceptSpotterAction = (url) =>
        {
            // Forzamos la navegación en el hilo principal de Blazor
            InvokeAsync(() => Nav.NavigateTo(url));
        };

        // 2. CASO COLD START (App cerrada): Revisamos si al abrir la app traíamos una ruta pendiente
        if (!string.IsNullOrEmpty(MauiProgram.RutaPendienteSpotter))
        {
            var rutaDestino = MauiProgram.RutaPendienteSpotter;
            MauiProgram.RutaPendienteSpotter = null; // La limpiamos para que no se repita
            Nav.NavigateTo(rutaDestino);
        }
    }

    private async void AlCambiarDePagina(object sender, LocationChangedEventArgs e)
    {
        try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); } catch { }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= AlCambiarDePagina;
    }
}