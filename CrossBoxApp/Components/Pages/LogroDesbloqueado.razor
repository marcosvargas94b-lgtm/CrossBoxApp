</style>

@code {
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; --theme-secondary: #808080;
        --theme-bg: #0d0d0d; --theme-card: #1a1a1a;
        --theme-border: #333333; --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    [Parameter] public Guid? TargetUserId { get; set; }
    private bool EsMiMedallero => !TargetUserId.HasValue || TargetUserId.Value == Sesion.Usuario.UsuarioID;
    private string nombreAtletaVisitado = "";

    private bool cargando = true;
    private bool EsAdminOStaff = false;

    // --- CLASES DTO PRINCIPALES ---
    public class MedallaUsuarioDto { public Guid Id { get; set; } public string Nombre { get; set; } public string Leyenda { get; set; } public string Diseno { get; set; } public bool EsAuto { get; set; } public DateTime? FechaObtencion { get; set; } public bool EsNueva { get; set; } }
    public class UsuarioSelectDto { public Guid UsuarioId { get; set; } public string NombreCompleto { get; set; } }
    
    // --- DTO PARA LA TAB INDIVIDUAL ---
    public class CatalogoManualDto { public Guid Id { get; set; } public string Nombre { get; set; } public string Diseno { get; set; } public bool LaTiene { get; set; } }
    
    // --- DTO PARA LA TAB MASIVA ---
    public class UsuarioMasivoDto { public Guid UsuarioId { get; set; } public string NombreCompleto { get; set; } public bool TieneLaMedalla { get; set; } }

    private List<MedallaUsuarioDto> misMedallas = new List<MedallaUsuarioDto>();
    
    // --- CELEBRACIÓN Y VISTA EXPANDIDA ---
    private bool mostrarAnimacionNuevas = false;
    private List<MedallaUsuarioDto> medallasNuevasAnimacion = new List<MedallaUsuarioDto>();
    
    private MedallaUsuarioDto medallaExpandida = null;

    // --- MODAL ADMIN ESTADOS ---
    private bool mostrarModalAdmin = false;
    private string tabAdmin = "Individual";
    private bool guardandoManuales = false;

    // VARIABLES TAB INDIVIDUAL
    private List<UsuarioSelectDto> listaUsuariosBox = new List<UsuarioSelectDto>();
    private Guid usuarioSeleccionadoId = Guid.Empty;
    private List<CatalogoManualDto> catalogoManual = new List<CatalogoManualDto>();
    private bool cargandoCatalogoManual = false;
    private string filtroMedallasIndividual = ""; 

    // VARIABLES TAB MASIVO
    private List<CatalogoManualDto> catalogoCompletoManual = new List<CatalogoManualDto>();
    private Guid medallaMasivaSeleccionada = Guid.Empty;
    private List<UsuarioMasivoDto> listaUsuariosMasivo = new List<UsuarioMasivoDto>();
    private bool cargandoAtletasMasivo = false;
    private string filtroAtletasMasivo = "";

    protected override async Task OnInitializedAsync()
    {
        try { var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box"); if (!string.IsNullOrEmpty(cache)) { EstilosTema = cache; StateHasChanged(); } } catch { }

        if (Sesion.Usuario == null) { Nav.NavigateTo("/"); return; }
        EsAdminOStaff = Sesion.Usuario.TipoUsuarioID == 1 || Sesion.Usuario.TipoUsuarioID == 3;

        if (!EsMiMedallero)
        {
            try { 
                var uInfo = await Http.GetFromJsonAsync<UsuarioSelectDto>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/usuariosapi/info-basica/{TargetUserId}");
                if (uInfo != null) nombreAtletaVisitado = uInfo.NombreCompleto;
            } catch { }
        }

        await CargarMedallasDelUsuario();
    }

    private async Task CargarMedallasDelUsuario()
    {
        try
        {
            cargando = true;
            Guid idConsulta = TargetUserId ?? Sesion.Usuario.UsuarioID;
            
            misMedallas = await Http.GetFromJsonAsync<List<MedallaUsuarioDto>>(
                $"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/medallasapi/mis-medallas/{Sesion.Usuario.BoxID}/{idConsulta}?visitanteId={Sesion.Usuario.UsuarioID}");
            
            if (EsMiMedallero && misMedallas != null && misMedallas.Any(m => m.EsNueva))
            {
                medallasNuevasAnimacion = misMedallas.Where(m => m.EsNueva).ToList();
                mostrarAnimacionNuevas = true;
            }
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); misMedallas = new List<MedallaUsuarioDto>(); }
        finally { cargando = false; StateHasChanged(); }
    }

    private void AbrirMedallaExpandida(MedallaUsuarioDto medalla) { medallaExpandida = medalla; }
    private void CerrarMedallaExpandida() { medallaExpandida = null; }
    private void CerrarTooltips() { }
    private void CerrarCelebracion() => mostrarAnimacionNuevas = false;
    private void Volver() { if (!EsMiMedallero) Nav.NavigateTo($"/ficha-atleta/{TargetUserId}"); else Nav.NavigateTo("/home"); }

    // ==========================================
    // LÓGICA ADMIN
    // ==========================================
    private async Task AbrirModalAsignar()
    {
        mostrarModalAdmin = true;
        tabAdmin = "Individual";
        usuarioSeleccionadoId = Guid.Empty;
        catalogoManual.Clear();
        filtroMedallasIndividual = "";
        
        medallaMasivaSeleccionada = Guid.Empty;
        listaUsuariosMasivo.Clear();
        filtroAtletasMasivo = "";

        if (listaUsuariosBox.Count == 0)
        {
            try { listaUsuariosBox = await Http.GetFromJsonAsync<List<UsuarioSelectDto>>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/medallasapi/usuarios-box/{Sesion.Usuario.BoxID}"); }
            catch { }
        }
    }

    private void CerrarModalAsignar() => mostrarModalAdmin = false;

    // --- TAB 1: INDIVIDUAL ---
    private async Task AlSeleccionarUsuario(ChangeEventArgs e)
    {
        filtroMedallasIndividual = ""; 
        if (Guid.TryParse(e.Value?.ToString(), out Guid uId))
        {
            usuarioSeleccionadoId = uId;
            cargandoCatalogoManual = true; StateHasChanged();
            try { catalogoManual = await Http.GetFromJsonAsync<List<CatalogoManualDto>>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/medallasapi/catalogo-manual/{Sesion.Usuario.BoxID}/{usuarioSeleccionadoId}"); }
            catch { }
            finally { cargandoCatalogoManual = false; StateHasChanged(); }
        }
        else { usuarioSeleccionadoId = Guid.Empty; catalogoManual.Clear(); }
    }

    private void ToggleMedallaManual(CatalogoManualDto item) => item.LaTiene = !item.LaTiene;

    private async Task GuardarMedallasManuales()
    {
        if (usuarioSeleccionadoId == Guid.Empty) return;
        guardandoManuales = true; StateHasChanged();
        
        try
        {
            var payload = new {
                UsuarioId = usuarioSeleccionadoId,
                MedallasActivasIds = catalogoManual.Where(m => m.LaTiene).Select(m => m.Id).ToList()
            };
            var res = await Http.PostAsJsonAsync("https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/medallasapi/asignar-manual", payload);
            
            if (res.IsSuccessStatusCode)
            {
                await App.Current.MainPage.DisplayAlert("Éxito", "Medallas guardadas correctamente.", "OK");
                CerrarModalAsignar();
                await CargarMedallasDelUsuario();
            }
            else { await App.Current.MainPage.DisplayAlert("Error", "No se pudo guardar.", "OK"); }
        }
        catch (Exception ex) { await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK"); }
        finally { guardandoManuales = false; StateHasChanged(); }
    }

    // --- TAB 2: MASIVO ---
    private async Task CargarTabMasivo()
    {
        tabAdmin = "Masivo";
        if (catalogoCompletoManual.Count == 0)
        {
            try { catalogoCompletoManual = await Http.GetFromJsonAsync<List<CatalogoManualDto>>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/medallasapi/catalogo-manual/{Sesion.Usuario.BoxID}/{Sesion.Usuario.UsuarioID}"); }
            catch { }
        }
    }

    private async Task AlSeleccionarMedallaMasiva(ChangeEventArgs e)
    {
        filtroAtletasMasivo = ""; 
        if (Guid.TryParse(e.Value?.ToString(), out Guid mId))
        {
            medallaMasivaSeleccionada = mId;
            cargandoAtletasMasivo = true; StateHasChanged();
            try { listaUsuariosMasivo = await Http.GetFromJsonAsync<List<UsuarioMasivoDto>>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/medallasapi/atletas-por-medalla/{Sesion.Usuario.BoxID}/{medallaMasivaSeleccionada}"); }
            catch { }
            finally { cargandoAtletasMasivo = false; StateHasChanged(); }
        }
        else { medallaMasivaSeleccionada = Guid.Empty; listaUsuariosMasivo.Clear(); }
    }

    private void ToggleUsuarioMasivo(UsuarioMasivoDto item) => item.TieneLaMedalla = !item.TieneLaMedalla;

    private async Task GuardarAsignacionMasiva()
    {
        if (medallaMasivaSeleccionada == Guid.Empty) return;
        guardandoManuales = true; StateHasChanged();
        
        try
        {
            var payload = new {
                MedallaId = medallaMasivaSeleccionada,
                UsuariosActivosIds = listaUsuariosMasivo.Where(u => u.TieneLaMedalla).Select(u => u.UsuarioId).ToList()
            };
            var res = await Http.PostAsJsonAsync("https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/medallasapi/asignar-masivo", payload);
            
            if (res.IsSuccessStatusCode)
            {
                await App.Current.MainPage.DisplayAlert("Éxito", "Logro repartido a los atletas seleccionados.", "OK");
                CerrarModalAsignar();
                await CargarMedallasDelUsuario();
            }
            else { await App.Current.MainPage.DisplayAlert("Error", "No se pudo guardar la asignación.", "OK"); }
        }
        catch (Exception ex) { await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK"); }
        finally { guardandoManuales = false; StateHasChanged(); }
    }
}