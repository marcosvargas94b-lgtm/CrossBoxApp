@page "/logrodesbloqueado"
@page "/logrodesbloqueado/{TargetUserId:guid}"
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS

<div style="@EstilosTema">
    <div class="main-layout">

        @* --- PANTALLA DE CELEBRACIÓN (NUEVOS LOGROS) --- *@
        @if (mostrarAnimacionNuevas && medallasNuevasAnimacion != null && medallasNuevasAnimacion.Any())
        {
            <div class="celebration-overlay fade-in" @onclick:stopPropagation="true">
                <div class="fireworks"></div>
                <div class="celebration-content bounce-in">
                    @if (medallasNuevasAnimacion.Count > 1)
                    {
                        <h2 class="celeb-title">¡@(medallasNuevasAnimacion.Count) NUEVOS LOGROS DESBLOQUEADOS!</h2>
                    }
                    else
                    {
                        <h2 class="celeb-title">¡NUEVO LOGRO DESBLOQUEADO!</h2>
                    }
                    <p class="celeb-subtitle">Tu esfuerzo tiene recompensas.</p>
                    
                    <div class="nuevas-grid">
                        @foreach (var n in medallasNuevasAnimacion)
                        {
                            <div class="medalla-nueva-card">
                                <img src="@($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/Imagenes/Medallas/{n.Id}.png")" class="celeb-img glow-effect" />
                                <h3>@n.Nombre</h3>
                            </div>
                        }
                    </div>

                    <button class="btn-awesome mt-4" @onclick="CerrarCelebracion">¡GENIAL!</button>
                </div>
            </div>
        }

        @* BARRA DE NAVEGACIÓN SUPERIOR *@
        <div class="navbar-container">
            <div class="nav-left" @onclick="Volver">
                <i class="fas fa-arrow-left"></i> VOLVER
            </div>

            <div class="nav-title" style="text-align: center;">
                @if (EsMiMedallero)
                {
                    <span>LOGROS</span>
                }
                else
                {
                    <span style="font-size: 0.7rem; color: var(--theme-text-muted); display: block; line-height: 1;">LOGROS DE</span>
                    <span style="font-size: 1rem; color: var(--theme-primary); line-height: 1;">@(nombreAtletaVisitado ?? "ATLETA")</span>
                }
            </div>
            
            <div class="nav-right">
                @if (EsAdminOStaff && EsMiMedallero)
                {
                    <button class="btn-admin-top" @onclick="AbrirModalAsignar">
                        <i class="fas fa-cog"></i>
                    </button>
                }
            </div>
        </div>

        <div class="scrollable-content">

            @if (cargando)
            {
                <div class="text-center mt-5 fade-in">
                    <div class="spinner-border" style="color: var(--theme-primary); width: 3rem; height: 3rem;" role="status"></div>
                    <p class="mt-3 text-muted" style="font-family: 'Oswald'; letter-spacing: 2px;">CARGANDO LOGROS...</p>
                </div>
            }
            else if (misMedallas == null || misMedallas.Count == 0)
            {
                <div class="empty-state fade-in">
                    <i class="fas fa-medal" style="opacity: 0.3; font-size: 3rem; margin-bottom: 15px; color: var(--theme-primary);"></i>
                    <p style="color: var(--theme-text-muted);">Aún no hay medallas disponibles en tu Box.</p>
                </div>
            }
            else
            {

                var medallaFinal = misMedallas.FirstOrDefault(m => m.Diseno.ToLower() == "legendary");
                // Filtramos las de premio:
                var medallasReward = misMedallas.Where(m => m.Diseno.ToLower() == "reward").ToList();
                // Filtramos para que no salgan repetidas abajo:
                var gruposNormales = misMedallas.Where(m => m.Diseno.ToLower() != "legendary" && m.Diseno.ToLower() != "reward").GroupBy(m => m.Diseno).OrderBy(g => g.Key);
                @* SECCIÓN ESTADÍSTICAS RÁPIDAS *@
                <div class="stats-panel fade-in">
                    <div class="stat-box">
                        <span class="stat-number">@misMedallas.Count(m => m.FechaObtencion != null)</span>
                        <span class="stat-label">DESBLOQUEADAS</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-box">
                        <span class="stat-number">@misMedallas.Count(m => m.FechaObtencion == null)</span>
                        <span class="stat-label">POR GANAR</span>
                    </div>
                </div>
              

                @* ======================================================== *@
                @* PREMIO FINAL: SECCIÓN LEGENDARY (ANCHO COMPLETO)         *@
                @* ======================================================== *@
                @if (medallaFinal != null)
                {
                    bool bloqueadaLegend = medallaFinal.FechaObtencion == null;
                    string claseFondoLegend = bloqueadaLegend ? "locked-legendary" : "unlocked-legendary";

                    <div class="legendary-section fade-in mt-4 mb-4">
                        <h3 class="section-title text-center" style="color: #FFD700; border-bottom: none; text-shadow: 0 0 15px rgba(255,215,0,0.6); justify-content: center; display: flex; align-items: center; gap: 10px;">
                            <i class="fas fa-crown"></i> EL PREMIO FINAL
                        </h3>
                        
                        <div class="medalla-card-legendary @claseFondoLegend" @onclick="() => AbrirMedallaExpandida(medallaFinal)">
                            @if (!bloqueadaLegend)
                            {
                                <div class="date-badge" style="background: #FFD700; color: #000;">@medallaFinal.FechaObtencion?.ToString("dd/MMM/yy")</div>
                            }
                            
                            <img src="@($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/Imagenes/Medallas/{medallaFinal.Id}.png")" 
                                 class="medalla-img-legendary @(bloqueadaLegend ? "img-bw" : "")" />
                            
                            <div class="legendary-info">
                                <h4>@medallaFinal.Nombre</h4>
                                @if (bloqueadaLegend)
                                {
                                    <p>@medallaFinal.Leyenda</p>
                                    <div class="lock-icon" style="position: static; margin-top: 10px; font-size: 1.2rem;"><i class="fas fa-lock"></i></div>
                                }
                                else
                                {
                                    <p style="color: #FFD700; font-weight: bold;">¡LOGRO MAESTRO COMPLETADO!</p>
                                }
                            </div>
                        </div>
                    </div>
                }

                @* ======================================================== *@
                @* SECCIÓN DE RECOMPENSAS FÍSICAS (REWARDS)                 *@
                @* ======================================================== *@
                @if (medallasReward.Any())
                {
                    <div class="reward-section fade-in mt-4 mb-4">
                        <h3 class="section-title text-center" style="color: #00E676; border-bottom: none; justify-content: center; display: flex; align-items: center; gap: 10px;">
                            <i class="fas fa-gift"></i> RECOMPENSAS DEL BOX
                        </h3>

                        <div class="medallas-grid">
                            @foreach (var medalla in medallasReward)
                            {
                                bool bloqueada = medalla.FechaObtencion == null;
                                string claseFondo = bloqueada ? "locked-reward" : "unlocked-reward";

                                <div class="medalla-card-reward @claseFondo" @onclick="() => AbrirMedallaExpandida(medalla)">
                                    @if (!bloqueada)
                                    {
                                        <div class="date-badge" style="background: #00E676; color: #000;">@medalla.FechaObtencion?.ToString("dd/MMM/yy")</div>
                                    }

                                    <img src="@($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/Imagenes/Medallas/{medalla.Id}.png")" class="medalla-img-reward @(bloqueada ? "img-bw" : "")" />

                                    <div class="reward-info">
                                        <h4>@medalla.Nombre</h4>
                                        @if (bloqueada)
                                        {
                                            <div class="lock-icon" style="position: static; margin-top: 5px;"><i class="fas fa-lock"></i></div>
                                        }
                                        else
                                        {
                                            <span class="reward-claim"><i class="fas fa-ticket-alt"></i> RECLAMABLE</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }


                @* GENERACIÓN DINÁMICA DEL RESTO DE LAS SECCIONES *@
                @foreach (var grupo in gruposNormales)
                {
                    string iconClass = "fa-star";
                    string tituloSeccion = $"COLECCIÓN {grupo.Key.ToUpper()}";

                    if (grupo.Key.ToLower() == "neon") { iconClass = "fa-bolt"; tituloSeccion = "COLECCIÓN NEÓN"; }
                    if (grupo.Key.ToLower() == "sticker") { iconClass = "fa-shield-alt"; tituloSeccion = "STICKERS TÁCTICOS"; }
                    if (grupo.Key.ToLower() == "arcade") { iconClass = "fa-gamepad"; tituloSeccion = "ARCADE RETRO"; }
                    if (grupo.Key.ToLower() == "holo") { iconClass = "fa-gem"; tituloSeccion = "COLECCIÓN HOLO"; }

                    <h3 class="section-title fade-in mt-4">
                        <i class="fas @iconClass" style="color: var(--theme-primary);"></i> @tituloSeccion
                    </h3>

                    <div class="medallas-grid fade-in">
                        @foreach (var medalla in grupo)
                        {
                            bool bloqueada = medalla.FechaObtencion == null;
                            string claseFondo = bloqueada ? "locked" : $"unlocked-{medalla.Diseno.ToLower()}";

                            <div class="medalla-card @claseFondo" @onclick="() => AbrirMedallaExpandida(medalla)">
                                
                                @if (!bloqueada)
                                {
                                    <div class="date-badge">@medalla.FechaObtencion?.ToString("dd/MMM/yy")</div>
                                }

                                <img src="@($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/Imagenes/Medallas/{medalla.Id}.png")" class="medalla-img @(bloqueada ? "img-bw" : (medalla.Diseno.ToLower() == "sticker" ? "drop-shadow-sticker" : ""))" />

                                <h4 class="medalla-nombre">@medalla.Nombre</h4>
                                
                                @if (bloqueada)
                                {
                                    <div class="lock-icon"><i class="fas fa-lock"></i></div>
                                }
                            </div>
                        }
                    </div>
                }
            }
            <div style="height: 40px;"></div>
        </div>
    </div>

    @* ========================================== *@
    @* MODAL EXPANDIDO DE MEDALLA (PARA COMPARTIR)*@
    @* ========================================== *@
    @if (medallaExpandida != null)
    {
        bool bloqueadaExp = medallaExpandida.FechaObtencion == null;
        string claseExp = bloqueadaExp ? "locked-exp" : $"unlocked-exp-{medallaExpandida.Diseno.ToLower()}";
        string claseImgExp = bloqueadaExp ? "img-bw" : (medallaExpandida.Diseno.ToLower() == "sticker" ? "drop-shadow-sticker" : "glow-effect-exp");

        <div class="modal-overlay fade-in" style="z-index: 6000;" @onclick="CerrarMedallaExpandida">
            <div class="modal-content custom-modal-exp bounce-in @claseExp" @onclick:stopPropagation="true">
                
                <button class="btn-close-exp" @onclick="CerrarMedallaExpandida"><i class="fas fa-times"></i></button>

                <div class="exp-header">
                    @if (bloqueadaExp)
                    {
                        <span class="exp-status"><i class="fas fa-lock"></i> LOGRO BLOQUEADO</span>
                    }
                    else
                    {
                        <span class="exp-status" style="color: var(--theme-primary);"><i class="fas fa-check-circle"></i> LOGRO DESBLOQUEADO</span>
                        <div class="exp-date">@medallaExpandida.FechaObtencion?.ToString("dd 'de' MMMM, yyyy", new System.Globalization.CultureInfo("es-ES")).ToUpper()</div>
                    }
                </div>

                <div class="exp-img-container">
                    <img src="@($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/Imagenes/Medallas/{medallaExpandida.Id}.png")" class="exp-img @claseImgExp" />
                    
                    @if (!bloqueadaExp && (medallaExpandida.Diseno.ToLower() == "neon" || medallaExpandida.Diseno.ToLower() == "holo" || medallaExpandida.Diseno.ToLower() == "legendary"))
                    {
                        <div class="exp-aura"></div>
                    }
                </div>

                <h2 class="exp-title">@medallaExpandida.Nombre</h2>
                
                <div class="exp-divider"></div>
                
                <p class="exp-leyenda">
                    @if (bloqueadaExp)
                    {
                        <strong style="color: var(--theme-text-muted);">¿Cómo obtenerla?</strong><br />
                    }
                    else
                    {
                        <strong style="color: var(--theme-primary);">Motivo del logro:</strong><br />
                    }
                    <span style="font-size: 1.1rem; font-style: italic;">"@medallaExpandida.Leyenda"</span>
                </p>

                @if (!medallaExpandida.EsAuto)
                {
                    <div class="exp-coach-tag">
                        <i class="fas fa-award"></i> ASIGNADA POR COACH
                    </div>
                }

                @if (!bloqueadaExp)
                {
                    <button class="btn-awesome mt-4" style="width: 80%; padding: 10px;" @onclick="CerrarMedallaExpandida">¡ASOMBROSO!</button>
                }
            </div>
        </div>
    }

    @* ========================================== *@
    @* MODAL ADMIN: ASIGNACIÓN MANUAL Y MASIVA    *@
    @* ========================================== *@
    @if (mostrarModalAdmin)
    {
        <div class="modal-overlay" style="z-index: 5000;">
            <div class="modal-content custom-modal slide-in-bottom">
                <div class="modal-header">
                    <h5 style="margin:0; color:var(--theme-primary); font-family:'Oswald'"><i class="fas fa-award"></i> ASIGNAR LOGROS</h5>
                    <button class="btn-close-custom" @onclick="CerrarModalAsignar"><i class="fas fa-times"></i></button>
                </div>
                
                @* TABS DEL MODAL ADMIN *@
                <div class="modal-tabs">
                    <div class="tab-btn @(tabAdmin == "Individual" ? "active" : "")" @onclick='() => tabAdmin = "Individual"'>POR ATLETA</div>
                    <div class="tab-btn @(tabAdmin == "Masivo" ? "active" : "")" @onclick='() => CargarTabMasivo()'>MASIVO</div>
                </div>

                <div class="modal-body" style="overflow-y:auto; padding-top: 10px;">
                    
                    @* ------------------ TAB: INDIVIDUAL ------------------ *@
                    @if (tabAdmin == "Individual")
                    {
                        <label class="lbl-input mt-2">Selecciona Atleta:</label>
                        <select class="form-control input-dark mb-4" @onchange="AlSeleccionarUsuario">
                            <option value="">-- Buscar Atleta --</option>
                            @if (listaUsuariosBox != null)
                            {
                                @foreach (var u in listaUsuariosBox)
                                {
                                    <option value="@u.UsuarioId">@u.NombreCompleto</option>
                                }
                            }
                        </select>

                        @if (usuarioSeleccionadoId != Guid.Empty)
                        {
                            @if (cargandoCatalogoManual)
                            {
                                <div class="text-center text-muted">Cargando catálogo...</div>
                            }
                            else if (catalogoManual != null && catalogoManual.Any())
                            {
                                <h6 style="color:var(--theme-text); font-family:'Oswald'; margin-bottom:10px; text-transform:uppercase;">Stickers / Logros Especiales:</h6>
                                
                                @* BUSCADOR DE MEDALLAS EN INDIVIDUAL *@
                                <div class="search-box">
                                    <i class="fas fa-search"></i>
                                    <input type="text" class="search-input" placeholder="Buscar medalla por nombre..." @bind="filtroMedallasIndividual" @bind:event="oninput" />
                                </div>

                                <div class="toggles-list">
                                    @foreach (var item in catalogoManual.Where(m => string.IsNullOrWhiteSpace(filtroMedallasIndividual) || m.Nombre.Contains(filtroMedallasIndividual, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <div class="module-row" @onclick="() => ToggleMedallaManual(item)">
                                            <div style="display:flex; align-items:center; gap:10px;">
                                                <i class="@(item.Diseno == "Sticker" ? "fas fa-shield-alt" : (item.Diseno == "Arcade" ? "fas fa-gamepad" : (item.Diseno == "Legendary" ? "fas fa-crown" : "fas fa-bolt")))" style="color:var(--theme-text-muted);"></i>
                                                <span class="mod-name">@item.Nombre</span>
                                            </div>
                                            <div class="switch-track @(item.LaTiene ? "on" : "off")">
                                                <div class="switch-thumb"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }

                    @* ------------------ TAB: MASIVO ------------------ *@
                    @if (tabAdmin == "Masivo")
                    {
                        <label class="lbl-input mt-2">1. Selecciona el Logro a repartir:</label>
                        <select class="form-control input-dark mb-4" @onchange="AlSeleccionarMedallaMasiva">
                            <option value="">-- Elegir Medalla --</option>
                            @if (catalogoCompletoManual != null)
                            {
                                @foreach (var m in catalogoCompletoManual)
                                {
                                    <option value="@m.Id">@m.Nombre (@m.Diseno)</option>
                                }
                            }
                        </select>

                        @if (medallaMasivaSeleccionada != Guid.Empty)
                        {
                            @if (cargandoAtletasMasivo)
                            {
                                <div class="text-center text-muted">Cargando atletas...</div>
                            }
                            else if (listaUsuariosMasivo != null && listaUsuariosMasivo.Any())
                            {
                                <h6 style="color:var(--theme-text); font-family:'Oswald'; margin-bottom:10px; text-transform:uppercase;">Asignar a los siguientes atletas:</h6>
                                
                                @* BUSCADOR DE ATLETAS EN MASIVO *@
                                <div class="search-box">
                                    <i class="fas fa-search"></i>
                                    <input type="text" class="search-input" placeholder="Buscar atleta por nombre..." @bind="filtroAtletasMasivo" @bind:event="oninput" />
                                </div>

                                <div class="toggles-list">
                                    @foreach (var u in listaUsuariosMasivo.Where(a => string.IsNullOrWhiteSpace(filtroAtletasMasivo) || a.NombreCompleto.Contains(filtroAtletasMasivo, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <div class="module-row" @onclick="() => ToggleUsuarioMasivo(u)">
                                            <span class="mod-name">@u.NombreCompleto</span>
                                            <div class="switch-track @(u.TieneLaMedalla ? "on" : "off")">
                                                <div class="switch-thumb"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }

                </div>
                
                <div class="modal-footer">
                    <button class="btn-cancel" @onclick="CerrarModalAsignar">Cancelar</button>
                    @if (tabAdmin == "Individual")
                    {
                        <button class="btn-confirm" @onclick="GuardarMedallasManuales" disabled="@guardandoManuales">
                            @if (guardandoManuales) { <i class="fas fa-spinner fa-spin"></i> } else { <span>GUARDAR</span> }
                        </button>
                    }
                    else
                    {
                        <button class="btn-confirm" @onclick="GuardarAsignacionMasiva" disabled="@guardandoManuales">
                            @if (guardandoManuales) { <i class="fas fa-spinner fa-spin"></i> } else { <span>REPARTIR</span> }
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* Estructura Base y Layout */
    .main-layout { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--theme-bg); display: flex; flex-direction: column; z-index: 1; }
    .navbar-container { flex-shrink: 0; padding-top: calc(env(safe-area-inset-top) + 5px); padding-bottom: 10px; padding-left: 20px; padding-right: 20px; background-color: var(--theme-bg); border-bottom: 1px solid var(--theme-primary); color: var(--theme-text); display: flex; justify-content: space-between; align-items: center; z-index: 100; font-family: 'Oswald'; min-height: 60px; }
    .nav-left { color: var(--theme-primary); font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
    .nav-title { font-weight: bold; font-size: 1.1rem; color: var(--theme-text); letter-spacing: 1px; text-transform: uppercase; }
    .nav-right { width: 60px; display: flex; justify-content: flex-end; }
    .scrollable-content { flex-grow: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; align-items: center; -webkit-overflow-scrolling: touch; padding-bottom: 40px; }

    /* Botón Admin Arriba */
    .btn-admin-top { background: transparent; border: 1px solid var(--theme-primary); color: var(--theme-primary); width: 35px; height: 35px; border-radius: 50%; display: flex; justify-content: center; align-items: center; cursor: pointer; transition: 0.2s; }
    .btn-admin-top:active { transform: scale(0.9); background: var(--theme-primary); color: var(--theme-bg); }

    /* Estadísticas */
    .stats-panel { display: flex; align-items: center; justify-content: space-evenly; background: var(--theme-card); border: 1px solid var(--theme-border); border-radius: 15px; width: 100%; max-width: 600px; padding: 15px 0; margin-bottom: 25px; box-shadow: 0 5px 15px rgba(0,0,0,0.4); }
    .stat-box { display: flex; flex-direction: column; align-items: center; flex: 1; }
    .stat-number { font-family: 'Oswald'; font-size: 1.8rem; font-weight: bold; color: var(--theme-primary); line-height: 1; }
    .stat-label { font-size: 0.7rem; color: var(--theme-text-muted); letter-spacing: 1px; font-weight: bold; margin-top: 5px; }
    .stat-divider { width: 1px; height: 40px; background: var(--theme-border); }

    /* ==================================================== */
    /* NUEVA SECCIÓN: LEGENDARY (PREMIO FINAL)              */
    /* ==================================================== */
    .legendary-section { width: 100%; max-width: 600px; display: flex; flex-direction: column; align-items: center; }
    .medalla-card-legendary { 
        width: 100%; 
        background: linear-gradient(145deg, #1a1a1a 0%, #332b00 100%); 
        border: 2px solid #FFD700; 
        border-radius: 15px; 
        padding: 20px; 
        display: flex; 
        align-items: center; 
        gap: 20px; 
        cursor: pointer; 
        position: relative; 
        overflow: hidden; 
        transition: all 0.3s ease; 
    }
    .medalla-card-legendary:active { transform: scale(0.98); }
    
    .medalla-img-legendary { width: 100px; height: 100px; object-fit: contain; z-index: 2; }
    .legendary-info { display: flex; flex-direction: column; flex: 1; z-index: 2; text-align: left; }
    .legendary-info h4 { font-family: 'Oswald'; font-size: 1.4rem; color: #FFD700; margin: 0 0 5px 0; line-height: 1.1; text-transform: uppercase; text-shadow: 0 2px 4px rgba(0,0,0,0.8); }
    .legendary-info p { font-size: 0.85rem; color: #ccc; margin: 0; line-height: 1.3; }

    .locked-legendary { background: rgba(0,0,0,0.5); border: 2px dashed #555; }
    .locked-legendary .medalla-img-legendary { filter: grayscale(100%) opacity(40%); }
    .locked-legendary .legendary-info h4 { color: #888; text-shadow: none; }
    
    .unlocked-legendary { 
        box-shadow: 0 10px 25px rgba(255,215,0,0.3), inset 0 0 20px rgba(255,215,0,0.1); 
        animation: legendaryPulse 3s infinite alternate;
    }
    .unlocked-legendary .medalla-img-legendary { filter: drop-shadow(0 0 15px rgba(255,215,0,0.8)); }
    .unlocked-legendary::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(255,215,0,0.1) 0%, transparent 60%); animation: spinGlow 10s linear infinite; z-index: 1; pointer-events: none; }

    /* ==================================================== */

    /* Grid y Tarjetas Normales */
