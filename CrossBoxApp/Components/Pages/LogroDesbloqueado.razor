    .celeb-title { font-family: 'Oswald'; color: var(--theme-primary); font-size: 2rem; margin: 0; line-height: 1.1; text-shadow: 0 0 10px rgba(248,197,69,0.5); }
    .celeb-subtitle { color: var(--theme-text); font-size: 1rem; margin-top: 5px; margin-bottom: 25px; }
    .nuevas-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 15px; }
    .medalla-nueva-card { display: flex; flex-direction: column; align-items: center; width: 120px; }
    .celeb-img { width: 100px; height: 100px; object-fit: contain; margin-bottom: 10px; }
    .glow-effect { filter: drop-shadow(0 0 15px var(--theme-primary)); animation: pulseGlow 2s infinite; }
    .medalla-nueva-card h3 { font-family: 'Oswald'; font-size: 1rem; color: var(--theme-text); margin: 0; }
    .btn-awesome { background: var(--theme-primary); color: var(--theme-bg); border: none; padding: 15px 40px; font-family: 'Oswald'; font-size: 1.2rem; font-weight: bold; border-radius: 30px; cursor: pointer; transition: 0.2s; width: 100%; box-shadow: 0 5px 15px rgba(0,0,0,0.5); }
    .btn-awesome:active { transform: scale(0.95); }

    /* Animaciones */
    .fade-in { animation: fadeIn 0.4s ease; }
    .slide-up { animation: slideUp 0.3s ease; }
    .slide-in-bottom { animation: slideInBottom 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    .bounce-in { animation: bounceIn 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55); }
    
   @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
   @@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
   @@keyframes slideInBottom { from { transform: translateY(100%); } to { transform: translateY(0); } }
   @@keyframes bounceIn { 0% { transform: scale(0.3); opacity: 0; } 50% { transform: scale(1.05); opacity: 1; } 100% { transform: scale(1); } }
   @@keyframes pulseGlow { 0%, 100% { filter: drop-shadow(0 0 10px var(--theme-primary)); } 50% { filter: drop-shadow(0 0 25px var(--theme-primary)); transform: scale(1.05); } }
   @@keyframes pulseGlowExp { 0%, 100% { filter: drop-shadow(0 0 15px var(--theme-primary)); } 50% { filter: drop-shadow(0 0 35px var(--theme-primary)); transform: scale(1.03); } }
   @@keyframes pulseAura { 0% { transform: translate(-50%, -50%) scale(0.9); opacity: 0.1; } 100% { transform: translate(-50%, -50%) scale(1.2); opacity: 0.3; } }
   @@keyframes legendaryPulse { 0% { border-color: #B8860B; box-shadow: 0 10px 25px rgba(255,215,0,0.1), inset 0 0 10px rgba(255,215,0,0.1); } 100% { border-color: #FFD700; box-shadow: 0 10px 35px rgba(255,215,0,0.5), inset 0 0 30px rgba(255,215,0,0.3); } }
   @@keyframes spinGlow { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }


   /* ==================================================== */
