    .reward-info h4 { font-family: 'Oswald'; font-size: 0.95rem; color: var(--theme-text); margin: 0; line-height: 1.2; }
    .reward-claim { font-size: 0.7rem; color: #00E676; font-weight: bold; margin-top: 5px; display: inline-block; background: rgba(0, 230, 118, 0.1); padding: 3px 8px; border-radius: 10px; border: 1px solid #00E676; }

    .locked-reward { background: rgba(0,0,0,0.3); border: 2px dashed #555; }
    .unlocked-reward {
        border-color: #00E676;
        background: linear-gradient(180deg, rgba(0, 230, 118, 0.1) 0%, var(--theme-card) 100%);
        box-shadow: 0 5px 15px rgba(0, 230, 118, 0.2), inset 0 0 10px rgba(0, 230, 118, 0.1);
    }
    .unlocked-reward .medalla-img-reward { 
        filter: drop-shadow(0 5px 10px rgba(0, 230, 118, 0.6)); 
        animation: floatReward 3s ease-in-out infinite; 
