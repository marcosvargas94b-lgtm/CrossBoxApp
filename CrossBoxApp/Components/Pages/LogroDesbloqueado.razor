    .tab-btn.active { color: var(--theme-primary); border-bottom: 3px solid var(--theme-primary); font-weight:bold; background:rgba(255,255,255,0.02);}

    /* Switch Component */
    .module-row { display: flex; justify-content: space-between; align-items: center; background-color: var(--theme-card); padding: 12px 15px; border-radius: 8px; margin-bottom: 10px; border: 1px solid var(--theme-border); cursor: pointer; }
