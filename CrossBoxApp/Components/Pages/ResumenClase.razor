</style>

@code {
    // --- ESTADO INICIAL NEUTRAL (PLATA MATE) ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    class AtletaResumen { 
        public Guid UsuarioId; public Guid BoxId; public string NombreCompleto; public string FotoUrl; 
        public int Reps; 
        public int Rondas;
        public string Categoria; 
    }
    
    // --- ACTUALIZADO PARA SEPARAR EL TEXTO EN PARTES ---
    class PodiumItem { 
        public string NombrePrincipal; 
        public List<string> NombresMiembros = new(); 
        public bool EsEquipo; 
        public string FotoUrl; 
        public string ScoreTexto; 
        public string ScoreVal; 
        public string ScoreLabel; 
        public string ScoreSub; 
        public int Posicion; 
        public double ValorOrdenamiento; 
    }
    
    public class GuardarResultadosDto
    {
        public Guid BoxId { get; set; }
        public Guid WodId { get; set; }
        public List<ResultadoAtletaDto> Resultados { get; set; } = new();
    }

    public class ResultadoAtletaDto
    {
        public Guid UsuarioUnoId { get; set; }
        public Guid? UsuarioDosId { get; set; }
        public bool EsEquipo { get; set; }
        public string TiempoFinal { get; set; }
        public int Reps { get; set; }
        public int Rondas { get; set; } 
        public string NombreEquipo { get; set; }
        public string Categoria { get; set; } 
        
        // --- NUEVO: LE DECIMOS AL BACKEND EXACTAMENTE QUÉ MODO FUE ---
        public string ModoCaptura { get; set; } 
    }

    private List<AtletaResumen> listaLocal = new();
    private string modoCaptura = "NADA"; 
    private bool guardando = false;
    private bool mostrarPodio = false;
    private List<PodiumItem> top3 = new();
    private List<PodiumItem> restoList = new();

    private bool usarCategorias = false; 
    private Dictionary<Guid, string> categoriasJuezSeleccionadas = new();
    private bool mostrarModalCategoria = false;
    private Guid idAtletaEditandoCategoria = Guid.Empty; 
    private bool esModoJuezEditando = false;

    protected override async Task OnInitializedAsync()
    {
        // LEER EL CACHÉ LOCAL AL INSTANTE
        try 
        {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) 
            { 
                EstilosTema = cache; 
                StateHasChanged(); 
            }
        } 
        catch { }

        if (!LiveState.FueModoJuez) {
            listaLocal = LiveState.AtletasEnClase.Select(a => new AtletaResumen { 
                UsuarioId = a.UsuarioId, BoxId = a.BoxId, NombreCompleto = a.NombreCompleto, FotoUrl = a.FotoUrl, Reps = 0, Rondas = 0, Categoria = "" 
            }).ToList();
        }
    }

    private void RegresarAlDashboard()
    {
        Nav.NavigateTo("/live-dashboard");
    }

    private void AbrirModalCategoria(Guid id, bool esJuez)
    {
        idAtletaEditandoCategoria = id;
        esModoJuezEditando = esJuez;
        mostrarModalCategoria = true;
    }

    private void AsignarCategoria(string cat)
    {
        if (esModoJuezEditando)
        {
            if(categoriasJuezSeleccionadas.ContainsKey(idAtletaEditandoCategoria)) 
                categoriasJuezSeleccionadas[idAtletaEditandoCategoria] = cat;
            else 
                categoriasJuezSeleccionadas.Add(idAtletaEditandoCategoria, cat);
        }
        else
        {
            var atleta = listaLocal.FirstOrDefault(x => x.UsuarioId == idAtletaEditandoCategoria);
            if(atleta != null) atleta.Categoria = cat;
        }
        mostrarModalCategoria = false;
    }

    private async Task ProcesarYGuardar()
    {
        guardando = true;
        StateHasChanged();

        var payload = new GuardarResultadosDto { BoxId = Sesion.Usuario.BoxID, WodId = Guid.Empty };

        if (LiveState.FueModoJuez)
        {
            foreach (var item in LiveState.ResultadosJuez)
            {
                string cat = "";
                if(categoriasJuezSeleccionadas.ContainsKey(item.Atletas[0].UsuarioId)) 
                    cat = categoriasJuezSeleccionadas[item.Atletas[0].UsuarioId];
                
                if (usarCategorias && string.IsNullOrEmpty(cat)) cat = "Sin asignar";
                if (!usarCategorias) cat = "";

                payload.Resultados.Add(new ResultadoAtletaDto
                {
                    UsuarioUnoId = item.Atletas[0].UsuarioId,
                    UsuarioDosId = (item.Atletas.Count > 1) ? item.Atletas[1].UsuarioId : null,
                    EsEquipo = (item.Atletas.Count > 1),
                    TiempoFinal = item.Finalizado ? item.TiempoFinal : "DNF",
                    Reps = 0,
                    Rondas = 0, 
                    NombreEquipo = item.NombreEquipo ?? "Equipo",
                    Categoria = cat,
                    ModoCaptura = "TIEMPO" // Le decimos al backend que fue por tiempo
                });
            }
        }
        else
        {
            foreach (var item in listaLocal)
            {
                string cat = item.Categoria;
                if (usarCategorias && string.IsNullOrEmpty(cat)) cat = "Sin asignar";
                if (!usarCategorias) cat = "";

                payload.Resultados.Add(new ResultadoAtletaDto
                {
                    UsuarioUnoId = item.UsuarioId,
                    EsEquipo = false,
                    Reps = (modoCaptura == "REPS" || modoCaptura == "RONDAS") ? item.Reps : 0,
                    Rondas = modoCaptura == "RONDAS" ? item.Rondas : 0,
                    TiempoFinal = null, 
                    NombreEquipo = "Individual",
                    Categoria = cat,
                    ModoCaptura = modoCaptura // <--- AQUI LE DECIMOS EXACTAMENTE QUÉ MODO ESTABA ACTIVO (NADA, REPS, RONDAS)
                });
            }
        }

        try
        {
            var url = "https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/scoresapi/guardar-clase";
            var response = await Http.PostAsJsonAsync(url, payload);
            
            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine("Error al guardar en servidor.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error de conexión: {ex.Message}");
        }

        bool huboCompetencia = LiveState.FueModoJuez || (modoCaptura != "NADA" && listaLocal.Any(x => x.Reps > 0 || x.Rondas > 0));

        if (!huboCompetencia)
        {
            FinalizarNavegacion();
        }
        else
        {
            CalularPodio();
        }

        guardando = false;
        StateHasChanged();
    }

    private void CalularPodio()
    {
       top3.Clear(); restoList.Clear(); List<PodiumItem> candidatos = new();
       
       if (LiveState.FueModoJuez) {
             var terminados = LiveState.ResultadosJuez.Where(x => x.Finalizado).ToList();
             foreach(var r in terminados) {
                 double segundos = 99999;
                 if(!string.IsNullOrEmpty(r.TiempoFinal)) { var parts = r.TiempoFinal.Split(':'); if(parts.Length == 2) segundos = (int.Parse(parts[0])*60) + int.Parse(parts[1]); }
                 
                 // ASIGNAMOS LAS VARIABLES DEL DISEÑO
                 var item = new PodiumItem { 
                     EsEquipo = r.Atletas.Count > 1, 
                     FotoUrl = r.Atletas[0].FotoUrl, 
                     ScoreTexto = r.TiempoFinal, 
                     ScoreVal = r.TiempoFinal,
                     ScoreLabel = "TIME",
                     ScoreSub = "",
                     ValorOrdenamiento = segundos 
                 };
                 
                 if (item.EsEquipo) item.NombresMiembros = r.Atletas.Select(a => a.NombreCompleto.Split(' ')[0]).ToList();
                 else item.NombrePrincipal = r.Atletas[0].NombreCompleto.Split(' ')[0];
                 candidatos.Add(item);
             }
             candidatos = candidatos.OrderBy(x => x.ValorOrdenamiento).ToList();
       } else {
             bool esRondas = modoCaptura == "RONDAS";
             var origen = listaLocal.Where(x => (esRondas ? x.Rondas : x.Reps) > 0).ToList();
             if(!origen.Any() && listaLocal.Any()) origen = listaLocal.Take(5).ToList(); 
             
             foreach(var a in origen) {
                 int valorRondas = esRondas ? a.Rondas : 0;
                 int valorReps = a.Reps;
                 
                 string texto = "";
                 string sVal = "";
                 string sLbl = "";
                 string sSub = "";
                 double orden = 0;
                 
                 if (esRondas) {
                     texto = $"{valorRondas} RONDAS";
                     sVal = valorRondas.ToString();
                     sLbl = "RONDAS";
                     
                     if (valorReps > 0) {
                         texto += $" + {valorReps}"; 
                         sSub = $"+ {valorReps} REPS";
                     }
                     orden = (valorRondas * 10000) + valorReps; // LAS RONDAS VALEN MÁS, LAS REPS DESEMPATAN
                 } else {
                     texto = $"{valorReps} REPS";
                     sVal = valorReps.ToString();
                     sLbl = "REPS";
                     orden = valorReps;
                 }
                 
                 candidatos.Add(new PodiumItem { 
                     EsEquipo = false, 
                     NombrePrincipal = a.NombreCompleto.Split(' ')[0], 
                     FotoUrl = a.FotoUrl, 
                     ScoreTexto = texto, 
                     ScoreVal = sVal,
                     ScoreLabel = sLbl,
                     ScoreSub = sSub,
                     ValorOrdenamiento = orden 
                 });
             }
             candidatos = candidatos.OrderByDescending(x => x.ValorOrdenamiento).ToList();
       }

       if (candidatos.Count > 0) {
            for(int i=0; i<candidatos.Count; i++) {
                candidatos[i].Posicion = i + 1;
                if(i < 3) top3.Add(candidatos[i]); else restoList.Add(candidatos[i]);
            }
            mostrarPodio = true;
       } else { FinalizarNavegacion(); }
    }

    private void FinalizarNavegacion() { LiveState.AtletasEnClase.Clear(); LiveState.ResultadosJuez.Clear(); LiveState.FueModoJuez = false; Nav.NavigateTo("/home"); }
}