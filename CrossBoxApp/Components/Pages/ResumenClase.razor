@page "/resumen-clase"
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@using System.Globalization
@inject LiveSessionState LiveState
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS

@* ENVOLVEMOS TODA LA PÁGINA EN EL TEMA *@
<div style="@EstilosTema">

    <div class="resumen-container">
        
        @* --- NUEVO: BOTÓN DE REGRESO AL DASHBOARD --- *@
        <button class="btn-back-dashboard fade-in" @onclick="RegresarAlDashboard" title="Volver a la clase">
            <i class="fas fa-arrow-left"></i> VOLVER AL DASHBOARD
        </button>

        <div class="resumen-card">
            
            <div class="header-resumen">
                <div class="header-top-row">
                    <h2>CLASE FINALIZADA</h2>
                    <div class="category-switch-area">
                        <span class="lbl-cat">¿USAR CATEGORÍAS?</span>
                        <label class="switch-cat">
                            <input type="checkbox" @bind="usarCategorias">
                            <span class="slider-cat round"></span>
                        </label>
                    </div>
                </div>

                @if (LiveState.FueModoJuez)
                {
                    <div class="mode-badge">
                        <i class="fas fa-stopwatch"></i> TIEMPOS CAPTURADOS POR JUEZ
                    </div>
                }
                else
                {
                    <div class="capture-mode-selector fade-in">
                        <button class="@(modoCaptura == "NADA" ? "active" : "")" @onclick='() => modoCaptura = "NADA"'>ASISTENCIA</button>
                        <button class="@(modoCaptura == "REPS" ? "active" : "")" @onclick='() => modoCaptura = "REPS"'>REPETICIONES</button>
                        <button class="@(modoCaptura == "RONDAS" ? "active" : "")" @onclick='() => modoCaptura = "RONDAS"'>RONDAS</button>
                    </div>
                }
            </div>

            <div class="attendance-list scroll-custom">
                
                @* ==================================================================== *@
                @* MODO JUEZ (TIEMPOS) *@
                @* ==================================================================== *@
                @if (LiveState.FueModoJuez)
                {
                    @if (LiveState.ResultadosJuez.Count == 0)
                    {
                        <div class="text-theme-muted">No se capturaron tiempos.</div>
                    }
                    else
                    {
                        <table class="table-results">
                            <thead>
                                <tr>
                                    <th>Atleta / Equipo</th>
                                    <th style="text-align:center;">Tiempo</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var res in LiveState.ResultadosJuez)
                            {
                                var key = res.Atletas[0].UsuarioId; 
                                string catActual = categoriasJuezSeleccionadas.ContainsKey(key) ? categoriasJuezSeleccionadas[key] : "";

                                <tr>
                                    <td style="text-align:left;">
                                        @if (res.Atletas.Count > 1)
                                        {
                                            <div class="team-group">
                                                <div class="team-members">
                                                    @foreach(var a in res.Atletas)
                                                    {
                                                        <div class="mini-row"><span>@a.NombreCompleto</span></div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            var atl = res.Atletas[0];
                                            <div class="individual-row">
                                                @if(!string.IsNullOrEmpty(atl.FotoUrl)) { <img src="@atl.FotoUrl" class="avatar-small" @onerror="@(e => atl.FotoUrl = null)" /> }
                                                else { <div class="avatar-small-letter">@atl.NombreCompleto.Substring(0,1)</div> }
                                                <span>@atl.NombreCompleto</span>
                                            </div>
                                        }

                                        @if (usarCategorias)
                                        {
                                            <div class="cat-badge-container" @onclick="() => AbrirModalCategoria(key, true)">
                                                @if (string.IsNullOrEmpty(catActual)) { <span class="cat-badge-empty">Categoría (+)</span> }
                                                else { <span class="cat-badge-filled">@catActual</span> }
                                            </div>
                                        }
                                    </td>
                                    <td style="text-align:center; vertical-align: top;">
                                        <div class="result-box @(res.Finalizado ? "done" : "pend")">
                                            @(res.Finalizado ? res.TiempoFinal : "---")
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                }
                @* ==================================================================== *@
                @* MODO MANUAL (NADA / REPS / RONDAS) *@
                @* ==================================================================== *@
                else
                {
                    @if (listaLocal.Count == 0)
                    {
                        <div class="text-theme-muted">Nadie hizo check-in.</div>
                    }
                    else
                    {
                        @foreach (var atleta in listaLocal)
                        {
                            <div class="user-row-wrapper">
                                <div class="user-row">
                                    <div class="user-left">
                                        @if (!string.IsNullOrEmpty(atleta.FotoUrl))
                                        {
                                            <img src="@atleta.FotoUrl" class="avatar-list-img" @onerror="@(e => atleta.FotoUrl = null)" />
                                        }
                                        else
                                        {
                                            <div class="avatar-list-letter">@(atleta.NombreCompleto?.Substring(0, 1).ToUpper() ?? "A")</div>
                                        }
                                        
                                        <div style="display:flex; flex-direction:column; align-items:flex-start;">
                                            <span class="text-truncate">@atleta.NombreCompleto</span>
                                            
                                            @if (usarCategorias)
                                            {
                                                <div class="cat-badge-manual" @onclick="() => AbrirModalCategoria(atleta.UsuarioId, false)">
                                                    @if (string.IsNullOrEmpty(atleta.Categoria)) { <span class="cat-text-empty">Categoría (+)</span> }
                                                    else { <span class="cat-text-filled">@atleta.Categoria</span> }
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    @if (modoCaptura == "REPS")
                                    {
                                        <div class="score-input-wrapper">
                                            <input type="number" @bind="atleta.Reps" class="input-reps" placeholder="0" min="0" />
                                            <small style="color: var(--theme-text-muted);">REPS</small>
                                        </div>
                                    }
                                    else if (modoCaptura == "RONDAS")
                                    {
                                        <div class="score-input-wrapper">
                                            <input type="number" @bind="atleta.Rondas" class="input-reps" placeholder="0" min="0" />
                                            <small style="color: var(--theme-text-muted);">RND</small>
                                            <span style="color: var(--theme-border); font-weight: bold; margin: 0 2px;">+</span>
                                            <input type="number" @bind="atleta.Reps" class="input-reps" placeholder="0" min="0" />
                                            <small style="color: var(--theme-text-muted);">REP</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <i class="fas fa-check" style="color:#28a745; margin-right:10px;"></i>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            <div class="footer-actions">
                <button class="btn-close-session" @onclick="ProcesarYGuardar" disabled="@guardando">
                    @if (guardando)
                    {
                        <span><i class="fas fa-spinner fa-spin"></i> GUARDANDO...</span>
                    }
                    else
                    {
                        <span>CONFIRMAR Y GUARDAR ASISTENCIA</span>
                    }
                </button>
            </div>
        </div>
    </div>

    @* --- MODALES Y PODIO --- *@
    @if (mostrarModalCategoria)
    {
        <div class="modal-overlay fade-in">
            <div class="modal-content custom-modal" style="height:auto; max-width:350px;">
                <div class="modal-header">
                    <h5 style="margin:0; color:var(--theme-primary); font-weight:bold;">SELECCIONAR NIVEL</h5>
                    <button class="btn-icon-header" @onclick="() => mostrarModalCategoria = false"><i class="fas fa-times"></i></button>
                </div>
                <div class="modal-body">
                    <div class="cat-buttons-grid">
                        <button class="btn-cat-opt" @onclick='() => AsignarCategoria("PRINCIPIANTE")'>PRINCIPIANTE</button>
                        <button class="btn-cat-opt" @onclick='() => AsignarCategoria("INTERMEDIO")'>INTERMEDIO</button>
                        <button class="btn-cat-opt" @onclick='() => AsignarCategoria("AVANZADO")'>AVANZADO</button>
                        <button class="btn-cat-opt" @onclick='() => AsignarCategoria("RX")'>RX</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (mostrarPodio)
    {
        <div class="podium-overlay fade-in">
            <button class="btn-close-overlay" @onclick="FinalizarNavegacion"><i class="fas fa-times"></i></button>
            <div class="victory-bg-effect"></div>
            <div class="victory-container">
                <div class="victory-layout-main">
                    <div class="podium-area">
                        <div class="podium-stage">
                            
                            @* 2DO LUGAR (PLATA MANTIENE COLOR UNIVERSAL) *@
                            <div class="podium-group slide-up-delay-2">
                                <div class="podium-avatar-box silver-glow">
                                    @if (!string.IsNullOrEmpty(top3.ElementAtOrDefault(1)?.FotoUrl)) { <img src="@top3[1].FotoUrl" class="avatar-circle" @onerror="@(e => top3[1].FotoUrl = null)" /> }
                                    else { <div class="medal-placeholder silver-medal"><i class="fas fa-medal"></i></div> }
                                </div>
                                <div class="podium-pillar silver" style="height: 160px;">
                                    <div class="bar-content">
                                        <span class="rank-num">2</span>
                                        @if (top3.Count >= 2)
                                        {
                                            <div class="winner-info">
                                                @if(top3[1].EsEquipo && top3[1].NombresMiembros.Any()) { <div class="team-stack-podium">@foreach(var name in top3[1].NombresMiembros.Take(2)){ <span class="winner-name">@name</span> }</div> }
                                                else { <span class="winner-name">@top3[1].NombrePrincipal</span> }
                                                
                                                <div class="winner-score-box">
                                                    <span class="w-val">@top3[1].ScoreVal</span>
                                                    <span class="w-lbl">@top3[1].ScoreLabel</span>
                                                    @if(!string.IsNullOrEmpty(top3[1].ScoreSub)) { <span class="w-sub">@top3[1].ScoreSub</span> }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            @* 1ER LUGAR (ORO MANTIENE COLOR UNIVERSAL) *@
                            <div class="podium-group slide-up-delay-1">
                                <div class="crown-floating zoom-in-delay"><i class="fas fa-crown"></i></div>
                                <div class="podium-avatar-box big gold-glow">
                                    @if (!string.IsNullOrEmpty(top3.ElementAtOrDefault(0)?.FotoUrl)) { <img src="@top3[0].FotoUrl" class="avatar-circle" @onerror="@(e => top3[0].FotoUrl = null)" /> }
                                    else { <div class="medal-placeholder gold-medal"><i class="fas fa-trophy"></i></div> }
                                </div>
                                <div class="podium-pillar gold" style="height: 220px;">
                                    <div class="bar-content">
                                        <span class="rank-num">1</span>
                                        @if (top3.Count >= 1)
                                        {
                                            <div class="winner-info main-winner">
                                                @if(top3[0].EsEquipo && top3[0].NombresMiembros.Any()) { <div class="team-stack-podium">@foreach(var name in top3[0].NombresMiembros.Take(2)){ <span class="winner-name">@name</span> }</div> }
                                                else { <span class="winner-name">@top3[0].NombrePrincipal</span> }
                                                
                                                <div class="winner-score-box main-score-box">
                                                    <span class="w-val">@top3[0].ScoreVal</span>
                                                    <span class="w-lbl">@top3[0].ScoreLabel</span>
                                                    @if(!string.IsNullOrEmpty(top3[0].ScoreSub)) { <span class="w-sub">@top3[0].ScoreSub</span> }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            @* 3ER LUGAR (BRONCE MANTIENE COLOR UNIVERSAL) *@
                            <div class="podium-group slide-up-delay-3">
                                <div class="podium-avatar-box bronze-glow">
                                    @if (!string.IsNullOrEmpty(top3.ElementAtOrDefault(2)?.FotoUrl)) { <img src="@top3[2].FotoUrl" class="avatar-circle" @onerror="@(e => top3[2].FotoUrl = null)" /> }
                                    else { <div class="medal-placeholder bronze-medal"><i class="fas fa-medal"></i></div> }
                                </div>
                                <div class="podium-pillar bronze" style="height: 130px;">
                                    <div class="bar-content">
                                        <span class="rank-num">3</span>
                                        @if (top3.Count >= 3)
                                        {
                                            <div class="winner-info">
                                                @if(top3[2].EsEquipo && top3[2].NombresMiembros.Any()) { <div class="team-stack-podium">@foreach(var name in top3[2].NombresMiembros.Take(2)){ <span class="winner-name">@name</span> }</div> }
                                                else { <span class="winner-name">@top3[2].NombrePrincipal</span> }
                                                
                                                <div class="winner-score-box">
                                                    <span class="w-val">@top3[2].ScoreVal</span>
                                                    <span class="w-lbl">@top3[2].ScoreLabel</span>
                                                    @if(!string.IsNullOrEmpty(top3[2].ScoreSub)) { <span class="w-sub">@top3[2].ScoreSub</span> }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    @if(restoList.Count > 0)
                    {
                        <div class="the-rest-area slide-in-right-delay">
                            <div class="rest-header">THE PACK</div>
                            <div class="rest-list scroll-custom">
                                @foreach(var item in restoList)
                                {
                                    <div class="rest-row">
                                        <span class="rest-rank">#@item.Posicion</span>
                                        <div class="rest-info">
                                             @if(item.EsEquipo && item.NombresMiembros.Any()) { <div class="rest-stack-names">@foreach(var name in item.NombresMiembros) { <span class="rest-name">@name</span> }</div> }
                                             else { <span class="rest-name">@item.NombrePrincipal</span> }
                                        </div>
                                        <div class="rest-score-box">
                                            <span class="r-val">@item.ScoreVal <small>@item.ScoreLabel</small></span>
                                            @if(!string.IsNullOrEmpty(item.ScoreSub)) { <span class="r-sub">@item.ScoreSub</span> }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* --- ESTILOS GENERALES Y VARIABLES BASE --- */
    .resumen-container { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: var(--theme-bg); color: var(--theme-text); display: flex; justify-content: center; align-items: center; z-index: 1; padding: 10px; }
    
    .text-theme-muted { color: var(--theme-text-muted); }

    /* --- BOTÓN VOLVER (COMPACTO Y MODERNO) --- */
    .btn-back-dashboard {
        position: absolute;
        top: 20px;
        left: 20px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--theme-primary);
        color: var(--theme-primary);
        padding: 8px 15px; 
        border-radius: 50px;
        font-family: 'Oswald';
        font-weight: bold;
        font-size: 0.85rem; 
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        z-index: 10;
        backdrop-filter: blur(5px);
    }
    .btn-back-dashboard:hover {
        background: var(--theme-primary);
        color: var(--theme-bg);
    }

    /* --- REGLAS EXCLUSIVAS PARA MODO VERTICAL (PORTRAIT) --- */
    @@media (orientation: portrait) {
        .btn-back-dashboard {
            top: calc(env(safe-area-inset-top) + 15px) !important;
            left: 15px;
        }
        
        .btn-close-overlay {
            top: calc(env(safe-area-inset-top) + 20px) !important;
            right: 20px !important;
        }
        
        .victory-container {
            padding-bottom: 20px !important;
            padding-top: calc(env(safe-area-inset-top) + 60px) !important;
            justify-content: center !important; 
        }
        
        .victory-layout-main {
            justify-content: center !important; 
        }
    }

    @@media (max-width: 600px) {
        .btn-back-dashboard {
            padding: 6px 12px;
            font-size: 0.75rem;
        }
    }

    /* --- TARJETA PRINCIPAL --- */
    .resumen-card { background: var(--theme-card); width: 90%; max-width: 500px; border-radius: 15px; padding: 15px 20px; text-align: center; border: 2px solid var(--theme-primary); box-shadow: 0 0 50px rgba(0,0,0,0.5); display: flex; flex-direction: column; max-height: 85vh; height: auto; position: relative; z-index: 5; }
    
    .header-resumen { flex-shrink: 0; }
    .header-top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; } 
    .header-top-row h2 { font-family: 'Oswald'; color: var(--theme-text); font-size: 1.2rem; margin: 0; }
    
    .attendance-list { flex-grow: 1; overflow-y: auto; min-height: 0; margin-bottom: 10px; padding-right: 5px; border-top: 1px solid var(--theme-border); border-bottom: 1px solid var(--theme-border); }
    .footer-actions { flex-shrink: 0; }
    .scroll-custom::-webkit-scrollbar { width: 5px; } .scroll-custom::-webkit-scrollbar-thumb { background: var(--theme-border); border-radius: 10px; }

    .category-switch-area { display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.05); padding: 3px 8px; border-radius: 10px; }
    .lbl-cat { font-size: 0.75rem; color: var(--theme-primary); font-family: 'Oswald'; }
    .switch-cat { position: relative; display: inline-block; width: 34px; height: 18px; margin: 0; }
    .switch-cat input { opacity: 0; width: 0; height: 0; }
    .slider-cat { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--theme-border); transition: .4s; border-radius: 34px; }
    .slider-cat:before { position: absolute; content: ""; height: 12px; width: 12px; left: 3px; bottom: 3px; background-color: var(--theme-text-muted); transition: .4s; border-radius: 50%; }
    input:checked + .slider-cat { background-color: var(--theme-primary); }
    input:checked + .slider-cat:before { transform: translateX(16px); background-color: var(--theme-bg); }

    .capture-mode-selector { display: flex; background: var(--theme-bg); border-radius: 8px; overflow: hidden; border: 1px solid var(--theme-border); margin-bottom: 10px; }
    .capture-mode-selector button { flex: 1; background: transparent; border: none; color: var(--theme-text-muted); padding: 8px 5px; font-family: 'Oswald'; font-size: 0.8rem; cursor: pointer; transition: 0.3s; }
    .capture-mode-selector button.active { background: var(--theme-primary); color: var(--theme-bg); font-weight: bold; }

    .cat-buttons-grid { display: flex; flex-direction: column; gap: 10px; }
    .btn-cat-opt { background: var(--theme-bg); border: 1px solid var(--theme-primary); color: var(--theme-text); padding: 12px; border-radius: 8px; font-family: 'Oswald'; font-size: 1.1rem; transition: 0.2s; text-transform: uppercase; }
    .btn-cat-opt:active { background: var(--theme-primary); color: var(--theme-bg); transform: scale(0.98); }

    .cat-badge-container { margin-top: 5px; cursor: pointer; display: inline-block; }
    .cat-badge-manual { cursor: pointer; margin-top: 2px; }
    .cat-badge-empty, .cat-text-empty { color: var(--theme-text-muted); font-size: 0.75rem; font-style: italic; border: 1px dashed var(--theme-border); padding: 2px 8px; border-radius: 4px; font-family: 'Roboto'; }
    .cat-badge-filled, .cat-text-filled { background: var(--theme-primary); color: var(--theme-bg); font-weight: bold; font-family: 'Oswald'; font-size: 0.75rem; padding: 2px 8px; border-radius: 4px; letter-spacing: 1px; }

    /* EL ARREGLO PARA QUE LOS NOMBRES NO CHOQUEN CON LOS INPUTS */
    .user-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 5px; gap: 15px; }
    .user-left { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; padding-right: 5px;}
    
    .avatar-list-img, .avatar-list-letter, .avatar-tiny, .avatar-tiny-letter, .avatar-small, .avatar-small-letter { border-radius: 50% !important; object-fit: cover; display: flex; justify-content: center; align-items: center; font-weight: bold; font-family: 'Oswald'; flex-shrink: 0; aspect-ratio: 1/1; }
    .avatar-list-img { width: 32px; height: 32px; border: 2px solid var(--theme-primary); }
    .avatar-list-letter { width: 32px; height: 32px; background: var(--theme-bg); color: var(--theme-primary); border: 2px solid var(--theme-primary); font-size: 1rem; }
    
    /* ACÁ ES DONDE SE CORTAN LOS NOMBRES LARGOS AUTOMÁTICAMENTE */
    .text-truncate { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 120px; font-size: 0.85rem; }
    
    .score-input-wrapper { display: flex; align-items: center; gap: 5px; animation: fadeIn 0.3s; flex-shrink: 0;}
    .input-reps { width: 50px; background: var(--theme-bg); border: 1px solid var(--theme-primary); color: var(--theme-text); text-align: center; padding: 3px; border-radius: 5px; font-weight: bold; font-size: 0.9rem; }

    .mode-badge { background: var(--theme-primary); color: var(--theme-bg); padding: 6px; border-radius: 6px; font-weight: bold; font-family: 'Oswald'; font-size: 0.85rem; margin-bottom: 10px; text-align: center; letter-spacing: 1px; width: 100%; }
    .table-results { width: 100%; border-collapse: collapse; margin-top: 5px; }
    .table-results th { text-align: left; color: var(--theme-text-muted); font-size: 0.75rem; padding-bottom: 5px; border-bottom: 1px solid var(--theme-border); font-family: 'Oswald'; letter-spacing: 1px; }
    .table-results td { padding: 6px 5px; border-bottom: 1px solid var(--theme-border); color: var(--theme-text); font-size: 0.85rem; vertical-align: middle; }
    .team-group { display: flex; flex-direction: column; align-items: flex-start; }
    .team-members { display: flex; flex-direction: column; gap: 2px; margin-top: 2px; }
    .mini-row { display: flex; align-items: center; gap: 6px; font-size: 0.8rem; color: var(--theme-text); }
    .individual-row { display: flex; align-items: center; gap: 8px; }
    .avatar-small { width: 28px; height: 28px; border: 1px solid var(--theme-primary); }
    .avatar-small-letter { width: 28px; height: 28px; border: 1px solid var(--theme-primary); background: var(--theme-bg); color: var(--theme-text); font-size: 0.8rem; }
    .result-box { padding: 3px 6px; border-radius: 4px; font-family: 'Oswald'; text-align: center; font-weight: bold; min-width: 60px; font-size: 0.85rem; }
    .result-box.done { background: rgba(40, 167, 69, 0.2); color: #28a745; border: 1px solid #28a745; text-shadow: 0 0 5px rgba(40, 167, 69, 0.5); }
    .result-box.pend { background: var(--theme-bg); color: var(--theme-text-muted); border: 1px solid var(--theme-border); }

    /* BOTÓN INFERIOR MÁS COMPACTO */
