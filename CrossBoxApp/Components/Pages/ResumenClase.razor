    .avatar-circle { width: 100%; height: 100%; object-fit: cover; }

    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUpAvatar { to { opacity: 1; transform: translateY(0); } }
