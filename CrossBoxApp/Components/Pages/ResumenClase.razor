    @@keyframes zoomIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    @@keyframes float { 0% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-15px) rotate(2deg); } 100% { transform: translateY(0) rotate(0deg); } }
    
    @@media (max-width: 850px) {
        .victory-layout-main { flex-direction: column; align-items: center; justify-content: flex-start; height: 100%; overflow-y: auto; padding-bottom: 20px; }
        .podium-area { width: 100%; flex: none; height: auto; margin-top: 40px; margin-bottom: 20px; }
        .the-rest-area { width: 90%; height: 250px; flex: none; margin-top: auto; margin-bottom: 0; }
