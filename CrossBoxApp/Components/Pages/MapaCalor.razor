@code {
    [Parameter] public List<CrossBoxApp.Models.MusculoRecuperacionDto> Datos { get; set; }

    private string GetColor(string musculo)
    {
        var d = Datos?.FirstOrDefault(m => m.Nombre == musculo);

        // MODIFICACIÓN DE COLOR: Un Gris Carbón más claro para que se vea premium y el fondo no se lo coma
        if (d == null || d.Porcentaje == 100) return "#969696";
        int p = d.Porcentaje;

        // TRANSICIONES MILIMÉTRICAS (Gradientes fluidos)
        // 0% a 40%: De Rojo (#FF3B30) a Naranja (#FF9500)
        if (p <= 40) return InterpolateColor(255, 59, 48, 255, 149, 0, p / 40.0);

        // 41% a 80%: De Naranja (#FF9500) a Amarillo (#FFCC00)
        // AQUÍ CAERÁ EL USUARIO QUE ENTRENA UN DÍA SÍ Y UN DÍA NO (Fatiga óptima)
        if (p <= 80) return InterpolateColor(255, 149, 0, 255, 204, 0, (p - 40) / 40.0);

        // 81% a 97%: De Amarillo (#FFCC00) a Teal (#00C3A5)
        return InterpolateColor(255, 204, 0, 0, 195, 165, (p - 80) / 17.0);
    }

    private string InterpolateColor(int r1, int g1, int b1, int r2, int g2, int b2, double fraction)
    {
        int r = (int)(r1 + (r2 - r1) * fraction);
        int g = (int)(g1 + (g2 - g1) * fraction);
        int b = (int)(b1 + (b2 - b1) * fraction);
        return $"rgb({r}, {g}, {b})";
    }

    private string GetFilter(string musculo)
    {
        var d = Datos?.FirstOrDefault(m => m.Nombre == musculo);
        // El brillo aplica para cualquier músculo que tenga algo de fatiga
        return (d != null && d.Porcentaje < 100) ? "url(#glow)" : "none";
    }
}

