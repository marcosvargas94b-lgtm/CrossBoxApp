@page "/agenda-view"
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS
<div style="@EstilosTema">
<div class="main-layout" >

    @* --- NAVBAR (PROTEGIDO PARA NOTCH) --- *@
    <div class="navbar-container">
        <div class="nav-left" @onclick="Volver">
            <i class="fas fa-arrow-left"></i> VOLVER
        </div>
        <div class="nav-title">AGENDA TU CLASE</div>
        <div class="nav-right"></div>
    </div>

    <div class="scrollable-content">
        
        @* --- TABS DE FECHA (HOY / MAÑANA) --- *@
        <div class="date-tabs-container fade-in">
            <button class="tab-date @(EsHoy ? "active" : "")" @onclick="SeleccionarHoy">
                <span>HOY</span>
                <small>@DateTime.Now.ToString("dd MMM").ToUpper()</small>
            </button>
            <button class="tab-date @(!EsHoy ? "active" : "")" @onclick="SeleccionarManana">
                <span>MAÑANA</span>
                <small>@DateTime.Now.AddDays(1).ToString("dd MMM").ToUpper()</small>
            </button>
        </div>

        @* --- TÍTULO DE LA FECHA SELECCIONADA --- *@
        <h2 class="date-header">@fechaSeleccionada.ToString("dddd, dd MMMM").ToUpper()</h2>

        <div class="booking-section fade-in">
            @if (miReservaActualId == Guid.Empty)
            {
                <label class="lbl-input">Selecciona tu horario:</label>
                <div class="input-group">
                    <select @bind="horarioSeleccionado" class="form-control input-dark">
                        <option value="">-- Elige Hora --</option>
                        @foreach (var item in agendaData)
                        {
                            <option value="@item.HorarioId">@item.HorarioNombre</option>
                        }
                    </select>
                    <button class="btn-reservar" @onclick="ReservarClase">RESERVAR</button>
                </div>
            }
            else
            {
                <div class="reservation-info text-center fade-in">
                    <div class="success-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <p class="success-text">
                        Ya tienes clase reservada para @(EsHoy ? "HOY" : "MAÑANA").
                    </p>
                    <button class="btn-cancelar w-100" @onclick="CancelarReserva">
                        CANCELAR MI RESERVACIÓN
                    </button>
                </div>
            }
        </div>

        <div class="divider"></div>

        @if (cargando)
        {
            <div class="text-center mt-4">
                <div class="spinner-border" style="color: var(--theme-primary) !important;"></div>
                <p class="mt-2" style="color: var(--theme-text-muted) !important;">Cargando horarios...</p>
            </div>
        }
        else
        {
            <div class="cards-grid">
                @if(agendaData.Count == 0)
                {
                     <div class="text-center mt-4" style="color: var(--theme-text-muted) !important;">No hay horarios disponibles para este día.</div>
                }

                @foreach (var horario in agendaData)
                {
                    <div class="schedule-card fade-in">
                        <div class="card-header">
                            <span class="time-text">@horario.HorarioNombre</span>
                            <span class="badge-count">@horario.UsuariosInscritos.Count Atletas</span>
                        </div>
                        <div class="card-body">
                            @if (horario.UsuariosInscritos.Count == 0)
                            {
                                <p class="small mb-0" style="color: var(--theme-text-muted) !important;">Sin atletas registrados aún.</p>
                            }
                            else
                            {
                                <div class="user-list">
                                    @foreach (var usuario in horario.UsuariosInscritos)
                                    {
                                        <div class="user-item">
                                            <i class="fas fa-user-check"></i> 
                                            <span>@usuario</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        
        <div style="height: 40px;"></div>
    </div>
</div>
</div>

<style>
    /* --- ESTRUCTURA BASE (PROTECCIÓN NOTCH) --- */
    .main-layout {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: var(--theme-bg) !important;
        display: flex;
        flex-direction: column;
        z-index: 1;
    }

    .navbar-container {
        flex-shrink: 0;
        padding-top: calc(env(safe-area-inset-top) + 15px); 
        padding-bottom: 15px;
        padding-left: 20px;
        padding-right: 20px;
        
        background-color: var(--theme-bg) !important;
        border-bottom: 1px solid var(--theme-primary) !important;
        color: var(--theme-text) !important;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 100;
        font-family: 'Oswald';
        min-height: 80px; 
    }

    .nav-left {
        color: var(--theme-primary) !important;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
    }

    .nav-title {
        font-weight: bold;
        font-size: 1.1rem;
        color: var(--theme-text) !important;
        letter-spacing: 1px;
    }

    .nav-right { width: 60px; }

    .scrollable-content {
        flex-grow: 1;
        overflow-y: auto;
        padding: 20px;
        display: flex;
        flex-direction: column;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 40px;
    }

    /* --- TABS FECHAS --- */
    .date-tabs-container {
        display: flex;
        gap: 15px;
        margin-bottom: 15px;
        justify-content: center;
    }

    .tab-date {
        flex: 1;
        background: var(--theme-card) !important;
        border: 1px solid var(--theme-border) !important;
        border-radius: 10px;
        padding: 10px;
        color: var(--theme-text-muted) !important;
        display: flex;
        flex-direction: column;
        align-items: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .tab-date span { font-family: 'Oswald'; font-weight: bold; font-size: 1.1rem; }
    .tab-date small { font-size: 0.75rem; font-family: 'Roboto'; }

    .tab-date.active {
        background: var(--theme-primary) !important;
        color: var(--theme-bg) !important;
        border-color: var(--theme-primary) !important;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
        transform: scale(1.02);
    }

    /* --- RESTO DE ESTILOS --- */
    .date-header { font-family: 'Oswald'; text-align: center; color: var(--theme-primary) !important; font-size: 1.5rem; margin-top: 5px; margin-bottom: 20px; letter-spacing: 1px; }
    .booking-section { background: var(--theme-card) !important; padding: 20px; border-radius: 15px; border: 1px solid var(--theme-border) !important; margin-bottom: 20px; width: 100%; max-width: 600px; align-self: center; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }
    .lbl-input { color: var(--theme-text-muted) !important; font-size: 0.9rem; margin-bottom: 8px; display: block; }
    .input-group { display: flex; gap: 10px; }
    .input-dark { background: var(--theme-bg) !important; color: var(--theme-text) !important; border: 1px solid var(--theme-border) !important; flex: 1; padding: 10px; border-radius: 8px; font-size: 1rem; }
    .btn-reservar { background-color: var(--theme-primary) !important; color: var(--theme-bg) !important; font-weight: bold; border: none; padding: 0 20px; border-radius: 8px; font-family: 'Oswald'; transition: transform 0.2s; }
    .btn-reservar:active { transform: scale(0.95); }
    
    .success-icon { font-size: 3rem; color: #28a745; margin-bottom: 10px; }
    .success-text { color: var(--theme-text) !important; font-size: 1.1rem; margin-bottom: 15px; font-weight: bold; }
    .btn-cancelar { background: transparent; border: 1px solid #dc3545; color: #dc3545; padding: 10px; border-radius: 50px; font-weight: bold; transition: all 0.2s; }
    .btn-cancelar:active { background: #dc3545; color: white; }
    
    .divider { width: 100%; height: 1px; background: var(--theme-border) !important; margin: 10px 0 20px 0; }
    
    .cards-grid { display: flex; flex-direction: column; gap: 15px; width: 100%; max-width: 600px; align-self: center; }
    .schedule-card { background: var(--theme-card) !important; border: 1px solid var(--theme-border) !important; border-radius: 12px; overflow: hidden; }
    .card-header { background: var(--theme-bg) !important; padding: 12px 15px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--theme-border) !important; }
    .time-text { font-family: 'Oswald'; font-size: 1.1rem; color: var(--theme-text) !important; font-weight: bold; }
    .badge-count { background: var(--theme-primary) !important; color: var(--theme-bg) !important; padding: 3px 10px; border-radius: 10px; font-size: 0.8rem; font-weight: bold; }
    .card-body { padding: 15px; }
    .user-list { display: flex; flex-direction: column; gap: 8px; }
    .user-item { display: flex; align-items: center; gap: 10px; padding-bottom: 8px; border-bottom: 1px solid var(--theme-border) !important; color: var(--theme-text) !important; font-size: 0.95rem; }
    .user-item:last-child { border-bottom: none; padding-bottom: 0; }
    .user-item i { color: var(--theme-primary) !important; }
    
    .fade-in { animation: fadeIn 0.5s ease; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    // --- ESTADO INICIAL NEUTRAL (PLATA MATE) PARA EVITAR FLASHAZOS AMARILLOS ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    public class BoxConfigDTO 
    { 
        public string ThemePrimary { get; set; }
        public string ThemeSecondary { get; set; }
        public string ThemeBg { get; set; }
        public string ThemeCard { get; set; }
        public string ThemeBorder { get; set; }
        public string ThemeText { get; set; }
        public string ThemeTextMuted { get; set; }
    }

    private List<AgendaVisualDto> agendaData = new List<AgendaVisualDto>();
    private Guid horarioSeleccionado;
    private bool cargando = true;
    private Guid miReservaActualId = Guid.Empty;
    
    // --- LÓGICA DE FECHAS ---
    private DateTime fechaSeleccionada = DateTime.Today;
    private bool EsHoy => fechaSeleccionada.Date == DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        // 1. CARGAMOS CACHÉ INMEDIATO (Si ya se guardó antes, la app carga sin flashear)
        try 
        {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) 
            { 
                EstilosTema = cache; 
                StateHasChanged(); 
            }
        } 
        catch { }

        // 2. BUSCAMOS TEMA ACTUALIZADO EN LA BD
        if (Sesion.Usuario != null)
        {
            try
            {
                var configBox = await Http.GetFromJsonAsync<BoxConfigDTO>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/boxesAPI/config/{Sesion.Usuario.BoxID}");
                if (configBox != null) 
                {
                    string p = string.IsNullOrEmpty(configBox.ThemePrimary) ? "#F8C545" : configBox.ThemePrimary;
                    string s = string.IsNullOrEmpty(configBox.ThemeSecondary) ? "#dcb03d" : configBox.ThemeSecondary;
                    string bg = string.IsNullOrEmpty(configBox.ThemeBg) ? "#0d0d0d" : configBox.ThemeBg;
                    string c = string.IsNullOrEmpty(configBox.ThemeCard) ? "#1a1a1a" : configBox.ThemeCard;
                    string b = string.IsNullOrEmpty(configBox.ThemeBorder) ? "#333333" : configBox.ThemeBorder;
                    string t = string.IsNullOrEmpty(configBox.ThemeText) ? "#ffffff" : configBox.ThemeText;
                    string tm = string.IsNullOrEmpty(configBox.ThemeTextMuted) ? "#888888" : configBox.ThemeTextMuted;

                    EstilosTema = $@"
                        --theme-primary: {p};
                        --theme-secondary: {s};
                        --theme-bg: {bg};
                        --theme-card: {c};
                        --theme-border: {b};
                        --theme-text: {t};
                        --theme-text-muted: {tm};
                    ";
                    
                    // Actualizamos la caché local
                    try { await JS.InvokeVoidAsync("localStorage.setItem", "tema_box", EstilosTema); } catch { }
                }
            }
            catch { } // Si no hay internet, se queda con la caché o el Plata Mate
        }

        await CargarDatos();
    }

    private async Task SeleccionarHoy()
    {
        if (EsHoy) return;
        fechaSeleccionada = DateTime.Today;
        await CargarDatos();
    }

    private async Task SeleccionarManana()
    {
        if (!EsHoy) return;
        fechaSeleccionada = DateTime.Today.AddDays(1);
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            cargando = true;
            // Reiniciamos selecciones al cambiar de día
            horarioSeleccionado = Guid.Empty;
            miReservaActualId = Guid.Empty;
            agendaData.Clear();
            StateHasChanged(); 

            if (Sesion.Usuario == null) { Nav.NavigateTo("/"); return; }

            var boxId = Sesion.Usuario.BoxID;
            var userId = Sesion.Usuario.UsuarioID;
            
            // Enviamos la fecha seleccionada en formato "yyyy-MM-dd"
            string fechaStr = fechaSeleccionada.ToString("yyyy-MM-dd");

            var response = await Http.GetAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/agendaapi/visual/{boxId}/{userId}/{fechaStr}");

            if (response.IsSuccessStatusCode)
            {
                agendaData = await response.Content.ReadFromJsonAsync<List<AgendaVisualDto>>();

                // Verificar si YA tengo reserva en ESTE día
                var miHorario = agendaData.FirstOrDefault(x => x.EsMiReserva);
                if (miHorario != null)
                {
                    miReservaActualId = miHorario.HorarioId;
                    horarioSeleccionado = miReservaActualId;
                }
            }
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error", "No se pudo cargar la agenda", "OK");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ReservarClase()
    {
        if (horarioSeleccionado == Guid.Empty)
        {
            await App.Current.MainPage.DisplayAlert("Atención", "Selecciona un horario.", "OK");
            return;
        }

        try
        {
            var reserva = new ReservaDto
            {
                UsuarioId = Sesion.Usuario.UsuarioID,
                BoxId = Sesion.Usuario.BoxID,
                HorarioId = horarioSeleccionado,
                Fecha = fechaSeleccionada // Enviamos la fecha del Tab activo (Hoy o Mañana)
            };

            var response = await Http.PostAsJsonAsync("https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/agendaapi/reservar", reserva);

            if (response.IsSuccessStatusCode)
            {
                string dia = EsHoy ? "hoy" : "mañana";
                await App.Current.MainPage.DisplayAlert("¡Listo!", $"Clase reservada para {dia}.", "OK");
                await CargarDatos();
            }
            else
            {
                var errorMsg = await response.Content.ReadFromJsonAsync<dynamic>();
                string mensaje = errorMsg.ToString();
                try { mensaje = errorMsg.GetProperty("mensaje").GetString(); } catch { }
                await App.Current.MainPage.DisplayAlert("Aviso", mensaje, "OK");
            }
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error", "Fallo al reservar.", "OK");
        }
    }

    private async Task CancelarReserva()
    {
        bool confirmar = await App.Current.MainPage.DisplayAlert("Cancelar", "¿Seguro que quieres cancelar?", "Sí", "No");
        if (!confirmar) return;

        try
        {
            var reserva = new ReservaDto
            {
                UsuarioId = Sesion.Usuario.UsuarioID,
                BoxId = Sesion.Usuario.BoxID,
                Fecha = fechaSeleccionada // Importante para cancelar la del día correcto
            };

            var response = await Http.PostAsJsonAsync("https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/agendaapi/cancelar", reserva);

            if (response.IsSuccessStatusCode)
            {
                await App.Current.MainPage.DisplayAlert("Listo", "Reserva cancelada.", "OK");
                await CargarDatos();
            }
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error", "No se pudo cancelar.", "OK");
        }
    }

    private void Volver() => Nav.NavigateTo("/home");
}