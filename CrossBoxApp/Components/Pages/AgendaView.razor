@page "/agenda-view"
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS

<div style="@EstilosTema">
    <div class="main-layout">

        @* --- NAVBAR --- *@
        <div class="navbar-container">
            <div class="nav-left" @onclick="Volver">
                <i class="fas fa-arrow-left"></i> VOLVER
            </div>
            <div class="nav-title">AGENDA TU CLASE</div>
            <div class="nav-right">
                @if (esAdminOCoach)
                {
                    <button class="btn-icon-nav" @onclick="AbrirModalLimite">
                        <i class="fas fa-cog"></i>
                    </button>
                }
            </div>
        </div>

        <div class="scrollable-content">
            
            @* --- TABS DE FECHA DINÁMICOS (CARRUSEL) --- *@
            <div class="date-tabs-container fade-in">
                @foreach (var fecha in fechasDisponibles)
                {
                    bool esHoyLocal = fecha.Date == DateTime.Today;
                    // Mostrar "HOY" si es hoy, sino las primeras 3 letras del día (LUN, MAR, MIE...)
                    string nombreDia = esHoyLocal ? "HOY" : fecha.ToString("dddd").Substring(0, 3).ToUpper();

                    <button class="tab-date @(fechaSeleccionada.Date == fecha.Date ? "active" : "")" @onclick="() => SeleccionarFecha(fecha)">
                        <span>@nombreDia</span>
                        <small>@fecha.ToString("dd MMM").ToUpper()</small>
                    </button>
                }
            </div>

            @* --- TÍTULO DE LA FECHA SELECCIONADA --- *@
            <h2 class="date-header">@fechaSeleccionada.ToString("dddd, dd MMMM").ToUpper()</h2>

            <div class="booking-section fade-in" style="border: none !important; background: transparent !important; padding: 0 !important; box-shadow: none;">
                @if (miReservaActualId == Guid.Empty)
                {
                    <div style="background: var(--theme-card); padding: 20px; border-radius: 15px; border: 1px solid var(--theme-border); box-shadow: 0 4px 15px rgba(0,0,0,0.5);">
                        <label class="lbl-input">Selecciona tu horario:</label>
                        <div class="input-group">
                            <select @bind="horarioSeleccionado" class="form-control input-dark">
                                <option value="">-- Elige Hora --</option>
                                @foreach (var item in agendaData)
                                {
                                    bool estaLleno = item.UsuariosInscritos.Count >= limiteBoxActual;
                                    <option value="@item.HorarioId" disabled="@estaLleno">
                                        @item.HorarioNombre @(estaLleno ? " (LLENO)" : "")
                                    </option>
                                }
                            </select>
                            <button class="btn-reservar" @onclick="ReservarClase" disabled="@cargando">
                                @if (cargando) { <i class="fas fa-spinner fa-spin"></i> } else { <span>RESERVAR</span> }
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="reservation-info text-center fade-in">
                        <div class="success-icon pulse-tap">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <h4 class="success-title">¡RESERVACIÓN CONFIRMADA!</h4>
                        <p class="success-text">
                            Tu lugar para el <strong>@fechaSeleccionada.ToString("dddd dd").ToUpper()</strong> está asegurado.
                        </p>
                        <button class="btn-cancelar w-100" @onclick="CancelarReserva" disabled="@cargando">
                            @if (cargando) { <i class="fas fa-spinner fa-spin"></i> } else { <span><i class="fas fa-times-circle" style="margin-right: 8px;"></i> CANCELAR MI RESERVACIÓN</span> }
                        </button>
                    </div>
                }
            </div>

            <div class="divider"></div>

            @if (cargando)
            {
                <div class="text-center mt-4">
                    <div class="spinner-border" style="color: var(--theme-primary) !important;"></div>
                    <p class="mt-2" style="color: var(--theme-text-muted) !important; font-family: 'Oswald'; letter-spacing: 1px;">CARGANDO HORARIOS...</p>
                </div>
            }
            else
            {
                <div class="cards-grid">
                    @if(agendaData.Count == 0)
                    {
                         <div class="text-center mt-4" style="color: var(--theme-text-muted) !important; font-size: 1.1rem;">
                             <i class="fas fa-bed mb-2" style="font-size: 2rem; opacity: 0.5;"></i><br/>
                             No hay horarios disponibles para este día.
                         </div>
                    }

                    @foreach (var horario in agendaData)
                    {
                        bool estaLleno = horario.UsuariosInscritos.Count >= limiteBoxActual;
                        string indicatorColor = estaLleno ? "#dc3545" : "var(--theme-primary)";
                        string statusText = estaLleno ? "LLENO" : "DISPONIBLE";

                        <div class="schedule-card fade-in" style="border-left: 5px solid @indicatorColor !important;">
                            
                            <div class="card-header">
                                <span class="time-text">
                                    <i class="fas fa-clock" style="color: @indicatorColor; margin-right: 8px;"></i> @horario.HorarioNombre
                                </span>
                                
                                <div style="display: flex; flex-direction: column; align-items: flex-end;">
                                    <span style="color: @indicatorColor; font-size: 0.65rem; font-weight: bold; letter-spacing: 1px; margin-bottom: 2px;">@statusText</span>
                                    <span class="badge-count" style="background-color: @indicatorColor !important; color: @(estaLleno ? "white" : "var(--theme-bg)") !important;">
                                        <i class="fas fa-users" style="margin-right: 4px;"></i> @horario.UsuariosInscritos.Count / @limiteBoxActual
                                    </span>
                                </div>
                            </div>

                            <div class="card-body">
                                @if (horario.UsuariosInscritos.Count == 0)
                                {
                                    <div class="empty-roster">
                                        <p class="small mb-0">Sin atletas registrados aún.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="user-list">
                                        @foreach (var usuario in horario.UsuariosInscritos)
                                        {
                                            <div class="user-item">
                                                <div class="user-avatar-mini">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                                <span class="user-name-list">@usuario</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            @if (horario.EsMiReserva)
                            {
                                <div class="my-reservation-banner">ESTA ES TU CLASE</div>
                            }
                        </div>
                    }
                </div>
            }
            <div style="height: 40px;"></div>
        </div> 
    </div> 

    @* --- MODAL CONFIGURAR LÍMITE (SOLO ADMIN/COACH) --- *@
    @if (mostrarModalLimite)
    {
        <div class="modal-overlay fade-in">
            <div class="modal-content custom-modal slide-up">
                <div class="modal-header">
                    <h5 style="color:var(--theme-primary); margin:0; font-family:'Oswald'">
                        <i class="fas fa-users-cog" style="margin-right:8px;"></i> AFORO MÁXIMO
                    </h5>
                    <button class="btn-close-custom" @onclick="() => mostrarModalLimite = false"><i class="fas fa-times"></i></button>
                </div>
                
                <div class="modal-body text-center">
                    <p style="color: var(--theme-text-muted); font-size: 0.9rem; margin-bottom: 20px;">
                        Establece el número máximo de atletas permitidos por clase.
                    </p>
                    
                    <div style="display: flex; justify-content: center; align-items: center; gap: 15px;">
                        <button class="btn-circle" @onclick="DisminuirLimite"><i class="fas fa-minus"></i></button>
                        <input type="number" @bind="limiteAtletasInput" class="form-control input-dark" style="width: 80px; text-align: center; font-size: 1.5rem; font-weight: bold; font-family: 'Oswald';" readonly />
                        <button class="btn-circle" @onclick="AumentarLimite"><i class="fas fa-plus"></i></button>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-cancel" @onclick="() => mostrarModalLimite = false">Cancelar</button>
                    <button class="btn-confirm" @onclick="GuardarLimite" disabled="@guardandoLimite">
                        @if (guardandoLimite) { <i class="fas fa-spinner fa-spin"></i> } else { <span>GUARDAR</span> }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* --- ESTRUCTURA BASE --- */
    .main-layout { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--theme-bg) !important; display: flex; flex-direction: column; z-index: 1; }
    .navbar-container { flex-shrink: 0; padding-top: calc(env(safe-area-inset-top) + 15px); padding-bottom: 15px; padding-left: 20px; padding-right: 20px; background-color: var(--theme-bg) !important; border-bottom: 1px solid var(--theme-primary) !important; color: var(--theme-text) !important; display: flex; justify-content: space-between; align-items: center; z-index: 100; font-family: 'Oswald'; min-height: 80px; }
    .nav-left { color: var(--theme-primary) !important; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
    .nav-title { font-weight: bold; font-size: 1.1rem; color: var(--theme-text) !important; letter-spacing: 1px; flex: 1; text-align: center; }
    .nav-right { width: 60px; display: flex; justify-content: flex-end; }
    .scrollable-content { flex-grow: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; -webkit-overflow-scrolling: touch; padding-bottom: 40px; }

    .btn-icon-nav { background: transparent; border: none; color: var(--theme-primary); font-size: 1.4rem; cursor: pointer; padding: 5px; }

    /* 🔥 TABS DESLIZABLES (CARRUSEL) CORREGIDOS */
    .date-tabs-container {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
        overflow-x: auto;
        padding-bottom: 8px;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        flex-shrink: 0; /* 🔥 LA MAGIA: Evita que la lista de abajo lo aplaste */
        min-height: 75px; /* Obliga al contenedor a respetar el espacio */
    }

        .date-tabs-container::-webkit-scrollbar {
            height: 4px;
        }

        .date-tabs-container::-webkit-scrollbar-thumb {
            background: var(--theme-border);
            border-radius: 10px;
        }

    .tab-date {
        flex: 0 0 auto;
        min-width: 85px;
        min-height: 60px; /* 🔥 Fuerza a que el botón tenga cuerpo */
        background: var(--theme-card) !important;
        border: 1px solid var(--theme-border) !important;
        border-radius: 10px;
        padding: 8px 5px;
        color: var(--theme-text-muted) !important;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center; /* Centra los textos verticalmente */
        cursor: pointer;
        transition: all 0.3s ease;
    }

        /* Le damos estilo fuerte a los textos para que resalten */
        .tab-date span {
            font-family: 'Oswald';
            font-size: 1rem;
            font-weight: bold;
            line-height: 1.1;
            margin-bottom: 2px;
        }

        .tab-date small {
            font-family: 'Roboto';
            font-size: 0.75rem;
            line-height: 1;
        }

        .tab-date.active {
            background: var(--theme-primary) !important;
            color: var(--theme-bg) !important;
            border-color: var(--theme-primary) !important;
        }

    /* MODAL LÍMITE */
    .btn-circle { background: var(--theme-card); border: 2px solid var(--theme-primary); color: var(--theme-primary); width: 45px; height: 45px; border-radius: 50%; display: flex; justify-content: center; align-items: center; cursor: pointer; }
    .custom-modal { background: var(--theme-card); width: 90%; max-width: 400px; border-radius: 15px; border: 1px solid var(--theme-border); overflow: hidden; }

    /* TÍTULO Y SELECT */
    .date-header { font-family: 'Oswald'; text-align: center; color: var(--theme-primary) !important; font-size: 1.5rem; margin-bottom: 20px; }
    .lbl-input { color: var(--theme-text-muted) !important; font-size: 0.9rem; margin-bottom: 8px; display: block; font-weight: bold; }
    .input-group { display: flex; gap: 10px; }
    .input-dark { background: var(--theme-bg) !important; color: var(--theme-text) !important; border: 1px solid var(--theme-border) !important; padding: 10px; border-radius: 8px; flex: 1; font-size: 1rem; }
    .btn-reservar { background-color: var(--theme-primary) !important; color: var(--theme-bg) !important; font-weight: bold; border: none; padding: 0 20px; border-radius: 8px; font-family: 'Oswald'; transition: transform 0.2s; }
    .btn-reservar:active { transform: scale(0.95); }

    /* --- MENSAJE DE ÉXITO --- */
    .reservation-info { background: rgba(40, 167, 69, 0.1); border: 1px solid #28a745; border-radius: 15px; padding: 25px 20px; width: 100%; max-width: 600px; margin: 0 auto; box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
    .success-icon i { font-size: 3.5rem; color: #28a745; filter: drop-shadow(0 0 10px rgba(40, 167, 69, 0.5)); }
    .success-title { color: white; font-family: 'Oswald'; font-weight: bold; margin-top: 15px; margin-bottom: 5px; letter-spacing: 1px; font-size: 1.3rem; text-shadow: 0 2px 4px rgba(0,0,0,0.8); }
    .success-text { color: rgba(255,255,255,0.8) !important; font-size: 0.95rem; margin-bottom: 20px; font-family: 'Roboto'; }
    
    .btn-cancelar { background: rgba(220, 53, 69, 0.1); border: 1px solid #dc3545; color: #dc3545; padding: 12px; border-radius: 10px; font-weight: bold; font-family: 'Oswald'; letter-spacing: 1px; transition: all 0.2s; cursor: pointer; }
    .btn-cancelar:active { background: #dc3545; color: white; transform: scale(0.95); }

    /* --- DISEÑO DE TARJETAS --- */
    .cards-grid { display: flex; flex-direction: column; gap: 15px; width: 100%; max-width: 600px; align-self: center; }
    .schedule-card { background: var(--theme-card) !important; border: 1px solid var(--theme-border) !important; border-radius: 12px; margin-bottom: 15px; overflow: hidden; position: relative; transition: transform 0.2s; }
    .schedule-card:active { transform: scale(0.98); }
    
    .card-header { background: rgba(255, 255, 255, 0.03) !important; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--theme-border) !important; flex-wrap: wrap; gap: 10px; }
    .time-text { font-family: 'Oswald'; font-size: 1.4rem; color: var(--theme-text) !important; font-weight: bold; letter-spacing: 1px; display: flex; align-items: center; }
    .badge-count { padding: 4px 12px; border-radius: 8px; font-size: 0.85rem; font-weight: bold; font-family: 'Roboto'; display: flex; align-items: center; box-shadow: 0 2px 5px rgba(0,0,0,0.4); }
    
    .card-body { padding: 0 !important; }
    .empty-roster { padding: 20px; text-align: center; font-style: italic; color: var(--theme-text-muted); opacity: 0.7; font-size: 0.9rem; }
    
    .user-list { display: flex; flex-direction: column; }
    .user-item { display: flex; align-items: center; gap: 12px; padding: 12px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.03); transition: background 0.2s; }
    .user-item:last-child { border-bottom: none; }
    .user-item:hover { background: rgba(255, 255, 255, 0.02); }
    
    .user-avatar-mini { width: 32px; height: 32px; border-radius: 50%; background: rgba(255, 255, 255, 0.08); display: flex; justify-content: center; align-items: center; color: var(--theme-text-muted); font-size: 0.8rem; flex-shrink: 0; }
    .user-name-list { color: var(--theme-text) !important; font-size: 0.95rem; font-family: 'Roboto'; font-weight: 500; }
    
    .my-reservation-banner { background: var(--theme-primary); color: var(--theme-bg); text-align: center; font-family: 'Oswald'; font-weight: bold; font-size: 0.75rem; letter-spacing: 2px; padding: 4px 0; width: 100%; }
    .divider { width: 100%; height: 1px; background: var(--theme-border); margin: 25px 0; opacity: 0.5; }
    .booking-section { margin-bottom: 30px; }
    
    /* MODALES GENÉRICOS */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 5000; display: flex; justify-content: center; align-items: center; backdrop-filter: blur(5px); }
    .modal-header { padding: 20px; border-bottom: 1px solid var(--theme-border); display: flex; justify-content: space-between; }
    .modal-footer { padding: 20px; display: flex; gap: 10px; }
    .btn-confirm { flex: 1; background: var(--theme-primary); color: var(--theme-bg); border: none; padding: 12px; border-radius: 8px; font-weight: bold; font-family: 'Oswald'; }
    .btn-cancel { flex: 1; background: #333; color: white; border: none; padding: 12px; border-radius: 8px; font-weight: bold; }
    .btn-close-custom { background: none; border: none; color: #888; font-size: 1.5rem; }

    .pulse-tap { animation: pulseAnim 2s infinite; }
    @@keyframes pulseAnim { 0% { transform: scale(1); } 50% { transform: scale(1.1); } 100% { transform: scale(1); } }
    .fade-in { animation: fadeIn 0.5s ease; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    // --- ESTADO INICIAL ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    private bool esAdminOCoach = false;
    private bool mostrarModalLimite = false;
    private bool guardandoLimite = false;
    private int limiteAtletasInput = 15;
    private int limiteBoxActual = 15;

    private List<AgendaVisualDto> agendaData = new List<AgendaVisualDto>();
    private Guid horarioSeleccionado;
    private bool cargando = true;
    private Guid miReservaActualId = Guid.Empty;
    
    // 🔥 NUEVAS VARIABLES PARA EL CALENDARIO DINÁMICO
    private DateTime fechaSeleccionada = DateTime.Today;
    private List<DateTime> fechasDisponibles = new List<DateTime>();
    private bool EsHoy => fechaSeleccionada.Date == DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        try {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) EstilosTema = cache;
        } catch { }

        GenerarFechasDisponibles(); // Llenamos el carrusel de días

        if (Sesion.Usuario != null)
        {
            esAdminOCoach = (Sesion.Usuario.TipoUsuarioID == 1 || Sesion.Usuario.TipoUsuarioID == 3);
            try {
                var configBox = await Http.GetFromJsonAsync<BoxConfigDTO>($"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/boxesAPI/config/{Sesion.Usuario.BoxID}");
                if (configBox != null) {
                    limiteBoxActual = configBox.LimitePorClase > 0 ? configBox.LimitePorClase : 15;
                }
            } catch { }
        }
        await CargarDatos();
    }

    // =========================================================================
    // 🔥 LÓGICA MAESTRA: CALCULAR LA VENTANA DE DÍAS (Lunes a Dom o Dom a Dom)
    // =========================================================================
    // =========================================================================
    // 🔥 LÓGICA MAESTRA: VENTANA MÓVIL (SIEMPRE HOY + 6 DÍAS)
    // =========================================================================
    private void GenerarFechasDisponibles()
    {
        fechasDisponibles.Clear();
        DateTime hoy = DateTime.Today;

        // Siempre cargamos 7 días en total (Hoy + los 6 días siguientes)
        for (int i = 0; i < 7; i++)
        {
            fechasDisponibles.Add(hoy.AddDays(i));
        }
    }

    private async Task SeleccionarFecha(DateTime nuevaFecha)
    {
        if (fechaSeleccionada.Date == nuevaFecha.Date) return;
        fechaSeleccionada = nuevaFecha;
        await CargarDatos();
    }
    // =========================================================================

    private async Task CargarDatos()
    {
        try {
            cargando = true;
            horarioSeleccionado = Guid.Empty;
            miReservaActualId = Guid.Empty;
            string fechaStr = fechaSeleccionada.ToString("yyyy-MM-dd");
            var response = await Http.GetAsync($"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/agendaapi/visual/{Sesion.Usuario.BoxID}/{Sesion.Usuario.UsuarioID}/{fechaStr}");
            if (response.IsSuccessStatusCode) {
                agendaData = await response.Content.ReadFromJsonAsync<List<AgendaVisualDto>>();
                var miHorario = agendaData.FirstOrDefault(x => x.EsMiReserva);
                if (miHorario != null) {
                    miReservaActualId = miHorario.HorarioId;
                    horarioSeleccionado = miReservaActualId;
                }
            }
        } catch { } finally { cargando = false; StateHasChanged(); }
    }

    private void AbrirModalLimite() { limiteAtletasInput = limiteBoxActual; mostrarModalLimite = true; }
    private void AumentarLimite() { limiteAtletasInput++; }
    private void DisminuirLimite() { if (limiteAtletasInput > 1) limiteAtletasInput--; }

    private async Task GuardarLimite()
    {
        guardandoLimite = true;
        try {
            var req = new { BoxID = Sesion.Usuario.BoxID, NuevoLimite = limiteAtletasInput };
            var response = await Http.PostAsJsonAsync("https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/boxesAPI/actualizar-limite", req);
            if (response.IsSuccessStatusCode) {
                limiteBoxActual = limiteAtletasInput;
                mostrarModalLimite = false;
                await App.Current.MainPage.DisplayAlert("Éxito", $"Límite actualizado a {limiteBoxActual}.", "OK");
                await CargarDatos();
            }
        } catch { } finally { guardandoLimite = false; }
    }

    private async Task ReservarClase()
    {
        if (horarioSeleccionado == Guid.Empty)
        {
            await App.Current.MainPage.DisplayAlert("Atención", "Selecciona un horario.", "OK");
            return;
        }

        cargando = true;
        StateHasChanged();

        try
        {
            var reserva = new ReservaDto
            {
                UsuarioId = Sesion.Usuario.UsuarioID,
                BoxId = Sesion.Usuario.BoxID,
                HorarioId = horarioSeleccionado,
                Fecha = fechaSeleccionada 
            };

            var response = await Http.PostAsJsonAsync("https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/agendaapi/reservar", reserva);

            if (response.IsSuccessStatusCode)
            {
                string txtDia = EsHoy ? "hoy" : fechaSeleccionada.ToString("dddd");
                await App.Current.MainPage.DisplayAlert("¡Listo!", $"Clase reservada para el día {txtDia}.", "OK");
                await CargarDatos();
            }
            else
            {
                var errorMsg = await response.Content.ReadFromJsonAsync<dynamic>();
                string mensaje = errorMsg.ToString();
                try { mensaje = errorMsg.GetProperty("mensaje").GetString(); } catch { }
                await App.Current.MainPage.DisplayAlert("Aviso", mensaje, "OK");
            }
        }
        catch (Exception)
        {
            await App.Current.MainPage.DisplayAlert("Error", "Fallo al reservar. Revisa tu conexión.", "OK");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CancelarReserva()
    {
        bool confirmar = await App.Current.MainPage.DisplayAlert("Cancelar", "¿Seguro que quieres cancelar tu clase?", "Sí, Cancelar", "No");
        if (!confirmar) return;

        cargando = true;
        StateHasChanged();

        try
        {
            var reserva = new ReservaDto
            {
                UsuarioId = Sesion.Usuario.UsuarioID,
                BoxId = Sesion.Usuario.BoxID,
                Fecha = fechaSeleccionada 
            };

            var response = await Http.PostAsJsonAsync("https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/agendaapi/cancelar", reserva);

            if (response.IsSuccessStatusCode)
            {
                await App.Current.MainPage.DisplayAlert("Listo", "Reserva cancelada.", "OK");
                await CargarDatos();
            }
        }
        catch (Exception)
        {
            await App.Current.MainPage.DisplayAlert("Error", "No se pudo cancelar.", "OK");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
    
    private void Volver() => Nav.NavigateTo("/home");

