@page "/admin/config-box"
@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject HttpClient Http
@inject NavigationManager Nav
@inject CrossBoxApp.Models.Services.SesionService Sesion
@inject IJSRuntime JS
@implements IDisposable

<div style="@EstilosTema">
    <div class="main-layout">

        <div class="navbar-container">
            <div class="nav-left" @onclick='() => Nav.NavigateTo("/home")'>
                <i class="fas fa-arrow-left"></i> VOLVER
            </div>
            <div class="nav-title">TU NEGOCIO</div>
            <div class="nav-right"></div>
        </div>

        <div class="scrollable-content">
            
            <div class="header-section text-center fade-in">
                @if (datosBox.Logo != null && datosBox.Logo != Guid.Empty && string.IsNullOrEmpty(previewImagen))
                {
                    <img src="@ObtenerUrlLogo(datosBox.Logo.Value)" class="profile-logo-img pulse-animation" />
                }
                else if (!string.IsNullOrEmpty(previewImagen))
                {
                    <img src="@previewImagen" class="profile-logo-img pulse-animation" />
                }
                else
                {
                    <div class="brand-icon-circle">
                        <i class="fas fa-dumbbell"></i>
                    </div>
                }

                <h2>GESTIÓN</h2>
                <p>Configura cobros, precios y apariencia.</p>
            </div>

            <div class="tabs-container fade-in">
                <button class="tab-btn @(tabActiva == 1 ? "active" : "")" @onclick="() => tabActiva = 1">
                    <i class="fas fa-hand-holding-usd"></i> COBROS
                </button>
                <button class="tab-btn @(tabActiva == 2 ? "active" : "")" @onclick="() => tabActiva = 2">
                    <i class="fas fa-tag"></i> PRECIOS
                </button>
                <button class="tab-btn @(tabActiva == 3 ? "active" : "")" @onclick="() => tabActiva = 3">
                    <i class="fas fa-image"></i> LOGO
                </button>
                <button class="tab-btn @(tabActiva == 4 ? "active" : "")" @onclick="() => tabActiva = 4">
                    <i class="fas fa-palette"></i> COLORES
                </button>
            </div>

            <div class="cards-wrapper">

                @* TAB 1: MERCADO PAGO *@
                @if (tabActiva == 1)
                {
                    <div class="mp-card text-center fade-in">
                        <img src="https://http2.mlstatic.com/frontend-assets/ui-navigation/5.19.1/mercadopago/logo__small.png" alt="Mercado Pago" width="100" class="mb-3" />

                        @if (datosBox.EstaVinculadoMP)
                        {
                            <div class="status-connected fade-in">
                                <i class="fas fa-check-circle fa-3x mb-2"></i>
                                <h4>¡CUENTA VINCULADA!</h4>
                                <p>Tu gimnasio ya está listo para recibir pagos.</p>
                            </div>

                            <button class="btn-mp-connect outline mt-3" @onclick="VincularMercadoPago">
                                Cambiar cuenta vinculada
                            </button>

                            <button class="btn-unlink mt-3" @onclick="DesvincularCuenta">
                                <i class="fas fa-trash-alt"></i> Desconectar Cuenta
                            </button>
                        }
                        else
                        {
                            <h5 class="section-title">RECIBIR PAGOS</h5>
                            <p class="text-muted small mb-4">
                                Para que los atletas te paguen directo a ti, conecta tu cuenta.
                            </p>

                            <div class="mp-status-box">
                                <i class="fas fa-exclamation-circle"></i>
                                <span>Estado: <strong>Sin conexión</strong></span>
                            </div>

                            <button class="btn-mp-connect mt-4" @onclick="VincularMercadoPago">
                                <b>CONECTAR CUENTA AHORA</b>
                            </button>

                            <p class="text-muted x-small mt-3">
                                Al hacer clic, serás redirigido a Mercado Pago.
                            </p>
                        }
                    </div>
                }

                @* TAB 2: PRECIOS *@
                @if (tabActiva == 2)
                {
                    <div class="prices-card text-center fade-in">
                        <h5 class="section-title">PRECIOS DE TU BOX</h5>
                        <p class="text-muted small">Define cuánto cobrará la App a tus atletas.</p>

                        <div class="form-group mt-3 text-start">
                            <label class="lbl-input">Mensualidad ($)</label>
                            <input type="number" @bind="datosBox.PrecioMensualidad" class="form-control input-dark" />
                        </div>

                        <div class="form-group mt-3 text-start">
                            <label class="lbl-input">Inscripción ($)</label>
                            <input type="number" @bind="datosBox.PrecioInscripcion" class="form-control input-dark" />
                            <small class="text-muted" style="font-size: 0.75rem;">Pon 0 si no cobras inscripción.</small>
                        </div>

                        <button class="btn-save mt-4 glow-effect" @onclick="GuardarPrecios" disabled="@guardando">
                            @if (guardando)
                            {
                                <span><i class="fas fa-spinner fa-spin"></i> GUARDANDO...</span>
                            }
                            else
                            {
                                <span><i class="fas fa-save"></i> GUARDAR CAMBIOS</span>
                            }
                        </button>
                    </div>
                }

                @* TAB 3: PERFIL (LOGO) *@
                @if (tabActiva == 3)
                {
                    <div class="prices-card text-center fade-in">
                        <h5 class="section-title">LOGO DEL BOX</h5>
                        <p class="text-muted small">Este logo aparecerá en el perfil de tus atletas.</p>

                        <div class="upload-area mt-4">
                            @if (archivoSeleccionado == null && string.IsNullOrEmpty(previewImagen) && datosBox.Logo == null)
                            {
                                <div class="upload-placeholder">
                                    <i class="fas fa-cloud-upload-alt fa-3x"></i>
                                    <p>Toca para subir imagen</p>
                                </div>
                            }
                            else
                            {
                                <div class="image-preview-container">
                                    @if (!string.IsNullOrEmpty(previewImagen))
                                    {
                                        <img src="@previewImagen" class="img-fluid rounded" />
                                    }
                                    else if (datosBox.Logo != null)
                                    {
                                        <img src="@ObtenerUrlLogo(datosBox.Logo.Value)" class="img-fluid rounded" />
                                    }
                                </div>
                            }

                            <InputFile OnChange="ProcesarSeleccionImagen" class="file-input-hidden" accept="image/*" />
                        </div>

                        @if (archivoSeleccionado != null)
                        {
                            <div class="mt-3 p-2" style="font-size: 0.8rem; border-radius: 8px; background: rgba(255,255,255,0.05); color: var(--theme-primary); border: 1px solid var(--theme-primary);">
                                Imagen seleccionada: @archivoSeleccionado.Name
                            </div>

                            <button class="btn-save mt-3 glow-effect" @onclick="SubirImagenAlServidor" disabled="@subiendoImagen">
                                @if (subiendoImagen)
                                {
                                    <span><i class="fas fa-spinner fa-spin"></i> SUBIENDO...</span>
                                }
                                else
                                {
                                    <span><i class="fas fa-upload"></i> ACTUALIZAR LOGO</span>
                                }
                            </button>
                        }
                        else
                        {
                            <div class="mt-3 text-muted" style="font-size:0.7rem">
                                Recomendado: Imagen cuadrada (500x500px)<br>Formatos: JPG, PNG
                            </div>
                        }
                    </div>
                }

                @* TAB 4: COLORES (TEMA DE LA APP) *@
                @if (tabActiva == 4)
                {
                    <div class="prices-card text-center fade-in">
                        <h5 class="section-title"><i class="fas fa-paint-brush"></i> COLORES DE TU APP</h5>
                        <p class="text-muted small mb-4">Personaliza la app con los colores de tu marca. Verás el cambio en vivo aquí mismo.</p>

                        <div class="color-grid">
                            <div class="color-item">
                                <label>Color de la Marca (Botones, Íconos, Títulos)</label>
                                <input type="color" @bind="datosBox.ThemePrimary" @bind:event="oninput" @onchange="ActualizarVistaPrevia" class="color-input" />
                            </div>
                            <div class="color-item">
                                <label>Brillo de Botones (Degradado 3D)</label>
                                <input type="color" @bind="datosBox.ThemeSecondary" @bind:event="oninput" @onchange="ActualizarVistaPrevia" class="color-input" />
                            </div>
                            <div class="color-item">
                                <label>Fondo General (Pantalla completa)</label>
                                <input type="color" @bind="datosBox.ThemeBg" @bind:event="oninput" @onchange="ActualizarVistaPrevia" class="color-input" />
                            </div>
                            <div class="color-item">
                                <label>Fondo de Recuadros (Tarjetas y Menús)</label>
                                <input type="color" @bind="datosBox.ThemeCard" @bind:event="oninput" @onchange="ActualizarVistaPrevia" class="color-input" />
                            </div>
                            <div class="color-item">
                                <label>Líneas Divisorias (Bordes de recuadros)</label>
                                <input type="color" @bind="datosBox.ThemeBorder" @bind:event="oninput" @onchange="ActualizarVistaPrevia" class="color-input" />
                            </div>
                            <div class="color-item">
                                <label>Color de Letra Principal (Textos grandes)</label>
                                <input type="color" @bind="datosBox.ThemeText" @bind:event="oninput" @onchange="ActualizarVistaPrevia" class="color-input" />
                            </div>
                            <div class="color-item">
                                <label>Color de Letra Apagada (Textos secundarios)</label>
                                <input type="color" @bind="datosBox.ThemeTextMuted" @bind:event="oninput" @onchange="ActualizarVistaPrevia" class="color-input" />
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button class="btn-cancelar flex-fill" @onclick="RestaurarColoresDefault">
                                <i class="fas fa-undo"></i> ORIGINAL
                            </button>
                            <button class="btn-save flex-fill glow-effect" @onclick="GuardarPrecios" disabled="@guardando">
                                @if (guardando) { <span><i class="fas fa-spinner fa-spin"></i></span> }
                                else { <span><i class="fas fa-save"></i> GUARDAR</span> }
                            </button>
                        </div>
                    </div>
                }

            </div> 
            
            <div style="height: 40px;"></div>
        </div> 
    </div> 
</div> 

<style>
    /* VARIABLES INYECTADAS */
    .main-layout { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--theme-bg); display: flex; flex-direction: column; z-index: 1; }
    .navbar-container { flex-shrink: 0; padding-top: calc(env(safe-area-inset-top) + 5px); padding-bottom: 10px; padding-left: 20px; padding-right: 20px; background-color: var(--theme-bg); border-bottom: 1px solid var(--theme-primary); color: var(--theme-text); display: flex; justify-content: space-between; align-items: center; z-index: 100; font-family: 'Oswald'; min-height: 60px; }
    .nav-left { color: var(--theme-primary); font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
    .nav-title { font-weight: bold; font-size: 1.1rem; color: var(--theme-text); letter-spacing: 1px; }
    .nav-right { width: 60px; }
    .scrollable-content { flex-grow: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; align-items: center; -webkit-overflow-scrolling: touch; padding-bottom: 40px; }

    /* ESTILOS CONFIG BOX */
    .header-section { margin-bottom: 20px; display: flex; flex-direction: column; align-items: center; }
    
    .profile-logo-img { width: 100px; height: 100px; object-fit: cover; border-radius: 50%; border: 3px solid var(--theme-primary); margin-bottom: 10px; margin-top: 10px; box-shadow: 0 0 15px rgba(0,0,0,0.4); }
    .brand-icon-circle { width: 100px; height: 100px; border-radius: 50%; background: var(--theme-card); border: 2px dashed var(--theme-border); display: flex; justify-content: center; align-items: center; margin-bottom: 10px; margin-top: 10px; }
    .brand-icon-circle i { font-size: 3rem; color: var(--theme-text-muted); }
    .header-section h2 { font-family: 'Oswald'; color: var(--theme-text); margin: 0; }
    .header-section p { color: var(--theme-text-muted); font-size: 0.9rem; }

    /* TABS */
    .tabs-container { display: flex; justify-content: center; margin-bottom: 20px; border-bottom: 1px solid var(--theme-border); width: 100%; max-width: 600px; overflow-x: auto; flex-shrink: 0;}
    .tab-btn { flex: 1; background: none; border: none; color: var(--theme-text-muted); padding: 15px 10px; font-weight: bold; border-bottom: 2px solid transparent; transition: 0.3s; cursor: pointer; font-family: 'Oswald'; font-size: 0.85rem; white-space: nowrap; }
    .tab-btn.active { color: var(--theme-primary); border-bottom: 2px solid var(--theme-primary); }
    .tab-btn i { margin-right: 5px; }

    .cards-wrapper { width: 100%; max-width: 600px; }
    .prices-card, .mp-card { background: var(--theme-card); border-radius: 15px; padding: 25px; border: 1px solid var(--theme-border); box-shadow: 0 4px 15px rgba(0,0,0,0.5); width: 100%; }
    .section-title { font-family: 'Oswald'; color: var(--theme-primary); letter-spacing: 1px; margin-bottom: 5px; }
    .lbl-input { color: var(--theme-primary); font-size: 0.9rem; font-weight: bold; display: block; margin-bottom: 5px; }
    
    .input-dark { background: var(--theme-bg) !important; color: var(--theme-text) !important; border: 1px solid var(--theme-border); padding: 10px; font-size: 1.1rem; border-radius: 8px; }
    .input-dark:focus { border-color: var(--theme-primary); box-shadow: 0 0 5px rgba(0,0,0,0.4); }

    /* BOTONES */
    .btn-save { width: 100%; background: linear-gradient(90deg, var(--theme-primary), var(--theme-secondary)) !important; color: var(--theme-bg) !important; font-weight: bold; padding: 12px; border: none; border-radius: 8px; font-family: 'Oswald'; font-size: 1.1rem; transition: 0.2s; }
    .btn-save:active { transform: scale(0.98); }
    .btn-save:disabled { background: var(--theme-border) !important; color: var(--theme-text-muted) !important; box-shadow: none; }
    .glow-effect { box-shadow: 0 0 15px rgba(0,0,0,0.4); }

    .btn-cancelar { background: transparent; border: 1px solid var(--theme-border); color: var(--theme-text-muted); padding: 12px; border-radius: 8px; font-family: 'Oswald'; font-weight: bold; transition: 0.2s; }
    .btn-cancelar:active { background: var(--theme-border); color: var(--theme-text); }

    /* UPLOAD AREA */
    .upload-area { position: relative; width: 100%; height: 200px; background: var(--theme-bg); border: 2px dashed var(--theme-border); border-radius: 10px; display: flex; justify-content: center; align-items: center; overflow: hidden; cursor: pointer; transition: all 0.3s; }
    .upload-area:hover { border-color: var(--theme-primary); }
    .upload-placeholder { color: var(--theme-text-muted); text-align: center; }
    .file-input-hidden { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 10; }
    .image-preview-container { display: flex; justify-content: center; align-items: center; height: 100%; padding: 10px; }
    .image-preview-container img { max-height: 100%; max-width: 100%; object-fit: contain; }

    /* GRID COLORES */
    .color-grid { display: grid; grid-template-columns: 1fr; gap: 15px; text-align: left; }
    .color-item { display: flex; flex-direction: column; gap: 5px; background: var(--theme-bg); padding: 10px; border-radius: 8px; border: 1px solid var(--theme-border);}
    .color-item label { color: var(--theme-text); font-size: 0.80rem; font-weight: bold; font-family: 'Oswald'; letter-spacing: 1px;}
    .color-input { width: 100%; height: 45px; border: none; border-radius: 8px; cursor: pointer; padding: 0; background: none; }
    .color-input::-webkit-color-swatch-wrapper { padding: 0; }
    .color-input::-webkit-color-swatch { border: 1px solid var(--theme-border); border-radius: 8px; }

    /* MERCADO PAGO */
    .mp-status-box { background: rgba(255, 0, 0, 0.1); border: 1px solid #ff4444; padding: 10px; border-radius: 8px; color: #ff4444; display: inline-block; width: 100%; font-size: 0.9rem; }
    .status-connected { color: #00c853; border: 1px solid #00c853; background: rgba(0, 200, 83, 0.1); padding: 20px; border-radius: 10px; }
    .status-connected h4 { margin: 0; font-family: 'Oswald'; margin-top: 10px; }
    .btn-mp-connect { display: block; width: 100%; padding: 15px; background-color: #009EE3; color: white; border-radius: 50px; border: none; text-decoration: none; font-weight: bold; box-shadow: 0 4px 15px rgba(0, 158, 227, 0.4); margin-top: 20px; transition: transform 0.2s; cursor: pointer; }
    .btn-mp-connect.outline { background: transparent; border: 1px solid #009EE3; color: #009EE3; box-shadow: none; }
    .btn-mp-connect:active { transform: scale(0.98); }
    .btn-unlink { background: transparent; border: 1px solid #ff4444; color: #ff4444; width: 100%; padding: 10px; border-radius: 50px; font-weight: bold; margin-top: 10px; cursor: pointer; }
    .btn-unlink:active { background: #ff4444; color: white; }

    .x-small { font-size: 0.7rem; }
    .fade-in { animation: fadeIn 0.5s ease; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .pulse-animation { animation: pulse 2s infinite; }
    @@keyframes pulse { 0% { transform: scale(1); } 70% { transform: scale(1.05); } 100% { transform: scale(1); } }
</style>

@code {
    private int tabActiva = 1;
    private bool guardando = false;
    private BoxConfigDTO datosBox = new BoxConfigDTO();
    private string appId = "3844219986795201";
    private string redirectUri = "https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/marketplace/oauth/callback";

    // --- MAGIA DE COLORES INICIALIZADA (FALLBACK PLATA MATE) ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9;
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    private void ActualizarVistaPrevia()
    {
        EstilosTema = $@"
            --theme-primary: {datosBox.ThemePrimary};
            --theme-secondary: {datosBox.ThemeSecondary};
            --theme-bg: {datosBox.ThemeBg};
            --theme-card: {datosBox.ThemeCard};
            --theme-border: {datosBox.ThemeBorder};
            --theme-text: {datosBox.ThemeText};
            --theme-text-muted: {datosBox.ThemeTextMuted};
        ";
    }

    private void RestaurarColoresDefault()
    {
        datosBox.ThemePrimary = "#F8C545";
        datosBox.ThemeSecondary = "#dcb03d";
        datosBox.ThemeBg = "#0d0d0d";
        datosBox.ThemeCard = "#1a1a1a";
        datosBox.ThemeBorder = "#333333";
        datosBox.ThemeText = "#ffffff";
        datosBox.ThemeTextMuted = "#888888";
        ActualizarVistaPrevia();
    }

    // --- VARIABLES IMAGEN ---
    private IBrowserFile? archivoSeleccionado;
    private string? previewImagen;
    private bool subiendoImagen = false;
    private string urlBaseImagenes = "https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/Imagenes/Logos/";

    protected override async Task OnInitializedAsync()
    {
        // 1. CARGAMOS CACHÉ INMEDIATO
        try 
        {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) 
            { 
                EstilosTema = cache; 
                StateHasChanged(); 
            }
        } 
        catch { }

        await CargarDatos();
        
        var ventana = Application.Current?.MainPage?.Window;
        if (ventana != null) ventana.Resumed += AlVolverAlaApp;
    }

    private void AlVolverAlaApp(object? sender, EventArgs e)
    {
        InvokeAsync(async () =>
        {
            await Task.Delay(1500);
            await CargarDatos();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        var ventana = Application.Current?.MainPage?.Window;
        if (ventana != null) ventana.Resumed -= AlVolverAlaApp;
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Http.GetAsync($"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/boxesAPI/config/{Sesion.Usuario.BoxID}");

            if (response.IsSuccessStatusCode)
            {
                var resultado = await response.Content.ReadFromJsonAsync<BoxConfigDTO>();
                if (resultado != null)
                {
                    datosBox = resultado;
                    
                    if (string.IsNullOrEmpty(datosBox.ThemePrimary)) 
                    {
                        RestaurarColoresDefault();
                    }
                    else 
                    {
                        ActualizarVistaPrevia(); 
                        // Actualizamos la caché
                        try { await JS.InvokeVoidAsync("localStorage.setItem", "tema_box", EstilosTema); } catch { }
                    }

                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando: " + ex.Message);
        }
    }

    private async Task ProcesarSeleccionImagen(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (!file.ContentType.Contains("image"))
            {
                await App.Current.MainPage.DisplayAlert("Error", "Selecciona un archivo de imagen válido.", "OK");
                return;
            }
            if (file.Size > 5 * 1024 * 1024)
            {
                await App.Current.MainPage.DisplayAlert("Muy pesado", "La imagen no debe pesar más de 5MB.", "OK");
                return;
            }

            var formato = "image/png";
            var buffer = new byte[file.Size];
            await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).ReadAsync(buffer);
            previewImagen = $"data:{formato};base64,{Convert.ToBase64String(buffer)}";
            archivoSeleccionado = file;
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error", "No se pudo leer la imagen: " + ex.Message, "OK");
        }
    }

    private async Task GuardarPrecios()
    {
        guardando = true;
        try
        {
            datosBox.BoxID = Sesion.Usuario.BoxID;
            var response = await Http.PostAsJsonAsync("https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/boxesAPI/actualizar-precios", datosBox);

            if (response.IsSuccessStatusCode)
            {
                // Si guardó exitosamente, actualizamos el caché con el nuevo color para que el resto de la app lo tome al instante
                try { await JS.InvokeVoidAsync("localStorage.setItem", "tema_box", EstilosTema); } catch { }
                await App.Current.MainPage.DisplayAlert("¡Éxito!", "Configuración guardada correctamente.", "OK");
            }
            else
            {
                await App.Current.MainPage.DisplayAlert("Error", "No se pudieron guardar los cambios.", "OK");
            }
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK");
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task SubirImagenAlServidor()
    {
        if (archivoSeleccionado == null) return;

        subiendoImagen = true;
        try
        {
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(archivoSeleccionado.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024));
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(archivoSeleccionado.ContentType);
            content.Add(fileContent, "logo", archivoSeleccionado.Name);

            var response = await Http.PostAsync($"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/boxesAPI/subir-logo/{Sesion.Usuario.BoxID}", content);

            if (response.IsSuccessStatusCode)
            {
                await App.Current.MainPage.DisplayAlert("¡Éxito!", "Logo actualizado correctamente.", "OK");
                archivoSeleccionado = null; 
                previewImagen = null;       
                await CargarDatos();        
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await App.Current.MainPage.DisplayAlert("Error", "No se pudo subir: " + error, "OK");
            }
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error de conexión", ex.Message, "OK");
        }
        finally
        {
            subiendoImagen = false;
        }
    }

    private string ObtenerUrlLogo(Guid logoId)
    {
        return $"{urlBaseImagenes}{logoId}.jpg?t={DateTime.Now.Ticks}";
    }

    private async Task DesvincularCuenta()
    {
        bool confirmar = await App.Current.MainPage.DisplayAlert("¿Desconectar?",
            "Si te desconectas, tus atletas ya no podrán pagarte en la App.",
            "Sí, desconectar", "Cancelar");

        if (confirmar)
        {
            try
            {
                var response = await Http.PostAsync($"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/boxesAPI/desvincular/{Sesion.Usuario.BoxID}", null);
                if (response.IsSuccessStatusCode) await CargarDatos();
                else await App.Current.MainPage.DisplayAlert("Error", "No se pudo desconectar.", "OK");
            }
            catch (Exception ex)
            {
                await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK");
            }
        }
    }

    private async Task VincularMercadoPago()
    {
        string url = $"https://auth.mercadopago.com.mx/authorization?client_id={appId}&response_type=code&platform_id=mp&state={Sesion.Usuario.BoxID}&redirect_uri={redirectUri}";
        await Browser.Default.OpenAsync(url, BrowserLaunchMode.SystemPreferred);
    }

