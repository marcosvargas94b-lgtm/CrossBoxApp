</style>

@code {
    // --- ESTADO INICIAL NEUTRAL (PLATA MATE) ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    private string tabActiva = "REPS";
    private bool cargando = true;
    private List<LeaderboardItem> listaActual = new();

    private bool mostrarModalSecuestro = false;
    private string tipoScoreRequerido = "";
    private string inputTiempo = "";
    private int inputRondas = 0;
    private int inputReps = 0;
    private bool guardandoScoreManual = false;
    private string inputCategoria = "Sin asignar";


    public class VerificacionScoreDto
    {
        public bool Pendiente { get; set; }
        public string Tipo { get; set; }
    }

    public class LeaderboardItem
    {
        public string Nombre { get; set; }
        public int Reps { get; set; }
        public int Rondas { get; set; } 
        public string Tiempo { get; set; }
        public int Posicion { get; set; }
        public string Foto { get; set; }
        public bool EsEquipo { get; set; }
        public string Categoria { get; set; }
    }

    private int ObtenerPesoCategoria(string cat)
    {
        if (cat == "RX" || cat == "RXS") return 1;
        if (cat == "AVANZADO" || cat == "AVANZADOS") return 2;
        if (cat == "INTERMEDIO" || cat == "INTERMEDIOS") return 3;
        if (cat == "PRINCIPIANTE" || cat == "PRINCIPIANTES") return 4;
        if (cat == "ESCALADO" || cat == "SCALED") return 5;
        return 99; // "SIN ASIGNAR" se irá hasta el fondo
    }

    protected override async Task OnInitializedAsync()
    {
        try { var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box"); if (!string.IsNullOrEmpty(cache)) { EstilosTema = cache; StateHasChanged(); } } catch { }

        if (Sesion.Usuario == null) { Nav.NavigateTo("/"); return; }

        // 🔥 PREGUNTAMOS AL BACKEND USANDO LA CLASE FUERTE, NO DYNAMIC
        try
        {
            var urlVerificacion = $"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/scoresapi/verificar-score-pendiente/{Sesion.Usuario.UsuarioID}";

            // Usamos la clase nueva en lugar de <dynamic>
            var verificacion = await Http.GetFromJsonAsync<VerificacionScoreDto>(urlVerificacion);

            if (verificacion != null && verificacion.Pendiente == true)
            {
                tipoScoreRequerido = verificacion.Tipo;
                mostrarModalSecuestro = true;
                StateHasChanged();
                return; // 🛑 Detenemos la carga del Leaderboard hasta que ponga su score
            }
        }
        catch (Exception ex)
        {
            // Si quieres ver si falla algo en el futuro, quita el comentario de abajo
            // Console.WriteLine("Error al verificar pendiente: " + ex.Message);
        }

        // Si no debía score, carga todo normal
        await CargarDatos();
    }

    private async Task GuardarScoreDiferido()
    {
        // =================================================================
        // 1. 🛡️ VALIDACIONES ESTRICTAS (Lo que pediste)
        // =================================================================
        if (tipoScoreRequerido == "TIEMPO")
        {
            // Si está vacío o NO tiene los dos puntos (:) lo rechazamos
            if (string.IsNullOrWhiteSpace(inputTiempo) || !inputTiempo.Contains(":"))
            {
                await App.Current.MainPage.DisplayAlert("Atención", "Por favor ingresa un tiempo válido usando los dos puntos (ejemplo: 14:30).", "OK");
                return;
            }
        }
        else if (tipoScoreRequerido == "REPS")
        {
            // Si las reps son 0 o negativas
            if (inputReps <= 0)
            {
                await App.Current.MainPage.DisplayAlert("Atención", "Por favor ingresa un total de repeticiones mayor a cero.", "OK");
                return;
            }
        }
        else if (tipoScoreRequerido == "RONDAS")
        {
            // Si dejaron las rondas y las reps en 0
            if (inputRondas <= 0 && inputReps <= 0)
            {
                await App.Current.MainPage.DisplayAlert("Atención", "Por favor ingresa cuántas rondas o repeticiones extra hiciste.", "OK");
                return;
            }
        }

        // =================================================================
        // 2. 🚀 PREPARAR ENVÍO AL SERVIDOR
        // =================================================================
        guardandoScoreManual = true;
        StateHasChanged();

        var payload = new GuardarResultadosDiferidoDto
        {
            BoxId = Sesion.Usuario.BoxID,
            WodId = Guid.Empty,
            RequiereScoreManual = false,

            // 🔥 SOLUCIÓN AL ERROR 400: Enviamos string vacío en lugar de null
            TipoScoreEsperado = "",

            Resultados = new List<ResultadoAtletaDiferidoDto>
            {
                new ResultadoAtletaDiferidoDto
                {
                    UsuarioUnoId = Sesion.Usuario.UsuarioID,
                    EsEquipo = false,
                    // Si es tiempo, mandamos el dato limpio. Si no, mandamos vacío.
                    TiempoFinal = tipoScoreRequerido == "TIEMPO" ? inputTiempo.Trim() : "",
                    Reps = inputReps,
                    Rondas = inputRondas,
                    NombreEquipo = "Individual",
                    Categoria = inputCategoria, // <--- Aquí va tu categoría
                    ModoCaptura = tipoScoreRequerido
                }
            }
        };

        // =================================================================
        // 3. 📡 COMUNICACIÓN CON LA API
        // =================================================================
        try
        {
            var url = "https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/scoresapi/guardar-clase";
            var response = await Http.PostAsJsonAsync(url, payload);

            if (response.IsSuccessStatusCode)
            {
                mostrarModalSecuestro = false;
                tabActiva = tipoScoreRequerido;
                await CargarDatos();
            }
            else
            {
                string errorReal = await response.Content.ReadAsStringAsync();
                await App.Current.MainPage.DisplayAlert("Error del Servidor", $"Detalle: {errorReal}", "OK");
            }
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error de Conexión", ex.Message, "OK");
        }
        finally
        {
            guardandoScoreManual = false;
            StateHasChanged();
        }
    }

    // 🛡️ DTOs EXPLÍCITOS PARA EVITAR TRIMMING EN COMPILACIÓN RELEASE
    public class GuardarResultadosDiferidoDto
    {
        public Guid BoxId { get; set; }
        public Guid WodId { get; set; }
        public bool RequiereScoreManual { get; set; }
        public string TipoScoreEsperado { get; set; }
        public List<ResultadoAtletaDiferidoDto> Resultados { get; set; } = new();
    }

    public class ResultadoAtletaDiferidoDto
    {
        public Guid UsuarioUnoId { get; set; }
        public Guid? UsuarioDosId { get; set; }
        public bool EsEquipo { get; set; }
        public string TiempoFinal { get; set; }
        public int Rondas { get; set; }
        public int Reps { get; set; }
        public string NombreEquipo { get; set; }
        public string Categoria { get; set; }
        public string ModoCaptura { get; set; }
    }

    private async Task CargarDatos()
    {
        cargando = true;
        listaActual = new(); 
        try
        {
            // Decidimos a qué endpoint pegarle según la pestaña activa
            string endpoint = "";
            if (tabActiva == "REPS") endpoint = "leaderboard-hoy";
            else if (tabActiva == "TIEMPO") endpoint = "leaderboard-tiempo-hoy";
            else if (tabActiva == "RONDAS") endpoint = "leaderboard-rondas-hoy";

            var url = $"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/scoresapi/{endpoint}/{Sesion.Usuario.BoxID}";

            var res = await Http.GetFromJsonAsync<List<LeaderboardItem>>(url);
            if (res != null)
            {
                listaActual = res;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando leaderboard: {ex.Message}");
            listaActual = new List<LeaderboardItem>();
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CambiarTab(string tab)
    {
        if (tabActiva == tab) return;
        tabActiva = tab;
        await CargarDatos();
    }

    private void Volver() => Nav.NavigateTo("/home");
}