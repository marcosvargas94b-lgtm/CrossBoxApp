@page "/leaderboard-hoy"
@using CrossBoxApp.Models.Services
@inject HttpClient Http
@inject NavigationManager Nav
@inject SesionService Sesion
@inject IJSRuntime JS

@* ENVOLVEMOS TODA LA PÁGINA EN EL TEMA *@
<div style="@EstilosTema">

    @if (mostrarModalSecuestro)
    {
        @* 🛑 PANTALLA DE SECUESTRO TOTAL: Reemplaza todo el diseño, es imposible ver el fondo *@
        <div class="modal-overlay" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 9999; backdrop-filter: blur(20px); background: #000000; display: flex; justify-content: center; align-items: center; padding: 20px;">
            <div class="modal-content custom-modal" style="max-width: 380px; border-color: var(--theme-primary); border-top: 5px solid var(--theme-primary); background: var(--theme-card); padding: 30px 20px; text-align: center; border-radius: 15px;">

                <i class="fas fa-clipboard-check" style="font-size: 3rem; color: var(--theme-primary); margin-bottom: 15px;"></i>
                <h4 style="color:var(--theme-primary); font-family:'Oswald'; font-weight:bold; letter-spacing: 1px; margin-bottom: 10px;">
                    ¡REGISTRA TU SCORE!
                </h4>
                <p style="color: var(--theme-text-muted); font-size: 0.95rem; margin-bottom: 25px; font-family:'Roboto';">
                    Tu coach registró tu asistencia. Para ver el Leaderboard y obtener tu Player Card, ingresa tu resultado de hoy.
                </p>

                @* INPUTS DINÁMICOS *@
                @if (tipoScoreRequerido == "TIEMPO")
                {
                    <div style="margin-bottom: 20px; text-align: left;">
                        <label class="lbl-input" style="text-align: center; display: block;">TIEMPO (MM:SS)</label>
                        <input type="text" @bind="inputTiempo" class="form-control input-dark" style="text-align: center; font-size: 1.8rem; font-family: 'Oswald'; letter-spacing: 2px;" placeholder="Ej: 14:30" />
                    </div>
                }
                else if (tipoScoreRequerido == "REPS")
                {
                    <div style="margin-bottom: 20px; text-align: left;">
                        <label class="lbl-input" style="text-align: center; display: block;">TOTAL DE REPETICIONES</label>
                        <input type="number" @bind="inputReps" class="form-control input-dark" style="text-align: center; font-size: 1.8rem; font-family: 'Oswald';" placeholder="0" min="1" />
                    </div>
                }
                else if (tipoScoreRequerido == "RONDAS")
                {
                    <div style="display: flex; gap: 15px; justify-content: center; margin-bottom: 20px; text-align: left;">
                        <div style="flex: 1;">
                            <label class="lbl-input" style="text-align: center; display: block;">RONDAS</label>
                            <input type="number" @bind="inputRondas" class="form-control input-dark" style="text-align: center; font-size: 1.5rem; font-family: 'Oswald';" placeholder="0" min="0" />
                        </div>
                        <div style="flex: 1;">
                            <label class="lbl-input" style="text-align: center; display: block;">REPS</label>
                            <input type="number" @bind="inputReps" class="form-control input-dark" style="text-align: center; font-size: 1.5rem; font-family: 'Oswald';" placeholder="0" min="0" />
                        </div>
                    </div>
                }

                @* SELECTOR DE CATEGORÍA *@
                <div style="margin-bottom: 25px; text-align: left;">
                    <label class="lbl-input" style="text-align: center; display: block;">¿EN QUÉ CATEGORÍA LO HICISTE?</label>
                    <select class="form-control input-dark" @bind="inputCategoria" style="text-align: center; font-size: 1.1rem; font-family: 'Oswald'; appearance: auto;">
                        <option value="Sin asignar">Ninguna / Entrenamiento Normal</option>
                        <option value="PRINCIPIANTE">Principiante</option>
                        <option value="INTERMEDIO">Intermedio</option>
                        <option value="AVANZADO">Avanzado</option>
                        <option value="RX">RX (As Rx'd)</option>
                    </select>
                </div>

                <button class="btn-confirm" @onclick="GuardarScoreDiferido" disabled="@guardandoScoreManual" style="width: 100%;">
                    @if (guardandoScoreManual)
                    {
                        <span><i class="fas fa-spinner fa-spin"></i> GUARDANDO...</span>
                    }
                    else
                    {
                        <span>SUBIR RESULTADO <i class="fas fa-rocket"></i></span>
                    }
                </button>

                <button class="btn-cancel" @onclick="Volver" style="width: 100%; margin-top: 15px; background: transparent; border: none; color: var(--theme-text-muted); text-decoration: underline; box-shadow: none;">
                    No quiero registrarlo ahora (Salir)
                </button>
            </div>
        </div>
    }
    else
    {
        @* ✅ VISTA NORMAL: Solo se compila y se muestra si "mostrarModalSecuestro" es FALSE *@
        <div class="main-layout">

            <div class="navbar-container">
                <div class="nav-left" @onclick="Volver">
                    <i class="fas fa-arrow-left"></i> VOLVER
                </div>
                <div class="nav-title">LEADERBOARD DIARIO</div>
                <div class="nav-right"></div>
            </div>

            <div class="scrollable-content">

                <div class="date-header">
                    @DateTime.Now.ToString("dddd, dd MMMM").ToUpper()
                </div>

                <div class="filter-tabs fade-in">
                    <button class="tab-btn @(tabActiva == "REPS" ? "active" : "")" @onclick='() => CambiarTab("REPS")'>
                        <i class="fas fa-redo-alt"></i> REPS
                    </button>
                    <button class="tab-btn @(tabActiva == "RONDAS" ? "active" : "")" @onclick='() => CambiarTab("RONDAS")'>
                        <i class="fas fa-sync-alt"></i> RONDAS
                    </button>
                    <button class="tab-btn @(tabActiva == "TIEMPO" ? "active" : "")" @onclick='() => CambiarTab("TIEMPO")'>
                        <i class="fas fa-stopwatch"></i> TIEMPO
                    </button>
                </div>

                @if (cargando)
                {
                    <div class="text-center mt-5">
                        <div class="spinner-border" style="color: var(--theme-primary);" role="status"></div>
                        <p class="mt-2" style="color: var(--theme-text-muted);">Cargando resultados...</p>
                    </div>
                }
                else if (listaActual == null || listaActual.Count == 0)
                {
                    <div class="empty-state fade-in">
                        <i class="fas fa-dumbbell" style="opacity: 0.3; font-size: 3rem; margin-bottom: 15px; color: var(--theme-text-muted);"></i>
                        <h3 style="color: var(--theme-text-muted);">SIN RESULTADOS</h3>
                        <p style="color: var(--theme-text-muted);">Aún no hay registros de @(tabActiva) para hoy.</p>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(Sesion.Usuario?.TipoLugar) &&
                                Sesion.Usuario.TipoLugar.ToUpper().Contains("CROSSFIT") &&
                                listaActual.Any(x => !string.IsNullOrEmpty(x.Categoria) && x.Categoria.ToUpper() != "SIN ASIGNAR"))
                    {
                        var grupos = listaActual
                        .GroupBy(x => string.IsNullOrEmpty(x.Categoria) || x.Categoria.ToUpper() == "SIN ASIGNAR" ? "SIN CATEGORÍA" : x.Categoria.ToUpper())
                        .OrderBy(g => ObtenerPesoCategoria(g.Key));

                        foreach (var grupo in grupos)
                        {
                            <div class="category-header fade-in">
                                <h4>@grupo.Key</h4>
                            </div>
                            <div class="podium-list fade-in mb-4">
                                @{
                                    int pos = 1;
                                }
                                @foreach (var item in grupo)
                                {
                                    <div class="score-row @(pos == 1 ? "gold" : "") @(item.EsEquipo ? "team-border" : "")">
                                        <div class="pos-column">
                                            @if (pos == 1)
                                            {
                                                <i class="fas fa-crown gold-icon"></i>
                                            }
                                            else if (pos == 2)
                                            {

                                                <i class="fas fa-medal silver-icon"></i>
                                            }
                                            else if (pos == 3)
                                            {

                                                <i class="fas fa-medal bronze-icon"></i>
                                            }
                                            else
                                            {

                                                <span>@pos</span>
                                            }
                                        </div>
                                        <div class="avatar-column">
                                            @if (!string.IsNullOrEmpty(item.Foto))
                                            {
                                                <img src="@item.Foto" class="score-avatar" />
                                            }
                                            else
                                            {

                                                <div class="score-placeholder">@(item.EsEquipo ? "T" : item.Nombre.Substring(0, 1).ToUpper())</div>
                                            }
                                        </div>
                                        <div class="name-column">
                                            <span class="name-text">@item.Nombre</span>
                                            @if (item.EsEquipo)
                                            {
                                                <span class="team-badge">EQUIPO</span>
                                            }
                                        </div>
                                        <div class="reps-column">
                                            @if (tabActiva == "REPS")
                                            {
                                                <span class="reps-val">@item.Reps</span>
                        
                                                <small>REPS</small>
                                            }
                                            else if (tabActiva == "RONDAS")
                                            {
                                                @if (item.Reps > 0)
                                                {
                                                    <div class="split-score">
                                                        <span class="reps-val">@item.Rondas<span class="reps-val-small"> RND</span></span>
                                                        <span class="reps-plus">+ @item.Reps<span class="reps-val-small"> REP</span></span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="reps-val">@item.Rondas</span>
                        
                                                    <small>RONDAS</small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="reps-val">@item.Tiempo</span>
                        
                                                <small>TIME</small>
                                            }
                                        </div>
                                    </div>
                                    pos++;
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="podium-list fade-in">
                            @foreach (var item in listaActual)
                            {
                                <div class="score-row @(item.Posicion == 1 ? "gold" : "") @(item.EsEquipo ? "team-border" : "")">
                                    <div class="pos-column">
                                        @if (item.Posicion == 1)
                                        {
                                            <i class="fas fa-crown gold-icon"></i>
                                        }
                                        else if (item.Posicion == 2)
                                        {

                                            <i class="fas fa-medal silver-icon"></i>
                                        }
                                        else if (item.Posicion == 3)
                                        {

                                            <i class="fas fa-medal bronze-icon"></i>
                                        }
                                        else
                                        {

                                            <span>@item.Posicion</span>
                                        }
                                    </div>
                                    <div class="avatar-column">
                                        @if (!string.IsNullOrEmpty(item.Foto))
                                        {
                                            <img src="@item.Foto" class="score-avatar" />
                                        }
                                        else
                                        {

                                            <div class="score-placeholder">@(item.EsEquipo ? "T" : item.Nombre.Substring(0, 1).ToUpper())</div>
                                        }
                                    </div>
                                    <div class="name-column">
                                        <span class="name-text">@item.Nombre</span>
                                        @if (item.EsEquipo)
                                        {
                                            <span class="team-badge">EQUIPO</span>
                                        }
                                    </div>
                                    <div class="reps-column">
                                        @if (tabActiva == "REPS")
                                        {
                                            <span class="reps-val">@item.Reps</span>
                                            <small>REPS</small>
                 }
                                        else if (tabActiva == "RONDAS")
                                        {
                                            @if (item.Reps > 0)
                                            {
                                                <div class="split-score">
                                                    <span class="reps-val">@item.Rondas<span class="reps-val-small"> RND</span></span>
                                                    <span class="reps-plus">+ @item.Reps<span class="reps-val-small"> REP</span></span>
                                                </div>
                                            }
                                            else
                                            {

                                                <span class="reps-val">@item.Rondas</span>
                                                <small>RONDAS</small>
                     }
                                        }
                                        else
                                        {
                                            <span class="reps-val">@item.Tiempo</span>
                                            <small>TIME</small>
                 }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                <div style="height: 40px;"></div>
            </div>
        </div>
    }
</div>

@* 🔥 MODAL DE SECUESTRO (OBLIGA A REGISTRAR SCORE) *@
@if (mostrarModalSecuestro)
{
    <div class="modal-overlay fade-in" style="z-index: 9999; backdrop-filter: blur(15px); background: rgba(0,0,0,0.95);">
        <div class="modal-content custom-modal slide-up" style="max-width: 380px; border-color: var(--theme-primary); border-top: 5px solid var(--theme-primary);">

            <div class="modal-body text-center" style="padding: 30px 20px;">
                <i class="fas fa-clipboard-check" style="font-size: 3rem; color: var(--theme-primary); margin-bottom: 15px;"></i>
                <h4 style="color:var(--theme-primary); font-family:'Oswald'; font-weight:bold; letter-spacing: 1px;">
                    ¡REGISTRA TU SCORE!
                </h4>
                <p style="color: var(--theme-text-muted); font-size: 0.95rem; margin-bottom: 25px; font-family:'Roboto';">
                    Tu coach registró tu asistencia. Para ver el Leaderboard y obtener tu Player Card, ingresa tu resultado de hoy.
                </p>

                @* INPUTS DINÁMICOS SEGÚN LO QUE PIDIÓ EL COACH *@
                @if (tipoScoreRequerido == "TIEMPO")
                {
                    <div style="margin-bottom: 20px;">
                        <label style="color: var(--theme-text-muted); font-size: 0.75rem; font-weight: bold; letter-spacing: 1px;">TIEMPO (MM:SS)</label>
                        <input type="text" @bind="inputTiempo" class="form-control" style="background: rgba(255,255,255,0.05); border: 1px solid var(--theme-border); color: white; text-align: center; font-size: 1.8rem; font-family: 'Oswald'; letter-spacing: 2px;" placeholder="Ej: 14:30" />
                    </div>
                }
                else if (tipoScoreRequerido == "REPS")
                {
                    <div style="margin-bottom: 20px;">
                        <label style="color: var(--theme-text-muted); font-size: 0.75rem; font-weight: bold; letter-spacing: 1px;">TOTAL DE REPETICIONES</label>
                        <input type="number" @bind="inputReps" class="form-control" style="background: rgba(255,255,255,0.05); border: 1px solid var(--theme-border); color: white; text-align: center; font-size: 1.8rem; font-family: 'Oswald';" placeholder="0" min="1" />
                    </div>
                }
                else if (tipoScoreRequerido == "RONDAS")
                {
                    <div style="display: flex; gap: 15px; justify-content: center; margin-bottom: 20px;">
                        <div style="flex: 1;">
                            <label style="color: var(--theme-text-muted); font-size: 0.75rem; font-weight: bold;">RONDAS</label>
                            <input type="number" @bind="inputRondas" class="form-control" style="background: rgba(255,255,255,0.05); border: 1px solid var(--theme-border); color: white; text-align: center; font-size: 1.5rem; font-family: 'Oswald';" placeholder="0" min="0" />
                        </div>
                        <div style="flex: 1;">
                            <label style="color: var(--theme-text-muted); font-size: 0.75rem; font-weight: bold;">REPS EXTRA</label>
                            <input type="number" @bind="inputReps" class="form-control" style="background: rgba(255,255,255,0.05); border: 1px solid var(--theme-border); color: white; text-align: center; font-size: 1.5rem; font-family: 'Oswald';" placeholder="0" min="0" />
                        </div>
                    </div>
                }

                <button class="btn-confirm mt-3" @onclick="GuardarScoreDiferido" disabled="@guardandoScoreManual" style="width: 100%; background: var(--theme-primary); color: var(--theme-bg); padding: 12px; border-radius: 8px; font-family: 'Oswald'; font-size: 1.1rem; border: none;">
                    @if (guardandoScoreManual)
                    {
                        <span><i class="fas fa-spinner fa-spin"></i> GUARDANDO...</span>
                    }
                    else
                    {
                        @* 🔥 NUEVO: SELECTOR DE CATEGORÍA *@
                        <div style="margin-bottom: 25px;">
                            <label style="color: var(--theme-text-muted); font-size: 0.75rem; font-weight: bold; letter-spacing: 1px;">¿EN QUÉ CATEGORÍA LO HICISTE?</label>
                            <select class="form-control mt-2" @bind="inputCategoria" style="background: rgba(255,255,255,0.05); border: 1px solid var(--theme-border); color: white; text-align: center; font-size: 1.2rem; font-family: 'Oswald'; padding: 10px; border-radius: 8px; appearance: auto;">
                                <option value="Sin asignar">Ninguna / Entrenamiento Normal</option>
                                <option value="PRINCIPIANTE">Principiante</option>
                                <option value="INTERMEDIO">Intermedio</option>
                                <option value="AVANZADO">Avanzado</option>
                                <option value="RX">RX (As Rx'd)</option>
                            </select>
                        </div>

                        <span>SUBIR RESULTADO <i class="fas fa-rocket"></i></span>
                    }
                </button>

                <button class="btn-cancel mt-3" @onclick="Volver" style="width: 100%; background: transparent; border: none; color: var(--theme-text-muted); font-size: 0.85rem; text-decoration: underline;">
                    No quiero registrarlo ahora (Volver al Inicio)
                </button>
            </div>
        </div>
    </div>
}

<style>
    /* --- ESTRUCTURA BASE --- */
    .main-layout { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--theme-bg); display: flex; flex-direction: column; z-index: 1; }
    .navbar-container { flex-shrink: 0; padding-top: calc(env(safe-area-inset-top) + 5px); padding-bottom: 10px; padding-left: 20px; padding-right: 20px; background-color: var(--theme-bg); border-bottom: 1px solid var(--theme-primary); color: var(--theme-text); display: flex; justify-content: space-between; align-items: center; z-index: 100; font-family: 'Oswald'; min-height: 60px; }
    .nav-left { color: var(--theme-primary); font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
    .nav-title { font-weight: bold; font-size: 1.1rem; color: var(--theme-text); letter-spacing: 1px; }
    .nav-right { width: 60px; }
    .scrollable-content { flex-grow: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; align-items: center; -webkit-overflow-scrolling: touch; padding-bottom: calc(env(safe-area-inset-bottom) + 40px); }

    /* --- TABS --- */
    .filter-tabs { display: flex; gap: 5px; margin-bottom: 20px; background: var(--theme-card); padding: 5px; border-radius: 12px; width: 100%; max-width: 600px; border: 1px solid var(--theme-border); }
    .tab-btn { flex: 1; background: transparent; border: none; color: var(--theme-text-muted); padding: 10px 5px; font-family: 'Oswald'; font-size: 0.85rem; border-radius: 8px; transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 5px; }
    .tab-btn.active { background: var(--theme-primary); color: var(--theme-bg); font-weight: bold; }

    /* --- LEADERBOARD ITEMS --- */
    .date-header { font-family: 'Oswald'; font-size: 1.3rem; color: var(--theme-text-muted); margin-bottom: 20px; text-align: center; width: 100%; letter-spacing: 1px; }
    .podium-list { width: 100%; max-width: 600px; display: flex; flex-direction: column; gap: 12px; }
    .score-row { display: flex; align-items: center; background: var(--theme-card); padding: 12px 15px; border-radius: 15px; border: 1px solid var(--theme-border); position: relative; }
    
    /* El ORO mantiene su color universal independiente del tema del gym */
    .score-row.gold { border: 1px solid #FFD700; background: linear-gradient(90deg, rgba(255, 215, 0, 0.1) 0%, var(--theme-card) 100%); }
    .score-row.team-border { border-left: 4px solid var(--theme-primary); }
    
    .pos-column { width: 35px; text-align: center; font-family: 'Oswald'; font-weight: bold; font-size: 1.1rem; color: var(--theme-text-muted); }
    .avatar-column { margin-right: 15px; }
    .score-avatar { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 2px solid var(--theme-border); }
    .score-placeholder { width: 48px; height: 48px; border-radius: 50%; background: var(--theme-bg); color: var(--theme-primary); display: flex; align-items: center; justify-content: center; font-weight: bold; font-family: 'Oswald'; border: 2px solid var(--theme-border); font-size: 1.2rem; }
    .name-column { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
    .name-text { font-size: 0.95rem; color: var(--theme-text); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .team-badge { font-size: 0.6rem; background: var(--theme-primary); color: var(--theme-bg); padding: 1px 6px; border-radius: 4px; width: fit-content; font-weight: bold; margin-top: 3px; }
    
    /* MODIFICACIÓN PARA RONDAS EXTRA */
    .reps-column { text-align: right; font-family: 'Oswald'; display: flex; flex-direction: column; justify-content: center; min-width: 70px; align-items: flex-end;}
    .reps-val { font-size: 1.3rem; color: var(--theme-primary); font-weight: bold; line-height: 1; display: flex; align-items: baseline; gap: 2px;}
    .reps-column small { font-size: 0.65rem; color: var(--theme-text-muted); margin-top: 2px; }
    
    /* Estilos específicos para cuando hay Rondas + Repes */
    .split-score { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.1; }
    .reps-plus { font-size: 0.95rem; color: var(--theme-text); font-weight: bold; }
    .reps-val-small { font-size: 0.6rem; color: var(--theme-text-muted); font-weight: normal; letter-spacing: 0.5px; }

    /* ICONOS PREMIOS (Se mantienen porque son estándar de medallas) */
    .gold-icon { color: #FFD700; font-size: 1.3rem; }
    .silver-icon { color: #C0C0C0; font-size: 1.2rem; }
    .bronze-icon { color: #CD7F32; font-size: 1.2rem; }
    
    .empty-state { text-align: center; margin-top: 60px; font-family: 'Oswald'; }
    .fade-in { animation: fadeIn 0.4s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .category-header { text-align: center; margin-top: 30px; margin-bottom: 15px; position: relative; }
    .category-header h4 { font-family: 'Oswald'; color: var(--theme-primary); font-size: 1.2rem; margin: 0; display: inline-block; background: var(--theme-bg); padding: 0 15px; position: relative; z-index: 2; letter-spacing: 1px; font-weight: bold; }
    .category-header::before { content: ''; position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: var(--theme-border); z-index: 1; }

    /* --- DISEÑO PREMIUM PARA PANTALLA DE SECUESTRO --- */
    .lbl-input { 
        color: var(--theme-text-muted); 
        font-size: 0.75rem; 
        font-weight: bold; 
        margin-bottom: 8px; 
        display: block; 
        text-transform: uppercase; 
        letter-spacing: 1px; 
    }
    
    .input-dark { 
        background: rgba(0, 0, 0, 0.4) !important; 
        border: 1px solid var(--theme-border) !important; 
        color: var(--theme-text) !important; 
        border-radius: 10px !important; 
        padding: 12px 15px; 
        font-size: 1.1rem; 
        transition: all 0.3s ease; 
        box-shadow: inset 0 2px 5px rgba(0,0,0,0.5); 
        width: 100%; 
        box-sizing: border-box; 
    }
    .input-dark:focus { 
        border-color: var(--theme-primary) !important; 
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.05) !important; 
        outline: none; 
    }
    .input-dark option { 
        background: var(--theme-card); 
        color: var(--theme-text); 
    }

    .btn-confirm { 
        background: var(--theme-primary); 
        color: var(--theme-bg); 
        border: none; 
        padding: 14px; 
        font-family: 'Oswald'; 
        font-weight: bold; 
        font-size: 1.1rem; 
        letter-spacing: 1px; 
        border-radius: 10px; 
        box-shadow: 0 5px 15px rgba(0,0,0,0.3); 
        transition: 0.2s; 
