@page "/evaluaciones/{UsuarioId:guid}/{NombreAtleta}"
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS
<div style="@EstilosTema">
<div class="main-layout" >

    <div class="navbar-container">
        <div class="nav-left" @onclick="Volver">
            <i class="fas fa-arrow-left"></i> VOLVER
        </div>
        <div class="nav-center">
            <div class="nav-title-main">EVALUACIONES</div>
            <div class="nav-title-sub">@NombreAtleta.Split(' ')[0].ToUpper()</div>
        </div>
        <div class="nav-right"></div>
    </div>

    <div class="scrollable-content">
        
        @if (cargando)
        {
            <div class="text-center mt-5">
                <div class="spinner-border" style="color: var(--theme-primary);"></div>
            </div>
        }
        else if (listaEvaluaciones == null || listaEvaluaciones.Count == 0)
        {
            <div class="empty-state fade-in">
                <i class="fas fa-clipboard-list" style="opacity: 0.3; font-size: 3rem; margin-bottom: 15px;"></i>
                <p>No hay tests configurados para evaluar.</p>
            </div>
        }
        else
        {
            <div class="eval-grid fade-in">
                @foreach (var item in listaEvaluaciones)
                {
                    <div class="eval-card">
                        <div class="card-header-yellow">
                            <span class="test-cat">@item.Categoria.ToUpper()</span>
                            <span class="test-unit">@item.Medida</span>
                        </div>

                        <div class="card-body-dark">
                            <div class="test-name">@item.NombreTest</div>

                            <div class="result-area">
                                @if (!string.IsNullOrEmpty(item.Valor))
                                {
                                    <div class="result-display">
                                        <div class="value-row">
                                            <span class="result-value">@item.Valor</span>
                                            <span class="result-unit">@item.Medida</span>
                                        </div>
                                        <span class="result-date">@item.Fecha?.ToShortDateString()</span>
                                    </div>
                                    
                                    <div class="action-buttons">
                                        <button class="btn-icon edit" @onclick="() => AbrirModal(item, esNuevaMarca: false)">
                                            <i class="fas fa-edit"></i>
                                        </button>

                                        <button class="btn-icon new-record" @onclick="() => AbrirModal(item, esNuevaMarca: true)">
                                            <i class="fas fa-plus-circle"></i> NUEVA
                                        </button>

                                        @if (Sesion.TienePermiso("DELETE_DATA"))
                                        {
                                            <button class="btn-icon delete" @onclick="() => EliminarRegistro(item.TestUsuarioId)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <button class="btn-ingresar" @onclick="() => AbrirModal(item, esNuevaMarca: true)">
                                        <i class="fas fa-plus"></i> INGRESAR DATOS
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        
        <div style="height: 40px;"></div>
    </div>
</div>

    @if (mostrarModal)
    {
        <div class="modal-overlay">
            <div class="modal-content custom-modal">
                <div class="modal-header">
                    <h5 style="color:var(--theme-primary); margin:0; font-family:'Oswald'">
                        <i class="fas @(esModoNuevaMarca ? "fa-plus-circle" : "fa-edit")" style="margin-right:8px;"></i>
                        @(esModoNuevaMarca ? "NUEVA MARCA" : "EDITAR REGISTRO")
                    </h5>
                    <button class="btn-close-custom" @onclick="() => mostrarModal = false"><i class="fas fa-times"></i></button>
                </div>

                <div class="modal-body text-center">
                    <h4 class="test-title-modal">@testSeleccionado.NombreTest</h4>
                    <label class="lbl-input text-center mb-3">Ingresa el resultado en:</label>

                    <div class="input-with-unit">
                        <input type="text" @bind="valorInput" class="form-control input-dark big-input" placeholder="Ej: 100 o 12:30" />
                        <span class="unit-label">@testSeleccionado.Medida</span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-cancel" @onclick="() => mostrarModal = false">Cancelar</button>
                    <button class="btn-confirm" @onclick="GuardarDatos">GUARDAR</button>
                </div>
            </div>
        </div>
    }
</div>
<style>
    /* --- ESTRUCTURA BASE Y NAVBAR BLINDADA --- */
    .main-layout { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--theme-bg); display: flex; flex-direction: column; z-index: 1; }

    .navbar-container {
        flex-shrink: 0;
        padding-top: calc(env(safe-area-inset-top) + 10px);
        padding-bottom: 10px;
        padding-left: 20px;
        padding-right: 20px;
        background-color: var(--theme-bg);
        border-bottom: 1px solid var(--theme-primary);
        color: var(--theme-text);
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 100;
        font-family: 'Oswald';
        min-height: 60px;
    }

    .nav-left { color: var(--theme-primary); font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 5px; font-size: 0.9rem; white-space: nowrap; z-index: 10; }
    .nav-center { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; overflow: hidden; padding: 0 10px; }
    .nav-title-main { font-weight: bold; font-size: 1.1rem; color: var(--theme-text); letter-spacing: 1px; white-space: nowrap; }
    .nav-title-sub { font-size: 0.75rem; color: var(--theme-text-muted); font-family: 'Roboto'; font-weight: normal; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
    .nav-right { display: flex; justify-content: flex-end; z-index: 10; min-width: 60px; }
    .scrollable-content { flex-grow: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; align-items: center; -webkit-overflow-scrolling: touch; padding-bottom: 40px; }

    /* --- ESTILOS EVALUACIONES (Tarjetas) --- */
    .eval-grid { width: 100%; max-width: 600px; display: flex; flex-direction: column; gap: 15px; }
    .eval-card { border: 1px solid var(--theme-border); border-radius: 12px; overflow: hidden; background: var(--theme-card); box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
    .card-header-yellow { background-color: var(--theme-primary); padding: 8px 15px; display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; color: var(--theme-bg); font-family: 'Oswald'; }
    .card-body-dark { padding: 15px; }

    .test-name { color: var(--theme-text); font-family: 'Oswald'; font-size: 1.2rem; margin-bottom: 10px; text-transform: uppercase; }
    .result-area { display: flex; justify-content: space-between; align-items: center; min-height: 40px; }
    .result-display { display: flex; flex-direction: column; }
    .value-row { display: flex; align-items: baseline; gap: 5px; }
    
    .result-value { color: var(--theme-primary); font-size: 1.8rem; font-weight: bold; line-height: 1; font-family: 'Oswald'; }
    .result-unit { color: var(--theme-primary); font-size: 1rem; font-weight: bold; text-transform: uppercase; font-family: 'Oswald'; }
    .result-date { color: var(--theme-text-muted); font-size: 0.75rem; margin-top: 4px; font-family: 'Roboto'; }

    .action-buttons { display: flex; gap: 8px; }
    .btn-icon { background: transparent; border: 1px solid var(--theme-border); color: var(--theme-text-muted); border-radius: 8px; padding: 8px 12px; font-size: 1rem; cursor: pointer; transition: 0.2s; }
    .btn-icon:active { transform: scale(0.95); }
    .btn-icon.edit:hover { color: var(--theme-primary); border-color: var(--theme-primary); background: rgba(255,255,255,0.05); }
    .btn-icon.delete:hover { color: #d9534f; border-color: #d9534f; background: rgba(217,83,79,0.1); }
    
    .btn-icon.new-record { color: #28a745; border-color: #28a745; font-weight: bold; font-family: 'Oswald'; font-size: 0.8rem; display: flex; align-items: center; gap: 5px; }
    .btn-icon.new-record:hover { background-color: rgba(40, 167, 69, 0.1); }

    .btn-ingresar { width: 100%; background: transparent; border: 1px dashed var(--theme-primary); color: var(--theme-primary); padding: 10px; border-radius: 8px; font-weight: bold; font-family: 'Oswald'; transition: 0.2s; }
    .btn-ingresar:active { background: rgba(255,255,255,0.05); }

    .empty-state { text-align: center; margin-top: 60px; color: var(--theme-text-muted); font-family: 'Roboto'; }

    /* ========================================= */
    /* MODALES GENÉRICOS (ESTILO FLOTANTE VIP)   */
    /* ========================================= */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); z-index: 5000; display: flex; justify-content: center; align-items: center; backdrop-filter: blur(8px); padding: 20px; }
    
    .custom-modal { background: var(--theme-bg); width: 100%; max-width: 420px; border-radius: 20px; border: 1px solid var(--theme-border); border-top: 4px solid var(--theme-primary); display: flex; flex-direction: column; color: var(--theme-text); max-height: 85vh; box-shadow: 0 25px 50px rgba(0,0,0,0.9); overflow: hidden; animation: modalBounce 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
    
    .modal-header { padding: 20px 25px; background: var(--theme-card); border-bottom: 1px solid var(--theme-border); display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; }
    
    .modal-body { padding: 25px 20px; overflow-y: auto; flex-grow: 1; -webkit-overflow-scrolling: touch; }
    
    .modal-footer { padding: 15px 20px; background: var(--theme-card); border-top: 1px solid var(--theme-border); display: flex; gap: 10px; flex-shrink: 0; }
    
    /* LA CRUZ ROJA ELEGANTE */
    .btn-close-custom { background: rgba(220, 53, 69, 0.1); border: 1px solid #dc3545; color: #dc3545; width: 36px; height: 36px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 1.2rem; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 10px rgba(220, 53, 69, 0.2); }
    .btn-close-custom:hover { background: #dc3545; color: white; transform: scale(1.1); }
    .btn-close-custom:active { transform: scale(0.9); }
    
    /* BOTONES DE ACCIÓN DEL MODAL */
    .btn-confirm { background: var(--theme-primary); color: var(--theme-bg); border: none; padding: 12px; font-family: 'Oswald'; font-weight: bold; font-size: 1.1rem; letter-spacing: 1px; flex: 1; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.3); transition: 0.2s; text-align: center; }
    .btn-confirm:active { transform: scale(0.95); }
    
    /* EL BOTÓN CANCELAR UNIVERSAL Y NEUTRAL */
    .btn-cancel { background: #333333 !important; color: #ffffff !important; border: 1px solid #555555 !important; padding: 12px; font-family: 'Oswald', sans-serif; font-weight: bold; font-size: 1.1rem; letter-spacing: 1px; flex: 1; border-radius: 10px; transition: 0.2s; text-align: center; cursor: pointer; }
    .btn-cancel:active { transform: scale(0.95); background: #222222 !important; }

    /* CAMPOS DE TEXTO ENCAPSULADOS */
    .lbl-input { color: var(--theme-text-muted); font-size: 0.8rem; font-weight: bold; margin-bottom: 8px; display: block; text-transform: uppercase; letter-spacing: 1px; }
    
    .input-dark { background: rgba(0, 0, 0, 0.4) !important; border: 1px solid var(--theme-border) !important; color: var(--theme-text) !important; border-radius: 10px !important; padding: 12px 15px; font-size: 0.95rem; transition: all 0.3s ease; box-shadow: inset 0 2px 5px rgba(0,0,0,0.5); width: 100%; box-sizing: border-box; }
    .input-dark:focus { border-color: var(--theme-primary) !important; box-shadow: 0 0 10px rgba(255, 255, 255, 0.05) !important; outline: none; }
    .input-dark::placeholder { color: var(--theme-text-muted) !important; opacity: 0.7; }

    /* Ajustes específicos para el input grande de la Evaluación */
    .test-title-modal { color: var(--theme-text); font-family: 'Oswald'; margin-bottom: 20px; font-size: 1.5rem; text-transform: uppercase; text-shadow: 1px 1px 3px rgba(0,0,0,0.5); }
    .input-with-unit { display: flex; align-items: center; justify-content: center; gap: 15px; }
    
    .big-input { text-align: center; font-size: 2.2rem !important; font-weight: bold; width: 150px !important; padding: 10px !important; font-family: 'Oswald'; }
    .big-input::placeholder { font-size: 1.2rem !important; font-weight: normal; vertical-align: middle; }
    
    .unit-label { color: var(--theme-primary); font-size: 1.6rem; font-family: 'Oswald'; font-weight: bold; text-transform: uppercase; }

    /* SCROLLBAR PREMIUM */
    .modal-body::-webkit-scrollbar, .scroll-custom::-webkit-scrollbar { width: 6px; }
    .modal-body::-webkit-scrollbar-track, .scroll-custom::-webkit-scrollbar-track { background: transparent; border-radius: 10px; }
    .modal-body::-webkit-scrollbar-thumb, .scroll-custom::-webkit-scrollbar-thumb { background: var(--theme-border); border-radius: 10px; }
    .modal-body::-webkit-scrollbar-thumb:hover, .scroll-custom::-webkit-scrollbar-thumb:hover { background: var(--theme-primary); }

    /* ANIMACIONES */
    .fade-in { animation: fadeIn 0.4s ease; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes modalBounce { from { transform: scale(0.8) translateY(30px); opacity: 0; } to { transform: scale(1) translateY(0); opacity: 1; } }
</style>
@code {
    // --- ESTADO INICIAL NEUTRAL (PLATA MATE) ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    [Parameter] public Guid UsuarioId { get; set; }
    [Parameter] public string NombreAtleta { get; set; }
    
    private bool esModoNuevaMarca = false;
    private List<EvaluacionVisualDto> listaEvaluaciones = new List<EvaluacionVisualDto>();
    private bool cargando = true;
    private bool mostrarModal = false;
    private EvaluacionVisualDto testSeleccionado;
    private string valorInput;

    protected override async Task OnInitializedAsync()
    {
        // LEER EL CACHÉ LOCAL AL INSTANTE
        try 
        {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) 
            { 
                EstilosTema = cache; 
                StateHasChanged(); 
            }
        } 
        catch { }

        if (Sesion.Usuario == null) { Nav.NavigateTo("/"); return; }

        if (Sesion.Usuario.TipoUsuarioID != 1 && !Sesion.TienePermiso("MANAGE_EVALUATIONS")) 
        { 
            await App.Current.MainPage.DisplayAlert("Acceso Denegado", "No tienes permisos para evaluar.", "OK");
            Nav.NavigateTo("/home"); 
            return; 
        }

        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try {
            cargando = true;
            var boxId = Sesion.Usuario.BoxID;
            var response = await Http.GetAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/evaluacionesapi/usuario/{boxId}/{UsuarioId}");
            if (response.IsSuccessStatusCode) 
                listaEvaluaciones = await response.Content.ReadFromJsonAsync<List<EvaluacionVisualDto>>();
        }
        finally { cargando = false; }
    }

    private void AbrirModal(EvaluacionVisualDto item, bool esNuevaMarca)
    {
        testSeleccionado = item;
        esModoNuevaMarca = esNuevaMarca;
        // Si es nueva marca, ponemos "" para que sea fácil escribir. Si es editar, ponemos el valor actual.
        valorInput = esNuevaMarca ? "" : (item.Valor ?? "");
        mostrarModal = true;
    }

    private async Task GuardarDatos()
    {
        try {
            var dto = new GuardarResultadoDto 
            { 
                TestUsuarioId = testSeleccionado.TestUsuarioId, 
                TestBoxId = testSeleccionado.TestBoxId, 
                UsuarioId = this.UsuarioId, 
                Valor = valorInput, 
                EsNuevaMarca = esModoNuevaMarca 
            };

            var r = await Http.PostAsJsonAsync("https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/evaluacionesapi/guardar", dto);
            
            if (r.IsSuccessStatusCode) 
            { 
                mostrarModal = false; 
                await CargarDatos(); 
            }
            else 
            { 
                await App.Current.MainPage.DisplayAlert("Error", "No se pudo guardar", "OK"); 
            }
        } 
        catch(Exception ex) 
        { 
            await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK"); 
        }
    }

    private async Task EliminarRegistro(Guid? testUsuarioId)
    {
        bool c = await App.Current.MainPage.DisplayAlert("Eliminar", "¿Seguro que quieres borrar este registro?", "Sí, borrar", "Cancelar");
        if (!c) return;
        
        try {
            var r = await Http.PostAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/evaluacionesapi/eliminar-registro/{testUsuarioId}", null);
            if (r.IsSuccessStatusCode) await CargarDatos();
            else await App.Current.MainPage.DisplayAlert("Error", "No se pudo eliminar.", "OK");
        } 
        catch(Exception ex) { await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK"); }
    }

    private void Volver() => Nav.NavigateTo("/usuarios-view");
} 