@page "/rutina-detalle/{RutinaID:int}"
@using CrossBoxApp.Models.Services
@using System.Net.Http.Json
@using Plugin.LocalNotification
@using Microsoft.Maui.Devices
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS

<div style="@EstilosTema">

    <div class="main-layout">

        <div class="navbar-container">
            <div class="nav-left" @onclick="Volver">
                <i class="fas fa-arrow-left"></i> VOLVER
            </div>
            <div class="nav-center">
                <div class="nav-title-main">WORKOUT</div>
            </div>
            <div class="nav-right"></div>
        </div>

        <div class="scrollable-content">

            @if (cargando)
            {
                <div class="text-center mt-5">
                    <div class="spinner-border" style="color: var(--theme-primary);"></div>
                </div>
            }
            else if (rutina == null)
            {
                <div class="text-center mt-5 text-theme-muted">Rutina no encontrada.</div>
            }
            else
            {
                <div class="routine-card fade-in">
                    <div class="rc-header">
                        <div class="rc-date">
                            <span class="rc-day">@NombreDia(rutina.Fecha.DayOfWeek)</span>
                            <span class="rc-num">@rutina.Fecha.ToString("dd MMM").ToUpper()</span>
                        </div>
                        <div class="rc-coach">
                            <i class="fas fa-user-edit"></i> @rutina.CoachNombre
                        </div>
                    </div>
                    
                    <div class="rc-body">
                        <p>@rutina.Descripcion</p>
                    </div>
                </div>

                @if (!rutina.Completada)
                {
                    <button class="btn-terminar slide-up mt-4" @onclick="TerminarDia" disabled="@guardando">
                        @if (guardando)
                        {
                            <i class="fas fa-spinner fa-spin"></i> <span>REGISTRANDO...</span>
                        }
                        else
                        {
                            <i class="fas fa-flag-checkered"></i> <span>TERMINAR DÍA</span>
                        }
                    </button>
                }
                else
                {
                    <div class="success-banner slide-up mt-4">
                        <i class="fas fa-check-circle"></i> ¡DÍA COMPLETADO!
                    </div>
                }
            }
            
            @* Espacio extra para asegurar que el scroll pase el timer flotante *@
            <div style="height: 40px;"></div>
        </div>

        @* TIMER FLOTANTE MANUAL *@
        <div class="floating-timer-container slide-up">
            <div class="timer-controls">
                <div class="timer-input-group">
                    <button class="btn-timer-adj" @onclick="() => AjustarTiempo(-10)"><i class="fas fa-minus"></i></button>

                    <div class="timer-display-wrapper">
                        <span class="timer-legend-mini">PROGRAMA TU DESCANSO</span>
                        <div class="timer-display">
                            @if (timerCorriendo)
                            {
                                <span class="time-text text-theme-primary">@tiempoRestanteFormateado</span>
                            }
                            else
                            {
                                <input type="number" class="input-segs" @bind="segundosDescansoDefecto" />
                                <span class="segs-label">SEGS</span>
                            }
                        </div>
                    </div>

                    <button class="btn-timer-adj" @onclick="() => AjustarTiempo(10)"><i class="fas fa-plus"></i></button>
                </div>

                <div class="timer-action">
                    @if (timerCorriendo)
                    {
                        <button class="btn-play-stop stop" @onclick="DetenerTimer"><i class="fas fa-stop"></i></button>
                    }
                    else
                    {
                        <button class="btn-play-stop play" @onclick="IniciarTimer"><i class="fas fa-play"></i></button>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    /* --- ESTRUCTURA BASE Y NAVBAR --- */
    .main-layout { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--theme-bg); display: flex; flex-direction: column; z-index: 1; }
    .navbar-container { flex-shrink: 0; padding-top: calc(env(safe-area-inset-top) + 10px); padding-bottom: 10px; padding-left: 20px; padding-right: 20px; background-color: var(--theme-bg); border-bottom: 1px solid var(--theme-primary); color: var(--theme-text); display: flex; justify-content: space-between; align-items: center; z-index: 100; font-family: 'Oswald'; min-height: 60px; box-shadow: 0 4px 10px rgba(0,0,0,0.5); }
    .nav-left { color: var(--theme-primary); font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 5px; font-size: 0.9rem; white-space: nowrap; z-index: 10; }
    .nav-center { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; }
    .nav-title-main { font-weight: bold; font-size: 1.2rem; color: var(--theme-text); letter-spacing: 1px; }
    .nav-right { min-width: 60px; }
    
    /* Aumentamos el padding-bottom a 120px para que el botón TERMINAR DÍA nunca quede escondido por el timer */
    .scrollable-content { flex-grow: 1; overflow-y: auto; padding: 20px; padding-bottom: 120px; display: flex; flex-direction: column; align-items: center; -webkit-overflow-scrolling: touch; }

    /* --- TARJETA DE DETALLE --- */
    .routine-card { width: 100%; max-width: 600px; background: var(--theme-card); border: 1px solid var(--theme-border); border-radius: 15px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    
    .rc-header { background: linear-gradient(to right, var(--theme-bg), rgba(255,255,255,0.05)); padding: 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--theme-border); }
    .rc-date { display: flex; flex-direction: column; }
    .rc-day { font-family: 'Oswald'; color: var(--theme-primary); font-size: 1.5rem; line-height: 1; letter-spacing: 1px; }
    .rc-num { font-family: 'Roboto'; color: var(--theme-text-muted); font-size: 0.9rem; font-weight: bold; margin-top: 4px; }
    .rc-coach { background: rgba(0,0,0,0.3); border: 1px solid var(--theme-border); padding: 6px 12px; border-radius: 20px; color: var(--theme-text-muted); font-size: 0.8rem; display: flex; align-items: center; gap: 8px; }

    .rc-body { padding: 25px; }
    .rc-body p { white-space: pre-wrap; font-family: 'Roboto'; color: var(--theme-text); font-size: 1.05rem; line-height: 1.6; margin: 0; }

    /* --- BOTÓN Y BANNERS --- */
    .btn-terminar { width: 100%; max-width: 600px; background: #28a745; color: white; border: none; padding: 20px; border-radius: 15px; font-family: 'Oswald'; font-weight: bold; font-size: 1.2rem; letter-spacing: 2px; box-shadow: 0 8px 25px rgba(40,167,69,0.3); display: flex; justify-content: center; align-items: center; gap: 10px; cursor: pointer; transition: 0.2s; }
    .btn-terminar:active { transform: scale(0.97); }
    .btn-terminar:disabled { opacity: 0.7; pointer-events: none; }

    .success-banner { width: 100%; max-width: 600px; background: rgba(40,167,69,0.1); border: 2px dashed #28a745; color: #28a745; padding: 20px; border-radius: 15px; text-align: center; font-family: 'Oswald'; font-weight: bold; font-size: 1.2rem; letter-spacing: 1px; }

    /* --- TIMER FLOTANTE CSS --- */
    .floating-timer-container { position: fixed; bottom: 0; left: 0; right: 0; background: var(--theme-card); border-top: 2px solid var(--theme-border); padding: 15px 20px; padding-bottom: calc(env(safe-area-inset-bottom) + 15px); z-index: 1000; box-shadow: 0 -10px 30px rgba(0,0,0,0.9); box-sizing: border-box; width: 100%; }
    .timer-controls { display: flex; justify-content: space-between; align-items: center; gap: 8px; width: 100%; max-width: 600px; margin: 0 auto; box-sizing: border-box; }
    .timer-input-group { flex: 1; display: flex; align-items: center; justify-content: space-between; background: var(--theme-bg); padding: 5px 8px; border-radius: 25px; border: 1px solid var(--theme-border); min-width: 0; }
    .btn-timer-adj { width: 40px; height: 40px; border-radius: 50%; background: var(--theme-card); color: var(--theme-text); border: none; font-size: .9rem; display: flex; justify-content: center; align-items: center; flex-shrink: 0; }
    .timer-display-wrapper { display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .timer-legend-mini { color: var(--theme-text-muted); font-size: 0.65rem; font-weight: bold; letter-spacing: 1px; margin-bottom: -2px; }
    .timer-display { display: flex; align-items: baseline; justify-content: center; gap: 5px; }
    .input-segs { width: 40px; background: transparent; border: none; color: var(--theme-text); font-family: 'Oswald'; font-size: 2rem; font-weight: bold; text-align: center; outline: none; padding: 0; }
    .segs-label { color: var(--theme-text-muted); font-size: 0.85rem; font-weight: bold; }
    .time-text { font-family: 'Oswald'; font-size: 2rem; font-weight: bold; letter-spacing: 2px; line-height: 1; }
    .timer-action { flex-shrink: 0; }
    .btn-play-stop { width: 50px; height: 50px; border-radius: 50%; border: none; display: flex; justify-content: center; align-items: center; font-size: 1.6rem; color: var(--theme-bg); transition: 0.2s; }
    .btn-play-stop.play { background: var(--theme-primary); box-shadow: 0 0 15px rgba(0, 0, 0, 0.4); }
    .btn-play-stop.stop { background: #ff4d4d; color: white; box-shadow: 0 0 15px rgba(255, 77, 77, 0.4); }
    .btn-play-stop:active { transform: scale(0.9); }

    /* ANIMACIONES */
    .fade-in { animation: fadeIn 0.4s ease; }
    .slide-up { animation: slideUp 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) backwards; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    private string EstilosTema = @"--theme-primary: #A9A9A9; --theme-secondary: #808080; --theme-bg: #0d0d0d; --theme-card: #1a1a1a; --theme-border: #333333; --theme-text: #ffffff; --theme-text-muted: #888888;";
    
    [Parameter] public int RutinaID { get; set; }
    
    private bool cargando = true;
    private bool guardando = false;

    // --- VARIABLES DEL TIMER ---
    private int segundosDescansoDefecto = 90;
    private bool timerCorriendo = false;
    private DateTime horaFinTimer;
    private string tiempoRestanteFormateado = "00:00";
    private int timerNotificacionId = 1001; // ID distinto para no chocar con otros timers

    public class RutinaAdminDto { 
        public int RutinaID { get; set; }
        public DateTime Fecha { get; set; } 
        public string Descripcion { get; set; } 
        public string CoachNombre { get; set; } 
        public bool Completada { get; set; }
    }
    
    private RutinaAdminDto rutina;

    protected override async Task OnInitializedAsync()
    {
        try { var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box"); if (!string.IsNullOrEmpty(cache)) { EstilosTema = cache; StateHasChanged(); } } catch { }
        if (Sesion.Usuario == null) { Nav.NavigateTo("/"); return; }

        await CargarDetalle();
    }

    private async Task CargarDetalle()
    {
        try
        {
            string url = $"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/rutinasapi/obtener-por-id/{RutinaID}";
            rutina = await Http.GetFromJsonAsync<RutinaAdminDto>(url);
        }
        catch { rutina = null; }
        finally { cargando = false; }
    }

    private async Task TerminarDia()
    {
        guardando = true;
        DetenerTimer(); // Si estaba corriendo, lo paramos por seguridad.
        try
        {
            var r = await Http.PostAsync($"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/rutinasapi/terminar-dia/{RutinaID}", null);
            if (r.IsSuccessStatusCode)
            {
                rutina.Completada = true;
                await App.Current.MainPage.DisplayAlert("¡Felicidades!", "Entrenamiento registrado y asistencia contada.", "OK");
                Volver();
            }
        }
        catch { }
        finally { guardando = false; }
    }

    // ===============================================
    // LÓGICA DEL TIMER MANUAL E INMUNE A BLOQUEOS
    // ===============================================
    private void AjustarTiempo(int segs)
    {
        if (timerCorriendo) return;
        segundosDescansoDefecto += segs;
        if (segundosDescansoDefecto < 10) segundosDescansoDefecto = 10;
        if (segundosDescansoDefecto > 600) segundosDescansoDefecto = 600;
    }

    private async Task IniciarTimer()
    {
        if (segundosDescansoDefecto <= 0) return;

        try { await JS.InvokeVoidAsync("unlockAudio"); } catch { }

        timerCorriendo = true;
        horaFinTimer = DateTime.Now.AddSeconds(segundosDescansoDefecto);

        try
        {
            if (DeviceInfo.Platform == DevicePlatform.Android || DeviceInfo.Platform == DevicePlatform.iOS)
            {
                var request = new NotificationRequest
                {
                    NotificationId = timerNotificacionId,
                    Title = "¡Tiempo de Descanso Terminado! ⏱️",
                    Description = "Es hora de volver a darle duro. ¡A la siguiente serie!",
                    ReturningData = "timer_terminado",
                    Schedule = new NotificationRequestSchedule { NotifyTime = horaFinTimer }
                };
                await LocalNotificationCenter.Current.Show(request);
            }
        }
        catch { }

        while (timerCorriendo)
        {
            var restante = horaFinTimer - DateTime.Now;
            if (restante.TotalSeconds <= 0) break;

            tiempoRestanteFormateado = $"{(int)restante.TotalMinutes:D2}:{restante.Seconds:D2}";
            StateHasChanged();
            await Task.Delay(500);
        }

        if (timerCorriendo)
        {
            tiempoRestanteFormateado = "00:00";
            timerCorriendo = false;
            StateHasChanged();

            try { await JS.InvokeVoidAsync("playTimerBeep"); } catch { }

            try
            {
                if (DeviceInfo.Platform == DevicePlatform.Android || DeviceInfo.Platform == DevicePlatform.iOS)
                {
                    Vibration.Default.Vibrate(TimeSpan.FromSeconds(1));
                }
            }
            catch { }
        }
    }

    private void DetenerTimer()
    {
        timerCorriendo = false;
        tiempoRestanteFormateado = "00:00";

        try
        {
            if (DeviceInfo.Platform == DevicePlatform.Android || DeviceInfo.Platform == DevicePlatform.iOS)
            {
                LocalNotificationCenter.Current.Cancel(timerNotificacionId);
            }
        }
        catch { }
    }

    private string NombreDia(DayOfWeek d) => d switch { DayOfWeek.Monday=>"LUNES", DayOfWeek.Tuesday=>"MARTES", DayOfWeek.Wednesday=>"MIÉRCOLES", DayOfWeek.Thursday=>"JUEVES", DayOfWeek.Friday=>"VIERNES", DayOfWeek.Saturday=>"SÁBADO", DayOfWeek.Sunday=>"DOMINGO", _=>"" };

    private void Volver() 
    {
        DetenerTimer(); // Siempre limpiamos el timer antes de salir
        Nav.NavigateTo("/rutina-cliente");
    }
}