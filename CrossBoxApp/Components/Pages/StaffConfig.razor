@page "/staff-config"
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@using System.Net.Http.Json
@inject HttpClient Http
@inject SesionService Sesion
@inject NavigationManager Nav
@inject IJSRuntime JS

@* ENVOLVEMOS TODA LA PÁGINA EN EL TEMA *@
<div style="@EstilosTema">

    <div class="main-layout">

        <div class="navbar-container">
            <div class="nav-left" @onclick="Volver">
                <i class="fas fa-arrow-left"></i> VOLVER
            </div>
            <div class="nav-title">GESTIÓN DE EQUIPO</div>
            <div class="nav-right"></div>
        </div>

        <div class="scrollable-content">
            
            <div class="header-section fade-in">
                <h3>TU STAFF</h3>
                <p style="color: var(--theme-text-muted);">Gestiona los permisos de tus entrenadores y encargados.</p>
            </div>

            @if (listaStaff == null)
            {
                <div class="text-center mt-5">
                    <div class="spinner-border" style="color: var(--theme-primary);"></div>
                </div>
            }
            else if (listaStaff.Count == 0)
            {
                <div class="empty-state fade-in">
                    <i class="fas fa-users-slash" style="font-size: 3rem; opacity: 0.3; margin-bottom: 15px; color: var(--theme-text-muted);"></i>
                    <p style="color: var(--theme-text-muted);">Aún no tienes equipo asignado.</p>
                </div>
            }
            else
            {
                <div class="staff-grid fade-in">
                    @foreach (var s in listaStaff)
                    {
                        <div class="staff-card">
                            <div class="card-info">
                                <div class="avatar-placeholder" style="border-color: var(--theme-primary); color: var(--theme-primary); background: var(--theme-bg);">
                                    @s.NombreCompleto.Substring(0, 1).ToUpper()
                                </div>
                                <div>
                                    <div class="staff-name">@s.NombreCompleto</div>
                                    <div class="staff-role" style="color: var(--theme-primary);">COACH / STAFF</div>
                                </div>
                            </div>

                            <div class="card-actions">
                                <button class="btn-permisos" style="border-color: var(--theme-primary); color: var(--theme-primary);" @onclick="() => AbrirPermisos(s)">
                                    <i class="fas fa-key"></i> PERMISOS
                                </button>

                                <button class="btn-remove" @onclick="() => DegradarStaff(s)">
                                    <i class="fas fa-user-minus"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            
            <div style="height: 100px;"></div>
        </div>

        <button class="btn-add-floating fade-in" style="background: var(--theme-primary); color: var(--theme-bg);" @onclick="AbrirModalCandidatos">
            <i class="fas fa-plus"></i> AGREGAR COACH
        </button>
    </div>

    @* --- MODAL PERMISOS --- *@
    @if (mostrarModalPermisos && staffSeleccionado != null)
    {
        <div class="modal-overlay fade-in">
            <div class="modal-content custom-modal slide-up" style="border-color: var(--theme-primary);">
                <div class="modal-header" style="background: var(--theme-card); border-bottom-color: var(--theme-border);">
                    <h5 style="margin:0; font-size:1rem; color: var(--theme-text);">PERMISOS: @staffSeleccionado.NombreCompleto.ToUpper()</h5>
                    <button class="btn-close-custom" @onclick="() => mostrarModalPermisos = false"><i class="fas fa-times"></i></button>
                </div>
                <div class="modal-body" style="background: var(--theme-bg);">
                    <p class="small mb-3" style="color: var(--theme-text-muted);">Activa las funciones que este Coach puede realizar.</p>

                    @foreach (var p in catalogoPermisos)
                    {
                        <div class="permiso-row" style="border-bottom-color: var(--theme-border);" @onclick="() => TogglePermiso(staffSeleccionado, p.Clave)">
                            <span class="permiso-desc" style="color: var(--theme-text);">@p.Descripcion</span>
                            <div class="switch-track @(TieneElPermiso(staffSeleccionado, p.Clave) ? "on" : "off")">
                                <div class="switch-thumb"></div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer" style="background: var(--theme-card); border-top-color: var(--theme-border);">
                    <button class="btn-confirm" style="background: var(--theme-primary); color: var(--theme-bg);" @onclick="() => mostrarModalPermisos = false">LISTO</button>
                </div>
            </div>
        </div>
    }

    @* --- MODAL CANDIDATOS --- *@
    @if (mostrarModalCandidatos)
    {
        <div class="modal-overlay fade-in">
            <div class="modal-content custom-modal slide-up" style="border-color: var(--theme-primary);">
                <div class="modal-header" style="background: var(--theme-card); border-bottom-color: var(--theme-border);">
                    <h5 style="margin:0; color:var(--theme-primary);">SELECCIONA UN ATLETA</h5>
                    <button class="btn-close-custom" @onclick="() => mostrarModalCandidatos = false"><i class="fas fa-times"></i></button>
                </div>

                <div class="modal-body scrollable-body" style="background: var(--theme-bg); max-height: 50vh; overflow-y: auto;">
                    @if (listaCandidatos.Count == 0)
                    {
                        <div class="text-center mt-4" style="color: var(--theme-text-muted);">No hay atletas disponibles para ascender.</div>
                    }
                    else
                    {
                        @foreach (var atleta in listaCandidatos)
                        {
                            <div class="candidate-row" style="border-bottom-color: var(--theme-border);">
                                <div class="candidate-name" style="color: var(--theme-text);">@atleta.NombreCompleto</div>
                                <button class="btn-promote" @onclick="() => AscenderAtleta(atleta)">
                                    ASCENDER <i class="fas fa-level-up-alt"></i>
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* --- ESTRUCTURA BASE --- */
    .main-layout { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--theme-bg); display: flex; flex-direction: column; z-index: 1; }
    .navbar-container { flex-shrink: 0; padding-top: calc(env(safe-area-inset-top) + 5px); padding-bottom: 10px; padding-left: 20px; padding-right: 20px; background-color: var(--theme-bg); border-bottom: 1px solid var(--theme-primary); color: var(--theme-text); display: flex; justify-content: space-between; align-items: center; z-index: 100; font-family: 'Oswald'; min-height: 60px; }
    .nav-left { color: var(--theme-primary); font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
    .nav-title { font-weight: bold; font-size: 1.1rem; color: var(--theme-text); letter-spacing: 1px; }
    .scrollable-content { flex-grow: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; align-items: center; -webkit-overflow-scrolling: touch; padding-bottom: 40px; }

    .header-section { text-align: center; width: 100%; max-width: 600px; margin-bottom: 20px; }
    .header-section h3 { font-family: 'Oswald'; color: var(--theme-primary); margin: 0; font-size: 1.5rem; }
    .staff-grid { width: 100%; max-width: 600px; display: flex; flex-direction: column; gap: 15px; }

    .staff-card { background: var(--theme-card); border: 1px solid var(--theme-border); border-radius: 10px; padding: 15px; display: flex; justify-content: space-between; align-items: center; }
    .card-info { display: flex; align-items: center; gap: 15px; }
    .avatar-placeholder { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-family: 'Oswald'; font-size: 1.2rem; border: 1px solid; }
    .staff-name { font-weight: bold; font-size: 1rem; color: var(--theme-text); font-family: 'Roboto'; }
    .staff-role { font-size: 0.7rem; letter-spacing: 1px; text-transform: uppercase; }

    .btn-permisos { background: transparent; border: 1px solid; padding: 5px 12px; border-radius: 20px; font-size: 0.7rem; font-weight: bold; cursor: pointer; transition: 0.2s; }
    .btn-permisos:active { background: var(--theme-primary); color: var(--theme-bg) !important; }
    .btn-remove { background: var(--theme-bg); border: none; color: #dc3545; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; }

    .btn-add-floating { position: absolute; bottom: 30px; right: 30px; border: none; padding: 15px 25px; border-radius: 30px; font-family: 'Oswald'; font-weight: bold; font-size: 1.1rem; box-shadow: 0 5px 20px rgba(0,0,0, 0.4); display: flex; align-items: center; gap: 10px; z-index: 200; transition: transform 0.2s; cursor: pointer; }
    .btn-add-floating:active { transform: scale(0.95); }

    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 3000; display: flex; justify-content: center; align-items: center; backdrop-filter: blur(4px); }
    .custom-modal { background: var(--theme-card); width: 90%; max-width: 400px; border: 1px solid; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 10px 40px rgba(0,0,0,0.8); }
    .modal-header { padding: 15px; display: flex; justify-content: space-between; align-items: center; }
    .modal-body { padding: 20px; }
    .modal-footer { padding: 15px; display: flex; justify-content: flex-end; }

    .btn-close-custom { background: none; border: none; color: var(--theme-text); font-size: 1.2rem; cursor: pointer; }
    .btn-confirm { width: 100%; border: none; padding: 12px; font-weight: bold; border-radius: 5px; font-family: 'Oswald'; cursor: pointer; }

    .permiso-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid; cursor: pointer; }
    .switch-track { width: 40px; height: 20px; border-radius: 10px; background: var(--theme-border); position: relative; transition: background 0.3s; }
    .switch-track.on { background: #28a745; }
    .switch-thumb { width: 16px; height: 16px; background: white; border-radius: 50%; position: absolute; top: 2px; left: 2px; transition: transform 0.3s; }
    .switch-track.on .switch-thumb { transform: translateX(20px); }

    .candidate-row { display: flex; justify-content: space-between; align-items: center; padding: 12px; border-bottom: 1px solid; }
    .btn-promote { background: #28a745; border: none; color: white; font-size: 0.7rem; padding: 5px 10px; border-radius: 5px; font-weight: bold; cursor: pointer; }

    .fade-in { animation: fadeIn 0.5s ease; }
    .slide-up { animation: slideUp 0.3s ease; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
</style>

@code {
    // --- ESTADO INICIAL NEUTRAL (PLATA MATE) ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    public class StaffDto
    {
        public Guid UsuarioID { get; set; }
        public string NombreCompleto { get; set; }
        public string Email { get; set; }
        public List<string> PermisosActivos { get; set; } = new List<string>();
    }
    public class PermisoCatalogo { public string Clave { get; set; } public string Descripcion { get; set; } }
    public class AsignarPermisoDto { public Guid UsuarioID { get; set; } public string ClavePermiso { get; set; } public bool Activo { get; set; } }

    private List<StaffDto> listaStaff = new List<StaffDto>();
    private List<StaffDto> listaCandidatos = new List<StaffDto>();
    private StaffDto staffSeleccionado;

    private bool mostrarModalPermisos = false;
    private bool mostrarModalCandidatos = false;

    private List<PermisoCatalogo> catalogoPermisos = new List<PermisoCatalogo>
    {
        new PermisoCatalogo { Clave = "MANAGE_WOD", Descripcion = "Crear y Editar WODs" },
        new PermisoCatalogo { Clave = "MANAGE_USERS", Descripcion = "Aceptar y Gestionar Atletas" },
        new PermisoCatalogo { Clave = "MANAGE_PAYMENTS", Descripcion = "Ver y Registrar Pagos" },
        new PermisoCatalogo { Clave = "MANAGE_AVISOS", Descripcion = "Publicar Avisos Generales" },
        new PermisoCatalogo { Clave = "DELETE_DATA", Descripcion = "Eliminar Registros (Peligroso)" }
    };

    protected override async Task OnInitializedAsync()
    {
        // LEER EL CACHÉ LOCAL AL INSTANTE
        try 
        {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) 
            { 
                EstilosTema = cache; 
                StateHasChanged(); 
            }
        } 
        catch { }

        await CargarStaff();
    }

    private async Task CargarStaff()
    {
        try
        {
            listaStaff = await Http.GetFromJsonAsync<List<StaffDto>>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/staffapi/lista/{Sesion.Usuario.BoxID}");
        }
        catch { }
    }

    private async Task CargarCandidatos()
    {
        try
        {
            listaCandidatos = await Http.GetFromJsonAsync<List<StaffDto>>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/staffapi/candidatos/{Sesion.Usuario.BoxID}");
        }
        catch { listaCandidatos = new List<StaffDto>(); }
    }

    private async Task AscenderAtleta(StaffDto atleta)
    {
        bool confirm = await App.Current.MainPage.DisplayAlert("Confirmar", $"¿Ascender a {atleta.NombreCompleto} a Coach?", "Sí", "Cancelar");
        if (!confirm) return;

        try
        {
            var resp = await Http.PostAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/staffapi/ascender/{atleta.UsuarioID}", null);
            if (resp.IsSuccessStatusCode)
            {
                await App.Current.MainPage.DisplayAlert("¡Listo!", "Nuevo miembro del equipo agregado.", "OK");
                mostrarModalCandidatos = false;
                await CargarStaff(); 
            }
        }
        catch { await App.Current.MainPage.DisplayAlert("Error", "No se pudo realizar la acción.", "OK"); }
    }

    private async Task DegradarStaff(StaffDto staff)
    {
        bool confirm = await App.Current.MainPage.DisplayAlert("Degradar", $"¿Quitar privilegios de Staff a {staff.NombreCompleto}? Volverá a ser atleta.", "Sí", "Cancelar");
        if (!confirm) return;

        try
        {
            var resp = await Http.PostAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/staffapi/degradar/{staff.UsuarioID}", null);
            if (resp.IsSuccessStatusCode)
            {
                await CargarStaff();
            }
        }
        catch { }
    }

    private void AbrirPermisos(StaffDto staff)
    {
        staffSeleccionado = staff;
        mostrarModalPermisos = true;
    }

    private bool TieneElPermiso(StaffDto s, string clave)
    {
        if (s.PermisosActivos == null) return false;
        return s.PermisosActivos.Contains(clave);
    }

    private async Task TogglePermiso(StaffDto staff, string clave)
    {
        bool tieneActualmente = TieneElPermiso(staff, clave);
        bool nuevoEstado = !tieneActualmente;

        if (staff.PermisosActivos == null) staff.PermisosActivos = new List<string>();
        if (nuevoEstado) staff.PermisosActivos.Add(clave);
        else staff.PermisosActivos.Remove(clave);

        try
        {
            var req = new AsignarPermisoDto { UsuarioID = staff.UsuarioID, ClavePermiso = clave, Activo = nuevoEstado };
            await Http.PostAsJsonAsync("https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/staffapi/permiso", req);
        }
        catch { }
    }

    private async Task AbrirModalCandidatos()
    {
        await CargarCandidatos();
        mostrarModalCandidatos = true;
    }

    private void Volver() => Nav.NavigateTo("/home");
}