    private async Task GuardarWodEditado()
    {
        if (listaBloquesEditor.Count == 0)
        {
            await App.Current.MainPage.DisplayAlert("Alto", "No puedes dejar el WOD vacío. Debe tener al menos un bloque.", "Entendido");
            return;
        }

        if (!modoTextoLibre && listaBloquesEditor.Any(b => b.SegmentoClaseID == Guid.Empty))
        {
            await App.Current.MainPage.DisplayAlert("Faltan datos", "Selecciona el TIPO DE SEGMENTO en todos los bloques.", "Entendido");
            return;
        }

        var wodPayload = new
        {
            BoxID = Sesion.Usuario.BoxID,
            FechaProgramacion = wodHoy.FechaProgramacion, 
            Bloques = new List<object>()
        };

        foreach (var bEdit in listaBloquesEditor)
        {
            var infoSegmento = listaSegmentos?.FirstOrDefault(s => s.Id == bEdit.SegmentoClaseID);
            string nombreSeg = infoSegmento != null ? infoSegmento.Nombre : "un bloque";

            var bloqueApi = new
            {
                SegmentoClaseID = bEdit.SegmentoClaseID,
                NombreSegmento = nombreSeg,
                TiempoFormato = bEdit.TiempoFormato ?? "",
                EsTextoLibre = modoTextoLibre,
                Ejercicios = new List<object>()
            };

            if (modoTextoLibre)
            {
                if (string.IsNullOrWhiteSpace(bEdit.TextoLibre)) continue;
                bloqueApi.Ejercicios.Add(new { PesoRepeticiones = "", Descripcion = bEdit.TextoLibre });
            }
            else
            {
                foreach (var ejEdit in bEdit.Ejercicios)
                {
                    bool tieneReps = !string.IsNullOrWhiteSpace(ejEdit.Reps);
                    bool tieneNombre = !string.IsNullOrWhiteSpace(ejEdit.NombreBase);

                    if (!tieneReps && !tieneNombre) continue;
                    if (tieneReps && !tieneNombre) { await App.Current.MainPage.DisplayAlert("Error", $"En '{nombreSeg}', pusiste repeticiones pero falta el nombre del ejercicio.", "Corregir"); return; }
                    if (!tieneReps && tieneNombre) { await App.Current.MainPage.DisplayAlert("Error", $"En '{nombreSeg}', falta poner las repeticiones.", "Corregir"); return; }

                    string descFinal = ejEdit.NombreBase;
                    if (ejEdit.TienePesos) descFinal += $" ({ejEdit.PesoH}/{ejEdit.PesoM})";

                    bloqueApi.Ejercicios.Add(new { PesoRepeticiones = ejEdit.Reps, Descripcion = descFinal });
                }
            }

            if (bloqueApi.Ejercicios.Count == 0)
            {
                await App.Current.MainPage.DisplayAlert("Bloque Vacío", $"Tienes un bloque vacío, agrégale información o elimínalo.", "Entendido");
                return;
            }

            wodPayload.Bloques.Add(bloqueApi);
        }

        cargandoOperacionWod = true;
        StateHasChanged();

        try
        {
            var r = await Http.PostAsJsonAsync("https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/wodapi/guardar", wodPayload);

            if (r.IsSuccessStatusCode)
            {
                mostrarModalWodEdicion = false;
                await CargarWodHoy();
                await App.Current.MainPage.DisplayAlert("Actualizado", "El WOD se actualizó en pantalla.", "OK");
            }
            else
            {
                var errorMsg = await r.Content.ReadAsStringAsync();
                await App.Current.MainPage.DisplayAlert("Error", "No se pudo guardar: " + errorMsg, "OK");
            }
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error de Conexión", ex.Message, "OK");
        }
        finally
        {
            cargandoOperacionWod = false;
            StateHasChanged();
        }
    }


    public async ValueTask DisposeAsync()
