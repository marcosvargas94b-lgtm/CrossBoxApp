@* --- SCRIPT PARA EL ZOOM Y PAN (MANIPULACIÓN TÁCTIL) --- *@
<script>
    // Variables globales para el estado del zoom
    let wodScale = 1;
    let wodPanning = false;
    let wodPointX = 0;
    let wodPointY = 0;
    let wodStartClientX = 0;
    let wodStartClientY = 0;
    let wodStartScale = 1;

    // Distancia inicial para el pinch
    let initialPinchDistance = null;

    // Referencia al elemento
    function getWodElement() {
        return document.getElementById('wod-zoom-target');
    }

    function setTransform() {
        const el = getWodElement();
        if(el) {
            el.style.transform = `translate(${wodPointX}px, ${wodPointY}px) scale(${wodScale})`;
        }
    }

    // Función invocada desde C# para resetear
    window.resetWodZoom = function() {
        wodScale = 1;
        wodPointX = 0;
        wodPointY = 0;
        setTransform();
    }

    // Eventos táctiles
    document.addEventListener('touchstart', function(e) {
        const wodPanel = e.target.closest('.wod-panel');
        if (!wodPanel) return;

        const lockBtn = wodPanel.querySelector('.btn-zoom-float.unlocked');
        if (!lockBtn) return; 

        if(e.touches.length > 1 || wodScale > 1) {
             // e.preventDefault(); 
        }

        if (e.touches.length === 1) {
            wodPanning = true;
            wodStartClientX = e.touches[0].clientX;
            wodStartClientY = e.touches[0].clientY;
        } else if (e.touches.length === 2) {
            initialPinchDistance = getDistance(e.touches);
            wodStartScale = wodScale;
        }
    }, { passive: false });

    document.addEventListener('touchmove', function(e) {
        const wodPanel = e.target.closest('.wod-panel');
        if (!wodPanel) return;
        const lockBtn = wodPanel.querySelector('.btn-zoom-float.unlocked');
        if (!lockBtn) return;

        if (wodPanning && e.touches.length === 1) {
            e.preventDefault(); 
            const newX = e.touches[0].clientX;
            const newY = e.touches[0].clientY;
            
            wodPointX += (newX - wodStartClientX);
            wodPointY += (newY - wodStartClientY);
            
            wodStartClientX = newX;
            wodStartClientY = newY;
            
            setTransform();
        } else if (e.touches.length === 2 && initialPinchDistance) {
            e.preventDefault();
            const currentDistance = getDistance(e.touches);
            const pinchScale = currentDistance / initialPinchDistance;
            
            const newScale = wodStartScale * pinchScale;
            if(newScale > 0.5 && newScale < 3) {
                wodScale = newScale;
                setTransform();
            }
        }
    }, { passive: false });

    document.addEventListener('touchend', function(e) {
        wodPanning = false;
        if (e.touches.length < 2) {
            initialPinchDistance = null;
        }
    });

    function getDistance(touches) {
        return Math.hypot(
            touches[0].pageX - touches[1].pageX,
            touches[0].pageY - touches[1].pageY
        );
    }
</script>