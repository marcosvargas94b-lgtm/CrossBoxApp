@page "/live-dashboard"
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@using Microsoft.AspNetCore.SignalR.Client
@using static CrossBoxApp.Components.Pages.LiveLobby
@using Plugin.Maui.Audio
@inject LiveSessionState LiveState
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS
@inject IAudioManager AudioManager
@implements IAsyncDisposable

@* ENVOLVEMOS TODA LA PÁGINA EN EL TEMA *@
<div style="@EstilosTema">

    @* --- AVISO DE GIRO PARA MÓVIL --- *@
    <div class="rotate-warning">
        <div class="phone-animation">
            <i class="fas fa-mobile-alt"></i>
        </div>
        <h3>MODO DASHBOARD</h3>
        <p>Para controlar la clase, gira tu teléfono en horizontal.</p>
    </div>

    <div class="dashboard-container @(wodExpandido ? "wod-wide" : "")">

        @* --- PANEL 1: TIMER (CON OPCIÓN EMOM AGREGADA) --- *@
        <div class="panel timer-panel @(verTimer ? "" : "collapsed")">
            @if (verTimer)
            {
                <div class="panel-header">
                    <div class="header-left">
                        <span><i class="fas fa-stopwatch"></i> TIMER</span>
                        @if (timerCorriendo || tiempoTranscurrido > 0)
                        {
                            <span class="header-timer-secondary fade-in">
                                @if (tipoTimer == 3) { <span>EMOM @rondaActual/@totalRondas</span> }
                                else { @FormatoTiempo(tiempoTranscurrido) }
                            </span>
                        }
                        @if (!timerCorriendo)
                        {
                            <button class="btn-icon-header ml-2" @onclick="() => modoConfiguracion = !modoConfiguracion"><i class="fas fa-cog"></i></button>
                        }
                    </div>
                    <button class="btn-icon-header" @onclick="() => verTimer = false"><i class="fas fa-compress-arrows-alt"></i></button>
                </div>

                <div class="panel-content flex-column-layout">
                    @if (modoConfiguracion && !timerCorriendo)
                    {
                        <div class="config-box slide-in">
                            @* --- SELECCION DE TIPO CON EMOM AGREGADO --- *@
                            <div class="timer-type-selector">
                                <button class="type-btn @(tipoTimer == 1 ? "active" : "")" @onclick="() => CambiarTipoTimer(1)">
                                    <i class="fas fa-hourglass-start"></i> CUENTA ATRÁS
                                </button>
                                <button class="type-btn @(tipoTimer == 2 ? "active" : "")" @onclick="() => CambiarTipoTimer(2)">
                                    <i class="fas fa-sync-alt"></i> INTERVALOS
                                </button>
                                <button class="type-btn @(tipoTimer == 3 ? "active" : "")" @onclick="() => CambiarTipoTimer(3)">
                                    <i class="fas fa-redo"></i> EMOM
                                </button>
                            </div>

                            <div class="inputs-grid">
                                <div class="input-group">
                                    <label>TIEMPO TRABAJO @(tipoTimer == 3 ? "(MINUTO)" : "")</label>
                                    <div class="time-inputs">
                                        <input type="number" @bind="inputMinutos" placeholder="00" />
                                        <span class="colon">:</span>
                                        <input type="number" @bind="inputSegundos" placeholder="00" />
                                    </div>
                                </div>
                                
                                @if (tipoTimer == 2 || tipoTimer == 3)
                                {
                                    <div class="inputs-row">
                                        <div class="input-group">
                                            <label>@(tipoTimer == 3 ? "MINUTOS (RONDAS)" : "RONDAS")</label>
                                            <input type="number" @bind="inputRondas" class="single-input" />
                                        </div>
                                        
                                        @* Ocultamos descanso si es EMOM *@
                                        @if (tipoTimer == 2)
                                        {
                                            <div class="input-group">
                                                <label>DESCANSO</label>
                                                <div class="time-inputs">
                                                    <input type="number" @bind="inputMinDescanso" placeholder="00" />
                                                    <span class="colon">:</span>
                                                    <input type="number" @bind="inputSegDescanso" placeholder="00" />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <button class="btn-save-timer" @onclick="GuardarConfiguracion">
                                <i class="fas fa-check"></i> LISTO
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="timer-visual-group">
                            @if (enConteoPrevio)
                            {
                                <div class="prep-display pulse-animation">
                                    <div class="prep-label">PREPARADOS</div>
                                    <div class="prep-number">@tiempoPrevio</div>
                                </div>
                            }
                            else
                            {
                                <div class="status-badge @(enDescanso ? "rest" : "work")">
                                    @if(tipoTimer == 3) { <span>EMOM</span> }
                                    else { @(enDescanso ? "DESCANSO" : "WORK") }
                                </div>
                                
                                <div class="timer-display @(timerCorriendo ? (enDescanso ? "resting" : "running") : "")">
                                    @FormatoTiempo(tiempoRestanteActual)
                                </div>
                                
                                @if (totalRondas > 1)
                                {
                                    <div class="round-counter @(rondaActual == totalRondas ? "last-round-alert" : "")">
                                        RONDA <span class="big-round">@rondaActual</span> / @totalRondas
                                    </div>
                                }
                            }
                        </div>

                        <div class="timer-controls-bottom">
                            @if (!timerCorriendo)
                            {
                                <button class="btn-control-rect start" @onclick="IniciarSecuencia">
                                    <i class="fas fa-play"></i> INICIAR
                                </button>
                            }
                            else
                            {
                                <button class="btn-control-rect stop" @onclick="PausarTimer">
                                    <i class="fas fa-pause"></i> PAUSAR
                                </button>
                            }
                            <button class="btn-control-rect reset" @onclick="ResetTimer">
                                <i class="fas fa-undo"></i> RESET
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="vertical-bar" @onclick="() => verTimer = true"><span class="v-text">TIMER</span><i class="fas fa-stopwatch v-icon"></i></div>
            }
        </div>

        @* --- PANEL 2: WOD (RECUPERADO SLIDER DE LETRA + NUEVO ZOOM) --- *@
        <div class="panel wod-panel @(verWod ? "" : "collapsed")">
            @if (verWod)
            {
                <div class="panel-header">
                    @if (wodHoy != null && wodHoy.Bloques != null && wodHoy.Bloques.Count > 0)
                    {
                        <div class="header-select-wrapper" style="flex: 1; min-width: 0; margin-right: 10px;">
                            <i class="fas fa-layer-group select-icon"></i>
                            <select class="header-select" @onchange="CambiarBloqueVisible" style="text-overflow: ellipsis;">
                                <option value="-1" selected="@(bloqueSeleccionadoIndex == -1)">WOD COMPLETO</option>
                                @for (int i = 0; i < wodHoy.Bloques.Count; i++)
                                {
                                    var b = wodHoy.Bloques[i];
                                    <option value="@i" selected="@(i == bloqueSeleccionadoIndex)">
                                        @(b.EsTextoLibre
                                                                        ? (string.IsNullOrEmpty(b.TiempoFormato) ? "WOD" : b.TiempoFormato.ToUpper())
                                                                        : (string.IsNullOrEmpty(b.NombreSegmento) ? "BLOQUE" : b.NombreSegmento.ToUpper()))
                    </option>
                                        }
                            </select>
                            <i class="fas fa-chevron-down select-arrow"></i>
                        </div>
                    }
                    else
                    {
                        <span style="flex:1;">WOD</span>
                    }

                    <div style="display:flex; gap:10px; align-items:center; position:relative; flex-shrink: 0;">
                        
                        @* --- AQUÍ ESTÁ EL SLIDER QUE RECUPERAMOS --- *@
                        <button class="btn-icon-header" @onclick="() => mostrarSliderLetra = !mostrarSliderLetra" title="Tamaño de letra">
                            <i class="fas fa-text-height"></i>
                        </button>
                        @if (mostrarSliderLetra)
                        {
                            <div class="font-settings-popover fade-in" style="right: 0; top: 100%;">
                                <i class="fas fa-font" style="font-size: 0.7rem;"></i>
                                <input type="range" min="0.8" max="1.6" step="0.1" @bind="wodFontSize" @bind:event="oninput" />
                                <i class="fas fa-font" style="font-size: 1rem;"></i>
                            </div>
                        }
                        @* ------------------------------------------- *@

                        <button class="btn-icon-header" @onclick="ToggleExpandirWod">
                            <i class="fas @(wodExpandido ? "fa-compress" : "fa-expand")"></i>
                        </button>
                        <button class="btn-icon-header" @onclick="() => verWod = false">
                            <i class="fas fa-compress-arrows-alt"></i>
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(UrlLogoBox))
                {
                    <div class="wod-watermark" style="background-image: url('@UrlLogoBox');"></div>
                }

                @* --- CONTENEDOR DEL WOD CON ZOOM --- *@
                <div class="panel-content scroll-custom" style="position: relative; overflow-y: @(wodBloqueado ? "auto" : "hidden");">
                    
                    @* Este div "wod-zoom-target" es el que se moverá y escalará con JS 
                        Y TAMBIÉN aplica el tamaño de letra del Slider *@
                    <div id="wod-zoom-target" class="bloques-container" style="transform-origin: 0 0; width: 100%; font-size: @(wodFontSize)rem;">
                        @if (wodHoy != null && wodHoy.Bloques != null && wodHoy.Bloques.Count > 0)
                        {
                            @for (int i = 0; i < wodHoy.Bloques.Count; i++)
                            {
                                var bloque = wodHoy.Bloques[i];

                                @if (bloqueSeleccionadoIndex == -1 || i == bloqueSeleccionadoIndex)
                                {
                                    <div class="wod-block fade-in">
                                        <h4 class="block-title">
                                            @(bloque.EsTextoLibre
                                                                            ? (string.IsNullOrEmpty(bloque.TiempoFormato) ? "RUTINA" : bloque.TiempoFormato.ToUpper())
                                                                            : (string.IsNullOrEmpty(bloque.NombreSegmento) ? "BLOQUE" : bloque.NombreSegmento.ToUpper()))
                                         </h4>

                                     @if (bloque.Ejercicios != null)
                                        {
                                            <div class="exercises-wrapper">
                                                @if (bloque.EsTextoLibre)
                                                {
                                                    @* MODO TEXTO LIBRE: Cortamos por cada "Enter" y dibujamos las filas *@
                                                    var textoCompleto = bloque.Ejercicios.FirstOrDefault()?.Descripcion ?? "";
                                                    var lineas = textoCompleto.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);

                                                    foreach (var linea in lineas)
                                                    {
                                                        <div class="ejercicio-row-clean">
                                                            <span class="ej-reps" style="color: var(--theme-text-muted); font-size: 0.9em;"><i class="fas fa-angle-right"></i></span>
                                                            <div class="ej-nombre">@linea</div>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    @* MODO TRADICIONAL: Bloques, reps y pesos *@
                                                    @foreach (var ej in bloque.Ejercicios)
                                                    {
                                                        <div class="ejercicio-row-clean">
                                                            <span class="ej-reps">@ej.PesoRepeticiones</span>
                                                            <div class="ej-nombre">
                                                                @((MarkupString)FormatearPesoPlateado(ej.Descripcion))
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="empty-state"><i class="fas fa-dumbbell"></i><p>@mensajeWod</p></div>
                        }
                    </div>

                    @* --- BOTONES FLOTANTES DE CONTROL DE ZOOM Y EDICIÓN --- *@
                    <div class="wod-zoom-controls">
                        <button class="btn-zoom-float" style="background-color: var(--theme-primary); border: none; color: var(--theme-bg);" @onclick="AbrirModalEdicionWod" title="Editar WOD">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn-zoom-float @(wodBloqueado ? "locked" : "unlocked")" @onclick="ToggleCandadoWod">
                            <i class="fas @(wodBloqueado ? "fa-lock" : "fa-lock-open")"></i>
                        </button>
                    </div>

                </div>
            }
            else
            {
                <div class="vertical-bar" @onclick="() => verWod = true"><span class="v-text">WORKOUT</span></div>
            }
        </div>

        @* --- PANEL 3: LISTA ATLETAS (INTACTO) --- *@
        <div class="panel list-panel @(verLista ? "" : "collapsed")">
            @if (verLista)
            {
                <div class="panel-header">
                    <span>CLASE</span>
                    <div style="display:flex; gap:10px; align-items:center;">
                        @if (Sesion.Usuario?.TipoLugar == "Crossfit")
                        {
                            <label class="switch-juez" title="Modo Juez (Capturar Tiempos)">
                                <input type="checkbox" @bind="modoJuez">
                                <span class="slider-juez round"></span>
                            </label>
                            @if (modoJuez)
                            {
                                <button class="btn-icon-header" style="color: var(--theme-primary);" @onclick="AbrirModalEquipos" title="Armar Equipos">
                                    <i class="fas fa-users-cog"></i>
                                </button>
                            }
                        }
                        <button class="btn-icon-header" @onclick="AbrirModalAtletas"><i class="fas fa-user-plus"></i></button>
                        <button class="btn-icon-header" @onclick="() => verLista = false"><i class="fas fa-compress-arrows-alt"></i></button>
                    </div>
                </div>

                <div class="panel-content scroll-custom">
                    @if (participantesVisuales != null && participantesVisuales.Count > 0)
                    {
                        <div class="atletas-grid">
                            @foreach (var p in participantesVisuales)
                            {
                                <div class="atleta-card slide-in @(p.Finalizado ? "card-finished" : "") @(p.Atletas.Count > 1 ? "card-team" : "")"
                                     @onclick="() => CapturarTiempo(p)">

                                    <div class="delete-badge" @onclick:stopPropagation="true" @onclick="() => SolicitarEliminar(p)">
                                        <i class="fas fa-times"></i>
                                    </div>

                                    <div class="card-inner-content">
                                        @if (p.Atletas.Count > 1)
                                        {
                                            <div class="team-avatars">
                                                @foreach (var a in p.Atletas)
                                                {
                                                    <div class="avatar-mini-team" style="@(!string.IsNullOrEmpty(a.FotoUrl) ? $"background-image: url('{a.FotoUrl}');" : "")">
                                                        @if (string.IsNullOrEmpty(a.FotoUrl))
                                                        {
                                                            @a.NombreCompleto.Substring(0, 1).ToUpper()
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <div class="name team-name">@(string.IsNullOrEmpty(p.NombreEquipo) ? "EQUIPO" : p.NombreEquipo)</div>
                                        }
                                        else
                                        {
                                            var atleta = p.Atletas.FirstOrDefault();
                                            <div class="avatar" style="@(!string.IsNullOrEmpty(atleta?.FotoUrl) ? $"background-image: url('{atleta.FotoUrl}'); background-size:cover; border:none;" : "")">
                                                @if (string.IsNullOrEmpty(atleta?.FotoUrl))
                                                {
                                                    @atleta?.NombreCompleto.Substring(0, 1).ToUpper()
                                                }
                                            </div>
                                            <div class="name">@atleta?.NombreCompleto</div>
                                        }

                                        @if (p.Finalizado)
                                        {
                                            <div class="badge-time">@p.TiempoFinal</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state"><i class="fas fa-users"></i><p>Esperando...</p></div>
                    }
                </div>

                <div class="bottom-actions-row">
                    <button class="btn-action-home" @onclick="IrAlHome" title="Salir al Inicio">
                        <i class="fas fa-home"></i>
                    </button>
                    <button class="btn-action-finish" @onclick="IrAResumen">
                        TERMINAR CLASE
                    </button>
                </div>
            }
            else
            {
                <div class="vertical-bar" @onclick="() => verLista = true"><span class="v-text">ATLETAS</span></div>
            }
        </div>
    </div>

    @* --- MODALES --- *@
    @if (mostrarModalAtletas)
    {
        <div class="modal-overlay">
            <div class="modal-content custom-modal">
                <div class="modal-header">
                    <h5 style="margin:0; color:var(--theme-primary); font-weight:bold;">SELECCIONAR ATLETA</h5>
                    <div style="display:flex; gap:15px; align-items:center;">
                        <button class="btn-icon-header" @onclick="() => mostrarBuscador = !mostrarBuscador"><i class="fas fa-search"></i></button>
                        <button class="btn-icon-header" @onclick="() => mostrarModalAtletas = false"><i class="fas fa-times"></i></button>
                    </div>
                </div>
                <div class="modal-body">
                    @if (mostrarBuscador)
                    {
                        <div class="search-box mb-3 slide-in">
                            <input type="text" class="form-control input-dark search-input" placeholder="Buscar por nombre..." value="@filtroAtleta" @oninput="FiltrarAtletas" autofocus />
                        </div>
                    }

                    <div class="lista-atletas-scroll scroll-custom">
                        @if (listaTodosAtletas == null)
                        {
                            <div class="text-center py-3"><div class="spinner-border" style="color: var(--theme-primary);"></div></div>
                        }
                        else if (listaAtletasFiltrada == null || listaAtletasFiltrada.Count == 0)
                        {
                            <p class="text-center text-muted mt-3">No hay resultados.</p>
                        }
                        else
                        {
                            @foreach (var atleta in listaAtletasFiltrada)
                            {
                                @if (!LiveState.AtletasEnClase.Any(x => x.UsuarioId == atleta.UsuarioId))
                                {
                                    <div class="atleta-row" @onclick="() => AgregarAtletaDesdeLista(atleta)">
                                        <div class="atleta-info">
                                            <div class="avatar-mini" style="@(!string.IsNullOrEmpty(atleta.FotoUrl) ? $"background-image: url('{atleta.FotoUrl}');" : "")">
                                                @if (string.IsNullOrEmpty(atleta.FotoUrl))
                                                {
                                                    @atleta.NombreCompleto.Substring(0, 1).ToUpper()
                                                }
                                            </div>
                                            <div style="display:flex; flex-direction:column;">
                                                <span class="atleta-nombre">@atleta.NombreCompleto</span>
                                            </div>
                                        </div>
                                        <i class="fas fa-plus-circle add-icon" style="color: var(--theme-primary);"></i>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (mostrarModalEquipos)
    {
        <div class="modal-overlay">
            <div class="modal-content custom-modal">
                <div class="modal-header">
                    <h5 style="margin:0; color:var(--theme-primary);">CREAR EQUIPOS (PAREJAS)</h5>
                    <button class="btn-icon-header" @onclick="CerrarModalEquipos"><i class="fas fa-times"></i></button>
                </div>
                <div class="modal-body">
                    <p class="text-theme-muted text-center mb-3">Selecciona 2 atletas para unirlos.</p>
                    <div class="team-builder-grid">
                        @foreach (var p in participantesVisuales.Where(x => x.Atletas.Count == 1).ToList())
                        {
                            var esSeleccionado = (seleccionadoParaEquipo == p);
                            <div class="atleta-select-row @(esSeleccionado ? "selected-theme" : "")" @onclick="() => SeleccionarParaEquipo(p)">
                                <span class="name" style="color: var(--theme-text);">@p.Atletas[0].NombreCompleto</span>
                                @if (esSeleccionado)
                                {
                                    <i class="fas fa-check-circle" style="color: var(--theme-bg);"></i>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (mostrarModalEliminar)
    {
        <div class="modal-overlay">
            <div class="modal-content custom-modal" style="height:auto; max-width:400px;">
                <div class="modal-body text-center p-4">
                    <i class="fas fa-exclamation-triangle mb-3" style="font-size:3rem; color: var(--theme-primary);"></i>
                    <h4 class="mb-2" style="color: var(--theme-text);">¿Eliminar?</h4>
                    <p class="mb-4" style="color: var(--theme-text-muted);">
                        @(itemAEliminar?.Atletas.Count > 1 ? "Se eliminará el equipo." : "Se eliminará al atleta de la clase.")
                    </p>
                    <div style="display:flex; gap:10px;">
                        <button class="btn-control-rect reset" style="flex:1;" @onclick="CerrarModalEliminar">CANCELAR</button>
                        <button class="btn-control-rect stop" style="flex:1;" @onclick="ConfirmarEliminar">ELIMINAR</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* --- MODAL EDITAR WOD EN VIVO --- *@
    @if (mostrarModalWodEdicion)
    {
        <div class="modal-overlay overlay-wod">
            <div class="modal-content custom-modal modal-wod" style="max-width: 600px; width: 100%;">

                <div class="modal-header">
                    <h5 style="margin:0; color:var(--theme-primary); font-family:'Oswald'">
                        EDITAR WOD ACTUAL
                        <span style="font-size:0.7rem; color:var(--theme-text-muted); margin-left:10px;">
                            @(modoTextoLibre ? "(TEXTO LIBRE)" : "(POR BLOQUES)")
                        </span>
                    </h5>
                    <button class="btn-close-custom" @onclick="() => mostrarModalWodEdicion = false"><i class="fas fa-times"></i></button>
                </div>

                <div class="modal-body scroll-custom" style="padding-bottom: 20px; overflow-y: auto;">
                    @if (cargandoOperacionWod)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border" style="color: var(--theme-primary);" role="status"></div>
                            <p class="mt-2" style="color: var(--theme-text-muted);">Guardando cambios...</p>
                        </div>
                    }
                    else
                    {
                        <div class="fade-in">
                            @foreach (var bloque in listaBloquesEditor)
                            {
                                <div class="card p-2 mb-3" style="background-color: var(--theme-bg); border: 1px solid var(--theme-border);">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span style="color:var(--theme-primary); font-weight:bold; font-family:'Oswald'">BLOQUE</span>
                                        <button class="btn-icon delete-btn" @onclick="() => EliminarBloque(bloque)"><i class="fas fa-trash"></i></button>
                                    </div>

                                    @if (!modoTextoLibre)
                                    {
                                        <select @bind="bloque.SegmentoClaseID" class="form-control input-dark mb-2">
                                            <option value="@Guid.Empty" selected disabled>-- Selecciona Segmento --</option>
                                            @if (listaSegmentos != null)
                                            {
                                                @foreach (var seg in listaSegmentos)
                                                {
                                                    <option value="@seg.Id">@seg.Nombre</option>
                                                }
                                            }
                                        </select>
                                    }

                                    <input type="text" @bind="bloque.TiempoFormato" class="form-control input-dark mb-3" placeholder="Tiempo / Formato (Ej: AMRAP 15 MIN)" />

                                    @if (modoTextoLibre)
                                    {
                                        <textarea @bind="bloque.TextoLibre" class="form-control input-dark" style="height: auto !important; min-height: 150px; resize: vertical;" placeholder="Escribe aquí los ejercicios..."></textarea>
                                    }
                                    else
                                    {
                                        @foreach (var ejercicio in bloque.Ejercicios)
                                        {
