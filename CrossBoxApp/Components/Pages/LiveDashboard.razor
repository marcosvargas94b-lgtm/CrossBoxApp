    private void SeleccionarParaEquipo(ResultadoCapturadoViewModel p)
    {
        if (seleccionadoParaEquipo == null)
        {
            seleccionadoParaEquipo = p;
        }
        else
        {
            if (seleccionadoParaEquipo == p) { seleccionadoParaEquipo = null; return; }

            string nombre1 = seleccionadoParaEquipo.Atletas[0].NombreCompleto.Split(' ')[0];
            string nombre2 = p.Atletas[0].NombreCompleto.Split(' ')[0];

            var nuevoEquipo = new ResultadoCapturadoViewModel
            {
                Atletas = new List<CheckInDto>(),
                NombreEquipo = $"{nombre1} & {nombre2}"
            };

            nuevoEquipo.Atletas.AddRange(seleccionadoParaEquipo.Atletas);
            nuevoEquipo.Atletas.AddRange(p.Atletas);

            participantesVisuales.Remove(seleccionadoParaEquipo);
            participantesVisuales.Remove(p);
            participantesVisuales.Insert(0, nuevoEquipo);

            seleccionadoParaEquipo = null;
        }
    }

