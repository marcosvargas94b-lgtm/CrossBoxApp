                                                <input type="text" @bind="ejercicio.NombreBase" class="form-control input-dark" style="flex: 1;" placeholder="Ejercicio" />
                                                <button class="btn-icon weight-btn @(ejercicio.TienePesos ? "active" : "")" @onclick="() => AbrirEditorPeso(ejercicio)" style="width: 38px; background: var(--theme-bg); color: var(--theme-text-muted); border: none; border-radius: 6px;">
                                                    <i class="fas fa-dumbbell"></i>
