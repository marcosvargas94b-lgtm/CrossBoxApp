    private async Task AbrirModalEdicionWod()
    {
        if (wodHoy == null || wodHoy.Bloques == null || !wodHoy.Bloques.Any())
        {
            await App.Current.MainPage.DisplayAlert("Aviso", "No hay WOD cargado hoy para editar. Prográmalo desde la pantalla de Inicio.", "Entendido");
            return;
        }

        if (listaSegmentos == null || !listaSegmentos.Any()) await CargarSegmentos();

        var primerBloque = wodHoy.Bloques.First();
        modoTextoLibre = primerBloque.EsTextoLibre;

        listaBloquesEditor = new List<BloqueEditorViewModel>();
        foreach (var b in wodHoy.Bloques)
        {
            var bloqueEdit = new BloqueEditorViewModel
            {
                SegmentoClaseID = b.SegmentoClaseID,
                NombreSegmento = b.NombreSegmento,
                TiempoFormato = b.TiempoFormato,
                Ejercicios = new List<EjercicioEditorViewModel>()
            };

            if (modoTextoLibre)
            {
                bloqueEdit.TextoLibre = string.Join("\n", b.Ejercicios.Select(e => e.Descripcion));
            }
            else
            {
                foreach (var ej in b.Ejercicios)
                {
                    bloqueEdit.Ejercicios.Add(new EjercicioEditorViewModel
                    {
                        Reps = ej.PesoRepeticiones,
                        NombreBase = ej.Descripcion
                    });
                }
            }
            listaBloquesEditor.Add(bloqueEdit);
        }

        mostrarModalWodEdicion = true;
    }

