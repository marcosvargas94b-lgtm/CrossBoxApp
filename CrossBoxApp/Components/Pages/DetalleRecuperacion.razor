@page "/detalle-recuperacion"
@using System.Net.Http.Json
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS

@* ENVOLVEMOS EN EL TEMA GLOBAL *@
<div style="@EstilosTema">
<div class="main-layout" >
    @* NAVBAR *@
    <div class="navbar-container">
        <div class="nav-left" @onclick='() => Nav.NavigateTo("/home")'>
            <i class="fas fa-arrow-left"></i> VOLVER
        </div>
        <div class="nav-title">READINESS ESTRATÉGICO</div>
        <div class="nav-right"></div>
    </div>

    @* CONTENIDO SCROLLEABLE *@
    <div class="scrollable-content">
        @if (datos == null) {
            <div class="text-center mt-5"><div class="spinner-border" style="color: var(--theme-primary);"></div></div>
        } else {
            
            @* ============================================ *@
            @* EVALUAR RPE Y SCALING SI TERMINÓ RUTINA HOY  *@
            @* ============================================ *@
            @if (datos.RutinaHoyParaRPE != null && !rpeEnviado)
            {
                <div class="rpe-container fade-in mb-4">
                    <h5><i class="fas fa-fire-alt me-2" style="color:#ff4d4d;"></i>¿CÓMO TE FUE HOY?</h5>
                    <p style="color: var(--theme-text-muted);">Evalúa tu esfuerzo para calcular el desgaste con precisión milimétrica.</p>

                    @if (datos.RequiereScaling)
                    {
                        <label class="section-label" style="color:var(--theme-primary); text-align:left; margin-top:10px;">1. NIVEL DE PESO (SCALING):</label>
                        <div class="scaling-grid mb-3">
                            <div class="scale-btn @(scalingSeleccionado == "Rx" ? "active rx" : "")" @onclick='() => scalingSeleccionado = "Rx"'>
                                <span class="scale-title">RX</span>
                                <span class="scale-desc">Peso Oficial (100%)</span>
                            </div>
                            <div class="scale-btn @(scalingSeleccionado == "Scaled Pro" ? "active pro" : "")" @onclick='() => scalingSeleccionado = "Scaled Pro"'>
                                <span class="scale-title">SCALED PRO</span>
                                <span class="scale-desc">Peso Retador (80%)</span>
                            </div>
                            <div class="scale-btn @(scalingSeleccionado == "Scaled" ? "active std" : "")" @onclick='() => scalingSeleccionado = "Scaled"'>
                                <span class="scale-title">SCALED</span>
                                <span class="scale-desc">Peso Moderado (60%)</span>
                            </div>
                            <div class="scale-btn @(scalingSeleccionado == "Bodyweight" ? "active bw" : "")" @onclick='() => scalingSeleccionado = "Bodyweight"'>
                                <span class="scale-title">ADAPTADO</span>
                                <span class="scale-desc">Sin peso (35%)</span>
                            </div>
                        </div>
                    }

                    <label class="section-label" style="color:var(--theme-primary); text-align:left;">@(datos.RequiereScaling ? "2. " : "")INTENSIDAD (RPE):</label>
                    <div class="rpe-scale">
                        @for (int i = 1; i <= 10; i++)
                        {
                            int rpeValor = i;
                            <button class="rpe-btn @(rpeSeleccionado == rpeValor ? "selected" : "")"
                                    style="border-color: @GetColorRPE(rpeValor);"
                                    @onclick="() => rpeSeleccionado = rpeValor">
                                @rpeValor
                            </button>
                        }
                    </div>

                    <div class="rpe-legend">
                        <span>Suave</span>
                        <span>Máximo</span>
                    </div>

                    @if (rpeSeleccionado > 0 && (!datos.RequiereScaling || !string.IsNullOrEmpty(scalingSeleccionado)))
                    {
                        <div class="text-center mt-2 fade-in">
                            <span class="rpe-label" style="color: @GetColorRPE(rpeSeleccionado)">
                                @GetTextoRPE(rpeSeleccionado)
                            </span>
                            <button class="btn-save-rpe mt-3" style="background: var(--theme-text); color: var(--theme-bg);" @onclick="GuardarRPE">
                                @if (guardandoRpe)
                                {
                                    <i class="fas fa-spinner fa-spin"></i>
                                }
                                else
                                {
                                    <span>CALCULAR IMPACTO</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            }
            <div class="focus-card fade-in">
                <div class="readiness-score">
                    <span class="big-num">@datos.DisponibilidadGlobal<small style="font-size: 2rem;">%</small></span>
                    <span class="score-label">ENERGÍA MUSCULAR</span>
                    <p class="status-msg">@datos.Mensaje.ToUpper()</p>
                    <div class="btn-detalles" style="color:var(--theme-text-muted); font-weight:normal;">Algoritmo de Fisiología Activo</div>
                </div>

                <div class="map-container">
                    @if (!string.IsNullOrEmpty(datos.Sexo) && datos.Sexo.ToUpper() == "F")
                    {
                        <MapaCalorFemenino Datos="datos.Musculos" />
                    }
                    else
                    {
                        <MapaCalor Datos="datos.Musculos" />
                    }
                </div>
            </div>
            
            @* AQUI ESTÁ LA NOTA ACLARATORIA QUE PEDISTE *@
            <p class="text-center mt-2 mb-0 fade-in" style="color: var(--theme-text-muted); font-size: 0.75rem; font-style: italic; max-width: 300px; line-height: 1.3;">
                *El nivel de energía refleja el desgaste local. No indica incapacidad, la recuperación se da fluidamente en horas.
            </p>

            @* LEYENDA DE COLORES *@
            <div class="gradient-legend-container mt-3 fade-in">
                <div class="gradient-bar"></div>
                <div class="gradient-labels">
                    <span>AGOTADO</span>
                    <span>FATIGA ÓPTIMA</span>
                    <span>RECUPERADO</span>
                </div>
            </div>

            <div class="divider-line mt-4 mb-4"></div>

            @* ============================================ *@
            @* MÓDULO DE FISIOLOGÍA                         *@
            @* ============================================ *@
            <div class="stats-section fade-in mb-4 @(datos.TieneDatosFisiologicos ? "" : "watermark-box")" @onclick="AbrirModalFisiologia">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h5 class="section-title" style="color: var(--theme-text);"><i class="fas fa-dna me-2" style="color:#00C3A5;"></i>PERFIL FISIOLÓGICO</h5>
                        <p class="section-sub mb-0">Edad, Peso, Estatura y Sexo.</p>
                    </div>
                    <i class="fas fa-pen" style="color:var(--theme-primary); font-size:1.2rem;"></i>
                </div>
                
                @if (datos.TieneDatosFisiologicos)
                {
                    <div class="mt-3" style="color:#00C3A5; font-size:0.85rem; font-weight:bold; font-family:'Oswald';">
                        <i class="fas fa-check-circle me-1"></i> METABOLISMO CALIBRADO
                    </div>
                    <div class="fisio-data-row mt-2">
                        <span>@(datos.Sexo == "M" ? "HOMBRE" : "MUJER")</span>
                        <div class="fisio-dot" style="background: var(--theme-primary);"></div>
                        <span>@datos.Edad AÑOS</span>
                        <div class="fisio-dot" style="background: var(--theme-primary);"></div>
                        <span>@datos.Peso KG</span>
                        <div class="fisio-dot" style="background: var(--theme-primary);"></div>
                        <span>@datos.Estatura CM</span>
                    </div>
                }
                else
                {
                    <div class="mt-3" style="color:var(--theme-primary); font-size:0.85rem; font-style:italic;">
                        <i class="fas fa-exclamation-circle me-1"></i> Toca aquí e ingresa tus datos para mayor precisión en tu recuperación.
                    </div>
                }
            </div>

            @* TIEMPO DE RECUPERACIÓN POR MÚSCULO *@
            <div class="stats-section fade-in mb-4">
                <h5 class="section-title"><i class="fas fa-stopwatch me-2" style="color: var(--theme-primary);"></i>TIEMPO DE RECUPERACIÓN</h5>
                <p class="section-sub">Horas estimadas para que el músculo alcance su 100%.</p>
                
                @{
                    var musculosFatigados = datos.Musculos.Where(m => m.Porcentaje < 100).OrderBy(m => m.Porcentaje).ToList();
                    
                    if(musculosFatigados.Any()) 
                    {
                        <div class="recovery-list">
                            @foreach(var m in musculosFatigados) 
                            {
                                <div class="recovery-item">
                                    <div class="recovery-header">
                                        <span class="muscle-name">@m.Nombre.ToUpper()</span>
                                        <span class="time-left" style="color: var(--theme-primary); border-color: var(--theme-border);"><i class="far fa-clock me-1"></i> @m.HorasParaRecuperacion HRS</span>
                                    </div>
                                    <div class="progress-bg" style="background: var(--theme-bg);">
                                        <div class="progress-fill" style="width: @(m.Porcentaje)%; background: @GetColorForBar(m.Porcentaje);"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    } 
                    else 
                    {
                        <div class="text-center mt-3 empty-state">
                            <i class="fas fa-battery-full mb-2" style="font-size: 1.5rem; color: #00C3A5;"></i><br />
                            Todos tus músculos están al 100%. <br/>¡Estás listo para destruir cualquier rutina!
                        </div>
                    }
                }
            </div>

            @* GRÁFICA DE BARRAS (VOLUMEN) *@
            <div class="stats-section fade-in mb-4">
                <h5 class="section-title"><i class="fas fa-chart-column me-2" style="color: var(--theme-primary);"></i>CARGA MUSCULAR SEMANAL</h5>
                <p class="section-sub">@(Sesion.Usuario.TipoLugar == "Gimnasio" ? "Volumen de series por grupo muscular en los últimos 7 días." : "Intensidad acumulada por zona en los últimos 7 días.")</p>
                
                @if(datos.VolumenSemanal != null && datos.VolumenSemanal.Any())
                {
                    int maxSeries = datos.VolumenSemanal.Max(v => v.SeriesTotales);
                    if (maxSeries == 0) maxSeries = 1; 
                    
                    <div class="chart-wrapper">
                        <div class="chart-container">
                            @foreach (var item in datos.VolumenSemanal) 
                            {
                                int heightPerc = (int)((double)item.SeriesTotales / maxSeries * 100);
                                if (heightPerc < 5) heightPerc = 5; 
                                
                                <div class="chart-column">
                                    <span class="chart-value">@item.SeriesTotales</span>
                                    <div class="bar-outer" style="background: var(--theme-bg);">
                                        <div class="bar-fill" style="height: @(heightPerc)%; background: @GetColorByVol(item.SeriesTotales)"></div>
                                    </div>
                                    <span class="chart-label">@Abreviar(item.GrupoMuscular)</span>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center mt-3 empty-state">
                        Aún no tienes volumen registrado esta semana.
                    </div>
                }
            </div>

            @* SUGERENCIA DE ENTRENAMIENTO *@
            <div class="stats-section fade-in mb-4">
                <h5 class="section-title"><i class="fas fa-bolt me-2" style="color: #00C3A5;"></i>MÚSCULOS FRESCOS</h5>
                <p class="section-sub">Grupos musculares en óptimas condiciones para entrenar hoy.</p>

                @{
                    var musculosFrescos = datos.Musculos.Where(m => m.Porcentaje >= 95).ToList();

                    if (musculosFrescos.Any())
                    {
                        <div class="fresh-muscles-container">
                            @foreach (var m in musculosFrescos)
                            {
                                <span class="fresh-chip">@m.Nombre.ToUpper()</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center mt-3 empty-state">
                            <i class="fas fa-bed mb-2" style="font-size: 1.5rem; color: #FF9500;"></i><br />
                            Tu cuerpo necesita descanso total.<br />Haz estiramientos o cardio ligero.
                        </div>
                    }
                }
            </div>
        }
        
        <div style="height: 60px;"></div>
    </div>
</div>

@* ============================================ *@
@* MODAL DE DATOS FISIOLÓGICOS                  *@
@* ============================================ *@
@if (mostrarModalFisiologia)
{
    <div class="modal-overlay fade-in">
        <div class="modal-content custom-modal slide-up" style="border-color: var(--theme-primary);">
            <div class="modal-header" style="background: var(--theme-card); border-bottom-color: var(--theme-border);">
                <h5 style="margin:0; color:var(--theme-primary); font-family:'Oswald';">
                    <i class="fas fa-dna me-2"></i> BIOMETRÍA
                </h5>
                <button class="btn-close-custom" @onclick="CerrarModalFisio"><i class="fas fa-times"></i></button>
            </div>
            
            <div class="modal-body" style="background: var(--theme-bg);">
                <p style="color:var(--theme-text-muted); font-size:0.8rem; margin-bottom: 20px;">
                    Estos datos son privados y se usan exclusivamente para calibrar la velocidad de regeneración de tu tejido muscular.
                </p>

                <label class="form-label" style="color: var(--theme-primary); font-weight: bold; font-size: 0.9rem;">Sexo Biológico</label>
                <select class="form-control input-dark mb-3" @bind="fisioEdit.Sexo">
                    <option value="" disabled selected>Selecciona...</option>
                    <option value="M">Masculino</option>
                    <option value="F">Femenino</option>
                </select>

                <label class="form-label" style="color: var(--theme-primary); font-weight: bold; font-size: 0.9rem;">Edad (Años)</label>
                <input type="number" class="form-control input-dark mb-3" placeholder="Ej: 28" @bind="fisioEdit.Edad" />

                <label class="form-label" style="color: var(--theme-primary); font-weight: bold; font-size: 0.9rem;">Peso (KG)</label>
                <input type="number" class="form-control input-dark mb-3" placeholder="Ej: 75.5" @bind="fisioEdit.Peso" />

                <label class="form-label" style="color: var(--theme-primary); font-weight: bold; font-size: 0.9rem;">Estatura (CM)</label>
                <input type="number" class="form-control input-dark mb-3" placeholder="Ej: 175" @bind="fisioEdit.Estatura" />
            </div>

            <div class="modal-footer" style="background: var(--theme-card); border-top-color: var(--theme-border);">
                <button class="btn-clear" @onclick="LimpiarDatosFisio" title="Limpiar todos los datos">
                    <i class="fas fa-trash"></i>
                </button>
                <button class="btn-cancel" style="border-color: var(--theme-border); color: var(--theme-text);" @onclick="CerrarModalFisio">Cancelar</button>
                <button class="btn-confirm @(FormularioFisioValido ? "btn-valid" : "btn-disabled")" 
                        @onclick="GuardarFisiologia" disabled="@(!FormularioFisioValido || guardandoFisio)">
                    @if(guardandoFisio) { <i class="fas fa-spinner fa-spin"></i> } else { <span>GUARDAR</span> }
                </button>
            </div>
        </div>
    </div>
}
</div>

<style>
    /* ESTILOS BASE Y VARIABLES */
    .main-layout { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--theme-bg); display: flex; flex-direction: column; z-index: 1; }
    .navbar-container { flex-shrink: 0; padding-top: calc(env(safe-area-inset-top) + 5px); padding-bottom: 10px; padding-left: 20px; padding-right: 20px; background-color: var(--theme-bg); border-bottom: 1px solid var(--theme-primary); color: var(--theme-text); display: flex; justify-content: space-between; align-items: center; z-index: 100; font-family: 'Oswald'; min-height: 60px; }
    .nav-left { color: var(--theme-primary); font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
    .nav-title { font-weight: bold; font-size: 1.1rem; color: var(--theme-text); letter-spacing: 1px; }
    .nav-right { width: 60px; }
    .scrollable-content { flex-grow: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; align-items: center; -webkit-overflow-scrolling: touch; background: radial-gradient(circle at top, var(--theme-card) 0%, var(--theme-bg) 100%); }

    /* TARJETA MAPA */
    .focus-card { background: var(--theme-card); border: 1px solid var(--theme-border); border-radius: 20px; padding: 20px; display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 500px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
    .readiness-score { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 20px; }
    .big-num { font-family: 'Oswald'; font-size: 4.5rem; font-weight: 900; line-height: 1; color: var(--theme-text); }
    .score-label { font-size: 0.8rem; letter-spacing: 2px; color: var(--theme-primary); font-weight: bold; margin-top: 5px; }
    .status-msg { font-size: 0.85rem; color: var(--theme-text); font-weight: 800; margin-top: 10px; font-style: italic; }
    .map-container { width: 100%; display: flex; justify-content: center; }

    /* LEYENDA */
    .gradient-legend-container { width: 100%; max-width: 500px; padding: 15px 20px; background: var(--theme-card); border-radius: 15px; border: 1px solid var(--theme-border); display: flex; flex-direction: column; gap: 8px; }
    /* La barra de colores se mantiene semántica (Rojo a Verde) */
    .gradient-bar { width: 100%; height: 10px; border-radius: 5px; background: linear-gradient(to right, #FF3B30 0%, #FF9500 40%, #FFCC00 80%, #00C3A5 100%); }
    .gradient-labels { display: flex; justify-content: space-between; color: var(--theme-text-muted); font-size: 0.65rem; font-weight: bold; letter-spacing: 1px; }
    .divider-line { width: 100%; max-width: 500px; height: 1px; background: var(--theme-border); }

    /* SECCIONES ESTADÍSTICAS */
    .stats-section { width: 100%; max-width: 500px; background: var(--theme-card); padding: 20px; border-radius: 20px; border: 1px solid var(--theme-border); cursor: pointer; transition: 0.3s; }
    .section-title { font-family: 'Oswald'; color: var(--theme-text); letter-spacing: 1px; margin-bottom: 2px; font-size: 1.1rem; }
    .section-sub { color: var(--theme-text-muted); font-size: 0.8rem; margin-bottom: 25px; }
    .empty-state { color: var(--theme-text-muted); font-style: italic; font-size: 0.85rem; }

    /* CAJA MARCA DE AGUA FISIOLOGÍA */
    .watermark-box { opacity: 0.5; border: 1px dashed var(--theme-primary); }
    .watermark-box:hover, .watermark-box:active { opacity: 1; background: var(--theme-bg); }
    .fisio-data-row { display: flex; justify-content: center; align-items: center; gap: 10px; background: var(--theme-bg); padding: 10px; border-radius: 8px; color: var(--theme-text); font-family: 'Oswald'; font-size: 0.9rem; }
    .fisio-dot { width: 4px; height: 4px; border-radius: 50%; }

    /* MODAL FISIO */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 3000; display: flex; justify-content: center; align-items: center; padding: 20px; backdrop-filter: blur(4px); }
    .custom-modal { width: 100%; max-width: 400px; border-radius: 12px; border: 1px solid; display: flex; flex-direction: column; box-shadow: 0 10px 40px rgba(0,0,0,0.8); }
    .modal-header { padding: 15px 20px; border-bottom: 1px solid; display: flex; justify-content: space-between; align-items: center; border-radius: 12px 12px 0 0; }
    .btn-close-custom { background: none; border: none; font-size: 1.2rem; cursor: pointer; }
    .modal-body { padding: 20px; }
    .modal-footer { padding: 15px; border-top: 1px solid; display: flex; gap: 10px; border-radius: 0 0 12px 12px; }
    .input-dark { background: var(--theme-bg) !important; border: 1px solid var(--theme-border) !important; color: var(--theme-text) !important; }
    .input-dark:focus { border-color: var(--theme-primary) !important; box-shadow: none !important; outline: none; }
    .btn-confirm { border: none; padding: 10px; font-weight: bold; flex: 2; border-radius: 5px; transition: 0.2s; font-family: 'Oswald'; letter-spacing: 1px;}
    
    .btn-valid { background: var(--theme-primary); color: var(--theme-bg); cursor: pointer; }
    .btn-disabled { background: var(--theme-border); color: var(--theme-text-muted); cursor: not-allowed; }
    
    .btn-cancel { background: transparent; border: 1px solid; padding: 10px; font-weight: bold; flex: 1; border-radius: 5px; cursor: pointer;}
    .btn-clear { background: rgba(255, 77, 77, 0.1); color: #ff4d4d; border: 1px solid #ff4d4d; padding: 10px; border-radius: 5px; flex: 0.5; display: flex; justify-content: center; align-items: center; transition: 0.2s; cursor: pointer; }
    .btn-clear:active { background: #ff4d4d; color: white; }

    /* RPE (INTENSIDAD) - Mantiene rojo semántico */
    .rpe-container { width: 100%; max-width: 500px; background: linear-gradient(145deg, var(--theme-card), var(--theme-bg)); border: 1px solid #ff4d4d; border-radius: 20px; padding: 20px; text-align: center; box-shadow: 0 0 20px rgba(255, 77, 77, 0.15); }
    .rpe-container h5 { font-family: 'Oswald'; color: var(--theme-text); margin-bottom: 5px; }
    .rpe-scale { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
    .rpe-btn { width: 40px; height: 40px; border-radius: 50%; background: var(--theme-bg); color: var(--theme-text); font-family: 'Oswald'; font-size: 1.1rem; border: 2px solid; cursor: pointer; transition: 0.2s; }
    .rpe-btn.selected { transform: scale(1.15); box-shadow: 0 0 10px rgba(255,255,255,0.5); background: white; color: black !important; font-weight: bold; }
    .rpe-label { font-family: 'Oswald'; font-size: 1.2rem; letter-spacing: 1px; display: block; margin-top: 10px; }
    .btn-save-rpe { font-family: 'Oswald'; padding: 8px 25px; border-radius: 50px; font-weight: bold; border: none; cursor: pointer; letter-spacing: 1px;}

    /* RESTO ESTILOS (Progreso, Gráficas, Animaciones) */
    .recovery-list { display: flex; flex-direction: column; gap: 15px; width: 100%; }
    .recovery-item { display: flex; flex-direction: column; gap: 6px; }
    .recovery-header { display: flex; justify-content: space-between; align-items: center; }
    .muscle-name { color: var(--theme-text); font-family: 'Oswald'; font-size: 0.95rem; letter-spacing: 1px; }
    .time-left { font-size: 0.75rem; font-weight: bold; padding: 3px 8px; border-radius: 10px; border: 1px solid; }
    .progress-bg { width: 100%; height: 8px; border-radius: 4px; overflow: hidden; }
    .progress-fill { height: 100%; border-radius: 4px; transition: width 1s ease-in-out; }

    .chart-wrapper { width: 100%; overflow-x: auto; padding-bottom: 10px; -webkit-overflow-scrolling: touch; }
    .chart-container { display: flex; align-items: flex-end; height: 220px; gap: 15px; min-width: min-content; padding: 0 10px; }
    .chart-column { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; width: 40px; flex-shrink: 0; }
    .chart-value { color: var(--theme-text); font-family: 'Oswald'; font-size: 1rem; font-weight: bold; margin-bottom: 5px; }
    .bar-outer { width: 100%; height: 150px; border-radius: 6px; display: flex; align-items: flex-end; overflow: hidden; }
    .bar-fill { width: 100%; border-radius: 6px; transition: height 1s ease-out; }
    .chart-label { color: var(--theme-text-muted); font-size: 0.65rem; margin-top: 10px; text-transform: uppercase; font-weight: bold; text-align: center; line-height: 1; }

    .fresh-muscles-container { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 15px; }
    .fresh-chip { background: rgba(0, 195, 165, 0.15); color: #00C3A5; border: 1px solid rgba(0, 195, 165, 0.4); padding: 6px 14px; border-radius: 20px; font-size: 0.75rem; font-family: 'Oswald', sans-serif; letter-spacing: 1px; font-weight: bold; }

    .fade-in { animation: fadeIn 0.5s ease; }
    .slide-up { animation: slideUp 0.3s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

    /* Estilos del Scaling - Colores semánticos */
    .scaling-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .scale-btn { background: var(--theme-bg); border: 1px solid var(--theme-border); border-radius: 8px; padding: 10px; display: flex; flex-direction: column; align-items: center; cursor: pointer; transition: 0.2s; }
    .scale-title { font-family: 'Oswald'; font-weight: bold; font-size: 1.1rem; color: var(--theme-text); }
    .scale-desc { font-family: 'Roboto'; font-size: 0.7rem; color: var(--theme-text-muted); }
    
    .scale-btn.active { transform: scale(1.05); z-index: 10; }
    .scale-btn.active.rx { border-color: #ff4d4d; background: rgba(255, 77, 77, 0.1); }
    .scale-btn.active.rx .scale-title { color: #ff4d4d; }
    
    .scale-btn.active.pro { border-color: #FFD700; background: rgba(255, 215, 0, 0.1); }
    .scale-btn.active.pro .scale-title { color: #FFD700; }
    
    .scale-btn.active.std { border-color: #00C3A5; background: rgba(0, 195, 165, 0.1); }
    .scale-btn.active.std .scale-title { color: #00C3A5; }
    
    .scale-btn.active.bw { border-color: #B0C4DE; background: rgba(176, 196, 222, 0.1); }
    .scale-btn.active.bw .scale-title { color: #B0C4DE; }
</style>

@code {
    // --- ESTADO INICIAL NEUTRAL (PLATA MATE) ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    private EstadoRecuperacionDto datos;
    private string scalingSeleccionado = "";

    // RPE
    private int rpeSeleccionado = 0;
    private bool guardandoRpe = false;
    private bool rpeEnviado = false;

    // FISIOLOGIA
    private bool mostrarModalFisiologia = false;
    private GuardarFisiologiaDto fisioEdit = new GuardarFisiologiaDto();
    private bool guardandoFisio = false;

    private bool EstaVacio => (fisioEdit.Edad == null || fisioEdit.Edad == 0) &&
                              (fisioEdit.Peso == null || fisioEdit.Peso == 0) &&
                              (fisioEdit.Estatura == null || fisioEdit.Estatura == 0) &&
                              string.IsNullOrEmpty(fisioEdit.Sexo);

    private bool EstaCompleto => (fisioEdit.Edad > 0) && (fisioEdit.Peso > 0) && (fisioEdit.Estatura > 0) && !string.IsNullOrEmpty(fisioEdit.Sexo);

    private bool FormularioFisioValido => EstaVacio || EstaCompleto;

    public class GuardarFisiologiaDto { public Guid UsuarioId { get; set; } public int? Edad { get; set; } public decimal? Peso { get; set; } public decimal? Estatura { get; set; } public string Sexo { get; set; } }

    protected override async Task OnInitializedAsync()
    {
        // LEER EL CACHÉ LOCAL AL INSTANTE
        try 
        {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) 
            { 
                EstilosTema = cache; 
                StateHasChanged(); 
            }
        } 
        catch { }

        if (Sesion.Usuario == null) { Nav.NavigateTo("/"); return; }

        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            string tipoLugar = Sesion.Usuario.TipoLugar ?? "";
            string endpoint = tipoLugar == "Gimnasio" ? "rutinasgym" : "rutinasbox";

            datos = await Http.GetFromJsonAsync<EstadoRecuperacionDto>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/{endpoint}/recuperacion/{Sesion.Usuario.UsuarioID}");
        }
        catch { }
    }

    // --- LÓGICA RPE ---
    private string GetColorRPE(int rpe)
    {
        if (rpe <= 4) return "#00C3A5"; // Verde (Fácil)
        if (rpe <= 7) return "#F8C545"; // Amarillo (Moderado)
        return "#ff4d4d";               // Rojo (Difícil)
    }

    private string GetTextoRPE(int rpe)
    {
        if (rpe <= 4) return "ENTRENAMIENTO LIGERO";
        if (rpe <= 7) return "ESFUERZO MODERADO";
        if (rpe <= 9) return "MUY DESAFIANTE";
        return "ESFUERZO MÁXIMO / AL FALLO";
    }

    private async Task GuardarRPE()
    {
        if (rpeSeleccionado == 0) return;
        if (datos.RequiereScaling && string.IsNullOrEmpty(scalingSeleccionado)) return;

        guardandoRpe = true;
        try
        {
            string tipoLugar = Sesion.Usuario.TipoLugar ?? "";

            if (tipoLugar == "Gimnasio")
            {
                var req = new { RpeScore = rpeSeleccionado };
                await Http.PostAsJsonAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/rutinasgym/guardar-rpe/{datos.RutinaHoyParaRPE}", req);
            }
            else
            {
                var req = new { RpeScore = rpeSeleccionado, NivelScaling = scalingSeleccionado };
                await Http.PostAsJsonAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/rutinasbox/guardar-rpe-box/{datos.RutinaHoyParaRPE}", req);
            }

            rpeEnviado = true;
            await CargarDatos(); // Recargar con la nueva fatiga matemática
        }
        catch { }
        finally { guardandoRpe = false; }
    }

    // --- LÓGICA FISIOLOGÍA ---
    private void AbrirModalFisiologia()
    {
        fisioEdit = new GuardarFisiologiaDto
        {
            UsuarioId = Sesion.Usuario.UsuarioID,
            Edad = datos?.Edad,
            Peso = datos?.Peso,
            Estatura = datos?.Estatura,
            Sexo = datos?.Sexo ?? ""
        };
        mostrarModalFisiologia = true;
    }

    private void CerrarModalFisio() => mostrarModalFisiologia = false;

    private void LimpiarDatosFisio()
    {
        fisioEdit.Edad = null;
        fisioEdit.Peso = null;
        fisioEdit.Estatura = null;
        fisioEdit.Sexo = "";
    }

    private async Task GuardarFisiologia()
    {
        if (!FormularioFisioValido) return;
        guardandoFisio = true;
        try
        {
            var res = await Http.PostAsJsonAsync("https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/rutinasgym/guardar-fisiologia", fisioEdit);
            if (res.IsSuccessStatusCode)
            {
                mostrarModalFisiologia = false;
                await CargarDatos(); // Recalcular con el nuevo metabolismo
            }
        }
        catch { }
        finally { guardandoFisio = false; }
    }

    private string Abreviar(string nombre)
    {
        if (string.IsNullOrEmpty(nombre)) return "";
        if (nombre == "Espalda Alta") return "ESP.A";
        if (nombre == "Antebrazos") return "ANTE.";
        if (nombre == "Lumbares") return "LUMB.";
        if (nombre == "Full Body / Cardio") return "CARDIO";
        if (nombre == "Isquiotibiales") return "ISQUIO";
        return nombre.Substring(0, Math.Min(6, nombre.Length)).ToUpper() + ".";
    }

    private string GetColorForBar(int p)
    {
        if (p <= 40) return InterpolateColor(255, 59, 48, 255, 149, 0, p / 40.0);
        if (p <= 80) return InterpolateColor(255, 149, 0, 255, 204, 0, (p - 40) / 40.0);
        return InterpolateColor(255, 204, 0, 0, 195, 165, (p - 80) / 20.0);
    }

    private string InterpolateColor(int r1, int g1, int b1, int r2, int g2, int b2, double fraction)
    {
        int r = (int)(r1 + (r2 - r1) * fraction);
        int g = (int)(g1 + (g2 - g1) * fraction);
        int b = (int)(b1 + (b2 - b1) * fraction);
        return $"rgb({r}, {g}, {b})";
    }

    private string GetColorByVol(int series) => series >= 16 ? "#FF3B30" : series >= 8 ? "#FF9500" : "#00C3A5";
}