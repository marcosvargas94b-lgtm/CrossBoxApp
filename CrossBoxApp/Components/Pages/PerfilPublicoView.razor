@page "/perfil-publico/{TargetUserId:guid}"
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@using CrossBoxApp.Models.Social
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS

@* ENVOLVEMOS TODA LA PÁGINA EN EL TEMA *@
<div style="@EstilosTema">

    <div class="main-layout">

        @* NAVBAR *@
        <div class="navbar-container">
            <div class="nav-left" @onclick="Volver">
                <i class="fas fa-arrow-left"></i> VOLVER
            </div>
            <div class="nav-title">PERFIL ATLETA</div>
            <div class="nav-right"></div>
        </div>

        <div class="scrollable-content">
            
            @if (perfil == null)
            {
                <div class="spinner-container">
                    <div class="spinner-border" style="color: var(--theme-primary);"></div>
                </div>
            }
            else
            {
                @* --- HERO IMAGE (FOTO PERFIL) --- *@
                <div class="hero-image-container">
                    @if (!string.IsNullOrEmpty(perfil.FotoUrl))
                    {
                        <img src="@perfil.FotoUrl" class="hero-image" @onclick='() => VerImagenFull(perfil.FotoUrl)' />
                    }
                    else
                    {
                        <div class="hero-initial-placeholder">
                            @(perfil.NombreCompleto?.Substring(0, 1).ToUpper() ?? "A")
                        </div>
                    }
                    
                    <div class="hero-overlay-info">
                        @* --- LÓGICA DE NOMBRE VS APODO --- *@
                        <h1 class="user-name">@NombrePrincipal</h1>
                        
                        @if (perfil.UsarApodo && !string.IsNullOrEmpty(perfil.Apodo))
                        {
                            <p class="real-name">(@perfil.NombreCompleto)</p>
                        }
                    </div>
                </div>

                <div class="info-section">
                    
                    @* BADGE LIKES (Se mantiene el corazón rojo semántico) *@
                    <div class="likes-badge-premium">
                        <i class="fas fa-heart"></i>
                        <span class="likes-count">@perfil.TotalLikes</span>
                        <span class="likes-text">LIKES ACUMULADOS</span>
                    </div>

                    @* BIOGRAFÍA *@
                    <div class="bio-box">
                        <label>SOBRE MÍ:</label>
                        <p>@(string.IsNullOrEmpty(perfil.Descripcion) ? "Sin descripción..." : perfil.Descripcion)</p>
                    </div>

                    @* --- GALERÍA DE FOTOS (CERTIFICADOS) --- *@
                    @if (!string.IsNullOrEmpty(perfil.FotoCertificado1Url) || !string.IsNullOrEmpty(perfil.FotoCertificado2Url))
                    {
                        <div class="gallery-section fade-in">
                            <h4 class="gallery-title"><i class="fas fa-images"></i> GALERÍA</h4>
                            
                            <div class="gallery-grid">
                                @if (!string.IsNullOrEmpty(perfil.FotoCertificado1Url))
                                {
                                    <div class="gallery-item" @onclick='() => VerImagenFull(perfil.FotoCertificado1Url)'>
                                        <img src="@perfil.FotoCertificado1Url" />
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(perfil.FotoCertificado2Url))
                                {
                                    <div class="gallery-item" @onclick='() => VerImagenFull(perfil.FotoCertificado2Url)'>
                                        <img src="@perfil.FotoCertificado2Url" />
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* --- SECCIÓN DE PROGRESO (SOLO SI TIENE DATOS) --- *@
                    @if (perfil.RegistrosProgreso != null && perfil.RegistrosProgreso.Any())
                    {
                        <div class="progress-section fade-in">
                            <h4 class="section-title"><i class="fas fa-trophy"></i> MEJORES MARCAS</h4>

                            <div class="progress-grid">
                                @foreach (var record in perfil.RegistrosProgreso)
                                {
                                    <div class="progress-card">
                                        <span class="ex-name">@record.NombreEjercicio</span>
                                        <div class="ex-value">
                                            <span class="val">@record.MejorMarca</span>
                                            <span class="unit">@record.Unidad</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* --- ACCIONES (MATCH / WHATSAPP) --- *@
                    <div class="actions-area mt-4">
                        @if (perfil.EsMatchMutuo)
                        {
                            <div class="match-success-box fade-in">
                                <div class="match-badge">¡YA HAN HECHO MATCH!</div>
                                
                                <div class="whatsapp-pill" @onclick="AbrirWhatsApp">
                                    <i class="fas fa-comment-dots"></i>
                                    <div class="btn-text-container">
                                        <span class="main-btn-text">CLICK PARA CHATEAR POR WHATSAPP</span>
                                        <span class="sub-btn-text">TELÉFONO: @perfil.WhatsappTarget</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (perfil.YaLeDiMatch)
                        {
                            <div class="match-sent-box pulse">
                                <i class="fas fa-check-circle" style="color: #28a745;"></i>
                                <span style="color: var(--theme-text);">TOQUE ENVIADO</span>
                                <small style="color: var(--theme-text-muted);">Esperando respuesta...</small>
                            </div>
                        }
                        else
                        {
                            <button class="btn-match" @onclick="HacerMatch">
                                <i class="fas fa-heart"></i> DAR TOQUE
                            </button>
                        }
                    </div>

                </div>
            }
            
            <div style="height: 60px;"></div>
        </div>
    </div>

    @* --- MODAL ZOOM IMAGEN --- *@
    @if (!string.IsNullOrEmpty(imagenZoomUrl))
    {
        <div class="image-zoom-overlay" @onclick="CerrarZoom">
            <button class="btn-close-zoom"><i class="fas fa-times"></i></button>
            <img src="@imagenZoomUrl" class="zoomed-image" @onclick:stopPropagation="true" />
        </div>
    }

</div>

<style>
    /* --- ESTRUCTURA BASE Y NAVBAR BLINDADA --- */
    .main-layout { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--theme-bg); display: flex; flex-direction: column; z-index: 1; }
    
    .navbar-container { flex-shrink: 0; padding-top: calc(env(safe-area-inset-top) + 5px); padding-bottom: 10px; padding-left: 20px; padding-right: 20px; background-color: var(--theme-bg); border-bottom: 1px solid var(--theme-primary); color: var(--theme-text); display: flex; justify-content: space-between; align-items: center; z-index: 100; font-family: 'Oswald'; min-height: 60px; }
    
    .nav-left { color: var(--theme-primary); font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
    .nav-title { font-weight: bold; font-size: 1.1rem; color: var(--theme-text); letter-spacing: 1px; }
    .nav-right { width: 60px; }
    
    .scrollable-content { flex-grow: 1; overflow-y: auto; background-color: var(--theme-bg); display: flex; flex-direction: column; -webkit-overflow-scrolling: touch; }

    /* HERO & NOMBRE */
    .hero-image-container { width: 100%; height: 400px; position: relative; background: var(--theme-card); flex-shrink: 0; cursor: pointer; }
    .hero-image { width: 100%; height: 100%; object-fit: cover; mask-image: linear-gradient(to bottom, black 60%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%); }
    .hero-initial-placeholder { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; background: var(--theme-bg); color: var(--theme-border); font-size: 8rem; font-family: 'Oswald'; font-weight: bold; }
    
    .hero-overlay-info { position: absolute; bottom: 20px; left: 0; right: 0; text-align: center; padding: 0 10px; text-shadow: 2px 2px 10px black; }
    .user-name { font-family: 'Oswald'; font-size: 2.8rem; color: var(--theme-primary); text-transform: uppercase; margin: 0; line-height: 1; }
    .real-name { font-size: 1rem; color: #ddd; margin: 5px 0 0 0; font-weight: bold; letter-spacing: 1px; }

    .info-section { padding: 20px; display: flex; flex-direction: column; align-items: center; width: 100%; }

    /* LIKES & BIO */
    .likes-badge-premium { background: rgba(255, 255, 255, 0.08); padding: 10px 25px; border-radius: 50px; border: 1px solid var(--theme-border); display: flex; align-items: center; gap: 10px; margin-bottom: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }
    .likes-badge-premium i { color: #ff4757; font-size: 1.2rem; filter: drop-shadow(0 0 5px rgba(255,71,87,0.5)); }
    .likes-count { color: var(--theme-primary); font-family: 'Oswald'; font-size: 1.4rem; font-weight: bold; }
    .likes-text { color: var(--theme-text); font-family: 'Oswald'; font-size: 0.9rem; letter-spacing: 1px; }
    
    .bio-box { width: 100%; background: var(--theme-card); padding: 15px; border-radius: 12px; border-left: 4px solid var(--theme-primary); margin-bottom: 30px; }
    .bio-box label { color: var(--theme-primary); font-size: 0.75rem; font-weight: bold; display: block; margin-bottom: 5px; font-family: 'Oswald'; letter-spacing: 1px; }
    .bio-box p { color: var(--theme-text-muted); font-style: italic; margin: 0; font-size: 0.95rem; }

 /* GALERÍA DE FOTOS */
    .gallery-section { width: 100%; margin-bottom: 20px; }
    .gallery-title { color: var(--theme-text); font-family: 'Oswald'; font-size: 1.1rem; border-bottom: 1px solid var(--theme-border); padding-bottom: 5px; margin-bottom: 15px; }
    .gallery-grid { display: flex; flex-direction: column; gap: 15px; width: 100%; }
    
    /* MODIFICACIÓN UX: Altura mínima y animación de carga */
    .gallery-item { 
        width: 100%; 
        border-radius: 12px; 
        overflow: hidden; 
        border: 1px solid var(--theme-border); 
        box-shadow: 0 5px 15px rgba(0,0,0,0.5); 
        cursor: pointer; 
        transition: transform 0.2s; 
        max-height: 400px; 
        min-height: 250px; 
        display: flex; 
        justify-content: center; 
        align-items: center; /* Centra la imagen cuando llegue */
        /* Animación Skeleton */
        background: linear-gradient(90deg, var(--theme-bg) 25%, var(--theme-card) 50%, var(--theme-bg) 75%);
        background-size: 200% 100%;
        animation: skeletonPulse 1.5s infinite linear;
        position: relative;
    }
    
    .gallery-item:active { transform: scale(0.98); }
    
    .gallery-item img { 
        width: 100%; 
        height: auto; 
        object-fit: contain; 
        max-height: 400px; 
        z-index: 2; /* Para que tape el fondo animado al cargar */
        color: transparent; /* Oculta el icono de 'imagen rota' nativo del navegador */
    }

    /* Animación del fondo (brillo viajando de izquierda a derecha) */
    @@keyframes skeletonPulse {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    /* ACCIONES (Match) */
    .actions-area { width: 100%; }
    
    /* El botón y los estilos de WhatsApp se mantienen intactos por su semántica global */
    .whatsapp-pill { background: #25D366; color: #000; padding: 12px 20px; border-radius: 12px; display: flex; align-items: center; gap: 15px; cursor: pointer; transition: 0.3s; margin-top: 15px; width: 100%; box-shadow: 0 6px 20px rgba(0,0,0,0.4); }
    .whatsapp-pill i { font-size: 1.8rem; }
    .btn-text-container { display: flex; flex-direction: column; text-align: left; }
    .main-btn-text { font-family: 'Oswald'; font-weight: bold; font-size: 0.85rem; line-height: 1.2; }
    .sub-btn-text { font-family: 'Roboto'; font-size: 0.8rem; font-weight: 900; opacity: 0.8; }
    .match-success-box { width: 100%; background: rgba(37, 211, 102, 0.05); border: 1px solid #25D366; border-radius: 15px; padding: 20px; text-align: center; }
    .match-badge { color: #25D366; font-family: 'Oswald'; font-size: 1.3rem; font-weight: bold; margin-bottom: 5px; }
    
    .match-sent-box { background: var(--theme-card); border: 1px dashed var(--theme-border); padding: 15px; border-radius: 10px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 5px; }
    
    .btn-match { width: 100%; padding: 16px; background: linear-gradient(45deg, var(--theme-primary), var(--theme-secondary)); border: none; border-radius: 50px; color: var(--theme-bg); font-weight: 900; font-family: 'Oswald'; font-size: 1.4rem; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3); transition: transform 0.1s; }
    .btn-match:active { transform: scale(0.95); }

    .spinner-container { display: flex; justify-content: center; align-items: center; padding-top: 100px; width: 100%; }
    .fade-in { animation: fadeIn 0.5s ease; }
    .pulse { animation: pulse 2s infinite; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.02); } 100% { transform: scale(1); } }

    /* ZOOM OVERLAY */
    .image-zoom-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.95); z-index: 5000; display: flex; justify-content: center; align-items: center; animation: fadeIn 0.3s; }
    .zoomed-image { max-width: 95%; max-height: 90vh; border-radius: 5px; box-shadow: 0 0 20px black; }
    
    /* --- CORRECCIÓN BOTÓN CERRAR ZOOM --- */
    .btn-close-zoom { 
        position: absolute; 
        /* Usamos env() para saltar el notch y sumamos 40px extras para que baje bien */
        top: calc(env(safe-area-inset-top) + 40px); 
        right: 20px; 
        background: rgba(255,255,255,0.2); 
        border: none; 
        color: white; 
        width: 50px; 
        height: 50px; 
        border-radius: 50%; 
        font-size: 1.5rem; 
        cursor: pointer; 
        display: flex; 
        justify-content: center; 
        align-items: center; 
        z-index: 5001; 
        box-shadow: 0 0 10px rgba(0,0,0,0.5);
    }

    /* PROGRESO PÚBLICO */
    .progress-section { width: 100%; margin-bottom: 25px; }
    .section-title { color: var(--theme-text); font-family: 'Oswald'; font-size: 1.1rem; border-bottom: 1px solid var(--theme-border); padding-bottom: 5px; margin-bottom: 15px; }
    
    .progress-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); 
        gap: 10px; 
    }

    .progress-card {
        background: var(--theme-card);
        border: 1px solid var(--theme-border);
        border-radius: 8px;
        padding: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }

    .ex-name { color: var(--theme-text-muted); font-size: 0.8rem; margin-bottom: 5px; font-family: 'Roboto'; font-weight: bold; text-transform: uppercase; }
    
    .ex-value .val { color: var(--theme-primary); font-family: 'Oswald'; font-size: 1.4rem; font-weight: bold; }
    .ex-value .unit { color: var(--theme-text-muted); font-size: 0.8rem; margin-left: 2px; }
</style>

@code {
    // --- ESTADO INICIAL NEUTRAL (PLATA MATE) ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    [Parameter] public Guid TargetUserId { get; set; }
    private DetallePublicoDto perfil;
    private bool mostrarAnimacionMatch = false;
    private string imagenZoomUrl = null;

    public class RegistroPublicoDto
    {
        public string NombreEjercicio { get; set; }
        public decimal MejorMarca { get; set; }
        public string Unidad { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // LEER EL CACHÉ LOCAL AL INSTANTE
        try 
        {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) 
            { 
                EstilosTema = cache; 
                StateHasChanged(); 
            }
        } 
        catch { }

        if (Sesion.Usuario == null) { Nav.NavigateTo("/"); return; }
        await CargarPerfil();
    }

    private async Task CargarPerfil()
    {
        try {
            var miId = Sesion.Usuario.UsuarioID;
            perfil = await Http.GetFromJsonAsync<DetallePublicoDto>($"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/SocialApi/detalle-publico/{TargetUserId}/{miId}");
        } catch (Exception ex) { 
            Console.WriteLine("Error cargando perfil público: " + ex.Message);
        }
    }

    private string NombrePrincipal
    {
        get
        {
            if (perfil == null) return "";
            if (perfil.UsarApodo && !string.IsNullOrWhiteSpace(perfil.Apodo))
            {
                return perfil.Apodo;
            }
            return perfil.NombreCompleto;
        }
    }

    private async Task HacerMatch()
    {
        try {
            var req = new LikeRequest { LikerID = Sesion.Usuario.UsuarioID, FotoID = TargetUserId };
            var resp = await Http.PostAsJsonAsync("https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/SocialApi/hacer-match", req);
            if (resp.IsSuccessStatusCode) {
                var result = await resp.Content.ReadFromJsonAsync<MatchResponseDto>();
                if (result.EsMatchMutuo) {
                    mostrarAnimacionMatch = true;
                    await CargarPerfil();
                } else {
                    await CargarPerfil();
                    await App.Current.MainPage.DisplayAlert("¡Listo!", "Tu interés ha sido enviado.", "OK");
                }
            }
        } catch { }
    }

    private async Task AbrirWhatsApp()
    {
        if (perfil?.WhatsappTarget == null) return;
        try {
            var url = $"https://wa.me/{perfil.WhatsappTarget.Replace("+", "").Replace(" ", "")}";
            await Browser.Default.OpenAsync(url, BrowserLaunchMode.External);
        } catch { }
    }

    private void VerImagenFull(string url)
    {
        imagenZoomUrl = url;
    }

    private void CerrarZoom()
    {
        imagenZoomUrl = null;
    }

    private void CerrarMatch() => mostrarAnimacionMatch = false;
    private void Volver() => Nav.NavigateTo("/entrenamos-juntos");
}