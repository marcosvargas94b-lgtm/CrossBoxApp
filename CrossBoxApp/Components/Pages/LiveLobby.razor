@page "/live-lobby"
@using Microsoft.AspNetCore.SignalR.Client
@using CrossBoxApp.Models.Services
@inject NavigationManager Nav
@inject SesionService Sesion
@inject HttpClient Http
@inject LiveSessionState LiveState
@inject IJSRuntime JS 
@implements IAsyncDisposable

<div class="rotate-warning">
    <div class="phone-animation">
        <i class="fas fa-mobile-alt"></i>
    </div>
    <h3>GIRA TU TELÉFONO</h3>
    <p>Para gestionar el Lobby en vivo, coloca tu dispositivo en horizontal.</p>
</div>

<div class="lobby-landscape">

    <div class="qr-section">
        <div class="qr-card fade-in">
            <h2 class="qr-title">ESCANEA PARA ENTRAR</h2>
            <div class="qr-frame">
                <img src="@($"https://quickchart.io/qr?text={Sesion.Usuario.BoxID}&size=400&dark=000000&light=ffffff")" 
                     class="qr-img" />
            </div>           
        </div>
    </div>

  <div class="controls-section">
        
        @* --- HEADER COMPACTO CON COMBOBOX INCORPORADO --- *@
        <div class="header-status fade-in">
            <div class="header-left">
                <div class="status-title">ATLETAS</div>
                <div class="badge-count pulse-badge">@atletasEnSala.Count</div>
            </div>
            
            <div class="header-right">
                <select @bind="HorarioSeleccionado" @bind:after="OnHorarioCambiado" class="form-control input-dark select-clase-compact">
                    <option value="@Guid.Empty">-- Selecciona --</option>
                    @foreach (var horario in listaHorarios)
                    {
                        <option value="@horario.HorarioID">@horario.Descripcion</option>
                    }
                </select>
            </div>
        </div>

        <div class="live-list-container">
            @if (cargandoAgenda)
            {
                <div class="empty-state">
                    <div class="spinner-border text-warning" style="width: 2rem; height: 2rem;"></div>
                </div>
            }
            else if (atletasEnSala.Count == 0)
            {
                <div class="empty-state">
                    <div class="radar-pulse">
                        <i class="fas fa-satellite-dish"></i>
                    </div>
                    <p style="font-size: 0.85rem;">Esperando señal...</p>
                </div>
            }
            else
            {
                <div class="athletes-scroll" id="scrollContainer">
                    @foreach (var atleta in atletasEnSala)
                    {
                        <div class="athlete-card slide-in">
                            @if (!string.IsNullOrEmpty(atleta.FotoUrl))
                            {
                                <img src="@atleta.FotoUrl" class="athlete-avatar" />
                            }
                            else
                            {
                                <div class="athlete-initial">
                                    @(atleta.NombreCompleto?.Substring(0, 1).ToUpper() ?? "A")
                                </div>
                            }

                            <div class="athlete-info">
                                <span class="athlete-name">@atleta.NombreCompleto</span>
                                <span class="athlete-time">
                                    @if(EsDeQR(atleta.UsuarioId))
                                    {
                                        <span style="color: #4CAF50;"><i class="fas fa-qrcode"></i> Escaneado</span>
                                    }
                                    else
                                    {
                                        <span><i class="fas fa-calendar-check"></i> Agendado</span>
                                    }
                                </span>
                            </div>
                            <i class="fas fa-check-circle check-icon"></i>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="action-buttons">
            <button class="btn-cancel" @onclick="CancelarClase">CANCELAR</button>
            <button class="btn-start" @onclick="IniciarClase">
                INICIAR <i class="fas fa-play" style="margin-left: 5px;"></i>
            </button>
        </div>
    </div>
</div>

<script>
    window.scrollToBottom = (elementId) => {
        var element = document.getElementById(elementId);
        if (element) {
            element.scrollTop = element.scrollHeight;
        }
    };
</script>

<style>
    /* --- BLOQUEO VERTICAL --- */
    .rotate-warning {
        position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
        background-color: #000; z-index: 9999;
        display: none; flex-direction: column; justify-content: center; align-items: center;
        color: #F8C545; text-align: center; padding: 40px;
    }
    .phone-animation { font-size: 4rem; margin-bottom: 20px; animation: rotarCelular 2s infinite ease-in-out; }
    @@keyframes rotarCelular { 0% { transform: rotate(0deg); } 50% { transform: rotate(-90deg); } 100% { transform: rotate(0deg); } }
    @@media (orientation: portrait) { .rotate-warning { display: flex; } .lobby-landscape { display: none !important; } }

    /* --- LAYOUT HORIZONTAL --- */
    .lobby-landscape {
        display: flex; width: 100vw; height: 100vh; background-color: #0d0d0d;
        padding: 15px; box-sizing: border-box; gap: 15px;
    }

    /* --- QR FIXED --- */
    .qr-section {
        flex: 1; display: flex; justify-content: center; align-items: center;
        background: radial-gradient(circle, #1a1a1a 0%, #000000 100%);
        border-radius: 20px; border: 1px solid #333; box-shadow: 0 0 30px rgba(0,0,0,0.5);
    }
    .qr-card { 
        text-align: center; width: 100%; 
        display: flex; flex-direction: column; align-items: center; 
    }
    .qr-title { font-family: 'Oswald'; font-size: 2rem; color: white; margin-bottom: 10px; letter-spacing: 2px; }
    
    .qr-frame { 
        background: white; padding: 12px; border-radius: 15px; 
        display: flex; justify-content: center; align-items: center;
        box-shadow: 0 0 40px rgba(248, 197, 69, 0.2);
        max-width: 75%; aspect-ratio: 1/1; 
    }
    
    .qr-img { width: 100%; height: 100%; max-width: 300px; object-fit: contain; }

    /* --- CONTROLES Y LISTA (Compactado) --- */
    .controls-section {
        flex: 1.2; 
        display: flex; flex-direction: column; background: #111;
        border-radius: 15px; 
        padding: 15px; 
        border: 1px solid #333;
        max-height: 100%; 
    }

    /* HEADER Y COMBOBOX EN LA MISMA LÍNEA */
    .header-status { 
        display: flex; justify-content: space-between; align-items: center; 
        border-bottom: 1px solid #333; padding-bottom: 10px; margin-bottom: 10px; flex-shrink: 0; gap: 10px;
    }
    .header-left { display: flex; align-items: center; gap: 8px; }
    .header-right { flex: 1; max-width: 180px; }

    .status-title { font-family: 'Oswald'; color: white; font-size: 1.3rem; margin-bottom: 0; }
    .badge-count { background: #F8C545; color: black; font-weight: bold; padding: 3px 12px; border-radius: 50px; font-size: 1rem; }
    .pulse-badge { animation: pulseBadge 2s infinite; }

    .select-clase-compact { 
        background-color: #222 !important; color: #F8C545 !important; 
        border: 1px solid #444; font-family: 'Oswald'; 
        font-size: 0.95rem; height: 38px; padding: 0 5px; width: 100%; text-align: center; border-radius: 8px;
    }

    /* SCROLL AREA */
    .live-list-container { flex: 1; overflow: hidden; position: relative; display: flex; flex-direction: column; }
    .athletes-scroll { overflow-y: auto; padding-right: 5px; height: 100%; scroll-behavior: smooth; }

    /* TARJETAS DE ATLETAS (Fotos en 50px, pero bordes ajustados) */
    .athlete-card {
        background: #222; border-left: 4px solid #F8C545; 
        padding: 8px 12px; margin-bottom: 8px;
        border-radius: 8px; display: flex; align-items: center; gap: 12px; 
        animation: slideIn 0.3s ease-out; 
    }

    .athlete-avatar { 
        width: 50px; height: 50px; border-radius: 50%; object-fit: cover; 
        border: 2px solid #555; flex-shrink: 0; 
    }

    .athlete-initial {
        width: 50px; height: 50px; background: #333; color: #F8C545; 
        border-radius: 50%; display: flex; align-items: center; justify-content: center;
        font-weight: bold; font-size: 1.5rem; border: 2px solid #555;
        flex-shrink: 0; font-family: 'Oswald';
    }

    .athlete-info { flex: 1; display: flex; flex-direction: column; justify-content: center; }
    .athlete-name { font-family: 'Oswald'; font-size: 1.1rem; color: white; text-transform: uppercase; line-height: 1.2; margin-bottom: 2px; }
    .athlete-time { font-size: 0.8rem; color: #888; }
    .check-icon { font-size: 1.3rem; color: #28a745; }

    .empty-state { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #444; }
    .radar-pulse { font-size: 3rem; margin-bottom: 10px; animation: pulseRadar 2s infinite; color: #F8C545; }

    /* BOTONES INFERIORES COMPACTOS */
    .action-buttons { display: flex; gap: 10px; margin-top: 10px; height: 50px; flex-shrink: 0; }
    .btn-cancel { flex: 1; background: #333; color: white; border: none; border-radius: 8px; font-weight: bold; font-family: 'Oswald'; font-size: 1rem; cursor: pointer; }
    .btn-start { flex: 2; background: #F8C545; color: black; border: none; border-radius: 8px; font-weight: bold; font-family: 'Oswald'; font-size: 1.1rem; cursor: pointer; box-shadow: 0 0 10px rgba(248, 197, 69, 0.3); }
    .btn-start:active { transform: scale(0.98); }

    @@keyframes slideIn { from { transform: translateX(50px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    @@keyframes pulseRadar { 0% { opacity: 0.3; transform: scale(1); } 50% { opacity: 1; transform: scale(1.1); } 100% { opacity: 0.3; transform: scale(1); } }
    @@keyframes pulseBadge { 0% { box-shadow: 0 0 0 0 rgba(248, 197, 69, 0.7); } 70% { box-shadow: 0 0 0 10px rgba(248, 197, 69, 0); } 100% { box-shadow: 0 0 0 0 rgba(248, 197, 69, 0); } }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    .fade-in { animation: fadeIn 1s ease-in; }
</style>
@code {
    // Para simplificar la lista de horarios localmente (Asegúrate de que esta clase exista o usa una propia)
    public class HorarioSimple { public Guid HorarioID { get; set; } public string Descripcion { get; set; } }

    private HubConnection hubConnection;
    
    // LISTAS DE MANEJO DE ESTADO
    private List<CheckInDto> atletasEnSala = new List<CheckInDto>(); // La lista maestra que se muestra
    private List<CheckInDto> atletasPorQR = new List<CheckInDto>();  // Los "inmunes" escaneados en vivo
    private List<CheckInDto> atletasPorAgenda = new List<CheckInDto>(); // Los que vienen de la BD según el combo

    // COMBOBOX
    private List<HorarioSimple> listaHorarios = new List<HorarioSimple>();
    private Guid HorarioSeleccionado { get; set; } = Guid.Empty;
    private bool cargandoAgenda = false;

    protected override async Task OnInitializedAsync()
    {
        if (Sesion.Usuario == null) { Nav.NavigateTo("/"); return; }

        // 1. Cargar Combobox de horarios (usando tu endpoint existente)
        await CargarHorariosDelBox();

        // 2. Conectar SignalR para los QR
        hubConnection = new HubConnectionBuilder()
            .WithUrl("https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/livehub")
            .WithAutomaticReconnect()
            .Build();

        hubConnection.Reconnected += async (connectionId) =>
         {
             // Si el internet parpadea, nos volvemos a unir a la sala del Box
             await hubConnection.SendAsync("JoinBoxGroup", Sesion.Usuario.BoxID.ToString());
         };

        hubConnection.On<CheckInDto>("NuevoAtletaEnClase", (atleta) =>
        {
            InvokeAsync(async () =>
            {
                // Si NO está en la lista maestra, lo agregamos a la maestra y a la de QR (inmunes)
                if (!atletasEnSala.Any(x => x.UsuarioId == atleta.UsuarioId))
                {
                    atletasPorQR.Add(atleta);
                    FusionarListas(); // Vuelve a juntar QR + Agenda para mostrar
                    
                    try {
                        await JS.InvokeVoidAsync("scrollToBottom", "scrollContainer");
                    } catch { /* Ignorar */ }
                }
            });
        });

        await hubConnection.StartAsync();
        await hubConnection.SendAsync("JoinBoxGroup", Sesion.Usuario.BoxID.ToString());
    }

    private async Task CargarHorariosDelBox()
    {
        try
        {
            
            var response = await Http.GetAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/agendaapi/lista-horarios/{Sesion.Usuario.BoxID}");
            if (response.IsSuccessStatusCode)
            {
                listaHorarios = await response.Content.ReadFromJsonAsync<List<HorarioSimple>>();
            }
        }
        catch { }
    }

    // Este evento se dispara cada vez que el Coach mueve el combobox
    private async Task OnHorarioCambiado()
    {
        if (HorarioSeleccionado == Guid.Empty)
        {
            // Si elige "Selecciona clase", vaciamos los de agenda y mostramos solo los de QR
            atletasPorAgenda.Clear();
            FusionarListas();
            return;
        }

        try
        {
            cargandoAgenda = true;
            StateHasChanged();

            // Llamamos al nuevo endpoint que creaste en el PASO 1
            var response = await Http.GetAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/agendaapi/lobby-agendados/{Sesion.Usuario.BoxID}/{HorarioSeleccionado}");
            
            if (response.IsSuccessStatusCode)
            {
                var agendados = await response.Content.ReadFromJsonAsync<List<CheckInDto>>();
                if (agendados != null)
                {
                    atletasPorAgenda = agendados; // Reemplazamos totalmente la lista de la agenda
                }
            }
            else
            {
                atletasPorAgenda.Clear();
            }
        }
        catch 
        {
            atletasPorAgenda.Clear();
            await App.Current.MainPage.DisplayAlert("Error", "No se pudo cargar la agenda de esta hora", "OK");
        }
        finally
        {
            cargandoAgenda = false;
            FusionarListas(); // Junta QR + Agenda y actualiza pantalla
        }
    }

    // El truco principal: Une los que llegaron por QR con los de la BD, evitando duplicados
    private void FusionarListas()
    {
        var listaFusionada = new List<CheckInDto>();

        // Primero metemos a los del QR
        listaFusionada.AddRange(atletasPorQR);

        // Luego metemos a los de la agenda, SOLO SI no estaban ya metidos por QR
        foreach (var agendado in atletasPorAgenda)
        {
            if (!listaFusionada.Any(x => x.UsuarioId == agendado.UsuarioId))
            {
                listaFusionada.Add(agendado);
            }
        }

        atletasEnSala = listaFusionada;
        StateHasChanged();
    }

    // Helper visual
    private bool EsDeQR(Guid usuarioId)
    {
        return atletasPorQR.Any(x => x.UsuarioId == usuarioId);
    }

    private void CancelarClase()
    {
        atletasEnSala.Clear();
        atletasPorQR.Clear();
        atletasPorAgenda.Clear();
        Nav.NavigateTo("/home");
    }

    private void IniciarClase()
    {
        // if(atletasEnSala.Count == 0)
        // {
        //     App.Current.MainPage.DisplayAlert("Atención", "No hay atletas en la sala.", "OK");
        //     return;
        // }

        // LiveState se lleva a TODOS los que estén en la pantalla (QR + Agenda)
        LiveState.AtletasEnClase = atletasEnSala;
        LiveState.BoxId = Sesion.Usuario.BoxID;
        Nav.NavigateTo("/live-dashboard");
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}