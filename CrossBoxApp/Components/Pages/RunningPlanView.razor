@code {
    // --- ESTADO INICIAL NEUTRAL (PLATA MATE) ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    [Parameter] public Guid TargetUserId { get; set; }
    [Parameter] public string NombreAtleta { get; set; }

    private DateTime fechaActual = DateTime.Today;
    private List<RunningLogs> logsDelMes = new List<RunningLogs>();
    private int diasEnMes;
    private int diasVaciosInicio;

    // AÑADIDO: VARIABLES PARA IA STORY CREATOR Y PREVIEWS
    private RunningLogs logDeHoy;
    private bool mostrarModalHistoria = false;
    private bool generandoHistoria = false;
    private string historiaGeneradaBase64 = null;
    private FileResult mapaHistoria = null;
    private string previewMapaHistoria = null;
    private FileResult fotoAtleta = null;
    private string previewFotoAtleta = null;
    private bool incluirTituloHistoria = true;
    private bool incluirDescHistoria = true;
    private string tituloHistoria = "";
    private string descripcionHistoria = "";

    private bool mostrarModal = false;
    private bool guardando = false;
    private bool mostrarExitoAnimacion = false;
    private string mensajeExitoAnimacion = "";
    private RunningLogs logEditando = new RunningLogs();
    private DateTime fechaSeleccionada;
    private bool yaEstabaVerificado = false; 
    
    private string semanaSeleccionadaId;
    public string SemanaSeleccionadaBind 
    {
        get => semanaSeleccionadaId;
        set { semanaSeleccionadaId = value; }
    }

    private bool acreditando = false;
    private List<SemanaItem> listaSemanasAnio = new();
    private List<string> semanasAcreditadasHistorial = new();

    private string imagenExpandida = null;
    
    // AÑADIDO PARA LA EVIDENCIA (PARCIALES)
    private List<FileResult> archivosEvidencia = new();
    private List<string> previewsEvidencia = new();

    public class SemanaItem { public string IdUnico { get; set; } public string Texto { get; set; } }
    public class ImagenRespuesta { public string imagenUrl { get; set; } }

    class TipoEntreno { public string Nombre { get; set; } public string Color { get; set; } }

    private List<TipoEntreno> TiposEntreno = new List<TipoEntreno>
    {
        new TipoEntreno { Nombre = "Acumulativo", Color = "#00BFFF" },
        new TipoEntreno { Nombre = "Intensidad", Color = "#FF4500" },
        new TipoEntreno { Nombre = "Tempo", Color = "#FF8C00" },
        new TipoEntreno { Nombre = "Cuestas", Color = "#9370DB" },
        new TipoEntreno { Nombre = "Fuerza", Color = "#808080" },
        new TipoEntreno { Nombre = "Regenerativo", Color = "#32CD32" },
        new TipoEntreno { Nombre = "Otro", Color = "" } // Si es vacio, tomará el color de var(--theme-primary)
    };

    public class RunningLogs
    {
        public Guid RunningLogID { get; set; }
        public Guid UsuarioID { get; set; }
        public DateTime Fecha { get; set; }
        public string Titulo { get; set; }
        public string Descripcion { get; set; }
        public string Tipo { get; set; }
        public bool? Realizado { get; set; }
        public int? RPE { get; set; }
        public string ComentariosAtleta { get; set; }
        public bool? CoachVerificado { get; set; } 
        public string EvidenciaUrl { get; set; } 
    }

    protected override async Task OnInitializedAsync()
    {
        // LEER EL CACHÉ LOCAL AL INSTANTE
        try 
        {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) 
            { 
                EstilosTema = cache; 
                StateHasChanged(); 
            }
        } 
        catch { }

        GenerarSemanasDelAnio();
        await CargarHistorialAcreditadas();
        await CargarCalendario();
    }

    private async Task CargarHistorialAcreditadas()
    {
        try
        {
            semanasAcreditadasHistorial = await Http.GetFromJsonAsync<List<string>>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/runningapi/semanas-acreditadas/{TargetUserId}") ?? new List<string>();
        }
        catch { semanasAcreditadasHistorial = new List<string>(); }
    }

    private async Task CargarCalendario()
    {
        diasEnMes = DateTime.DaysInMonth(fechaActual.Year, fechaActual.Month);
        var primerDiaMes = new DateTime(fechaActual.Year, fechaActual.Month, 1);
        diasVaciosInicio = (int)primerDiaMes.DayOfWeek;

        try
        {
            logsDelMes = await Http.GetFromJsonAsync<List<RunningLogs>>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/runningapi/plan/{TargetUserId}/{fechaActual.Month}/{fechaActual.Year}");
            // Aseguramos cargar el logDeHoy para el Creador de Historias IA
            logDeHoy = logsDelMes.FirstOrDefault(l => l.Fecha.Date == DateTime.Today.Date);
        }
        catch { logsDelMes = new List<RunningLogs>(); }
    }

    private void GenerarSemanasDelAnio()
    {
        listaSemanasAnio.Clear();
        DateTime inicioAnio = new DateTime(DateTime.Today.Year, 1, 1);

        while (inicioAnio.DayOfWeek != DayOfWeek.Monday) inicioAnio = inicioAnio.AddDays(1);

        int numSemana = 1;
        DateTime fechaPivote = inicioAnio;

        while (fechaPivote <= DateTime.Today)
        {
            DateTime finSemana = fechaPivote.AddDays(6);
            string clave = $"{DateTime.Today.Year}-W{numSemana}";

            listaSemanasAnio.Add(new SemanaItem
            {
                IdUnico = clave,
                Texto = $"Semana {numSemana}: {fechaPivote:dd/MM} al {finSemana:dd/MM}"
            });

            fechaPivote = fechaPivote.AddDays(7);
            numSemana++;
        }

        if (listaSemanasAnio.Any())
            semanaSeleccionadaId = listaSemanasAnio.Last().IdUnico;
    }

    private async Task AcreditarSemana()
    {
        bool confirm = await App.Current.MainPage.DisplayAlert("Acreditar Semana",
            $"¿Confirmas que {NombreAtleta} cumplió con su entrenamiento? Se sumará a su Ficha Running.", "SÍ", "CANCELAR");

        if (!confirm) return;

        acreditando = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/runningapi/acreditar-semana/{TargetUserId}", semanaSeleccionadaId);
            
            if (response.IsSuccessStatusCode)
            {
                await CargarHistorialAcreditadas(); 
                
                // MUESTRA LA ANIMACIÓN
                mensajeExitoAnimacion = "Semana cobrada al perfil del atleta.";
                mostrarExitoAnimacion = true;
                StateHasChanged();
                await Task.Delay(1800);
                mostrarExitoAnimacion = false;
                StateHasChanged();
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                await App.Current.MainPage.DisplayAlert("Aviso", "No se pudo acreditar: " + errorMsg, "OK");
            }
        }
        catch (Exception ex) { await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK"); }
        finally { acreditando = false; }
    }

    private RunningLogs ObtenerLog(int dia) => logsDelMes.FirstOrDefault(l => l.Fecha.Day == dia);

    private string ObtenerColor(string tipo)
    {
        var t = TiposEntreno.FirstOrDefault(x => x.Nombre == tipo);
        return t != null && !string.IsNullOrEmpty(t.Color) ? t.Color : "var(--theme-primary)";
    }

    private async Task MesAnterior() { fechaActual = fechaActual.AddMonths(-1); await CargarCalendario(); }
    private async Task MesSiguiente() { fechaActual = fechaActual.AddMonths(1); await CargarCalendario(); }

    private void AbrirModal(int dia)
    {
        fechaSeleccionada = new DateTime(fechaActual.Year, fechaActual.Month, dia);
        var existente = ObtenerLog(dia);

        if (existente != null)
        {
            yaEstabaVerificado = (existente.CoachVerificado == true);

            logEditando = new RunningLogs
            {
                RunningLogID = existente.RunningLogID,
                UsuarioID = existente.UsuarioID,
                Fecha = existente.Fecha,
                Titulo = existente.Titulo,
                Descripcion = existente.Descripcion,
                Tipo = existente.Tipo,
                Realizado = existente.Realizado,
                RPE = existente.RPE,
                ComentariosAtleta = existente.ComentariosAtleta,
                CoachVerificado = existente.CoachVerificado,
                EvidenciaUrl = existente.EvidenciaUrl
            };
        }
        else
        {
            yaEstabaVerificado = false;
            logEditando = new RunningLogs
            {
                UsuarioID = TargetUserId,
                Fecha = fechaSeleccionada,
                Tipo = "Acumulativo",
                Titulo = "",
                Descripcion = "",
                CoachVerificado = false
            };
        }
        
        archivosEvidencia.Clear();
        previewsEvidencia.Clear();
        
        mostrarModal = true;
    }

    private void ToggleRealizado()
    {
        bool estadoActual = logEditando.Realizado ?? false;
        logEditando.Realizado = !estadoActual;
    }
    
    private void SeleccionarRPE(int valor) => logEditando.RPE = valor;

    private async Task AgregarFotoEvidencia()
    {
        try
        {
            FileResult resultado = null;
            await MainThread.InvokeOnMainThreadAsync(async () =>
            {
                try { resultado = await MediaPicker.Default.PickPhotoAsync(); } catch { }
            });

            if (resultado != null)
            {
                archivosEvidencia.Add(resultado);

                using var stream = await resultado.OpenReadAsync();
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                previewsEvidencia.Add($"data:image/jpeg;base64,{base64}");
                
                StateHasChanged();
            }
        }
        catch { await App.Current.MainPage.DisplayAlert("Aviso", "No se pudo cargar la imagen.", "OK"); }
    }

    private void QuitarFoto(int index)
    {
        archivosEvidencia.RemoveAt(index);
        previewsEvidencia.RemoveAt(index);
    }

    private void VerImagenExpandida(string url)
    {
        imagenExpandida = url;
    }

    private void CerrarImagenExpandida()
    {
        imagenExpandida = null;
    }

    private void SeleccionarTipo(string tipo) => logEditando.Tipo = tipo;

    private async Task GuardarLog()
    {
        if (string.IsNullOrEmpty(logEditando.Titulo))
        {
            await App.Current.MainPage.DisplayAlert("Falta Título", "Pon una instrucción breve", "OK");
            return;
        }
        if (logEditando.Descripcion == null) logEditando.Descripcion = "";

        guardando = true;
        StateHasChanged();

        try
        {
            // El Coach manda el JSON limpio al endpoint correcto de Guardado general
            var resp = await Http.PostAsJsonAsync("https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/runningapi/guardar", logEditando);

            if (resp.IsSuccessStatusCode)
            {
                mostrarModal = false;
                await CargarCalendario();

                // MUESTRA LA ANIMACIÓN EN LUGAR DEL ALERT
                mensajeExitoAnimacion = "Rutina guardada correctamente.";
                mostrarExitoAnimacion = true;
                StateHasChanged();
                await Task.Delay(1800);
                mostrarExitoAnimacion = false;
                StateHasChanged();
            }
            else
            {
                var error = await resp.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(error)) error = resp.StatusCode.ToString();

                await App.Current.MainPage.DisplayAlert("Error", $"API: {error}", "OK");
            }
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK");
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private async Task EliminarLog()
    {
        bool confirm = await App.Current.MainPage.DisplayAlert("Borrar", "¿Quitar este entrenamiento?", "Sí", "No");
        if (!confirm) return;

        try
        {
            var resp = await Http.PostAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/runningapi/eliminar/{logEditando.RunningLogID}", null);
            if (resp.IsSuccessStatusCode)
            {
                mostrarModal = false;
                await CargarCalendario();
            }
        }
        catch { }
    }

    private string ObtenerColorRPE(int valor)
    {
        if (valor <= 2) return "#32CD32"; 
        if (valor <= 4) return "#ADFF2F"; 
        if (valor <= 6) return "#FFD700"; 
        if (valor <= 8) return "#FF8C00"; 
        return "#FF0000"; 
    }

