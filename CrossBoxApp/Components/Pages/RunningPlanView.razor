@page "/running-plan/{TargetUserId:guid}/{NombreAtleta}"
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@using System.Net.Http.Headers
@using Microsoft.Maui.Media
@using System.IO
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS

@* ENVOLVEMOS TODA LA PÁGINA EN EL TEMA GLOBAL *@
<div style="@EstilosTema">

    <div class="main-layout">

        <div class="navbar-container">
            <div class="nav-left" @onclick="Volver">
                <i class="fas fa-arrow-left"></i> VOLVER
            </div>
            <div class="nav-center">
                <div class="nav-title-main">RUNNING PLAN</div>
                <div class="nav-title-sub">@NombreAtleta.Split(' ')[0].ToUpper()</div>
            </div>
            <div class="nav-right"></div>
        </div>

        <div class="scrollable-content">
            
            <div class="month-control fade-in">
                <button class="btn-nav" @onclick="MesAnterior"><i class="fas fa-chevron-left"></i></button>
                <span class="month-label">@fechaActual.ToString("MMMM yyyy").ToUpper()</span>
                <button class="btn-nav" @onclick="MesSiguiente"><i class="fas fa-chevron-right"></i></button>
            </div>

            <div class="calendar-grid fade-in">
                <div class="day-name">DOM</div> <div class="day-name">LUN</div> <div class="day-name">MAR</div>
                <div class="day-name">MIE</div> <div class="day-name">JUE</div> <div class="day-name">VIE</div>
                <div class="day-name">SAB</div>

                @for (int i = 0; i < diasVaciosInicio; i++)
                {
                    <div class="calendar-day empty"></div>
                }

                @for (int dia = 1; dia <= diasEnMes; dia++)
                {
                    int diaActual = dia;
                    var log = ObtenerLog(diaActual);
                    bool tieneData = log != null;
                    bool estaRealizado = tieneData && (log.Realizado == true);

                    bool esHoy = (fechaActual.Year == DateTime.Today.Year && 
                                  fechaActual.Month == DateTime.Today.Month && 
                                  diaActual == DateTime.Today.Day);

                    // Reemplazo de colores duros por variables
                    string colorBorde = tieneData ? ObtenerColor(log.Tipo) : "var(--theme-border)";
                    string bgDia = tieneData ? "var(--theme-card)" : "var(--theme-bg)";
                    string opacidad = tieneData ? "1" : "0.5";

                    <div class="calendar-day @(esHoy ? "dia-actual-pulse" : "")"
                         style="border-color: @colorBorde; background: @bgDia; opacity: @opacidad"
                         @onclick="() => AbrirModal(diaActual)">

                        <span class="day-number" style="color: @(tieneData? colorBorde : "var(--theme-text-muted)")">@dia</span>

                        @if (tieneData)
                        {
                            <div class="day-content">
                                <i class="fas fa-running running-icon" style="color: @colorBorde"></i>
                                <span class="day-type" style="color: @colorBorde">@log.Tipo</span>
                            </div>

                            @if (estaRealizado)
                            {
                                <div class="done-badge"><i class="fas fa-check"></i></div>
                            }
                        }
                    </div>
                }
            </div>

            <div class="legend-scroll">
                @foreach (var t in TiposEntreno)
                {
                    <div class="legend-item"><span class="dot" style="background:@t.Color"></span> @t.Nombre</div>
                }
            </div>
            
            <div class="week-accreditation-box fade-in mt-4">
                <div class="week-header">
                    <i class="fas fa-medal" style="color: var(--theme-primary);"></i>
                    <span>ACREDITAR SEMANA</span>
                </div>

                <div class="week-controls">
                    <select @bind="SemanaSeleccionadaBind" class="form-select input-dark week-select">
                        @foreach (var sem in listaSemanasAnio)
                        {
                            <option value="@sem.IdUnico">@sem.Texto</option>
                        }
                    </select>

                    @{
                        bool yaAcreditada = semanasAcreditadasHistorial.Contains(semanaSeleccionadaId);
                    }

                    <button class="btn-accredit @(yaAcreditada ? "btn-accredit-done" : "")" 
                            @onclick="AcreditarSemana" 
                            disabled="@(acreditando || yaAcreditada)">
                        @if (acreditando)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                        }
                        else if (yaAcreditada)
                        {
                            <i class="fas fa-check-double"></i>
                            <span>Acreditada</span>
                        }
                        else
                        {
                            <i class="fas fa-check-circle"></i>
                            <span>Acreditar</span>
                        }
                    </button>
                </div>
                <small class="watermark-text">Debió cumplir el 75% del plan para sumar la semana.</small>
            </div>

            @* --- SECCIÓN: GENERADOR DE HISTORIAS CON IA --- *@
            @if (logDeHoy != null && logDeHoy.Realizado == true)
            {
                <div class="story-generator-card fade-in mt-4">
                    <div class="story-header">
                        <div class="ig-icon-container">
                            <i class="fas fa-bolt" style="color: var(--theme-primary); font-size: 1.8rem;"></i>
                        </div>
                        <div class="story-title-box">
                            <h4>¡ENTRENO SUPERADO!</h4>
                            <p>Genera una historia épica con IA.</p>
                        </div>
                    </div>
                    <button class="btn-create-story" @onclick="AbrirModalHistoria">
                        <i class="fas fa-magic"></i> CREAR HISTORIA IA
                    </button>
                </div>
            }
            
            <div style="height: 40px;"></div>
        </div>
    </div>

    @* --- PANTALLA ANIMADA DE ÉXITO (NUEVO) --- *@
    @if (mostrarExitoAnimacion)
    {
        <div class="success-overlay">
            <div class="success-content bounce-in">
                <div class="success-icon-container">
                    <i class="fas fa-check"></i>
                </div>
                <h2 style="color: white;">¡HECHO!</h2>
                <p style="color: var(--theme-primary);">@mensajeExitoAnimacion</p>
            </div>
        </div>
    }

    @* --- MODAL FEEDBACK NORMAL --- *@
    @* --- MODAL ASIGNAR PLAN / VER FEEDBACK (COACH) --- *@
    @if (mostrarModal && logEditando != null)
    {
        <div class="modal-overlay fade-in">
            <div class="modal-content custom-modal slide-up">

                <div class="modal-header" style="background: @ObtenerColor(logEditando.Tipo)">
                    <div class="header-info">
                        <span class="header-date">@fechaSeleccionada.ToString("dd MMMM").ToUpper()</span>
                        <span class="header-type">@logEditando.Tipo</span>
                    </div>
                    <button class="btn-close-custom" @onclick="CerrarModal"><i class="fas fa-times" style="color:black;"></i></button>
                </div>
                <div class="modal-body">

                    @* --- SECCIÓN 1: FEEDBACK DEL ATLETA Y VALIDACIÓN (SOLO VISIBLE SI YA LO HIZO) --- *@
                    @if (logEditando.Realizado == true)
                    {
                        <div class="coach-card mb-4" style="border-left-color: #28a745;">
                            <div class="card-label" style="color: #28a745;"><i class="fas fa-check-circle"></i> FEEDBACK DEL ATLETA</div>

                            <div class="mt-2">
                                <span style="font-weight: bold; color: var(--theme-text);">Intensidad (RPE): </span>
                                <span style="color: @ObtenerColorRPE(logEditando.RPE ?? 0); font-weight: bold; font-size: 1.2rem;">@(logEditando.RPE ?? 0)/10</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(logEditando.ComentariosAtleta))
                            {
                                <div class="mt-2 p-2" style="background: rgba(0,0,0,0.3); border-radius: 8px; border: 1px solid var(--theme-border);">
                                    <p style="color: var(--theme-text); font-style: italic; margin: 0; font-size: 0.9rem;">"@logEditando.ComentariosAtleta"</p>
                                </div>
                            }
                            else
                            {
                                <p style="color: var(--theme-text-muted); font-size: 0.8rem; margin-top: 5px;">Sin comentarios adicionales.</p>
                            }

                            @if (!string.IsNullOrEmpty(logEditando.EvidenciaUrl))
                            {
                                <div class="mt-3">
                                    <span style="font-weight: bold; font-size: 0.85rem; color: var(--theme-text-muted);"><i class="fas fa-camera"></i> EVIDENCIA:</span>
                                    <div class="evidence-box mt-2" @onclick='() => VerImagenExpandida($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/imagenes/running/{logEditando.EvidenciaUrl}")'>
                                        <img src="https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/imagenes/running/@logEditando.EvidenciaUrl" />
                                    </div>
                                </div>
                            }
                        </div>

                        @* EL SWITCH DE VALIDAR ASISTENCIA AHORA ESTÁ AQUÍ ADENTRO *@
                        <div class="coach-verification-box fade-in @(yaEstabaVerificado ? "verified-locked" : "")" style="margin-bottom: 20px;">
                            <div style="flex:1; padding-right:10px;">
                                <label style="color: var(--theme-primary); font-family:'Oswald'; font-size:1rem; margin-bottom:2px; display:block;">
                                    <i class="fas fa-check-double"></i> VALIDAR ASISTENCIA
                                </label>
                                @if (yaEstabaVerificado)
                                {
                                    <span style="color: #28a745; font-size: 0.75rem; line-height:1.2; display:block; font-weight: bold;">
                                        <i class="fas fa-lock"></i> Asistencia validada y sumada.
                                    </span>
                                }
                                else
                                {
                                    <span style="color: var(--theme-text-muted); font-size: 0.75rem; line-height:1.2; display:block;">
                                        Al encenderlo, se sumará +1 día de entrenamiento a su ficha anual.
                                    </span>
                                }
                            </div>
                            <label class="switch @(yaEstabaVerificado ? "disabled-switch" : "")">
                                <input type="checkbox" @bind="logEditando.CoachVerificado" disabled="@yaEstabaVerificado">
                                <span class="slider round"></span>
                            </label>
                        </div>

                        <div class="action-divider"></div>
                    }

                    @* --- SECCIÓN 2: ASIGNACIÓN DEL PLAN (SIEMPRE VISIBLE) --- *@
                    <label class="lbl-input">Tipo de Sesión:</label>
                    <div class="type-grid mb-3">
                        @foreach (var tipo in TiposEntreno)
                        {
                            <div class="type-btn @(logEditando.Tipo == tipo.Nombre ? "selected" : "")"
                                 style="border-color: @(string.IsNullOrEmpty(tipo.Color) ? "var(--theme-primary)" : tipo.Color); color: @(logEditando.Tipo == tipo.Nombre ? "black" : "var(--theme-text)"); background: @(logEditando.Tipo == tipo.Nombre ? (string.IsNullOrEmpty(tipo.Color) ? "var(--theme-primary)" : tipo.Color) : "transparent")"
                                 @onclick="() => SeleccionarTipo(tipo.Nombre)">
                                @tipo.Nombre
                            </div>
                        }
                    </div>

                    <label class="lbl-input">Instrucciones Breves (Título):</label>
                    <input @bind="logEditando.Titulo" class="form-control input-dark mb-3" placeholder="Ej: 12k Ritmo Carrera" />

                    <label class="lbl-input">Detalles / Instrucciones Completas:</label>
                    <textarea @bind="logEditando.Descripcion" class="form-control input-dark" rows="4" placeholder="Desglosa el calentamiento, bloques principales..."></textarea>
                </div>

                <div class="modal-footer">
                    @if (logEditando.RunningLogID != Guid.Empty)
                    {
                        <button class="btn-delete" @onclick="EliminarLog" disabled="@guardando"><i class="fas fa-trash"></i></button>
                    }
                    <button class="btn-confirm" @onclick="GuardarLog" disabled="@guardando">
                        @if (guardando)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                        }
                        else
                        {

                            <span>GUARDAR CAMBIOS</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

  @if (mostrarModalHistoria)
    {
        <div class="modal-overlay fade-in">
            <div class="modal-content custom-modal slide-up" style="background-color: var(--theme-bg);">
                
                <div class="modal-header" style="background: linear-gradient(45deg, #f09433, #bc1888); border:none;">
                    <h5 style="margin:0; font-family:'Oswald'; color:white; letter-spacing:1px;">IA STORY CREATOR</h5>
                    <button class="btn-close-custom" @onclick="CerrarModalHistoria"><i class="fas fa-times" style="color:white;"></i></button>
                </div>

                <div class="modal-body">
                    @if (string.IsNullOrEmpty(historiaGeneradaBase64))
                    {
                        <div class="story-upload-grid">
                            @* CAJA 1: MAPA STRAVA *@
                            <div class="upload-col">
                                <label>1. TU RELOJ O MAPA STRAVA</label>
                                <div class="map-picker-box story-aspect @(mapaHistoria != null ? "has-image" : "")" @onclick="SeleccionarMapaHistoria">
                                    @if (previewMapaHistoria != null)
                                    {
                                        <img src="@previewMapaHistoria" class="map-preview-img" />
                                        <div class="map-picker-overlay"><i class="fas fa-sync-alt"></i> Cambiar</div>
                                    }
                                    else
                                    {
                                        <i class="fas fa-map-marked-alt map-icon"></i>
                                    }
                                </div>
                            </div>

                            @* CAJA 2: SELFIE *@
                            <div class="upload-col">
                                <label>2. TU FOTO DE HOY</label>
                                <div class="map-picker-box story-aspect @(fotoAtleta != null ? "has-image" : "")" @onclick="SeleccionarFotoAtleta">
                                    @if (previewFotoAtleta != null)
                                    {
                                        <img src="@previewFotoAtleta" class="map-preview-img" />
                                        <div class="map-picker-overlay"><i class="fas fa-sync-alt"></i> Cambiar</div>
                                    }
                                    else
                                    {
                                        <i class="fas fa-user-circle map-icon"></i>
                                    }
                                </div>
                            </div>
                        </div>

                       <div class="story-switches mt-2">
                            <div class="switch-row">
                                <span style="color: var(--theme-text);"><i class="fas fa-heading"></i> Incluir Título del Entreno</span>
                                <label class="switch">
                                    <input type="checkbox" @bind="incluirTituloHistoria">
                                    <span class="slider round"></span>
                                </label>
                            </div>
                            
                            @* --- CAJA EDITABLE PARA EL TÍTULO --- *@
                            @if (incluirTituloHistoria)
                            {
                                <div class="fade-in mt-2 mb-3">
                                    <label style="color: var(--theme-primary); font-size: 0.75rem; font-weight: bold; margin-bottom: 5px; display: block; font-family:'Oswald';">
                                        <i class="fas fa-edit"></i> EDITAR TÍTULO:
                                    </label>
                                    <input type="text" @bind="tituloHistoria" class="feedback-textarea" style="min-height: 40px; padding: 10px; font-size: 0.85rem;" placeholder="Ej: 10 KM TEMPO" />
                                </div>
                            }

                            <div class="switch-row mt-2">
                                <span style="color: var(--theme-text);"><i class="fas fa-align-left"></i> Incluir Descripción</span>
                                <label class="switch">
                                    <input type="checkbox" @bind="incluirDescHistoria">
                                    <span class="slider round"></span>
                                </label>
                            </div>
                            
                            @* --- CAJA EDITABLE PARA LA DESCRIPCIÓN --- *@
                            @if (incluirDescHistoria)
                            {
                                <div class="fade-in mt-2">
                                    <label style="color: var(--theme-primary); font-size: 0.75rem; font-weight: bold; margin-bottom: 5px; display: block; font-family:'Oswald';">
                                        <i class="fas fa-edit"></i> EDITAR DESCRIPCIÓN:
                                    </label>
                                    <textarea @bind="descripcionHistoria" class="feedback-textarea" style="min-height: 70px; font-size: 0.8rem;" placeholder="Acomoda tu texto..."></textarea>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        // --- RESULTADO GENERADO ---
                        <div class="story-result-container fade-in">
                            <img src="@historiaGeneradaBase64" class="story-final-img" />
                            <p class="mt-3 text-center" style="color:var(--theme-text-muted); font-size:0.8rem;">
                                ¡Épico! Mantén presionada la imagen para guardarla o usa el botón de abajo.
                            </p>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    @if (string.IsNullOrEmpty(historiaGeneradaBase64))
                    {
                        <button class="btn-cancel" @onclick="CerrarModalHistoria">CANCELAR</button>
                        <button class="btn-save" @onclick="GenerarHistoriaApi" disabled="@(mapaHistoria == null || fotoAtleta == null || generandoHistoria)">
                            @if(generandoHistoria) { <i class="fas fa-spinner fa-spin"></i> <span>GENERANDO...</span> }
                            else { <i class="fas fa-magic"></i> <span>GENERAR</span> }
                        </button>
                    }
                    else
                    {
                        <button class="btn-cancel" @onclick="() => historiaGeneradaBase64 = null">ATRAS</button>
                        <button class="btn-save" @onclick="CompartirHistoria">
                            <i class="fas fa-share-alt"></i> COMPARTIR
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(imagenExpandida))
    {
        <div class="lightbox-overlay fade-in" @onclick="CerrarImagenExpandida">
            <button class="btn-close-lightbox" @onclick="CerrarImagenExpandida"><i class="fas fa-times"></i></button>
            <img src="@imagenExpandida" class="lightbox-img zoom-in" @onclick:stopPropagation="true" />
        </div>
    }
</div>

<style>
    /* --- ESTRUCTURA BASE --- */
    .main-layout { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--theme-bg); display: flex; flex-direction: column; z-index: 1; }

    .navbar-container { flex-shrink: 0; padding-top: calc(env(safe-area-inset-top) + 10px); padding-bottom: 10px; padding-left: 20px; padding-right: 20px; background-color: var(--theme-bg); border-bottom: 1px solid var(--theme-primary); color: var(--theme-text); display: grid; grid-template-columns: 80px 1fr 80px; align-items: center; z-index: 100; font-family: 'Oswald'; min-height: 60px; }
    .nav-left { color: var(--theme-primary); font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 5px; font-size: 0.9rem; white-space: nowrap; z-index: 10; }
    .nav-center { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; overflow: hidden; padding: 0 10px; }
    .nav-title-main { font-weight: bold; font-size: 1.1rem; color: var(--theme-text); letter-spacing: 1px; white-space: nowrap; }
    .nav-title-sub { font-size: 0.75rem; color: var(--theme-text-muted); font-family: 'Roboto'; font-weight: normal; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
    .nav-right { display: flex; justify-content: flex-end; z-index: 10; min-width: 60px; }
    
    .scrollable-content { flex-grow: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; align-items: center; -webkit-overflow-scrolling: touch; padding-bottom: 40px; }

    /* --- ANIMACIÓN DE ÉXITO PANTALLA COMPLETA --- */
    .success-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); z-index: 9999; display: flex; justify-content: center; align-items: center; backdrop-filter: blur(5px); }
    .success-content { display: flex; flex-direction: column; align-items: center; text-align: center; }
    .success-icon-container { width: 100px; height: 100px; background: #28a745; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 3.5rem; color: white; margin-bottom: 20px; box-shadow: 0 0 30px rgba(40, 167, 69, 0.6); animation: pulseGreen 1.5s infinite; }
    .success-content h2 { font-family: 'Oswald'; color: white; font-size: 2.5rem; margin: 0; letter-spacing: 2px; text-shadow: 0 4px 10px rgba(0,0,0,0.5); }
    .success-content p { color: var(--theme-primary); font-family: 'Roboto'; font-weight: bold; font-size: 1.1rem; margin-top: 5px; text-transform: uppercase; }
    .bounce-in { animation: bounceInMsg 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards; }
    @@keyframes bounceInMsg { 0% { transform: scale(0.3); opacity: 0; } 50% { transform: scale(1.05); opacity: 1; } 100% { transform: scale(1); opacity: 1; } }
    @@keyframes pulseGreen { 0% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7); } 70% { box-shadow: 0 0 0 20px rgba(40, 167, 69, 0); } 100% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0); } }

    /* --- CALENDARIO --- */
    .month-control { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; background: var(--theme-card); padding: 10px; border-radius: 8px; border: 1px solid var(--theme-border); width: 100%; max-width: 500px; }
    .month-label { font-family: 'Oswald'; font-size: 1.2rem; color: var(--theme-primary); }
    .btn-nav { background: none; border: none; color: var(--theme-text); font-size: 1.2rem; width: 40px; cursor: pointer; }

    .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; width: 100%; max-width: 500px; }
    .day-name { text-align: center; color: var(--theme-text-muted); font-size: 0.7rem; font-weight: bold; margin-bottom: 5px; }

    .calendar-day { border-radius: 6px; min-height: 75px; padding: 4px; position: relative; cursor: pointer; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid; }
    .calendar-day.empty { background: transparent !important; border: none !important; cursor: default; }
    .day-number { font-size: 0.8rem; font-weight: bold; align-self: flex-end; }
    .day-content { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; margin-top: -15px; }
    .running-icon { font-size: 1.5rem; filter: drop-shadow(0 0 2px rgba(0,0,0,0.5)); }
    .day-type { font-size: 0.55rem; text-transform: uppercase; font-weight: bold; margin-top: 2px; text-align: center; line-height: 1; text-shadow: 1px 1px 1px black; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
    .done-badge { position: absolute; top: -5px; left: -5px; background: #28a745; color: white; width: 20px; height: 20px; border-radius: 50%; font-size: 0.7rem; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 5px rgba(0,0,0,0.5); border: 2px solid var(--theme-card); }
    .dia-actual-pulse { border-width: 2px !important; box-shadow: 0 0 15px var(--theme-primary); animation: pulse-today 2s infinite; }

    .legend-scroll { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; justify-content: center; width: 100%; max-width: 500px; }
    .legend-item { font-size: 0.7rem; color: var(--theme-text-muted); display: flex; align-items: center; gap: 5px; }
    .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }

    /* --- MODAL --- */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 3000; display: flex; justify-content: center; align-items: center; backdrop-filter: blur(3px); }
