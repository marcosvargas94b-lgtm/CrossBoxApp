@page "/running-plan/{TargetUserId:guid}/{NombreAtleta}"
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@inject NavigationManager Nav
@inject HttpClient Http

<div class="main-layout">

    <div class="navbar-container">
        <div class="nav-left" @onclick="Volver">
            <i class="fas fa-arrow-left"></i> VOLVER
        </div>
        <div class="nav-center">
            <div class="nav-title-main">RUNNING PLAN</div>
            <div class="nav-title-sub">@NombreAtleta.Split(' ')[0].ToUpper()</div>
        </div>
        <div class="nav-right"></div>
    </div>

    <div class="scrollable-content">
        
        <div class="month-control fade-in">
            <button class="btn-nav" @onclick="MesAnterior"><i class="fas fa-chevron-left"></i></button>
            <span class="month-label">@fechaActual.ToString("MMMM yyyy").ToUpper()</span>
            <button class="btn-nav" @onclick="MesSiguiente"><i class="fas fa-chevron-right"></i></button>
        </div>

        <div class="calendar-grid fade-in">
            <div class="day-name">DOM</div> <div class="day-name">LUN</div> <div class="day-name">MAR</div>
            <div class="day-name">MIE</div> <div class="day-name">JUE</div> <div class="day-name">VIE</div>
            <div class="day-name">SAB</div>

            @for (int i = 0; i < diasVaciosInicio; i++)
            {
                <div class="calendar-day empty"></div>
            }

            @for (int dia = 1; dia <= diasEnMes; dia++)
            {
                int diaActual = dia;
                var log = ObtenerLog(diaActual);
                bool tieneData = log != null;
                bool estaRealizado = tieneData && (log.Realizado == true);

                bool esHoy = (fechaActual.Year == DateTime.Today.Year && 
                              fechaActual.Month == DateTime.Today.Month && 
                              diaActual == DateTime.Today.Day);

                string colorBorde = tieneData ? ObtenerColor(log.Tipo) : "#333";

                <div class="calendar-day @(esHoy ? "dia-actual-pulse" : "")"
                     style="border-color: @colorBorde; background: @(tieneData ? "rgba(30,30,30,0.8)" : "#1a1a1a")"
                     @onclick="() => AbrirModal(diaActual)">

                    <span class="day-number" style="color: @(tieneData? colorBorde : "#666")">@dia</span>

                    @if (tieneData)
                    {
                        <div class="day-content">
                            <i class="fas fa-running running-icon" style="color: @colorBorde"></i>
                            <span class="day-type" style="color: @colorBorde">@log.Tipo</span>
                        </div>

                        @if (estaRealizado)
                        {
                            <div class="done-badge"><i class="fas fa-check"></i></div>
                        }
                    }
                </div>
            }
        </div>

        <div class="legend-scroll">
            @foreach (var t in TiposEntreno)
            {
                <div class="legend-item"><span class="dot" style="background:@t.Color"></span> @t.Nombre</div>
            }
        </div>
        
        <div class="week-accreditation-box fade-in mt-4">
            <div class="week-header">
                <i class="fas fa-medal text-warning"></i>
                <span>ACREDITAR SEMANA</span>
            </div>

            <div class="week-controls">
                <select @bind="SemanaSeleccionadaBind" class="form-select input-dark week-select">
                    @foreach (var sem in listaSemanasAnio)
                    {
                        <option value="@sem.IdUnico">@sem.Texto</option>
                    }
                </select>

                @{
                    bool yaAcreditada = semanasAcreditadasHistorial.Contains(semanaSeleccionadaId);
                }

                <button class="btn-accredit @(yaAcreditada ? "btn-accredit-done" : "")" 
                        @onclick="AcreditarSemana" 
                        disabled="@(acreditando || yaAcreditada)">
                    @if (acreditando)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                    }
                    else if (yaAcreditada)
                    {
                        <i class="fas fa-check-double"></i>
                        <span>Acreditada</span>
                    }
                    else
                    {
                        <i class="fas fa-check-circle"></i>
                        <span>Acreditar</span>
                    }
                </button>
            </div>
            <small class="watermark-text">Debió cumplir el 75% del plan para sumar la semana.</small>
        </div>

        <div style="height: 40px;"></div>
    </div>
</div>

@* --- PANTALLA ANIMADA DE ÉXITO (NUEVO) --- *@
@if (mostrarExitoAnimacion)
{
    <div class="success-overlay">
        <div class="success-content bounce-in">
            <div class="success-icon-container">
                <i class="fas fa-check"></i>
            </div>
            <h2>¡HECHO!</h2>
            <p>@mensajeExitoAnimacion</p>
        </div>
    </div>
}

@if (mostrarModal)
{
    <div class="modal-overlay fade-in">
        <div class="modal-content custom-modal slide-up">
            <div class="modal-header">
                <h5 style="margin:0; font-family:'Oswald'; color:black;">@fechaSeleccionada.ToString("dddd dd 'de' MMMM")</h5>
                <button class="btn-close-custom" @onclick="CerrarModal"><i class="fas fa-times" style="color:black;"></i></button>
            </div>

            <div class="modal-body">

                @if (logEditando.Realizado == true)
                {
                    <div class="feedback-card-premium">

                        <div class="feedback-top">
                            <div class="status-indicator">
                                <i class="fas fa-check-circle"></i> COMPLETADO
                            </div>

                            <div class="rpe-circle" style="background-color: @ObtenerColorRPE(logEditando.RPE ?? 0)">
                                <span class="rpe-val">@(logEditando.RPE ?? 0)</span>
                                <span class="rpe-tag">RPE</span>
                            </div>
                        </div>

                        <div class="comment-bubble">
                            <label><i class="fas fa-comment-alt"></i> Comentarios del Atleta:</label>
                            <p>"@(string.IsNullOrEmpty(logEditando.ComentariosAtleta) ? "Sin comentarios..." : logEditando.ComentariosAtleta)"</p>
                        </div>

                        @if (!string.IsNullOrEmpty(logEditando.EvidenciaUrl))
                        {
                            <div class="evidence-coach-section mt-3">
                                <label style="color: #888; font-size: 0.75rem; font-weight: bold; margin-bottom: 8px; font-family: 'Roboto'; display:block;">
                                    <i class="fas fa-camera"></i> EVIDENCIA (PARCIALES)
                                </label>
                                <div class="evidence-gallery">
                                    @foreach (var fileName in logEditando.EvidenciaUrl.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        string fullUrl = $"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/imagenes/running/{fileName}";
                                        <img src="@fullUrl" class="evidence-thumbnail" @onclick="() => VerImagenExpandida(fullUrl)" />
                                    }
                                </div>
                            </div>
                        }
                        
                        @* --- BOTÓN SWITCH VERIFICACIÓN COACH (BLOQUEABLE) --- *@
                        <div class="coach-verification-box mt-3 fade-in @(yaEstabaVerificado ? "verified-locked" : "")">
                            <div style="flex:1; padding-right:10px;">
                                <label style="color: #F8C545; font-family:'Oswald'; font-size:1rem; margin-bottom:2px; display:block;">
                                    <i class="fas fa-check-double"></i> VALIDAR ASISTENCIA
                                </label>
                                @if (yaEstabaVerificado)
                                {
                                    <span style="color: #28a745; font-size: 0.75rem; line-height:1.2; display:block; font-weight: bold;">
                                        <i class="fas fa-lock"></i> Asistencia validada y sumada.
                                    </span>
                                }
                                else
                                {
                                    <span style="color: #aaa; font-size: 0.75rem; line-height:1.2; display:block;">
                                        Al encenderlo, se sumará +1 día de entrenamiento a su ficha anual.
                                    </span>
                                }
                            </div>
                            <label class="switch @(yaEstabaVerificado ? "disabled-switch" : "")">
                                <input type="checkbox" @bind="logEditando.CoachVerificado" disabled="@yaEstabaVerificado">
                                <span class="slider round"></span>
                            </label>
                        </div>

                    </div>

                    <div class="feedback-divider"></div>
                }

                <label class="lbl-input">Tipo de Sesión:</label>
                <div class="type-grid mb-3">
                    @foreach (var tipo in TiposEntreno)
                    {
                        <div class="type-btn @(logEditando.Tipo == tipo.Nombre ? "selected" : "")"
                             style="border-color: @tipo.Color; color: @(logEditando.Tipo == tipo.Nombre ? "black" : "white"); background: @(logEditando.Tipo == tipo.Nombre ? tipo.Color : "transparent")"
                             @onclick="() => SeleccionarTipo(tipo.Nombre)">
                            @tipo.Nombre
                        </div>
                    }
                </div>

                <label class="lbl-input">Instrucciones Breves (Título):</label>
                <input @bind="logEditando.Titulo" class="form-control input-dark mb-3" placeholder="Ej: 12k Ritmo Carrera" />

                <label class="lbl-input">Detalles / Instrucciones Completas:</label>
                <textarea @bind="logEditando.Descripcion" class="form-control input-dark" rows="4" placeholder="Desglosa el calentamiento, bloques principales..."></textarea>
            </div>

            <div class="modal-footer">
                @if (logEditando.RunningLogID != Guid.Empty)
                {
                    <button class="btn-delete" @onclick="EliminarLog" disabled="@guardando"><i class="fas fa-trash"></i></button>
                }
                <button class="btn-confirm" @onclick="GuardarLog" disabled="@guardando">
                    @if (guardando) { <i class="fas fa-spinner fa-spin"></i> } else { <span>GUARDAR CAMBIOS</span> }
                </button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(imagenExpandida))
{
    <div class="lightbox-overlay fade-in" @onclick="CerrarImagenExpandida">
        <button class="btn-close-lightbox" @onclick="CerrarImagenExpandida"><i class="fas fa-times"></i></button>
        <img src="@imagenExpandida" class="lightbox-img zoom-in" @onclick:stopPropagation="true" />
    </div>
}

<style>
    /* --- ESTRUCTURA BASE --- */
    .main-layout { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: #0d0d0d; display: flex; flex-direction: column; z-index: 1; }

    .navbar-container { flex-shrink: 0; padding-top: calc(env(safe-area-inset-top) + 10px); padding-bottom: 10px; padding-left: 20px; padding-right: 20px; background-color: #0d0d0d; border-bottom: 1px solid #F8C545; color: white; display: flex; justify-content: space-between; align-items: center; z-index: 100; font-family: 'Oswald'; min-height: 60px; }
    .nav-left { color: #F8C545; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 5px; font-size: 0.9rem; white-space: nowrap; z-index: 10; }
    .nav-center { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; overflow: hidden; padding: 0 10px; }
    .nav-title-main { font-weight: bold; font-size: 1.1rem; color: white; letter-spacing: 1px; white-space: nowrap; }
    .nav-title-sub { font-size: 0.75rem; color: #888; font-family: 'Roboto'; font-weight: normal; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
    .nav-right { display: flex; justify-content: flex-end; z-index: 10; min-width: 60px; }
    
    .scrollable-content { flex-grow: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; align-items: center; -webkit-overflow-scrolling: touch; padding-bottom: 40px; }

    /* --- ANIMACIÓN DE ÉXITO PANTALLA COMPLETA --- */
    .success-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); z-index: 9999; display: flex; justify-content: center; align-items: center; backdrop-filter: blur(5px); }
    .success-content { display: flex; flex-direction: column; align-items: center; text-align: center; }
    .success-icon-container { width: 100px; height: 100px; background: #28a745; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 3.5rem; color: white; margin-bottom: 20px; box-shadow: 0 0 30px rgba(40, 167, 69, 0.6); animation: pulseGreen 1.5s infinite; }
    .success-content h2 { font-family: 'Oswald'; color: white; font-size: 2.5rem; margin: 0; letter-spacing: 2px; text-shadow: 0 4px 10px rgba(0,0,0,0.5); }
    .success-content p { color: #F8C545; font-family: 'Roboto'; font-weight: bold; font-size: 1.1rem; margin-top: 5px; text-transform: uppercase; }
    .bounce-in { animation: bounceInMsg 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards; }
    @@keyframes bounceInMsg { 0% { transform: scale(0.3); opacity: 0; } 50% { transform: scale(1.05); opacity: 1; } 100% { transform: scale(1); opacity: 1; } }
    @@keyframes pulseGreen { 0% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7); } 70% { box-shadow: 0 0 0 20px rgba(40, 167, 69, 0); } 100% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0); } }

    /* --- CALENDARIO --- */
    .month-control { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; background: #1a1a1a; padding: 10px; border-radius: 8px; border: 1px solid #333; width: 100%; max-width: 500px; }
    .month-label { font-family: 'Oswald'; font-size: 1.2rem; color: #F8C545; }
    .btn-nav { background: none; border: none; color: white; font-size: 1.2rem; width: 40px; }

    .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; width: 100%; max-width: 500px; }
    .day-name { text-align: center; color: #666; font-size: 0.7rem; font-weight: bold; margin-bottom: 5px; }

    .calendar-day { background: #1a1a1a; border: 1px solid #333; border-radius: 6px; min-height: 75px; padding: 4px; position: relative; cursor: pointer; display: flex; flex-direction: column; justify-content: space-between; }
    .calendar-day.empty { background: transparent; border: none; cursor: default; }
    .day-number { font-size: 0.8rem; font-weight: bold; align-self: flex-end; }
    .day-content { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; margin-top: -15px; }
    .running-icon { font-size: 1.5rem; filter: drop-shadow(0 0 2px rgba(0,0,0,0.5)); }
    .day-type { font-size: 0.55rem; text-transform: uppercase; font-weight: bold; margin-top: 2px; text-align: center; line-height: 1; text-shadow: 1px 1px 1px black; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
    .done-badge { position: absolute; top: -5px; left: -5px; background: #28a745; color: white; width: 20px; height: 20px; border-radius: 50%; font-size: 0.7rem; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 5px rgba(0,0,0,0.5); border: 2px solid #1a1a1a; }
    .dia-actual-pulse { border-width: 2px !important; box-shadow: 0 0 15px rgba(248, 197, 69, 0.4); animation: pulse-today 2s infinite; }

    .legend-scroll { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; justify-content: center; width: 100%; max-width: 500px; }
    .legend-item { font-size: 0.7rem; color: #ccc; display: flex; align-items: center; gap: 5px; }
    .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }

    /* --- MODAL --- */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 3000; display: flex; justify-content: center; align-items: center; backdrop-filter: blur(3px); }
    .custom-modal { background: #1a1a1a; width: 90%; max-width: 400px; border: 1px solid #F8C545; border-radius: 12px; padding: 0; overflow: hidden; display: flex; flex-direction: column; max-height: 85vh; box-shadow: 0 10px 40px rgba(0,0,0,0.8); }
    .modal-header { background: #F8C545; padding: 12px 15px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; }
    .modal-body { padding: 20px; color: white; overflow-y: auto; }
    .modal-footer { padding: 15px; display: flex; justify-content: space-between; gap: 10px; background: #222; border-top: 1px solid #333; }
    .lbl-input { color: #aaa; font-size: 0.85rem; margin-bottom: 5px; display: block; font-weight: bold; }
    .input-dark { background: #333 !important; color: white !important; border: 1px solid #555; }
    .input-dark:focus { border-color: #F8C545; box-shadow: none; }

    /* Feedback */
    .feedback-card-premium { background: linear-gradient(145deg, #1e1e1e, #252525); border-left: 5px solid #28a745; border-radius: 10px; padding: 20px; margin-bottom: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.3); border-top: 1px solid #333; border-right: 1px solid #333; border-bottom: 1px solid #333; }
    .feedback-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 15px; }
    .status-indicator { color: #28a745; font-family: 'Oswald'; font-size: 1.1rem; font-weight: bold; display: flex; align-items: center; gap: 10px; text-shadow: 0 0 10px rgba(40, 167, 69, 0.3); }
    .rpe-circle { width: 50px; height: 50px; border-radius: 50%; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #000; box-shadow: 0 0 10px rgba(0,0,0,0.5); border: 2px solid rgba(255,255,255,0.8); line-height: 1; }
    .rpe-val { font-size: 1.4rem; font-weight: 900; font-family: 'Oswald'; }
    .rpe-tag { font-size: 0.55rem; font-weight: bold; margin-top: -3px; }
    .comment-bubble { background: rgba(0,0,0,0.3); padding: 15px; border-radius: 8px; border: 1px solid #333; }
    .comment-bubble label { display: block; color: #888; font-size: 0.75rem; font-weight: bold; margin-bottom: 8px; font-family: 'Roboto'; }
    .comment-bubble p { color: #eee; font-style: italic; margin: 0; font-size: 0.95rem; line-height: 1.4; font-family: 'Roboto'; }
    .feedback-divider { height: 1px; background: linear-gradient(90deg, transparent, #444, transparent); margin-bottom: 25px; width: 100%; }

    /* EVIDENCIA COACH */
    .evidence-gallery { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px; margin-top: 5px; }
    .evidence-thumbnail { width: 70px; height: 70px; object-fit: cover; border-radius: 8px; border: 1px solid #555; cursor: pointer; transition: 0.2s; }
    .evidence-thumbnail:active { transform: scale(0.95); opacity: 0.8; }

    /* LIGHTBOX */
    .lightbox-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.95); z-index: 9999; display: flex; justify-content: center; align-items: center; flex-direction: column; padding: 20px; }
    .lightbox-img { max-width: 100%; max-height: 80vh; object-fit: contain; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.8); border: 2px solid #333; }
    .btn-close-lightbox { position: absolute; top: 40px; right: 20px; background: rgba(255,255,255,0.2); border: none; color: white; width: 45px; height: 45px; border-radius: 50%; font-size: 1.5rem; cursor: pointer; display: flex; justify-content: center; align-items: center; z-index: 10000; }

    /* SWITCH ESTILIZADO Y BLOQUEO */
    .coach-verification-box { display: flex; align-items: center; background: rgba(248, 197, 69, 0.1); border: 1px dashed #F8C545; padding: 15px; border-radius: 10px; transition: 0.3s; }
    .verified-locked { border-color: #28a745 !important; background: rgba(40,167,69,0.1) !important; }
    .verified-locked label { color: #28a745 !important; }
    
    .switch { position: relative; display: inline-block; width: 50px; height: 26px; flex-shrink: 0; margin: 0; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #444; transition: .4s; border-radius: 34px; border: 1px solid #222; }
    .slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px; background-color: #888; transition: .4s; border-radius: 50%; }
    input:checked + .slider { background-color: #F8C545; border-color: #F8C545; box-shadow: 0 0 10px rgba(248,197,69,0.5); }
    input:checked + .slider:before { transform: translateX(24px); background-color: #000; }

    .disabled-switch { opacity: 0.6; pointer-events: none; }
    .disabled-switch input:checked + .slider { background-color: #28a745; border-color: #28a745; box-shadow: none; }

    /* Type Buttons */
    .type-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .type-btn { border: 1px solid; padding: 8px 2px; text-align: center; border-radius: 5px; font-size: 0.7rem; font-weight: bold; cursor: pointer; transition: all 0.2s; text-transform: uppercase; }
    .type-btn:active { transform: scale(0.95); }

    .btn-close-custom { background: none; border: none; font-size: 1.2rem; }
    .btn-confirm { background: #F8C545; color: black; border: none; padding: 10px; font-weight: bold; flex: 1; border-radius: 5px; font-family: 'Oswald'; }
    .btn-delete { background: #d9534f; color: white; border: none; padding: 10px; border-radius: 5px; width: 45px; display: flex; justify-content: center; align-items: center; }

    .fade-in { animation: fadeIn 0.3s ease; }
    .slide-up { animation: slideUp 0.3s ease; }
    .zoom-in { animation: zoomIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
   @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
   @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
   @@keyframes zoomIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }

    /* --- ESTILOS DE LA BARRA DE ACREDITACIÓN ACTUALIZADA --- */
    .mt-4 { margin-top: 30px !important; }
    .week-accreditation-box { background: #1a1a1a; border: 1px dashed #F8C545; border-radius: 10px; padding: 15px; margin-bottom: 20px; width: 100%; max-width: 500px; text-align: center; }
    .week-header { color: #F8C545; font-family: 'Oswald'; font-size: 1rem; margin-bottom: 10px; display: flex; align-items: center; justify-content: center; gap: 8px; }
    .week-controls { display: flex; gap: 10px; align-items: center; }
    .week-select { flex: 1; border-radius: 8px; font-size: 0.85rem; padding: 8px; }
    
    .btn-accredit { background: #28a745; color: white; border: none; border-radius: 8px; padding: 8px 15px; font-weight: bold; font-family: 'Oswald'; display: flex; align-items: center; gap: 5px; box-shadow: 0 4px 10px rgba(40,167,69,0.3); transition: 0.2s; }
    .btn-accredit:active { transform: scale(0.95); }
    .btn-accredit-done { background: rgba(40, 167, 69, 0.2) !important; color: #28a745 !important; border: 1px solid #28a745 !important; box-shadow: none !important; cursor: not-allowed; }
    .watermark-text { color: #666; font-size: 0.7rem; font-style: italic; display: block; margin-top: 8px; }
</style>

@code {
    [Parameter] public Guid TargetUserId { get; set; }
    [Parameter] public string NombreAtleta { get; set; }

    private DateTime fechaActual = DateTime.Today;
    private List<RunningLogs> logsDelMes = new List<RunningLogs>();
    private int diasEnMes;
    private int diasVaciosInicio;

    private bool mostrarModal = false;
    private bool guardando = false;
    private bool mostrarExitoAnimacion = false;
    private string mensajeExitoAnimacion = "";
    private RunningLogs logEditando = new RunningLogs();
    private DateTime fechaSeleccionada;
    private bool yaEstabaVerificado = false; 
    
    private string semanaSeleccionadaId;
    public string SemanaSeleccionadaBind 
    {
        get => semanaSeleccionadaId;
        set { semanaSeleccionadaId = value; }
    }

    private bool acreditando = false;
    private List<SemanaItem> listaSemanasAnio = new();
    private List<string> semanasAcreditadasHistorial = new();

    private string imagenExpandida = null;

    public class SemanaItem { public string IdUnico { get; set; } public string Texto { get; set; } }

    class TipoEntreno { public string Nombre { get; set; } public string Color { get; set; } }

    private List<TipoEntreno> TiposEntreno = new List<TipoEntreno>
    {
        new TipoEntreno { Nombre = "Acumulativo", Color = "#00BFFF" },
        new TipoEntreno { Nombre = "Intensidad", Color = "#FF4500" },
        new TipoEntreno { Nombre = "Tempo", Color = "#FF8C00" },
        new TipoEntreno { Nombre = "Cuestas", Color = "#9370DB" },
        new TipoEntreno { Nombre = "Fuerza", Color = "#808080" },
        new TipoEntreno { Nombre = "Regenerativo", Color = "#32CD32" },
        new TipoEntreno { Nombre = "Otro", Color = "#FFFFFF" }
    };

    public class RunningLogs
    {
        public Guid RunningLogID { get; set; }
        public Guid UsuarioID { get; set; }
        public DateTime Fecha { get; set; }
        public string Titulo { get; set; }
        public string Descripcion { get; set; }
        public string Tipo { get; set; }
        public bool? Realizado { get; set; }
        public int? RPE { get; set; }
        public string ComentariosAtleta { get; set; }
        public bool? CoachVerificado { get; set; } 
        public string EvidenciaUrl { get; set; } 
    }

    protected override async Task OnInitializedAsync()
    {
        GenerarSemanasDelAnio();
        await CargarHistorialAcreditadas();
        await CargarCalendario();
    }

    private async Task CargarHistorialAcreditadas()
    {
        try
        {
            semanasAcreditadasHistorial = await Http.GetFromJsonAsync<List<string>>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/runningapi/semanas-acreditadas/{TargetUserId}") ?? new List<string>();
        }
        catch { semanasAcreditadasHistorial = new List<string>(); }
    }

    private async Task CargarCalendario()
    {
        diasEnMes = DateTime.DaysInMonth(fechaActual.Year, fechaActual.Month);
        var primerDiaMes = new DateTime(fechaActual.Year, fechaActual.Month, 1);
        diasVaciosInicio = (int)primerDiaMes.DayOfWeek;

        try
        {
            logsDelMes = await Http.GetFromJsonAsync<List<RunningLogs>>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/runningapi/plan/{TargetUserId}/{fechaActual.Month}/{fechaActual.Year}");
        }
        catch { logsDelMes = new List<RunningLogs>(); }
    }

    private void GenerarSemanasDelAnio()
    {
        listaSemanasAnio.Clear();
        DateTime inicioAnio = new DateTime(DateTime.Today.Year, 1, 1);

        while (inicioAnio.DayOfWeek != DayOfWeek.Monday) inicioAnio = inicioAnio.AddDays(1);

        int numSemana = 1;
        DateTime fechaPivote = inicioAnio;

        while (fechaPivote <= DateTime.Today)
        {
            DateTime finSemana = fechaPivote.AddDays(6);
            string clave = $"{DateTime.Today.Year}-W{numSemana}";

            listaSemanasAnio.Add(new SemanaItem
            {
                IdUnico = clave,
                Texto = $"Semana {numSemana}: {fechaPivote:dd/MM} al {finSemana:dd/MM}"
            });

            fechaPivote = fechaPivote.AddDays(7);
            numSemana++;
        }

        if (listaSemanasAnio.Any())
            semanaSeleccionadaId = listaSemanasAnio.Last().IdUnico;
    }

    private async Task AcreditarSemana()
    {
        bool confirm = await App.Current.MainPage.DisplayAlert("Acreditar Semana",
            $"¿Confirmas que {NombreAtleta} cumplió con su entrenamiento? Se sumará a su Ficha Running.", "SÍ", "CANCELAR");

        if (!confirm) return;

        acreditando = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/runningapi/acreditar-semana/{TargetUserId}", semanaSeleccionadaId);
            
            if (response.IsSuccessStatusCode)
            {
                await CargarHistorialAcreditadas(); 
                
                // MUESTRA LA ANIMACIÓN
                mensajeExitoAnimacion = "Semana cobrada al perfil del atleta.";
                mostrarExitoAnimacion = true;
                StateHasChanged();
                await Task.Delay(1800);
                mostrarExitoAnimacion = false;
                StateHasChanged();
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                await App.Current.MainPage.DisplayAlert("Aviso", "No se pudo acreditar: " + errorMsg, "OK");
            }
        }
        catch (Exception ex) { await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK"); }
        finally { acreditando = false; }
    }

    private RunningLogs ObtenerLog(int dia) => logsDelMes.FirstOrDefault(l => l.Fecha.Day == dia);

    private string ObtenerColor(string tipo)
    {
        var t = TiposEntreno.FirstOrDefault(x => x.Nombre == tipo);
        return t != null ? t.Color : "#F8C545";
    }

    private async Task MesAnterior() { fechaActual = fechaActual.AddMonths(-1); await CargarCalendario(); }
    private async Task MesSiguiente() { fechaActual = fechaActual.AddMonths(1); await CargarCalendario(); }

    private void AbrirModal(int dia)
    {
        fechaSeleccionada = new DateTime(fechaActual.Year, fechaActual.Month, dia);
        var existente = ObtenerLog(dia);

        if (existente != null)
        {
            yaEstabaVerificado = (existente.CoachVerificado == true);

            logEditando = new RunningLogs
            {
                RunningLogID = existente.RunningLogID,
                UsuarioID = existente.UsuarioID,
                Fecha = existente.Fecha,
                Titulo = existente.Titulo,
                Descripcion = existente.Descripcion,
                Tipo = existente.Tipo,
                Realizado = existente.Realizado,
                RPE = existente.RPE,
                ComentariosAtleta = existente.ComentariosAtleta,
                CoachVerificado = existente.CoachVerificado,
                EvidenciaUrl = existente.EvidenciaUrl
            };
        }
        else
        {
            yaEstabaVerificado = false;
            logEditando = new RunningLogs
            {
                UsuarioID = TargetUserId,
                Fecha = fechaSeleccionada,
                Tipo = "Acumulativo",
                Titulo = "",
                Descripcion = "",
                CoachVerificado = false
            };
        }
        mostrarModal = true;
    }

    private void VerImagenExpandida(string url)
    {
        imagenExpandida = url;
    }

    private void CerrarImagenExpandida()
    {
        imagenExpandida = null;
    }

    private void SeleccionarTipo(string tipo) => logEditando.Tipo = tipo;

    private async Task GuardarLog()
    {
        if (string.IsNullOrEmpty(logEditando.Titulo))
        {
            await App.Current.MainPage.DisplayAlert("Falta Título", "Pon una instrucción breve", "OK");
            return;
        }
        if (logEditando.Descripcion == null) logEditando.Descripcion = "";

        guardando = true;
        StateHasChanged();
        
        try
        {
            var resp = await Http.PostAsJsonAsync("https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/runningapi/guardar", logEditando);
            if (resp.IsSuccessStatusCode)
            {
                mostrarModal = false;
                await CargarCalendario();
                
                // MUESTRA LA ANIMACIÓN EN LUGAR DEL ALERT
                mensajeExitoAnimacion = "Rutina guardada correctamente.";
                mostrarExitoAnimacion = true;
                StateHasChanged();
                await Task.Delay(1800);
                mostrarExitoAnimacion = false;
                StateHasChanged();
            }
            else
            {
                var error = await resp.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(error)) error = resp.StatusCode.ToString();
                
                await App.Current.MainPage.DisplayAlert("Error", $"API: {error}", "OK");
            }
        }
        catch (Exception ex) { await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK"); }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private async Task EliminarLog()
    {
        bool confirm = await App.Current.MainPage.DisplayAlert("Borrar", "¿Quitar este entrenamiento?", "Sí", "No");
        if (!confirm) return;

        try
        {
            var resp = await Http.PostAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/runningapi/eliminar/{logEditando.RunningLogID}", null);
            if (resp.IsSuccessStatusCode)
            {
                mostrarModal = false;
                await CargarCalendario();
            }
        }
        catch { }
    }

    private string ObtenerColorRPE(int valor)
    {
        if (valor <= 2) return "#32CD32"; 
        if (valor <= 4) return "#ADFF2F"; 
        if (valor <= 6) return "#FFD700"; 
        if (valor <= 8) return "#FF8C00"; 
        return "#FF0000"; 
    }

    private void CerrarModal() => mostrarModal = false;
    private void Volver() => Nav.NavigateTo("/usuarios-view");
