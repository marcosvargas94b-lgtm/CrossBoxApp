    /* 2. NEÓN (Brillo agresivo exterior e interior. Afecta al texto) */
    .community-entry-card.neon {
        border: 2px solid var(--b-color) !important;
        box-shadow: 0 0 8px var(--b-color), 0 0 20px var(--b-color), inset 0 0 15px var(--b-color) !important;
