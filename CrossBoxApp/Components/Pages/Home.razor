        background: linear-gradient(120deg, rgba(255,0,150,0.35), rgba(0,204,255,0.35), rgba(204,0,255,0.35), rgba(255,0,150,0.35)), rgba(0,0,0,0.4);
        background-size: 300% 300%, 100% 100%;
