    private async Task SubirImagenBannerForm(InputFileChangeEventArgs e, string tipo)
    {
        var archivo = e.File; if (archivo == null) return;

        if (tipo == "fondo") subiendoFondo = true; else subiendoFoto = true;
        StateHasChanged();

        try
        {
            using var form = new MultipartFormDataContent();
            using var fileStream = archivo.OpenReadStream(maxAllowedSize: 5120000);
            using var streamContent = new StreamContent(fileStream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(archivo.ContentType);
            form.Add(streamContent, "archivo", archivo.Name);

            var response = await Http.PostAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/communityapi/subir-imagen/{tipo}/{Sesion.Usuario.UsuarioID}", form);

            if (response.IsSuccessStatusCode)
            {
                // Si subió foto especial, apagamos el switch de "usar foto de perfil"
                if (tipo == "foto") miBannerEdit.UsarFotoPerfil = false;
                await CargarMiBanner();
            }
        }
        catch { await App.Current.MainPage.DisplayAlert("Error", "No se pudo subir la imagen", "OK"); }
        finally
        {
            if (tipo == "fondo") subiendoFondo = false; else subiendoFoto = false;
            StateHasChanged();
        }
    }

