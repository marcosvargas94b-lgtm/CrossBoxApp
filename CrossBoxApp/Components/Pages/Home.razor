        color: #fff !important; 
        text-shadow: 0 0 10px var(--b-color), 0 0 20px var(--b-color), 2px 2px 2px black !important; 
    }

    /* 3. CYBERPUNK (Solo marco recortado, CERO rayas en la foto) */
    .community-entry-card.cyberpunk {
        border: none !important;
        border-left: 6px solid var(--b-color) !important;
        border-right: 4px solid var(--theme-text) !important;
        border-radius: 0 !important;
        clip-path: polygon(25px 0, 100% 0, 100% calc(100% - 25px), calc(100% - 25px) 100%, 0 100%, 0 25px);
        box-shadow: none !important;
    }
    .community-entry-card.cyberpunk .card-overlay {
        /* Gradiente suave a los lados para leer el texto, el centro 100% visible */
        background: linear-gradient(90deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.8) 100%);
    }

    /* 4. GOLD (Destello metálico cruzando la tarjeta) */
    .community-entry-card.gold {
        border: 2px solid #FFD700 !important;
        box-shadow: 0 0 20px rgba(255, 215, 0, 0.3), inset 0 0 15px rgba(255, 215, 0, 0.2) !important;
        position: relative;
    }
    .community-entry-card.gold .card-overlay { background: linear-gradient(45deg, rgba(0,0,0,0.7) 0%, rgba(255,215,0,0.1) 50%, rgba(0,0,0,0.7) 100%); }
    .community-entry-card.gold::before {
        content: ""; position: absolute; top: 0; left: -150%; width: 50%; height: 100%;
        background: linear-gradient(to right, transparent, rgba(255,255,255,0.4), transparent);
        transform: skewX(-25deg); animation: goldShine 4s infinite; z-index: 5; pointer-events: none;
    }

    /* 5. HOLO (Carta Coleccionable Tornasol) */
    .community-entry-card.holo {
        border: 2px solid rgba(255,255,255,0.5) !important;
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.4) !important;
    }
    .community-entry-card.holo .card-overlay {
