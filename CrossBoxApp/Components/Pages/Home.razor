@if (mostrarModalHorarios)
{
    <div class="modal-overlay">
        <div class="modal-content custom-modal">
            <div class="modal-header">
                <h5 style="margin:0; color:#F8C545; font-weight:bold;">
                    <i class="fas fa-clock"></i> HORARIOS DEL BOX
                </h5>
                <button class="btn-close-custom" @onclick="() => mostrarModalHorarios = false"><i class="fas fa-times"></i></button>
            </div>

            <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">

                <div class="add-section mb-4">
                    <label class="lbl-input">Nuevo Horario (Ej: 7:00 AM)</label>
                    <div class="input-group">
                        <input type="text" @bind="nuevoHorarioTexto" class="form-control input-dark" placeholder="Escribe el horario..." />
                        <button class="btn btn-warning" @onclick="AgregarHorario" style="background-color:#F8C545; color:black; font-weight:bold;">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>

                <hr style="border-color:#333;" />

                <h6 style="color:white; margin-bottom:15px;">Horarios Activos:</h6>

                @if (listaHorariosAdmin == null)
                {
                    <div class="text-center text-muted">Cargando...</div>
                }
                else if (listaHorariosAdmin.Count == 0)
                {
                    <div class="text-center text-muted">No hay horarios registrados.</div>
                }
                else
                {
                    <div class="horarios-list">
                        @foreach (var h in listaHorariosAdmin)
                        {
                            <div class="horario-row">
                                <span class="horario-text">@h.Descripcion</span>
                                <button class="btn-delete-mini" @onclick="() => EliminarHorario(h.HorarioID)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    /* Estilos base */
    .main-layout { position: fixed; top:0; left:0; width:100vw; height:100vh; background:#050505; display:flex; flex-direction:column; z-index:1; }
    .navbar-container { position: relative; flex-shrink:0; padding-top: calc(env(safe-area-inset-top) + 5px); padding-bottom:10px; padding-left:20px; padding-right:20px; background-color: #0d0d0d; border-bottom:1px solid #F8C545; display:flex; justify-content:space-between; align-items:center; z-index:100; font-family:'Oswald'; color:white; min-height: 60px; }
    .nav-left { color:#F8C545; font-weight:bold; cursor:pointer; display:flex; align-items:center; gap:8px; font-size:0.9rem; }
    .nav-title { font-weight:bold; font-size:1.1rem; color:white; letter-spacing:1px; }
    .nav-right { width:60px; display:flex; justify-content:flex-end; }
    .scrollable-content { flex-grow: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; align-items: center; -webkit-overflow-scrolling: touch; padding-bottom: 40px; z-index: 10; position: relative; }

    /* Marca de agua y Z-index */
    .menu-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 90; background: transparent; }
    .watermark { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 70%; max-width: 500px; aspect-ratio: 1/1; background-repeat: no-repeat; background-position: center; background-size: contain; opacity: 0.35; z-index: 0; pointer-events: none; }
    .nav-logo { height: 40px; width: 40px; border-radius: 50%; object-fit: cover; margin-right: 10px; border: 1px solid #F8C545; }
    .brand { display: flex; align-items: center; font-size: 1.3rem; font-weight: bold; }

    /* --- ENTRADA A COMUNIDAD (HOME) --- */
    .community-entry-card { 
        width: 100%; 
        max-width: 600px; 
        min-height: 110px; /* EVITA QUE SE APLASTE */
        flex-shrink: 0; /* EVITA QUE SE APLASTE */
        margin: 0 auto; 
        border-radius: 15px; 
        position: relative; 
        overflow: hidden; 
        background-size: cover; 
        background-position: center; 
        cursor: pointer; 
        display: flex; 
        align-items: center; 
        transition: transform 0.2s; 
        border: 2px solid var(--b-color, #F8C545); 
        box-shadow: 0 10px 20px rgba(0,0,0,0.5); 
    }
    .community-entry-card:active { transform: scale(0.97); }
    .card-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }
    
    /* --- BOTÓN LATERAL VERTICAL --- */
    .btn-edit-corner { 
        position: absolute; 
        top: 0; 
        right: 0; 
        height: 100%; /* Ocupa todo el alto de la tarjeta */
        background: rgba(0,0,0,0.75); 
        color: #F8C545; 
        border: none;
        border-left: 2px solid var(--b-color, #F8C545); /* Toma el color del estilo seleccionado */
        font-family: 'Oswald'; 
        font-size: 0.85rem; 
        padding: 0 10px; 
        border-radius: 0 13px 13px 0; /* Se adapta a la curva derecha del banner */
        z-index: 50; 
        font-weight: bold; 
        backdrop-filter: blur(4px); 
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        writing-mode: vertical-rl; /* Gira el texto verticalmente (de arriba a abajo) */
        cursor: pointer;
        transition: background 0.2s;
    }
    .btn-edit-corner:active { 
        background: rgba(248, 197, 69, 0.2); 
    }
    .btn-edit-corner i { 
        transform: rotate(90deg); /* Gira el lapicito para que acompañe la dirección del texto */
    }
    
    /* Le damos un poco más de padding derecho (45px) para que el texto de la tarjeta no choque con el botón */
    .entry-content { 
        position: relative; 
        z-index: 10; 
        display: flex; 
        align-items: center; 
        gap: 15px; 
        padding: 0 45px 0 20px; 
        width: 100%; 
    }
    .entry-avatar { width: 70px; height: 70px; border-radius: 50%; object-fit: cover; border: 3px solid var(--b-color, #F8C545); box-shadow: 0 4px 10px rgba(0,0,0,0.6); background: #222; flex-shrink: 0; }
    .entry-text { display: flex; flex-direction: column; }
    .entry-text h4 { font-family: 'Oswald'; font-size: 1.4rem; font-weight: 900; color: white !important; text-transform: uppercase; margin: 0; text-shadow: 1px 1px 3px black; line-height: 1.1; }
    .entry-text span { font-family: 'Roboto'; font-size: 0.8rem; color: #F8C545; font-weight: bold; margin-top: 4px; text-shadow: 1px 1px 2px black; display: flex; align-items: center; gap: 5px; }

    /* ESTILOS VISUALES BANNER */
    .community-entry-card.glass .card-overlay { background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
    .community-entry-card.neon { border: 2px solid var(--b-color, #00ffcc); box-shadow: 0 0 12px var(--b-color, #00ffcc), inset 0 0 10px var(--b-color, #00ffcc); }
    .community-entry-card.neon .card-overlay { background: rgba(0, 0, 0, 0.6); }
    .community-entry-card.neon h4 { color: var(--b-color, #00ffcc) !important; text-shadow: 0 0 8px var(--b-color, #00ffcc); }
    .community-entry-card.cyberpunk { border: none; border-left: 6px solid var(--b-color, #ff0055); border-radius: 0; clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px); }
    .community-entry-card.cyberpunk .card-overlay { background: linear-gradient(90deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 100%); }
    .community-entry-card.cyberpunk .entry-avatar { border-radius: 0; clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px); }
    .community-entry-card.gold { border: 2px solid #FFD700; box-shadow: 0 5px 15px rgba(255, 215, 0, 0.2); }
    .community-entry-card.gold .card-overlay { background: linear-gradient(145deg, rgba(0,0,0,0.9) 0%, rgba(50,40,0,0.7) 100%); }
    .community-entry-card.gold h4 { background: linear-gradient(to right, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C); -webkit-background-clip: text; -webkit-text-fill-color: transparent; text-shadow: none; }
    .community-entry-card.flat { border: 3px solid var(--b-color, #ff5500); border-radius: 4px; box-shadow: none; }
    .community-entry-card.flat .card-overlay { background: rgba(15, 15, 15, 0.85); }
    .community-entry-card.flat .entry-avatar { border: 3px solid var(--b-color, #ff5500); border-radius: 4px; }

    /* MODAL ESTILOS BANNER */
    .edit-group { background: #1a1a1a; border: 1px solid #333; padding: 15px; border-radius: 10px; }
    .edit-group label { color: #F8C545; font-family: 'Oswald'; font-size: 0.85rem; display: block; margin-bottom: 8px; }
    .btn-upload-action { width: 100%; background: #333; color: white; text-align: center; padding: 10px; border-radius: 8px; font-family: 'Oswald'; cursor: pointer; transition: 0.2s; display: block; }
    .btn-upload-action:active { transform: scale(0.98); background: #444; }
    .btn-upload-action.secondary { background: #222; border: 1px dashed #F8C545; color: #F8C545; }
    .color-input { width: 100%; height: 40px; border: none; border-radius: 8px; cursor: pointer; padding: 0; background: none; }
    .color-input::-webkit-color-swatch-wrapper { padding: 0; }
    .color-input::-webkit-color-swatch { border: 1px solid #444; border-radius: 8px; }
    .styles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .style-item { display: flex; flex-direction: column; align-items: center; gap: 5px; cursor: pointer; transition: 0.2s; opacity: 0.5; }
    .style-item.selected { opacity: 1; transform: scale(1.05); }
    .style-item span { color: white; font-family: 'Oswald'; font-size: 0.7rem; }
    .style-preview { width: 100%; height: 40px; border-radius: 6px; background: #222; border: 1px solid #555; }
