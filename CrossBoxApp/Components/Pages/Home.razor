@page "/home"
@using System.Net.Http.Json
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Social
@using Microsoft.Maui.Devices
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Nav
@inject HttpClient Http
@inject CrossBoxApp.Models.Services.SesionService Sesion
@inject IJSRuntime JS
@using Plugin.Firebase.CloudMessaging;
@using Microsoft.Maui.ApplicationModel; 

<div style="@EstilosTema">
<div class="main-layout" >

    @* --- MARCA DE AGUA (FONDO LOGO) --- *@
    @if (LogoBoxId != null)
    {
        <div class="watermark" style="background-image: url('@UrlLogo');"></div>
    }

    @* --- CAPA INVISIBLE PARA CERRAR MENÚS --- *@
    @if (mostrarMenuPrincipal || mostrarNotis)
    {
        <div class="menu-overlay" @onclick="CerrarTodosLosMenus"></div>
    }

    <div class="navbar-container">
        
        @* BRAND: LOGO + NOMBRE *@
        <div class="brand">
            @if (LogoBoxId != null)
            {
                <img src="@UrlLogo" class="nav-logo" />
            }
            <span>@NombreBox</span>
        </div>

        <div class="right-actions">
            
            @* NOTIFICACIONES *@
            <div class="noti-wrapper" @onclick="ToggleNotificaciones">
                <i class="fas fa-bell noti-icon @(hayNuevas ? "bell-ring" : "")"></i>
                @if (hayNuevas) { <span class="noti-dot"></span> }
                
                @if (mostrarNotis)
                {
                    <div class="noti-dropdown" @onclick:stopPropagation="true">
                        @if (misNotificaciones == null || misNotificaciones.Count == 0)
                        {
                            <div class="noti-item empty">Sin novedades...</div>
                        }
                        else
                        {
                            @foreach (var n in misNotificaciones.Take(10))
                            {
                                <div class="noti-item @(n.Leido ? "" : "unread")">
                                    <i class="@GetIcono(n.Tipo)"></i>
                                    <span class="noti-text">@n.Mensaje</span>
                                </div>
                            }

                            @if (misNotificaciones.Count > 10)
                            {
                                <div class="noti-item" style="justify-content: center; font-size: 0.7rem; color: var(--theme-text-muted);">
                                    Mostrando las últimas 10
                                </div>
                            }
                            <div style="height: 15px;"></div>
                        }
                    </div>
                }
            </div>

            @* MENÚ PRINCIPAL *@
            <div class="main-menu-wrapper" @onclick="ToggleMainMenu">
                <span class="user-name">Hola, @(Sesion.Usuario?.Nombre ?? "Atleta")</span>
                <i class="fas fa-bars menu-burger"></i>

                @if (mostrarMenuPrincipal)
                {
                    <div class="main-dropdown" @onclick:stopPropagation="true">
                        <div class="dropdown-header">GENERAL</div>
                        <div class="dropdown-item" @onclick="IrAPerfil">
                            <i class="fas fa-user-edit"></i> Modificar Perfil
                        </div>
                        <div class="dropdown-item" @onclick="AbrirModalPassword">
                            <i class="fas fa-key"></i> Cambiar Contraseña
                        </div>
                        <div class="dropdown-item text-danger" @onclick="ConfirmarEliminarCuenta" style="color: #ff4444 !important;">
                            <i class="fas fa-user-times" style="color: #ff4444;"></i> Eliminar Cuenta
                        </div>

                        @if (Sesion.Usuario != null && (Sesion.Usuario.TipoUsuarioID == 1 || Sesion.Usuario.TipoUsuarioID == 3))
                        {
                            <div class="dropdown-divider"></div>
                            <div class="dropdown-header admin-header">ADMINISTRACIÓN</div>

                            <div class="dropdown-item" style="color:#d9534f !important;" @onclick='() => Nav.NavigateTo("/live-lobby")'>
                                <i class="fas fa-stopwatch" style="color:#d9534f"></i> LIVE
                            </div>

                            @if (Sesion.TienePermiso("MANAGE_WOD"))
                            {
                                <div class="dropdown-item" @onclick="AbrirModalWod">
                                    <i class="fas fa-hammer"></i> Programar WOD
                                </div>
                                <div class="dropdown-item" @onclick='() => NavegarA("test")'>
                                    <i class="fas fa-flask"></i> Configurar Tests
                                </div>
                                <div class="dropdown-item" @onclick="AbrirModalHorarios">
                                    <i class="fas fa-clock"></i> Gestionar Horarios
                                </div>
                            }

                            @if (Sesion.TienePermiso("MANAGE_USERS"))
                            {
                                <div class="dropdown-item" @onclick='() => NavegarA("usuarios")'>
                                    <i class="fas fa-users"></i> Gestionar Usuarios
                                </div>
                                <div class="dropdown-item" @onclick='() => Nav.NavigateTo("/solicitudes")'>
                                    <i class="fas fa-user-check"></i> Solicitudes de Acceso
                                </div>
                            }

                            @if (Sesion.TienePermiso("MANAGE_AVISOS"))
                            {
                                <div class="dropdown-item" @onclick="AbrirCrearAviso">
                                    <i class="fas fa-bullhorn"></i> Publicar Avisos
                                </div>
                            }

                            @if (EsAdmin)
                            {
                                <div class="dropdown-divider" style="opacity: 0.3;"></div>
                                <div class="dropdown-header" style="color:var(--theme-primary); font-size:0.6rem;">DUEÑO</div>

                                <div class="dropdown-item" @onclick='() => Nav.NavigateTo("/staff-config")'>
                                    <i class="fas fa-id-badge"></i> Gestión de Equipo
                                </div>

                                <div class="dropdown-item" @onclick="AbrirGestionModulos">
                                    <i class="fas fa-toggle-on"></i> Módulos del Box
                                </div>

                                <div class="dropdown-item" @onclick='() => Nav.NavigateTo("/admin/whatsapp")'>
                                    <i class="fas fa-comment-dots"></i> Configurar WhatsApp
                                </div>

                                <div class="dropdown-item" @onclick='() => Nav.NavigateTo("/admin/config-box")'>
                                    <i class="fas fa-cogs"></i> Configurar Box y Pagos
                                </div>
                                <div class="dropdown-item" @onclick='() => Nav.NavigateTo("/control-ingresos")'>
                                    <i class="fas fa-chart-line text-success"></i> Finanzas
                                </div>
                            }
                        }

                        <div class="dropdown-divider"></div>
                        <div class="dropdown-item text-muted" @onclick="CerrarSesion" style="color: var(--theme-text-muted) !important;">
                            <i class="fas fa-sign-out-alt" style="color: var(--theme-text-muted);"></i> Cerrar Sesión
                        </div>
                        <div style="height: 20px; width: 100%;"></div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="scrollable-content">

        @if (diasRestantes <= 3)
        {
            <div class="payment-alert @(diasRestantes <= 0 ? "expired" : "warning")" @onclick="IrAPagar">
                <div class="alert-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="alert-text">
                    @if (diasRestantes > 0)
                    {
                        <strong>¡ATENCIÓN!</strong>
                        <span>Tu plan vence en @diasRestantes días. -</span>
                    }
                    else
                    {
                        <strong>¡SERVICIO VENCIDO!</strong>
                        @if (Sesion.Usuario != null && Sesion.Usuario.TipoUsuarioID == 2 && Sesion.Usuario.BoxID != IdCanaHueca)
                        {
                            @if (boxTieneMP)
                            {
                                <span> Toca aquí para pagar en línea o pasar a recepción</span>
                            }
                            else
                            {
                                <span> Acude a tu recepción para pagar.</span>
                            }
                        }
                        else
                        {
                            <span> Toca aquí para pagar en línea.</span>
                        }
                    }
                </div>
            </div>
        }

        <div class="welcome-section">
            <h1>BIENVENIDO @(Sesion.Usuario?.Nombre?.ToUpper() ?? "ATLETA")</h1>
        </div>

        @if (cargandoConfiguracion)
        {
            <div class="text-center mt-5 fade-in">
                <div class="spinner-border" style="color: var(--theme-primary); width: 3rem; height: 3rem; border-width: 0.2em;" role="status"></div>
                <p class="mt-3 text-muted" style="font-family: 'Oswald'; letter-spacing: 2px;">PREPARANDO TU ENTORNO...</p>
            </div>
        }
        else
        {
            @if (Sesion.Usuario?.TipoLugar != "Running")
            { 
                <div class="recovery-section fade-in">
            @if (resumenRecuperacion != null)
            {
                <div class="card-recuperacion-master @(resumenRecuperacion.RutinaHoyParaRPE.HasValue ? "alerta-rpe-aura" : "")" @onclick='() => Nav.NavigateTo("/detalle-recuperacion")'>
                    
                    @* ETIQUETA FLOTANTE SI FALTA RPE *@
                    @if (resumenRecuperacion.RutinaHoyParaRPE.HasValue || resumenRecuperacion.RutinaCoachHoyParaRPE.HasValue)
                    {
                        <div class="badge-falta-rpe">
                            <i class="fas fa-exclamation-circle"></i> FALTA RPE
                        </div>
                    }

                    <div class="info-content">
                        <span class="label-top">ESTADO DE RECUPERACIÓN</span>
                        <h2 class="display-porcentaje">@resumenRecuperacion.DisponibilidadGlobal<small>%</small></h2>
                        <p class="status-desc">@resumenRecuperacion.Mensaje.ToUpper()</p>
                        <div class="btn-detalles">DETALLES <i class="fas fa-chevron-right"></i></div>
                        <div style="font-size: 0.65rem; color: var(--theme-text-muted); margin-top: 5px; font-family:'Roboto';">Configura para mayor precisión</div>
                    </div>

                    <div class="visual-content">
                        @if (!string.IsNullOrEmpty(resumenRecuperacion.Sexo) && resumenRecuperacion.Sexo.ToUpper() == "F")
                        {
                            <MapaCalorFemenino Datos="resumenRecuperacion.Musculos" />
                        }
                        else
                        {
                            <MapaCalor Datos="resumenRecuperacion.Musculos" />
                        }
                    </div>

                    <div class="bg-blur-glow"></div>
                </div>
            }
        </div>
            }

            @* ========================================== *@
            @* PUERTA DE ENTRADA A LA COMUNIDAD           *@
            @* ========================================== *@
            @if (cargandoBanner)
            {
                <div class="text-center mt-4 mb-4">
                    <div class="spinner-border spinner-sm" style="color: var(--theme-primary);"></div>
                    <div class="text-muted" style="font-size: 0.8rem; font-family: 'Oswald';">CARGANDO STATS...</div>
                </div>
            }
            else if (miBanner != null)
            {
                <div class="community-entry-card @(miBanner.EstiloVisual.ToLower()) fade-in mt-4 mb-4"
                     style="--b-color: @miBanner.ColorBorde; background-image: @(!string.IsNullOrEmpty(miBanner.FondoUrl) ? $"url('{miBanner.FondoUrl}')" : "none");"
                     @onclick='() => Nav.NavigateTo("/comunidad")'>

                    <div class="card-overlay"></div>

                    <button class="btn-edit-corner" @onclick:stopPropagation="true" @onclick="AbrirModalBanner">
                        <i class="fas fa-pen"></i> CUSTOMIZE
                    </button>

                    <div class="entry-content">
                        @if (!string.IsNullOrEmpty(miBanner.FotoAvatar))
                        {
                            <img src="@miBanner.FotoAvatar" class="entry-avatar" />
                        }
                        else
                        {
                            <div class="entry-avatar" style="display:flex; justify-content:center; align-items:center; color:var(--theme-primary); font-size:2rem;">
                                <i class="fas fa-user-astronaut"></i>
                            </div>
                        }
                        <div class="entry-text">
                            <h4>COMMUNITY STATS</h4>
                            <span><i class="fas fa-hand-pointer pulse-tap"></i> TOCA PARA VER A TODOS</span>
                        </div>
                    </div>
                </div>
            }

            <div class="cards-grid fade-in">
                @if (EstaActivo("AGENDA"))
                {
                    <div class="menu-card yellow-highlight" @onclick="IrAAgenda">
                        <i class="fas fa-calendar card-icon"></i>
                        <h3>AGENDA TU CLASE</h3><p>Elige tu horario...</p>
                    </div>
                }
                 @if (Sesion.Usuario?.TipoLugar == "Gimnasio")
            { 
                <div class="menu-card gym-card yellow-highlight" @onclick='() => Nav.NavigateTo("/rutina-semanal")'>
                    <div class="sparkle-container">
                        <div class="sparkle s1"></div>
                        <div class="sparkle s2"></div>
                    </div>
                    <i class="fas fa-dumbbell card-icon gym-icon"></i>
                    <h3 class="gym-title">RUTINA SEMANAL</h3>
                    <p style="color:var(--theme-bg);">Planifica y ejecuta tus días</p>
                </div>
                 } 
                @if (EstaActivo("WOD"))
                {
                    <div class="menu-card yellow-highlight" @onclick="IrAWodView">
                        <i class="fas fa-chalkboard-teacher card-icon"></i>
                        <h3>WOD</h3><p>@DateTime.Now.ToString("dd/MM/yyyy")</p>
                    </div>
                }

                @if (EstaActivo("PROGRESO"))
                {
                    <div class="menu-card yellow-highlight" @onclick="IrAProgreso">
                        <i class="fas fa-clipboard-list card-icon"></i>
                        <h3>PROGRESO</h3><p>Consulta tus datos</p>
                    </div>
                }

                @if (EstaActivo("FOTO"))
                {
                    <div class="menu-card yellow-highlight" @onclick="IrASeEntreno">
                        <i class="fas fa-fire-alt card-icon" style="color:#d9534f;"></i>
                        <h3>SE ENTRENÓ</h3><p>Sube tu foto</p>
                    </div>
                }

                @if (EstaActivo("SOCIAL"))
                {
                    <div class="menu-card yellow-highlight" @onclick="IrACompaneros">
                        <i class="fas fa-heart card-icon" style="color:darkred;"></i>
                        <h3>¿ENTRENAMOS?</h3><p>Busca hacer MATCH</p>
                    </div>
                }

                 <div class="menu-card yellow-highlight" @onclick='() => Nav.NavigateTo("/cumpleanos")'>
                 <i class="fas fa-birthday-cake card-icon" style="color: var(--theme-bg);"></i>
                 <h3>CUMPLEAÑOS</h3>
                 <p>¡Felicita a tu comunidad!</p>
                 </div>

                @if (EstaActivo("RANKING"))
                {
                    <div class="menu-card yellow-highlight" @onclick="IrARanking">
                        <i class="fas fa-trophy card-icon" style="color:#FFD700;"></i>
                        <h3>LIKES</h3><p>Líderes</p>
                    </div>
                }

                @if (EstaActivo("LEADERBOARD_HOY"))
                {
                    <div class="menu-card yellow-highlight" @onclick='() => Nav.NavigateTo("/leaderboard-hoy")'>
                        <i class="fas fa-trophy card-icon"></i>
                        <h3>RESULTADOS</h3>
                        <p>Leaderboard de Hoy</p>
                        <div class="live-badge">HOY</div>
                    </div>
                }

                @if (EstaActivo("RUNNING"))
                {
                    <div class="menu-card yellow-highlight" @onclick='() => Nav.NavigateTo("/mi-running")'>
                        <i class="fas fa-running card-icon"></i>
                        <h3>MI PLAN RUNNING</h3>
                        <p>Bitácora</p>
                    </div>
                }

              
                    <div class="menu-card yellow-highlight" @onclick='() => Nav.NavigateTo("/rutina-cliente")'>
                        <i class="fas fa-dumbbell card-icon"></i>
                        <h3>RUTINA PERSONALIZADA</h3>
                        <p>Tu plan personalizado</p>
                    </div>
                

                @if (EstaActivo("IAFUERZA"))
                {
                    <div class="menu-card yellow-highlight" @onclick='() => Nav.NavigateTo("/rutina-ia")'>
                        <i class="fas fa-robot card-icon"></i>
                        <h3>ENTRENADOR IA</h3>
                        <p>Crea tu rutina perfecta</p>
                        <div class="live-badge" style="background-color: var(--theme-bg); color: var(--theme-primary);">NUEVO</div>
                    </div>
                }

                @if (EstaActivo("PROPOSITOS"))
                {
                    <div class="menu-card yellow-highlight" @onclick='() => Nav.NavigateTo("/mis-propositos")'>
                        <i class="fas fa-bullseye card-icon"></i>
                        <h3>MIS RETOS</h3>
                        <p>Propósitos @DateTime.Now.Year</p>
                    </div>
                }

                @if (EstaActivo("QRCLASE"))
                {
                    <div class="menu-card yellow-highlight" @onclick="AbrirEscanerParaEntrar" style="position: relative;">
                        @if (abriendoCamara)
                        {
                            <div class="spinner-border text-dark" role="status" style="width: 3rem; height: 3rem;"></div>
                            <p style="margin-top: 10px; font-weight: bold;">Abriendo...</p>
                        }
                        else
                        {
                            <i class="fas fa-qrcode card-icon"></i>
                            <h3>ENTRAR A CLASE</h3>
                            <p>Escanear Pantalla</p>
                        }
                    </div>
                }

                @if (EstaActivo("RACHA"))
                {
                    <div class="menu-card yellow-highlight" @onclick='() => Nav.NavigateTo("/ranking-asistencia")'>
                        <i class="fas fa-calendar-check card-icon" style="color:var(--theme-text);"></i>
                        <h3>ASISTENCIA</h3>
                        <p>Top Anual @DateTime.Now.Year</p>
                    </div>
                }

                @if (EstaActivo("CALCULADORA"))
                {
                    <div class="menu-card yellow-highlight" @onclick='() => Nav.NavigateTo("/calculadora-rm")'>
                        <i class="fas fa-calculator card-icon" style="color: var(--theme-bg);"></i>
                        <h3>CALCULAR %</h3>
                        <p>Discos exactos</p>
                    </div>
                }

                @if (EstaActivo("TABATA"))
                {
                    <div class="menu-card yellow-highlight" @onclick='() => Nav.NavigateTo("/creador-tabata")'>
                        <i class="fas fa-fire card-icon" style="color: #ff4d4d;"></i>
                        <h3>CREADOR TÁBATA</h3>
                        <p>Ruleta 20/10</p>
                    </div>
                }

                <div class="menu-card yellow-highlight" @onclick='() => Nav.NavigateTo("/credencial")'>
                    <i class="fas fa-id-card card-icon" style="color: var(--theme-bg);"></i>
                    <h3>MI CREDENCIAL</h3>
                    <p>Identificación Digital</p>
                </div>

                @if (EstaActivo("MEDALLERO"))
                {
                    <div class="menu-card medallero-card" @onclick="IrAMedallero">
                        <div class="sparkle-container">
                            <div class="sparkle s1"></div>
                            <div class="sparkle s2"></div>
                            <div class="sparkle s3"></div>
                        </div>
                        <i class="fas fa-medal card-icon trophy-icon"></i>
                        <h3 class="trophy-title">MEDALLERO</h3>
                        <p class="trophy-title">Observa tu esfuerzo</p>
                    </div>
                }

                @if (EstaActivo("PLAYERCARD"))
                {
                    <div class="menu-card ficha-card yellow-highlight" @onclick="IrAMiFicha">
                        <div class="holo-glare"></div>
                        <i class="fas fa-id-badge card-icon player-icon"></i>
                        <h3 class="player-title">MI FICHA</h3>
                        <p>Player Card Oficial</p>
                    </div>
                }

                @if (boxTieneMedallas)
                {
                    <div class="menu-card medallero-card" @onclick='() => Nav.NavigateTo("/logrodesbloqueado")'>
                        <div class="sparkle-container">
                            <div class="sparkle s1"></div>
                            <div class="sparkle s2"></div>
                            <div class="sparkle s3"></div>
                        </div>
                        <i class="fa-brands fa-phoenix-framework card-icon trophy-icon"></i>
                        <h3 class="trophy-title">ACHIEVEMENTS</h3>
                        <p class="trophy-title">Coleccionalas</p>
                    </div>
                }

            </div>
        }

        <div class="footer-brand">@NombreBox</div>
        <div style="height: 40px;"></div>
    </div>
</div>

@* --- MODAL PEDIR CUMPLEAÑOS --- *@
@if (mostrarModalPedirCumple)
{
    <div class="modal-overlay fade-in">
        <div class="modal-content custom-modal slide-up text-center">
            <div class="modal-header" style="justify-content: center; border-bottom: none;">
                <h5 style="color:var(--theme-primary); margin:0; font-family:'Oswald'; font-size: 1.5rem;">
                    <i class="fas fa-birthday-cake"></i> ¡QUEREMOS CELEBRARTE!
                </h5>
            </div>
            
            <div class="modal-body">
                <p style="color:var(--theme-text-muted); font-size: 0.9rem; margin-bottom: 20px; font-family: 'Roboto';">
                    Ingresa tu fecha de nacimiento para que toda la comunidad pueda felicitarte en tu día especial.
                </p>
                
                <input type="date" @bind="fechaCumpleInput" class="form-control input-dark mb-4" style="text-align: center; font-size: 1.2rem; font-family: 'Oswald';" />
            </div>

            <div class="modal-footer" style="flex-direction: column; gap: 10px;">
                <button class="btn-confirm w-100" @onclick="GuardarMiCumple" disabled="@guardandoCumple">
                    @if(guardandoCumple) { <i class="fas fa-spinner fa-spin"></i> } else { <span>GUARDAR FECHA</span> }
                </button>
                <button class="btn-cancel w-100" style="background: transparent !important; border: none !important; color: var(--theme-text-muted) !important;" @onclick="() => mostrarModalPedirCumple = false">
                    Hacerlo más tarde
                </button>
            </div>
        </div>
    </div>
}

@if (mostrarModalBanner)
{
    <div class="modal-overlay fade-in" @onclick="CerrarModalBanner">
        <div class="modal-content custom-modal slide-up" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h5 style="margin:0; color:var(--theme-primary); font-weight:bold; font-family:'Oswald';">
                    <i class="fas fa-pen" style="margin-right:8px;"></i> CALLING CARD
                </h5>
                <button class="btn-close-custom" @onclick="CerrarModalBanner"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body scroll-custom">

                <div class="edit-group">
                    <label><i class="fas fa-image"></i> WALLPAPER DEL BANNER</label>
                    <InputFile OnChange='(e) => SubirImagenBannerForm(e, "fondo")' accept="image/*" id="banner-bg" style="display:none;" />
                    <label for="banner-bg" class="btn-upload-action">
                        @if (subiendoFondo)
                        {
                            <i class="fas fa-spinner fa-spin"></i> <span>SUBIENDO...</span>
                        }
                        else
                        {
                            <i class="fas fa-upload"></i> <span>CARGAR FONDO</span>
                        }
                    </label>
                    @if (!string.IsNullOrEmpty(miBanner?.FondoUrl))
                    {
                        <button class="btn-quitar-bg mt-2" @onclick="QuitarFondoCustomBanner"><i class="fas fa-trash"></i> QUITAR FONDO</button>
                    }
                </div>

                <div class="edit-group mt-3">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <label style="margin:0;"><i class="fas fa-user-circle"></i> USAR MI FOTO DE PERFIL</label>
                        <label class="switch">
                            <input type="checkbox" @bind="miBannerEdit.UsarFotoPerfil">
                            <span class="slider round"></span>
                        </label>
                    </div>

                    @if (!miBannerEdit.UsarFotoPerfil)
                    {
                        <div class="mt-2 p-2" style="background: rgba(0,0,0,0.3); border-radius: 8px;">
                            <InputFile OnChange='(e) => SubirImagenBannerForm(e, "foto")' accept="image/*" id="banner-pic" style="display:none;" />
                            <label for="banner-pic" class="btn-upload-action secondary">
                                @if (subiendoFoto)
                                {
                                    <i class="fas fa-spinner fa-spin"></i> <span>SUBIENDO...</span>
                                }
                                else
                                {
                                    <i class="fas fa-camera"></i> <span>SUBIR FOTO ESPECIAL</span>
                                }
                            </label>
                        </div>
                    }
                </div>

                <div class="edit-group mt-3">
                    <label><i class="fas fa-palette"></i> COLOR DEL BORDE / NEÓN</label>
                    <input type="color" @bind="miBannerEdit.ColorBorde" class="color-input" />
                </div>

           <div class="edit-group mt-3">
                    <label><i class="fas fa-magic"></i> ESTILO VISUAL</label>
                    <div class="styles-grid">
                        <div class="style-item @(miBannerEdit.EstiloVisual == "Glass" ? "selected" : "")" @onclick='() => miBannerEdit.EstiloVisual = "Glass"'>
                            <div class="style-preview glass-preview"></div> <span>GLASS</span>
                        </div>
                        <div class="style-item @(miBannerEdit.EstiloVisual == "Neon" ? "selected" : "")" @onclick='() => miBannerEdit.EstiloVisual = "Neon"'>
                            <div class="style-preview neon-preview"></div> <span>NEÓN</span>
                        </div>
                        <div class="style-item @(miBannerEdit.EstiloVisual == "Cyberpunk" ? "selected" : "")" @onclick='() => miBannerEdit.EstiloVisual = "Cyberpunk"'>
                            <div class="style-preview cyber-preview"></div> <span>CYBER</span>
                        </div>
                        <div class="style-item @(miBannerEdit.EstiloVisual == "Gold" ? "selected" : "")" @onclick='() => miBannerEdit.EstiloVisual = "Gold"'>
                            <div class="style-preview gold-preview"></div> <span>ORO</span>
                        </div>
                        <div class="style-item @(miBannerEdit.EstiloVisual == "Holo" ? "selected" : "")" @onclick='() => miBannerEdit.EstiloVisual = "Holo"'>
                            <div class="style-preview holo-preview"></div> <span>HOLO</span>
                        </div>
                        <div class="style-item @(miBannerEdit.EstiloVisual == "Toxic" ? "selected" : "")" @onclick='() => miBannerEdit.EstiloVisual = "Toxic"'>
                            <div class="style-preview toxic-preview"></div> <span>TOXIC</span>
                        </div>
                        <div class="style-item @(miBannerEdit.EstiloVisual == "Flat" ? "selected" : "")" @onclick='() => miBannerEdit.EstiloVisual = "Flat"'>
                            <div class="style-preview flat-preview"></div> <span>FLAT</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CerrarModalBanner">Cancelar</button>
                <button class="btn-confirm" @onclick="GuardarConfiguracionBanner" disabled="@guardandoBanner">
                    @if (guardandoBanner)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                    }
                    else
                    {
                        <span>GUARDAR</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
@if (mostrarModalPassword)
{
    <div class="modal-overlay">
        <div class="modal-content custom-modal">
            <div class="modal-header">
                <h5 style="margin:0; color:var(--theme-primary); font-weight:bold; font-family:'Oswald';">
                    <i class="fas fa-lock" style="margin-right:8px;"></i> CAMBIAR CONTRASEÑA
                </h5>
                <button class="btn-close-custom" @onclick="() => mostrarModalPassword = false"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <label class="lbl-input">Contraseña Actual:</label>
                <div class="input-group mb-3">
                    <input type="@tipoInputOld" @bind="passOld" class="form-control input-dark" placeholder="******" style="border-radius: 10px 0 0 10px !important;" />
                    <button class="btn-eye" @onclick="() => ToggleVerPass(1)" style="padding: 0 15px;"><i class="fas fa-eye"></i></button>
                </div>

                <label class="lbl-input">Nueva Contraseña:</label>
                <div class="input-group mb-3">
                    <input type="@tipoInputNew" @bind="passNew" class="form-control input-dark" placeholder="******" style="border-radius: 10px 0 0 10px !important;" />
                    <button class="btn-eye" @onclick="() => ToggleVerPass(2)" style="padding: 0 15px;"><i class="fas fa-eye"></i></button>
                </div>

                <label class="lbl-input">Confirmar Nueva:</label>
                <div class="input-group mb-3">
                    <input type="@tipoInputConfirm" @bind="passConfirm" class="form-control input-dark" placeholder="******" style="border-radius: 10px 0 0 10px !important;" />
                    <button class="btn-eye" @onclick="() => ToggleVerPass(3)" style="padding: 0 15px;"><i class="fas fa-eye"></i></button>
                </div>

                @if (!string.IsNullOrEmpty(msgErrorPass))
                {
                    <div class="alert alert-danger p-2 text-center" style="font-size:0.85rem; border-radius: 10px;">@msgErrorPass</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="() => mostrarModalPassword = false">Cancelar</button>
                <button class="btn-confirm" @onclick="GuardarNuevaPassword" disabled="@procesandoPass">
                    @if (procesandoPass)
                    {
                        <span><i class="fas fa-spinner fa-spin"></i></span>
                    }
                    else
                    {
                        <span>GUARDAR</span>
                    }
                </button>
            </div>
        </div>
    </div>
}@if (mostrarModalPlanesAdmin)
{
    <div class="modal-overlay">
        <div class="modal-content custom-modal">
            <div class="modal-header">
                <h5 style="color:var(--theme-primary); margin:0; font-family:'Oswald'; letter-spacing:1px;">ELIGE TU PLAN</h5>
                <button class="btn-close-custom" @onclick="() => mostrarModalPlanesAdmin = false"><i class="fas fa-times"></i></button>
            </div>

            <div class="modal-body text-center">
                <p style="color:var(--theme-text-muted); font-size:0.9rem; margin-bottom:20px;">Selecciona cómo quieres renovar tu servicio:</p>

                <div class="planes-selection-grid">
                    @{
                        var planMes = listaPlanes.FirstOrDefault(p => p.PlanID == 1);
                    }
                    @if (planMes != null)
                    {
                        <div class="plan-option-card" @onclick='() => ProcesarPago("Renta Mensual", planMes.Precio)'>
                            <div class="plan-title">MENSUAL</div>
                            <div class="plan-price">$@planMes.Precio</div>
                            <div class="plan-note">Pago único por 30 días</div>
                        </div>
                    }

                    @{
                        var planAnio = listaPlanes.FirstOrDefault(p => p.PlanID == 2);
                    }
                    @if (planAnio != null)
                    {
                        <div class="plan-option-card recommended" @onclick='() => ProcesarPago("Renta Anual (Ahorro)", planAnio.Precio)'>
                            <div class="badge-save">AHORRA MÁS</div>
                            <div class="plan-title">ANUAL</div>
                            <div class="plan-price">$@planAnio.Precio</div>
                            <div class="plan-note">12 Meses de servicio completo</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* --- MODAL MODULOS --- *@
@if (mostrarModalModulos)
{
    <div class="modal-overlay">
        <div class="modal-content custom-modal" style="max-height: 80vh;">
            <div class="modal-header">
                <h5 style="margin:0; color:var(--theme-primary); font-weight:bold;">CONFIGURAR MÓDULOS</h5>
                <button class="btn-close-custom" @onclick="() => mostrarModalModulos = false"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body" style="overflow-y:auto;">
                <p style="color:var(--theme-text-muted); font-size:0.8rem; margin-bottom:15px;">Apaga los módulos que no quieras que vean tus atletas.</p>
                @if (listaConfiguracion != null)
                {
                    @foreach (var mod in listaConfiguracion)
                    {
                        <div class="module-row" @onclick="() => ToggleModulo(mod)">
                            <span class="mod-name">@mod.NombreVisible</span>
                            <div class="switch-track @(mod.Activo ? "on" : "off")">
                                <div class="switch-thumb"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center" style="color: var(--theme-primary);">Cargando...</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-confirm" @onclick="() => mostrarModalModulos = false">LISTO</button>
            </div>
        </div>
    </div>
}

@* --- MODAL WOD PRINCIPAL --- *@
@if (mostrarModalWod)
{
    <div class="modal-overlay overlay-wod">
        <div class="modal-content custom-modal modal-wod">

            <div class="modal-header">
                <h5 style="margin:0; color:var(--theme-primary); font-family:'Oswald'">
                    PROGRAMACIÓN WOD
                    <span style="font-size:0.7rem; color:var(--theme-text-muted); margin-left:10px;">
                        @(modoTextoLibre ? "(TEXTO LIBRE)" : "(POR BLOQUES)")
                    </span>
                </h5>
                <button class="btn-close-custom" @onclick="() => mostrarModalWod = false"><i class="fas fa-times"></i></button>
            </div>

            <div class="modal-body" style="padding-bottom: 50px;">
                <div class="mb-4">
                    <label style="color:var(--theme-text-muted); font-size:0.8rem;">Fecha del WOD:</label>
                    <input type="date" value="@nuevoWod.FechaProgramacion.ToString("yyyy-MM-dd")" @onchange="AlCambiarFechaWod" class="form-control input-dark" />
                </div>

                @if (cargandoOperacionWod)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border" style="color: var(--theme-primary);" role="status"></div>
                        <p class="mt-2 text-muted">Cargando...</p>
                    </div>
                }
                else if (wodExiste && !editandoWod)
                {
                    <div class="alert-conflict fade-in">
                        <i class="fas fa-exclamation-triangle conflict-icon"></i>
                        <h4>¡YA EXISTE UN WOD!</h4>
                        <p>Hay una rutina programada para esta fecha.</p>
                        <div class="d-grid gap-2 mt-4">
                            <button class="btn" style="border: 1px solid var(--theme-primary); color: var(--theme-primary);" @onclick="CargarWodParaEditar"><i class="fas fa-edit"></i> EDITAR EXISTENTE</button>
                            <button class="btn btn-outline-danger" @onclick="EliminarWodActual"><i class="fas fa-trash"></i> ELIMINAR TODO</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="fade-in">
                        @foreach (var bloque in listaBloquesEditor)
                        {
                            <div class="card p-2 mb-3" style="background-color: var(--theme-card-inner); border: 1px solid var(--theme-border);">

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span style="color:var(--theme-primary); font-weight:bold; font-family:'Oswald'">BLOQUE</span>
                                    <button class="btn-icon delete-btn" @onclick="() => EliminarBloque(bloque)"><i class="fas fa-trash"></i></button>
                                </div>

                                @if (!modoTextoLibre)
                                {
                                    <select @bind="bloque.SegmentoClaseID" class="form-control input-dark mb-2">
                                        <option value="@Guid.Empty" selected disabled>-- Selecciona Segmento --</option>
                                        @foreach (var seg in listaSegmentos)
                                        {
                                            <option value="@seg.Id">@seg.Nombre</option>
                                        }
                                    </select>
                                }

                                @if (modoTextoLibre)
                                {
                                    <input type="text" @bind="bloque.TiempoFormato" class="form-control input-dark mb-3" placeholder="Tiempo / Formato (Ej: AMRAP 15 MIN, 8x1min)" style="border-color: #555;" />                               
                                    @* MODO TEXTO LIBRE *@
                                    <textarea @bind="bloque.TextoLibre" class="form-control input-dark textarea-avisos" style="height: auto !important; min-height: 150px; resize: vertical; border-color: var(--theme-primary);" placeholder="Escribe aquí los ejercicios libremente... (Los saltos de línea se respetarán)"></textarea>
                                }
                                else
                                {
                                    @* MODO NORMAL (FILAS) *@
                                    @foreach (var ejercicio in bloque.Ejercicios)
                                    {
                                        <div class="ejercicio-row fade-in">
                                            <div class="input-group-reps">
                                                <input type="text" @bind="ejercicio.Reps" class="form-control input-dark text-center" placeholder="Reps" />
                                            </div>
                                            <div class="input-group-name">
                                                <input type="text" @bind="ejercicio.NombreBase" class="form-control input-dark" placeholder="Ejercicio" />
                                            </div>
                                            <div>
                                                <button class="btn-icon weight-btn @(ejercicio.TienePesos ? "active" : "")" @onclick="() => AbrirEditorPeso(ejercicio)">
                                                    <i class="fas fa-dumbbell"></i>
                                                    @if (ejercicio.TienePesos)
                                                    {
                                                        <span class="dot-indicator"></span>
                                                    }
                                                </button>
                                            </div>
                                            <button class="btn-icon delete-btn" @onclick="() => EliminarEjercicio(bloque, ejercicio)">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    }
                                    <button class="btn-add-ejercicio" @onclick="() => AgregarEjercicio(bloque)">
                                        <i class="fas fa-plus"></i> Ejercicio
                                    </button>
                                }
                            </div>
                        }
                        <button class="btn w-100 py-2" style="border: 1px solid var(--theme-primary); color: var(--theme-primary);" @onclick="AgregarBloque">+ Bloque</button>
                    </div>
                }
            </div>

            @if ((!wodExiste || editandoWod) && !cargandoOperacionWod)
            {
                <div class="modal-footer">
                    <button class="btn w-100" style="background-color:var(--theme-primary); color:var(--theme-bg); font-weight:bold;" @onclick="GuardarProgramacion">GUARDAR WOD</button>
                </div>
            }
        </div>
    </div>
}

@* --- BOTTOM SHEET (EDITOR DE PESOS) --- *@
@if (mostrarModalPeso && ejercicioEnEdicion != null)
{
    @* Fondo oscuro (Backdrop) *@
    <div class="sheet-backdrop visible" @onclick="CerrarEditorPeso"></div>

    @* El Panel Deslizante *@
    <div class="bottom-sheet slide-in-bottom">
        
        <div class="sheet-handle"></div>

        <div class="text-center mb-4">
            <h5 style="color:var(--theme-primary); font-family:'Oswald'; margin:0;">PESOS (Rx)</h5>
            <p style="color:var(--theme-text-muted); font-size:0.8rem; margin-top:5px;">
                @(string.IsNullOrEmpty(ejercicioEnEdicion.NombreBase) ? "Ejercicio" : ejercicioEnEdicion.NombreBase)
            </p>
        </div>

        <div class="row">
            <div class="col-6">
                <label style="color:var(--theme-text); font-size:0.8rem; display:block; text-align:center;">HOMBRE</label>
                <div class="input-group-animated">
                    <input type="text" @bind="ejercicioEnEdicion.PesoH" 
                           class="form-control input-dark text-center" 
                           style="font-size:1.5rem; color:var(--theme-primary); font-weight:bold; border: 1px solid var(--theme-border);" 
                           placeholder="--" />
                </div>
            </div>
            <div class="col-6">
                <label style="color:var(--theme-text); font-size:0.8rem; display:block; text-align:center;">MUJER</label>
                <div class="input-group-animated">
                    <input type="text" @bind="ejercicioEnEdicion.PesoM" 
                           class="form-control input-dark text-center" 
                           style="font-size:1.5rem; color:var(--theme-primary); font-weight:bold; border: 1px solid var(--theme-border);" 
                           placeholder="--" />
                </div>
            </div>
        </div>

        <button class="btn w-100 mt-4 py-3" 
                style="background:var(--theme-primary); font-weight:bold; border-radius:50px; color: var(--theme-bg);" 
                @onclick="CerrarEditorPeso">
            GUARDAR <i class="fas fa-check"></i>
        </button>
    </div>
}

@* --- RESTO DE MODALES (Avisos, Horarios) --- *@
@if (mostrarModalCrearAviso)
{
    <div class="modal-overlay">
        <div class="modal-content custom-modal">
            <div class="modal-header">
                <h5 style="margin:0; color: var(--theme-primary); font-weight:bold; font-family:'Oswald';"><i class="fas fa-bullhorn" style="margin-right:8px;"></i> NUEVO AVISO</h5>
                <button class="btn-close-custom" @onclick="() => mostrarModalCrearAviso = false"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <label class="lbl-input">Título:</label>
                <input type="text" @bind="nuevoAviso.Titulo" class="form-control input-dark mb-3" placeholder="Ej: Horario Festivo" />
                
                <label class="lbl-input">Mensaje:</label>
                <textarea @bind="nuevoAviso.Mensaje" class="form-control input-dark textarea-avisos mb-3" placeholder="Escribe aquí la información detallada..."></textarea>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="() => mostrarModalCrearAviso = false">Cancelar</button>
                <button class="btn-confirm" @onclick="PublicarAviso">PUBLICAR</button>
            </div>
        </div>
    </div>
}

@if (mostrarAvisoPopUp && ultimoAviso != null)
{
    <div class="modal-overlay pop-up-effect">
        <div class="modal-content aviso-content">
            <div class="aviso-icon"><i class="fas fa-bullhorn"></i></div>
            <h3 class="aviso-title">@ultimoAviso.Titulo</h3>
            <div class="aviso-date">@ultimoAviso.FechaCreacion.GetValueOrDefault().ToString("dd/MM/yyyy")</div>
            <div class="aviso-body">@ultimoAviso.Mensaje</div>
            <button class="btn-ok" @onclick="CerrarAviso">ENTERADO</button>
        </div>
