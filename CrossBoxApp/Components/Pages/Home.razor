    private async Task VerificarWodExistente(DateTime fecha)
    {
        cargandoOperacionWod = true; wodExiste = false; editandoWod = false; StateHasChanged();
        try
        {
            var fechaStr = fecha.ToString("yyyy-MM-dd");
            wodExiste = await Http.GetFromJsonAsync<bool>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/wodapi/existe/{Sesion.Usuario.BoxID}/{fechaStr}");

            if (!wodExiste)
            {
                listaBloquesEditor = new List<BloqueEditorViewModel>();
                AgregarBloque();
            }
        }
        catch
        {
            wodExiste = false;
            listaBloquesEditor = new List<BloqueEditorViewModel>();
            AgregarBloque();
        }
        finally
        {
            cargandoOperacionWod = false;
            StateHasChanged();
        }
    }

    private async Task CargarWodParaEditar()
    {
        cargandoOperacionWod = true;
        try
        {
            var fechaStr = nuevoWod.FechaProgramacion.ToString("yyyy-MM-dd");
            // Aquí debes asegurarte de que tu clase DTO del frontend coincida con la que manda la API
            var wodExistente = await Http.GetFromJsonAsync<ProgramacionWodViewModel>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/wodapi/obtener/{Sesion.Usuario.BoxID}/{fechaStr}");

            if (wodExistente != null && wodExistente.Bloques.Any())
            {
                nuevoWod = wodExistente;
                editandoWod = true; // Mostramos el form

                // DETECTAR EL MODO DEL WOD EXISTENTE (Basta con ver el primer bloque)
                // Nota: Asegúrate de tener EsTextoLibre en tu clase DTO de C# en el frontend
                // Si no lo mapeaste, lo puedes deducir si el Ejercicio solo tiene Descripción y Reps está vacío

                listaBloquesEditor = new List<BloqueEditorViewModel>();

                // Determinamos el modo global basados en el primer bloque
                var primerBloque = wodExistente.Bloques.First();
                // (Opcional) Si agregaste EsTextoLibre al ViewModel, úsalo. Si no, lo deducimos:
                modoTextoLibre = string.IsNullOrEmpty(primerBloque.Ejercicios.First().PesoRepeticiones) && primerBloque.Ejercicios.Count == 1;

                foreach (var b in wodExistente.Bloques)
                {
                    var bloqueEdit = new BloqueEditorViewModel
                    {
                        SegmentoClaseID = b.SegmentoClaseID,
                        NombreSegmento = b.NombreSegmento,
                        // Suponiendo que agregaste TiempoFormato a tu DTO BloqueWodViewModel en el frontend:
                        TiempoFormato = b.TiempoFormato,
                        Ejercicios = new List<EjercicioEditorViewModel>()
                    };

                    if (modoTextoLibre)
                    {
                        bloqueEdit.TextoLibre = b.Ejercicios.FirstOrDefault()?.Descripcion;
                    }
                    else
                    {
                        foreach (var ej in b.Ejercicios)
                        {
                            bloqueEdit.Ejercicios.Add(new EjercicioEditorViewModel
                            {
                                Reps = ej.PesoRepeticiones,
                                NombreBase = ej.Descripcion
                            });
                        }
                    }
                    listaBloquesEditor.Add(bloqueEdit);
                }
            }
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error", "No se pudo cargar el WOD: " + ex.Message, "OK");
        }
        finally
        {
            cargandoOperacionWod = false;
        }
    }

