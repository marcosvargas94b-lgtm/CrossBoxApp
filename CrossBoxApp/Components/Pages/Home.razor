            var fechaStr = nuevoWod.FechaProgramacion.ToString("yyyy-MM-dd");
            var wodExistente = await Http.GetFromJsonAsync<ProgramacionWodViewModel>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/wodapi/obtener/{Sesion.Usuario.BoxID}/{fechaStr}");
            if (wodExistente != null && wodExistente.Bloques.Any())
            {
                nuevoWod = wodExistente;
                editandoWod = true; 
                listaBloquesEditor = new List<BloqueEditorViewModel>();
                var primerBloque = wodExistente.Bloques.First();
                modoTextoLibre = string.IsNullOrEmpty(primerBloque.Ejercicios.First().PesoRepeticiones) && primerBloque.Ejercicios.Count == 1;

                foreach (var b in wodExistente.Bloques)
                {
                    var bloqueEdit = new BloqueEditorViewModel { SegmentoClaseID = b.SegmentoClaseID, NombreSegmento = b.NombreSegmento, TiempoFormato = b.TiempoFormato, Ejercicios = new List<EjercicioEditorViewModel>() };
                    if (modoTextoLibre) { bloqueEdit.TextoLibre = b.Ejercicios.FirstOrDefault()?.Descripcion; }
                    else { foreach (var ej in b.Ejercicios) { bloqueEdit.Ejercicios.Add(new EjercicioEditorViewModel { Reps = ej.PesoRepeticiones, NombreBase = ej.Descripcion }); } }
                    listaBloquesEditor.Add(bloqueEdit);
                }
            }
        }
        catch (Exception ex) { await App.Current.MainPage.DisplayAlert("Error", "No se pudo cargar el WOD: " + ex.Message, "OK"); }
        finally { cargandoOperacionWod = false; }
    }

