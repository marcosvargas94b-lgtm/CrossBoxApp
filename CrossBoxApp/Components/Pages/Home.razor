    private async Task CargarMiBanner()
    {
        cargandoBanner = true;
        StateHasChanged();
        try
        {
            var urlBase = "https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/communityapi";
            miBanner = await Http.GetFromJsonAsync<BannerDto>($"{urlBase}/mi-banner/{Sesion.Usuario.BoxID}/{Sesion.Usuario.UsuarioID}");

            if (miBanner != null)
            {
                miBannerEdit.ColorBorde = miBanner.ColorBorde;
                miBannerEdit.EstiloVisual = miBanner.EstiloVisual;
                
                // --- NUEVO: DETERMINAR SI USA FOTO CUSTOM O DE PERFIL ---
                // Si la URL que nos devuelve el servidor viene de la carpeta "/banners/", es porque subió una propia
                if (!string.IsNullOrEmpty(miBanner.FotoAvatar) && miBanner.FotoAvatar.Contains("/banners/"))
                {
                    miBannerEdit.UsarFotoPerfil = false;
                }
                else
                {
                    miBannerEdit.UsarFotoPerfil = true;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar mi banner: " + ex.Message);
