}

@if (mostrarModalHorarios)
{
    <div class="modal-overlay">
        <div class="modal-content custom-modal">
            <div class="modal-header">
                <h5 style="margin:0; color:var(--theme-primary); font-weight:bold; font-family:'Oswald';">
                    <i class="fas fa-clock"></i> HORARIOS DEL BOX
                </h5>
                <button class="btn-close-custom" @onclick="() => mostrarModalHorarios = false"><i class="fas fa-times"></i></button>
            </div>

            <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                <div class="add-section mb-4">
                    <label class="lbl-input">Nuevo Horario (Ej: 7:00 AM)</label>
                    <div class="input-group">
                        <input type="text" @bind="nuevoHorarioTexto" class="form-control input-dark" placeholder="Escribe el horario..." style="border-radius: 10px 0 0 10px !important;" />
                        <button class="btn-confirm" @onclick="AgregarHorario" style="border-radius: 0 10px 10px 0 !important; flex: 0 0 60px;">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>

                <hr style="border-color:var(--theme-border);" />
                <label class="lbl-input mb-3">Horarios Activos:</label>

                @if (listaHorariosAdmin == null)
                {
                    <div class="text-center text-muted">Cargando...</div>
                }
                else if (listaHorariosAdmin.Count == 0)
                {
                    <div class="text-center text-muted">No hay horarios registrados.</div>
                }
                else
                {
                    <div class="horarios-list">
                        @foreach (var h in listaHorariosAdmin)
                        {
                            <div class="horario-row">
                                <span class="horario-text">@h.Descripcion</span>
                                <button class="btn-delete-mini" @onclick="() => EliminarHorario(h.HorarioID)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                 <button class="btn-cancel" @onclick="() => mostrarModalHorarios = false">Cerrar</button>
            </div>
        </div>
    </div>
}
</div>
<style>
    /* ========================================= */
    /* ESTILOS BASE Y ESTRUCTURA                 */
    /* ========================================= */
    .main-layout { position: fixed; top:0; left:0; width:100vw; height:100vh; background:var(--theme-bg); display:flex; flex-direction:column; z-index:1; }
    .navbar-container { position: relative; flex-shrink:0; padding-top: calc(env(safe-area-inset-top) + 5px); padding-bottom:10px; padding-left:20px; padding-right:20px; background-color: var(--theme-bg); border-bottom:1px solid var(--theme-primary); display:flex; justify-content:space-between; align-items:center; z-index:100; font-family:'Oswald'; color:var(--theme-text); min-height: 60px; }
    .nav-left { color:var(--theme-primary); font-weight:bold; cursor:pointer; display:flex; align-items:center; gap:8px; font-size:0.9rem; }
    .nav-title { font-weight:bold; font-size:1.1rem; color:var(--theme-text); letter-spacing:1px; }
    .nav-right { width:60px; display:flex; justify-content:flex-end; }
    .scrollable-content { flex-grow: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; align-items: center; -webkit-overflow-scrolling: touch; padding-bottom: 40px; z-index: 10; position: relative; }

    /* Marca de agua y Menús Superpuestos */
    .menu-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 90; background: transparent; }
    .watermark { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 70%; max-width: 500px; aspect-ratio: 1/1; background-repeat: no-repeat; background-position: center; background-size: contain; opacity: 0.35; z-index: 0; pointer-events: none; }
    .nav-logo { height: 40px; width: 40px; border-radius: 50%; object-fit: cover; margin-right: 10px; border: 1px solid var(--theme-primary); }
    .brand { display: flex; align-items: center; font-size: 1.3rem; font-weight: bold; color: var(--theme-text); }

    /* ========================================= */
    /* HOME CARDS Y MENÚS PRINCIPALES            */
    /* ========================================= */
    .right-actions { display: flex; align-items: center; gap: 15px; }
    .welcome-section h1 { font-family: 'Oswald'; color: var(--theme-primary); font-size: 1.8rem; margin-bottom: 20px; text-align: center; margin-top: 10px; }
    .cards-grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 15px; width: 100%; max-width: 600px; margin: 0 auto; }
    
    .menu-card { background-color: var(--theme-primary); color: var(--theme-bg); width: calc(50% - 7.5px); max-width: none; height: 150px; border-radius: 15px; padding: 10px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; box-shadow: 0 4px 10px rgba(0,0,0, 0.2); cursor: pointer; transition: transform 0.2s; }
    .menu-card:active { transform: scale(0.95); }
    .menu-card h3 { font-family: 'Oswald'; font-size: 0.9rem; font-weight: bold; margin: 0; line-height: 1.2; color: inherit; }
    .menu-card p { font-size: 0.65rem; font-family: 'Roboto'; line-height: 1.1; margin-top: 4px; color: inherit; }
    .card-icon { font-size: 2rem; margin-bottom: 8px; color: inherit; }
    
    .yellow-highlight { background: var(--theme-primary) !important; color: var(--theme-bg) !important; border: 2px solid var(--theme-text); position: relative; }
    .yellow-highlight h3, .yellow-highlight p, .yellow-highlight i { color: var(--theme-bg) !important; }
    .live-badge { position: absolute; top: 8px; right: 8px; background: red; color: white; font-size: 0.55rem; padding: 2px 5px; border-radius: 4px; font-weight: bold; }
    .footer-brand { margin-top: auto; padding: 20px; color: var(--theme-primary); font-family: 'Oswald'; }
    
    .payment-alert { margin: 0 auto 15px auto; padding: 12px; border-radius: 10px; display: flex; align-items: center; gap: 10px; width: 100%; max-width: 600px; }
    .payment-alert.warning { background: linear-gradient(90deg, #ffc107 0%, #ff9800 100%); color: black; }
    .payment-alert.expired { background: linear-gradient(90deg, #dc3545 0%, #c82333 100%); color: white; }
    
    .main-menu-wrapper { position: relative; cursor: pointer; display: flex; align-items: center; gap: 10px; }
    .user-name { font-size: 0.9rem; font-weight: bold; display: none; color: var(--theme-text); }
    @@media(min-width: 768px) { .user-name { display: block; } }
    .menu-burger { font-size: 1.5rem; color: var(--theme-primary); }
    .dropdown-header { font-size: 0.7rem; color: var(--theme-text-muted); padding: 10px 15px 5px 15px; font-weight: bold; letter-spacing: 1px; }
    .admin-header { color: var(--theme-primary); text-transform: uppercase; border-top: 1px solid var(--theme-border); margin-top: 5px; }
    .dropdown-item { padding: 12px 20px; color: var(--theme-text) !important; cursor: pointer; font-family: 'Roboto', sans-serif; font-size: 0.9rem; display: flex; align-items: center; gap: 12px; transition: background 0.2s; }
    .dropdown-item:hover { background-color: var(--theme-border); color: var(--theme-primary) !important; }
    .dropdown-divider { height: 1px; background: var(--theme-border); margin: 5px 0; }
    .main-dropdown { position: absolute; top: 45px; right: 0; width: 260px; background: var(--theme-card); border: 1px solid var(--theme-primary); border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.9); overflow-y: auto; -webkit-overflow-scrolling: touch; max-height: 70vh; padding-bottom: 30px; z-index: 2000; animation: slideDown 0.2s ease-out; }
    
    /* Notificaciones */
    /* Notificaciones */
    .noti-wrapper { position: relative; cursor: pointer; display: flex; align-items: center; } /* Aseguramos que sea relative */
    .noti-icon { font-size: 1.3rem; color: var(--theme-text); }
    .noti-dot { position: absolute; top: -2px; right: -2px; width: 8px; height: 8px; background: red; border-radius: 50%; border: 2px solid var(--theme-bg); }
    .bell-ring { animation: ring 4s .7s ease-in-out infinite; color: var(--theme-primary); }
    
    /* EL ARREGLO DEL RECUADRO ESTÁ AQUÍ */
    .noti-dropdown { 
        position: absolute; 
        top: 45px; /* Empuja el cuadro hacia abajo, lejos del notch */
        right: -10px; /* Lo mantiene pegado a la orilla derecha sin salirse */
        width: 280px; 
        background: var(--theme-card); 
        border: 1px solid var(--theme-border); 
        border-radius: 8px; 
        box-shadow: 0 10px 30px rgba(0,0,0,0.8); 
        overflow: hidden; 
        z-index: 9999; /* Máxima prioridad para que no se tape con nada */
        max-height: 300px; 
        overflow-y: auto; 
    }
    
    .noti-item { padding: 12px; border-bottom: 1px solid var(--theme-border); font-size: 0.8rem; display: flex; align-items: center; gap: 10px; color: var(--theme-text); }
    .noti-item.unread { background: rgba(255,255,255,0.05); border-left: 3px solid var(--theme-primary); }

    /* Switch Component (Módulos) */
    .module-row { display: flex; justify-content: space-between; align-items: center; background-color: var(--theme-card); padding: 12px 15px; border-radius: 8px; margin-bottom: 10px; border: 1px solid var(--theme-border); cursor: pointer; transition: background-color 0.2s; }
    .mod-name { color: var(--theme-text); font-family: 'Roboto', sans-serif; font-weight: bold; font-size: 0.9rem; }
    .switch-track { width: 50px; height: 26px; background-color: var(--theme-border); border-radius: 20px; position: relative; transition: background-color 0.3s ease; border: 1px solid var(--theme-border); }
    .switch-track.on { background-color: var(--theme-primary); border-color: var(--theme-primary); }
    .switch-thumb { width: 22px; height: 22px; background-color: white; border-radius: 50%; position: absolute; top: 1px; left: 2px; transition: transform 0.3s cubic-bezier(0.4, 0.0, 0.2, 1); }
    .switch-track.on .switch-thumb { transform: translateX(24px); }

    /* ========================================= */
    /* TARJETA DE RECUPERACIÓN Y BANNER          */
    /* ========================================= */
    .recovery-section { width: 100%; max-width: 600px; margin: 0 auto 20px auto; padding: 0; }
    .card-recuperacion-master { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); border: 1px solid var(--theme-border); border-radius: 28px; display: flex; padding: 20px 15px; height: 240px; position: relative; overflow: hidden; box-shadow: 0 15px 35px rgba(0,0,0,0.4); cursor: pointer; }
    .info-content { flex: 1; display: flex; flex-direction: column; justify-content: center; z-index: 5; }
    .label-top { font-family: 'Oswald'; color: var(--theme-primary); font-size: 0.75rem; letter-spacing: 2px; font-weight: bold; line-height: 1.1; }
    .display-porcentaje { font-family: 'Oswald'; font-size: 3.5rem; color: var(--theme-text); margin: 5px 0; font-weight: 900; line-height: 1; }
    .status-desc { color: var(--theme-text); font-weight: 800; font-size: 0.8rem; line-height: 1.2; margin-bottom: 10px; text-shadow: 1px 1px 3px rgba(0,0,0,0.8); }
    .btn-detalles { font-size: 0.65rem; color: var(--theme-primary); font-weight: bold; letter-spacing: 1px; }
    .visual-content { flex: 1.8; height: 120%; display: flex; justify-content: flex-end; align-items: center; z-index: 5; transform: translateY(-15%); }
    .bg-blur-glow { position: absolute; top: -20%; right: -10%; width: 180px; height: 180px; background: radial-gradient(circle, var(--theme-primary) 0%, transparent 70%); opacity: 0.15; z-index: 1; }

    .alerta-rpe-aura { border: 2px solid #FF3B30 !important; animation: pulseRpeAura 2s infinite !important; }
    .badge-falta-rpe { position: absolute; top: 15px; right: 15px; background: #FF3B30; color: white; font-family: 'Oswald'; font-size: 0.75rem; padding: 4px 10px; border-radius: 20px; font-weight: bold; z-index: 50; box-shadow: 0 4px 10px rgba(255, 59, 48, 0.4); display: flex; align-items: center; gap: 5px; animation: fadeInOutRpe 1.5s infinite; }

    /* Community Banner */
    .community-entry-card { width: 100%; max-width: 600px; min-height: 110px; flex-shrink: 0; margin: 0 auto; border-radius: 15px; position: relative; overflow: hidden; background-size: cover; background-position: center; cursor: pointer; display: flex; align-items: center; transition: transform 0.2s; border: 2px solid var(--b-color, var(--theme-primary)); box-shadow: 0 10px 20px rgba(0,0,0,0.5); }
    .community-entry-card:active { transform: scale(0.97); }
    .card-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }
    
    .btn-edit-corner { 
        position: absolute; top: 0; right: 0; height: 100%; 
        background: rgba(0,0,0,0.6); color: var(--theme-text); border: none;
        font-family: 'Oswald'; font-size: 0.85rem; padding: 0 10px; 
        border-radius: 0 13px 13px 0; z-index: 50; font-weight: bold; 
        backdrop-filter: blur(4px); display: flex; justify-content: center; align-items: center;
        gap: 8px; writing-mode: vertical-rl; cursor: pointer; transition: all 0.2s;
    }
    .btn-edit-corner:hover { background: rgba(0,0,0,0.9); color: var(--theme-primary); }
    .btn-edit-corner i { transform: rotate(90deg); }
    .btn-edit-corner i { transform: rotate(90deg); }
    
    .entry-content { position: relative; z-index: 10; display: flex; align-items: center; gap: 15px; padding: 0 45px 0 20px; width: 100%; }
    .entry-avatar { width: 70px; height: 70px; border-radius: 50%; object-fit: cover; border: 3px solid var(--b-color, var(--theme-primary)); box-shadow: 0 4px 10px rgba(0,0,0,0.6); background: var(--theme-card); flex-shrink: 0; }
    .entry-text { display: flex; flex-direction: column; }
    .entry-text h4 { font-family: 'Oswald'; font-size: 1.4rem; font-weight: 900; color: var(--theme-text) !important; text-transform: uppercase; margin: 0; text-shadow: 1px 1px 3px black; line-height: 1.1; }
    .entry-text span { font-family: 'Roboto'; font-size: 0.8rem; color: var(--theme-primary); font-weight: bold; margin-top: 4px; text-shadow: 1px 1px 2px black; display: flex; align-items: center; gap: 5px; }

    /* ========================================= */
    /* MODALES GENÉRICOS VIP                     */
    /* ========================================= */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); z-index: 5000; display: flex; justify-content: center; align-items: center; backdrop-filter: blur(8px); padding: 20px; }
    
    .custom-modal { background: var(--theme-bg); width: 100%; max-width: 420px; border-radius: 20px; border: 1px solid var(--theme-border); border-top: 4px solid var(--theme-primary); display: flex; flex-direction: column; color: var(--theme-text); max-height: 85vh; box-shadow: 0 25px 50px rgba(0,0,0,0.9); overflow: hidden; animation: modalBounce 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
    
    .modal-header { padding: 20px 25px; background: var(--theme-card); border-bottom: 1px solid var(--theme-border); display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; }
    
    .modal-body { padding: 25px 20px; overflow-y: auto; flex-grow: 1; -webkit-overflow-scrolling: touch; }
    
    .modal-footer { padding: 15px 20px; background: var(--theme-card); border-top: 1px solid var(--theme-border); display: flex; gap: 10px; flex-shrink: 0; }

    /* LA CRUZ ROJA ELEGANTE */
    .btn-close-custom { background: rgba(220, 53, 69, 0.1); border: 1px solid #dc3545; color: #dc3545; width: 36px; height: 36px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 1.2rem; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 10px rgba(220, 53, 69, 0.2); }
    .btn-close-custom:hover { background: #dc3545; color: white; transform: scale(1.1); }
    .btn-close-custom:active { transform: scale(0.9); }
    
    /* BOTONES DE ACCIÓN DEL MODAL */
    .btn-confirm { background: var(--theme-primary); color: var(--theme-bg); border: none; padding: 12px; font-family: 'Oswald'; font-weight: bold; font-size: 1.1rem; letter-spacing: 1px; flex: 1; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.3); transition: 0.2s; text-align: center; }
    .btn-confirm:active { transform: scale(0.95); }
    
    /* EL BOTÓN CANCELAR UNIVERSAL Y NEUTRAL */
    .btn-cancel { background: #333333 !important; color: #ffffff !important; border: 1px solid #555555 !important; padding: 12px; font-family: 'Oswald', sans-serif; font-weight: bold; font-size: 1.1rem; letter-spacing: 1px; flex: 1; border-radius: 10px; transition: 0.2s; text-align: center; cursor: pointer; }
    .btn-cancel:active { transform: scale(0.95); background: #222222 !important; }

    /* CAMPOS DE TEXTO ENCAPSULADOS */
    .lbl-input { color: var(--theme-text-muted); font-size: 0.75rem; font-weight: bold; margin-bottom: 8px; display: block; text-transform: uppercase; letter-spacing: 1px; }
    
    .input-dark { background: rgba(0, 0, 0, 0.4) !important; border: 1px solid var(--theme-border) !important; color: var(--theme-text) !important; border-radius: 10px !important; padding: 12px 15px; font-size: 0.95rem; transition: all 0.3s ease; box-shadow: inset 0 2px 5px rgba(0,0,0,0.5); width: 100%; box-sizing: border-box; }
    .input-dark:focus { border-color: var(--theme-primary) !important; box-shadow: 0 0 10px rgba(255, 255, 255, 0.05) !important; outline: none; }
    .input-dark::placeholder { color: var(--theme-text-muted) !important; opacity: 0.7; }

    /* CAJA DE TEXTO MÁS GRANDE PARA AVISOS */
    .textarea-avisos { min-height: 150px !important; resize: vertical; }

    /* BOTÓN DEL OJITO (Para contraseñas) */
    .btn-eye { background: rgba(0, 0, 0, 0.4) !important; border: 1px solid var(--theme-border) !important; border-left: none !important; color: var(--theme-text-muted) !important; border-radius: 0 10px 10px 0 !important; cursor: pointer; transition: 0.2s; }
    .btn-eye:hover { color: var(--theme-primary) !important; }

    /* SCROLLBAR PREMIUM (Para todos los modales)*/
    .modal-body::-webkit-scrollbar, .scroll-custom::-webkit-scrollbar { width: 6px; }
    .modal-body::-webkit-scrollbar-track, .scroll-custom::-webkit-scrollbar-track { background: transparent; border-radius: 10px; }
    .modal-body::-webkit-scrollbar-thumb, .scroll-custom::-webkit-scrollbar-thumb { background: var(--theme-border); border-radius: 10px; }
    .modal-body::-webkit-scrollbar-thumb:hover, .scroll-custom::-webkit-scrollbar-thumb:hover { background: var(--theme-primary); }


    /* ========================================= */
    /* DISEÑO DE ELEMENTOS INTERNOS DE MODALES   */
    /* ========================================= */
    /* Editor de Banner */
    .edit-group { background: var(--theme-card); border: 1px solid var(--theme-border); padding: 15px; border-radius: 10px; }
    .edit-group label { color: var(--theme-primary); font-family: 'Oswald'; font-size: 0.85rem; display: block; margin-bottom: 8px; }
    .btn-upload-action { width: 100%; background: var(--theme-border); color: var(--theme-text); text-align: center; padding: 10px; border-radius: 8px; font-family: 'Oswald'; cursor: pointer; transition: 0.2s; display: block; }
    .btn-upload-action.secondary { background: var(--theme-card); border: 1px dashed var(--theme-primary); color: var(--theme-primary); }
    .color-input { width: 100%; height: 40px; border: none; border-radius: 8px; cursor: pointer; padding: 0; background: none; }
    .color-input::-webkit-color-swatch { border: 1px solid var(--theme-border); border-radius: 8px; }
    .btn-save-banner { width: 100%; background: var(--theme-primary); color: var(--theme-bg); font-family: 'Oswald'; font-weight: bold; font-size: 1.1rem; padding: 12px; border: none; border-radius: 8px; box-shadow: 0 4px 15px rgba(248,197,69,0.3); }

    /* WOD y Editor de Pesos */
    .sheet-backdrop { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 4000; opacity: 0; visibility: hidden; transition: opacity 0.3s ease; }
    .sheet-backdrop.visible { opacity: 1; visibility: visible; }
    .bottom-sheet { position: fixed; bottom: 0; left: 0; width: 100%; background: var(--theme-card); border-top-left-radius: 25px; border-top-right-radius: 25px; border-top: 3px solid var(--theme-primary); padding: 25px 20px 40px 20px; z-index: 4001; box-shadow: 0 -15px 40px rgba(0,0,0,0.9); }
    .sheet-handle { width: 40px; height: 4px; background: var(--theme-border); border-radius: 10px; margin: 0 auto 25px auto; }
    
    .ejercicio-row { display: flex; align-items: center; background: rgba(255,255,255,0.02); border-radius: 8px; margin-bottom: 8px; border: 1px solid var(--theme-border); padding: 8px 4px; gap: 6px; }
    .btn-icon { width: 38px; height: 38px; border: none; border-radius: 6px; display: flex; justify-content: center; align-items: center; cursor: pointer; transition: all 0.2s; position: relative; }
    .weight-btn { background: var(--theme-border); color: var(--theme-text-muted); }
    .weight-btn.active { color: var(--theme-primary); border: 1px solid var(--theme-primary); background: rgba(255, 255, 255, 0.05); }
    .dot-indicator { position: absolute; top: 4px; right: 4px; width: 6px; height: 6px; background: var(--theme-primary); border-radius: 50%; }
    .delete-btn { background: transparent; color: var(--theme-text-muted); }
    .delete-btn:hover { background: rgba(220, 53, 69, 0.2); color: #dc3545; }

    /* Lista de Horarios VIP */
    .horarios-list { display: flex; flex-direction: column; gap: 12px; padding-right: 5px; }
    .horario-row { background: rgba(255, 255, 255, 0.03); border: 1px solid var(--theme-border); border-radius: 12px; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; transition: all 0.3s ease; }
    .horario-row:hover { border-color: var(--theme-primary); background: rgba(255, 255, 255, 0.05); transform: translateX(4px); }
    .horario-text { font-family: 'Oswald'; font-size: 1.2rem; color: var(--theme-text); letter-spacing: 1px; }
    .btn-delete-mini { background: rgba(220, 53, 69, 0.1); color: #dc3545; border: 1px solid transparent; width: 38px; height: 38px; border-radius: 10px; display: flex; justify-content: center; align-items: center; cursor: pointer; transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    .btn-delete-mini:hover { background: #dc3545; color: white; border-color: #dc3545; transform: scale(1.1) rotate(5deg); box-shadow: 0 4px 10px rgba(220, 53, 69, 0.3); }
    .btn-delete-mini:active { transform: scale(0.9); }

    /* Modales de Planes / Admin */
    .plan-option-card { background: var(--theme-card); border: 1px solid var(--theme-border); border-radius: 12px; padding: 20px; flex: 1; cursor: pointer; transition: all 0.2s ease; position: relative; display: flex; flex-direction: column; justify-content: center; align-items: center; }
    .plan-option-card:hover { border-color: var(--theme-primary); transform: translateY(-3px); }
    .plan-option-card.recommended { border: 2px solid var(--theme-primary); background: rgba(255, 255, 255, 0.05); }
    .badge-save { position: absolute; top: -10px; background: var(--theme-primary); color: var(--theme-bg); font-size: 0.65rem; font-weight: bold; padding: 4px 10px; border-radius: 10px; text-transform: uppercase; font-family: 'Oswald'; }
    .plan-title { font-family: 'Oswald'; font-size: 1.1rem; color: var(--theme-text); margin-bottom: 5px; }
    .plan-price { font-family: 'Oswald'; font-size: 1.8rem; color: var(--theme-text); font-weight: bold; margin-bottom: 5px; }
    .alert-conflict { background: var(--theme-card); border: 2px solid #dc3545; border-radius: 10px; padding: 30px 20px; text-align: center; }
    .alert-conflict h4 { color: var(--theme-text); font-family: 'Oswald'; letter-spacing: 1px; margin-bottom: 10px; }

    /* Modal de Aviso Pop Up */
    .aviso-content { width: 90%; max-width: 400px; background: var(--theme-card); border-radius: 12px; text-align: center; border: 2px solid var(--theme-primary); padding-bottom: 20px; box-shadow: 0 0 20px rgba(0, 0, 0, 0.3); animation: bounceIn 0.6s; overflow: hidden; margin: auto; }
    .aviso-icon { font-size: 3rem; color: var(--theme-primary); margin-top: 20px; animation: pulse 2s infinite; }
    .aviso-title { font-family: 'Oswald'; color: var(--theme-text); font-size: 1.5rem; margin: 10px 20px; text-transform: uppercase; }
    .aviso-date { font-size: 0.75rem; color: var(--theme-primary); font-weight: bold; margin-bottom: 15px; }
    
    .aviso-body { 
        background: rgba(0,0,0,0.3); 
        color: var(--theme-text); 
        font-family: 'Roboto', sans-serif; 
        font-size: 0.95rem; 
        line-height: 1.5; 
        margin: 0 20px 25px 20px; 
        padding: 15px; 
        border-radius: 8px; 
        border: 1px solid var(--theme-border); 
        text-align: left;
    }
    .btn-ok { width: 80%; margin: 0 auto 25px auto; background: var(--theme-primary); border: none; padding: 12px; font-weight: bold; border-radius: 30px; color: var(--theme-bg); cursor: pointer; transition: 0.2s;}
    .btn-ok:active { transform: scale(0.95); }

    /* ========================================= */
    /* ANIMACIONES CLAVE                         */
    /* ========================================= */
    .fade-in { animation: fadeIn 0.3s ease-in; }
    @@keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes slideInBottom { from { bottom: -100%; } to { bottom: 0; } }
    @@keyframes ring { 0% { transform: rotate(0); } 5% { transform: rotate(30deg); } 10% { transform: rotate(-28deg); } 15% { transform: rotate(34deg); } 20% { transform: rotate(-32deg); } 25% { transform: rotate(30deg); } 30% { transform: rotate(-28deg); } 35% { transform: rotate(26deg); } 40% { transform: rotate(-24deg); } 45% { transform: rotate(22deg); } 50% { transform: rotate(-20deg); } 100% { transform: rotate(0); } }
    @@keyframes bounceIn { 0% { transform: scale(0.3); opacity: 0; } 50% { transform: scale(1.05); } 100% { transform: scale(1); opacity: 1; } }
    @@keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.1); } 100% { transform: scale(1); } }
    @@keyframes fadeIn { from { opacity:0; } to { opacity:1; } }
    @@keyframes pulseRpeAura { 0% { box-shadow: 0 0 0 0 rgba(255, 59, 48, 0.7), 0 15px 35px rgba(0,0,0,0.4); } 70% { box-shadow: 0 0 0 15px rgba(255, 59, 48, 0), 0 15px 35px rgba(0,0,0,0.4); } 100% { box-shadow: 0 0 0 0 rgba(255, 59, 48, 0), 0 15px 35px rgba(0,0,0,0.4); } }
    @@keyframes fadeInOutRpe { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
        /* ========================================= */
    /* ELEMENTOS FALTANTES: MODAL BANNER         */
    /* ========================================= */
    .styles-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(80px, 1fr)); gap: 10px; margin-top: 10px; }
    .style-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; background: rgba(0,0,0,0.4); border: 2px solid var(--theme-border); padding: 15px 10px; border-radius: 12px; cursor: pointer; transition: all 0.2s; }
    .style-item:hover { transform: translateY(-3px); border-color: var(--theme-text-muted); }
    .style-item.selected { border-color: var(--theme-primary); background: rgba(255,255,255,0.05); box-shadow: 0 0 10px rgba(248,197,69,0.2); }
    .style-item span { font-family: 'Oswald'; font-size: 0.75rem; font-weight: bold; letter-spacing: 1px; color: var(--theme-text); }
    
    .style-preview { width: 35px; height: 35px; border-radius: 50%; border: 2px solid transparent; }
    .glass-preview { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.3); }
    .neon-preview { background: black; border-color: #0ff; box-shadow: 0 0 8px #0ff; }
    .cyber-preview { background: #fcee0a; border-radius: 0; border-color: #000; }
    .gold-preview { background: linear-gradient(45deg, #FFD700, #F8C545); border-color: #FFF; }
    .flat-preview { background: #222; border-color: #555; }

    .btn-quitar-bg { width: 100%; background: transparent; border: 1px dashed #dc3545; color: #dc3545; padding: 8px; border-radius: 8px; font-family: 'Oswald'; font-weight: bold; cursor: pointer; transition: 0.2s; }
    .btn-quitar-bg:hover { background: rgba(220,53,69,0.1); }
    
    /* Toggle switch nativo para el modal */
    .switch { position: relative; display: inline-block; width: 44px; height: 24px; margin: 0; }
    .switch input { opacity: 0; width: 0; height: 0; }
