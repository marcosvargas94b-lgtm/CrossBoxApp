@page "/progreso-view"
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS

<div style="@EstilosTema">

    <div class="main-layout">

        <div class="navbar-container">
            <div class="nav-left" @onclick="Volver">
                <i class="fas fa-arrow-left"></i> VOLVER
            </div>
            <div class="nav-title">MI PROGRESO</div>
            <div class="nav-right"></div>
        </div>

        <div class="scrollable-content">

            @* PESTAÑAS DE NAVEGACIÓN (SIEMPRE VISIBLES) *@
            <div class="filter-tabs fade-in mt-2">
                <button class="tab-btn @(pestañaActiva == "HISTORIAL" ? "active" : "")" @onclick='async () => await CambiarPestaña("HISTORIAL")'>
                    <i class="fas fa-history"></i> MI HISTORIAL
                </button>

                <button class="tab-btn @(pestañaActiva == "REGISTRAR" ? "active" : "")" @onclick='async () => await CambiarPestaña("REGISTRAR")'>
                    <i class="fas fa-plus-circle"></i> NUEVA MARCA
                </button>

                @if (Sesion.Usuario?.TipoLugar == "Gimnasio")
                {
                    <button class="tab-btn @(pestañaActiva == "MEDIDAS" ? "active" : "")" @onclick='async () => await CambiarPestaña("MEDIDAS")'>
                        <i class="fas fa-weight"></i> MEDIDAS
                    </button>
                }
            </div>

            @if (cargando)
            {
                <div class="text-center mt-5">
                    <div class="spinner-border" style="color: var(--theme-primary);" role="status"></div>
                    <p class="mt-2" style="color: var(--theme-text-muted); font-family: 'Oswald';">CARGANDO...</p>
                </div>
            }
            else
            {
                @* ======================================================= *@
                @* PESTAÑA 1: HISTORIAL DE PROGRESO (Tus marcas personales)*@
                @* ======================================================= *@
                @if (pestañaActiva == "HISTORIAL")
                {
                    @if (gruposProgreso != null && gruposProgreso.Any())
                    {
                        <div class="instruction-banner fade-in">
                            <i class="fas fa-hand-pointer"></i> Toca una marca para ver los récords anteriores
                        </div>
                    }

                    @if (gruposProgreso == null || !gruposProgreso.Any())
                    {
                        <div class="empty-state fade-in">
                            <i class="fas fa-chart-line"></i>
                            <h3>SIN REGISTROS</h3>
                            <p>Ve a "NUEVA MARCA" para registrar el primer PR.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var grupo in gruposProgreso)
                        {
                            <div class="category-section fade-in">
                                <div class="category-header">
                                    @grupo.Key.ToUpper()
                                </div>

                                <div class="records-list">
                                    @foreach (var item in grupo)
                                    {
                                        <div class="record-item" @onclick="() => VerHistorial(item.TestBoxId, item.NombreTest)">
                                            <span class="record-name">@item.NombreTest</span>

                                            <div class="record-value-wrapper">
                                                <span class="record-num">@item.Valor</span>
                                                <span class="record-unit">@item.Medida</span>
                                            </div>
                                            <i class="fas fa-chevron-right history-icon"></i>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                }

                @* ======================================================= *@
                @* PESTAÑA 2: REGISTRAR NUEVAS MARCAS (Tus marcas personales)*@
                @* ======================================================= *@
                @if (pestañaActiva == "REGISTRAR")
                {
                    @if (listaEvaluaciones == null || !listaEvaluaciones.Any())
                    {
                        <div class="empty-state fade-in">
                            <i class="fas fa-clipboard-list" style="opacity: 0.3; font-size: 3rem; margin-bottom: 15px;"></i>
                            <h3>NO HAY TESTS</h3>
                            <p>Tu box no ha configurado pruebas para evaluar.</p>
                        </div>
                    }
                    else
                    {
                        <div class="eval-grid fade-in">
                            @foreach (var item in listaEvaluaciones)
                            {
                                <div class="eval-card">
                                    <div class="card-header-yellow">
                                        <span class="test-cat">@item.Categoria.ToUpper()</span>
                                        <span class="test-unit">@item.Medida</span>
                                    </div>

                                    <div class="card-body-dark">
                                        <div class="test-name">@item.NombreTest</div>

                                        <div class="result-area">
                                            @if (!string.IsNullOrEmpty(item.Valor))
                                            {
                                                <div class="result-display">
                                                    <div class="value-row">
                                                        <span class="result-value">@item.Valor</span>
                                                        <span class="result-unit">@item.Medida</span>
                                                    </div>
                                                    <span class="result-date">@item.Fecha?.ToShortDateString()</span>
                                                </div>
                                                
                                                <div class="action-buttons">
                                                    <button class="btn-icon edit" @onclick="() => AbrirModalRegistro(item, false)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn-icon new-record" @onclick="() => AbrirModalRegistro(item, true)">
                                                        <i class="fas fa-plus-circle"></i> NUEVA
                                                    </button>
                                                    <button class="btn-icon delete" @onclick="() => EliminarRegistro(item.TestUsuarioId)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <button class="btn-ingresar" @onclick="() => AbrirModalRegistro(item, true)">
                                                    <i class="fas fa-plus"></i> INGRESAR MARCA
                                                </button>
                                            }
                                        </div>
                                    </div> 
                                </div>
                            }
                        </div>
                    }
                }

                @* ======================================================= *@
                @* PESTAÑA 3: MEDIDAS CORPORALES (SOLO GIMNASIOS)          *@
                @* ======================================================= *@
                @if (pestañaActiva == "MEDIDAS")
                {
                    <div class="fade-in" style="width: 100%; max-width: 600px;">

                        @* SI ES COACH Y NO HA SELECCIONADO ATLETA: MOSTRAR BUSCADOR *@
                        @if (EsAdminOCoach && atletaActivo == null)
                        {
                            <div class="instruction-banner">
                                <i class="fas fa-user-check"></i> Selecciona un atleta para ver o registrar su composición corporal.
                            </div>

                            <div class="search-box mb-3">
                                <input type="text" class="form-control input-dark search-input" placeholder="Buscar por nombre..." value="@filtroAtleta" @oninput="FiltrarAtletas" />
                            </div>

                            <div class="records-list" style="max-height: 60vh; overflow-y: auto;">
                                @if (listaAtletasFiltrada == null)
                                {
                                    <div class="text-center p-4"><div class="spinner-border" style="color: var(--theme-primary);"></div></div>
                                }
                                else if (!listaAtletasFiltrada.Any())
                                {
                                    <div class="text-center p-4 text-theme-muted">No hay resultados.</div>
                                }
                                else
                                {
                                    @foreach (var atleta in listaAtletasFiltrada)
                                    {
                                        <div class="record-item" @onclick="() => SeleccionarAtleta(atleta)">
                                            <div style="display:flex; align-items:center; gap:10px;">
                                                <div class="avatar-mini" style="@(!string.IsNullOrEmpty(atleta.FotoUrl) ? $"background-image: url('{atleta.FotoUrl}');" : "")">
                                                    @if (string.IsNullOrEmpty(atleta.FotoUrl))
                                                    {
                                                        @atleta.NombreCompleto.Substring(0, 1).ToUpper()
                                                    }
                                                </div>
                                                <span class="record-name">@atleta.NombreCompleto</span>
                                            </div>
                                            <i class="fas fa-chevron-right history-icon"></i>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            @* YA HAY ATLETA SELECCIONADO O ES USUARIO NORMAL: MOSTRAR DASHBOARD *@
                            @if (EsAdminOCoach)
                            {
                                <div class="active-athlete-bar mb-3">
                                    <div style="display:flex; align-items:center; gap:10px;">
                                        <div class="avatar-mini" style="@(!string.IsNullOrEmpty(atletaActivo?.FotoUrl) ? $"background-image: url('{atletaActivo.FotoUrl}');" : "")">
                                            @if (string.IsNullOrEmpty(atletaActivo?.FotoUrl))
                                            {
                                                @atletaActivo?.NombreCompleto.Substring(0, 1).ToUpper()
                                            }
                                        </div>
                                        <span style="font-weight:bold; color:var(--theme-primary);">@atletaActivo?.NombreCompleto</span>
                                    </div>
                                    <button class="btn-change-athlete" @onclick="CambiarDeAtleta">
                                        <i class="fas fa-exchange-alt"></i> CAMBIAR
                                    </button>
                                </div>
                            }

                            @if (historialMedidas == null || !historialMedidas.Any())
                            {
                                <div class="empty-state">
                                    <i class="fas fa-weight" style="opacity: 0.3; font-size: 3rem; margin-bottom: 15px;"></i>
                                    <h3>SIN COMPOSICIÓN CORPORAL</h3>
                                    <p>No existen medidas registradas actualmente.</p>
                                    @* AQUÍ SE OCULTÓ EL BOTÓN AL ATLETA *@
                                    @if (EsAdminOCoach)
                                    {
                                        <button class="btn-confirm mt-4" @onclick="AbrirModalNuevaMedida" style="width: 200px; margin: 0 auto;">
                                            NUEVO REGISTRO
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                var actual = historialMedidas.First();
                                double imc = CalcularIMC(actual.Peso, actual.Altura);
                                var (imcCategoria, imcColor) = ObtenerCategoriaIMC(imc);

                                @* TARJETA CENTRAL (RESUMEN ACTUAL) *@
                                <div class="body-comp-card" @onclick="() => mostrarModalHistorialMedidas = true">
                                    <div class="card-glow"></div>
                                    <div class="badge-actual">ACTUAL</div>

                                    <div class="comp-date">@actual.Fecha.ToString("dd DE MMMM, yyyy").ToUpper()</div>

                                    <div class="comp-grid">
                                        <div class="comp-item">
                                            <i class="fas fa-weight"></i>
                                            <div class="comp-val">@actual.Peso</div>
                                            <div class="comp-label">PESO (KG)</div>
                                        </div>
                                        <div class="comp-item">
                                            <i class="fas fa-fire-alt text-warning"></i>
                                            <div class="comp-val">@(actual.PorcentajeGrasa?.ToString() ?? "--")</div>
                                            <div class="comp-label">% GRASA</div>
                                        </div>
                                        <div class="comp-item">
                                            <i class="fas fa-heartbeat text-danger"></i>
                                            <div class="comp-val">@(actual.GrasaVisceral?.ToString() ?? "--")</div>
                                            <div class="comp-label">VISCERAL</div>
                                        </div>
                                        <div class="comp-item">
                                            <i class="fas fa-dumbbell" style="color: #28a745;"></i>
                                            <div class="comp-val">@(actual.Musculo?.ToString() ?? "--")</div>
                                            <div class="comp-label">MÚSCULO (KG)</div>
                                        </div>
                                    </div>
                                    <div class="tap-hint">TOCA PARA VER HISTORIAL <i class="fas fa-chevron-right"></i></div>
                                </div>

                                @* SECCIÓN IMC Y MENSAJE IA *@
                                <div class="imc-section fade-in mt-4">
                                    <div class="imc-header">
                                        <span class="imc-title">ÍNDICE DE MASA CORPORAL</span>
                                        <span class="imc-value" style="color: @imcColor">@imc.ToString("0.0")</span>
                                    </div>

                                    <div class="imc-bar">
                                        <div class="imc-segment" style="background-color: #3498db;" title="Bajo Peso"></div>
                                        <div class="imc-segment" style="background-color: #2ecc71;" title="Saludable"></div>
                                        <div class="imc-segment" style="background-color: #f1c40f;" title="Sobrepeso"></div>
                                        <div class="imc-segment" style="background-color: #e74c3c;" title="Obesidad"></div>
                                        <div class="imc-marker" style="left: @(CalcularPosicionIMC(imc))%;">▼</div>
                                    </div>

                                    <div class="imc-category-label text-center mb-3" style="color: @imcColor; font-weight: bold; font-family: 'Oswald'; font-size: 0.9rem;">
                                        @imcCategoria
                                    </div>

                                    @if (!string.IsNullOrEmpty(actual.MensajeIA))
                                    {
                                        <div class="ia-message-box">
                                            <i class="fas fa-robot ia-icon"></i>
                                            <p>@actual.MensajeIA</p>
                                        </div>
                                    }
                                </div>

                                @* AQUÍ SE OCULTÓ EL BOTÓN AL ATLETA *@
                                @if (EsAdminOCoach)
                                {
                                    <button class="btn-ingresar mb-4 mt-3" @onclick="AbrirModalNuevaMedida">
                                        <i class="fas fa-plus"></i> REGISTRAR NUEVA MARCA
                                    </button>
                                }

                                @* GRÁFICA DE BARRAS CSS *@
                                <div class="chart-wrapper mb-4">
                                    <h4 class="chart-title">EVOLUCIÓN DEL PESO (KG)</h4>
                                    <div class="chart-scroll-x scroll-custom">
                                        <div class="chart-flex">
                                            @foreach (var m in historialMedidas.OrderBy(x => x.Fecha))
                                            {
                                                <div class="bar-col">
                                                    <div class="bar-value">@m.Peso</div>
                                                    <div class="bar-track">
                                                        <div class="bar-fill" style="height: @(CalcularAlturaBarra(m.Peso))%;"></div>
                                                    </div>
                                                    <div class="bar-date">@m.Fecha.ToString("dd MMM")</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                @* PREGUNTAS FRECUENTES (FAQ NATIVO) *@
                                <div class="faq-container mb-4">
                                    <h4 class="faq-main-title"><i class="fas fa-info-circle"></i> ACERCA DEL IMC Y TU COMPOSICIÓN</h4>
                                    <details class="faq-details">
                                        <summary class="faq-summary">¿Es el IMC un indicador fiable de grasa corporal?</summary>
                                        <div class="faq-content">Es una guía útil y rápida para poblaciones generales, pero <strong>no distingue entre grasa y músculo</strong>. Los atletas que entrenan fuerza pueden tener un IMC "alto" debido al peso de su masa muscular, estando en realidad perfectamente saludables.</div>
                                    </details>
                                    <details class="faq-details">
                                        <summary class="faq-summary">¿Por qué es importante mantener un IMC dentro del rango recomendado?</summary>
                                        <div class="faq-content">Estadísticamente, un rango equilibrado se asocia con mayor energía diaria, mejor salud cardiovascular, menor estrés en las rodillas y articulaciones, y un sistema inmunológico más fuerte.</div>
                                    </details>
                                    <details class="faq-details">
                                        <summary class="faq-summary">¿Puede un IMC alto/bajo ser saludable en algunos casos?</summary>
                                        <div class="faq-content">¡Totalmente! Como mencionamos, el músculo pesa más que la grasa ocupando menos volumen. Lo más importante no es este número, sino tu <strong>composición corporal real</strong> (% de grasa vs músculo), tu resistencia y cómo te sientes en el día a día.</div>
                                    </details>
                                </div>
                            }
                        }
                    </div>
                }
            }
            
            <div style="height: 40px;"></div>
        </div>
    </div>

    @* ========================================== *@
    @* MODAL 1: VER HISTORIAL DE UN EJERCICIO     *@
    @* ========================================== *@
    @if (mostrarModalHistorial)
    {
        <div class="modal-overlay fade-in" @onclick="CerrarModalHistorial">
            <div class="modal-content custom-modal slide-up" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h5 style="color:var(--theme-primary); margin:0; font-family:'Oswald'">
                        <i class="fas fa-history" style="margin-right:8px;"></i> HISTORIAL
                    </h5>
                    <button class="btn-close-custom" @onclick="CerrarModalHistorial"><i class="fas fa-times"></i></button>
                </div>

                <div class="modal-body history-list">
                    <h4 class="test-title-modal text-center">@nombreEjercicioSeleccionado</h4>

                    @if (historialCargado == null)
                    {
                        <div class="text-center p-4">
                            <div class="spinner-border" style="color: var(--theme-primary);"></div>
                        </div>
                    }
                    else if (historialCargado.Count == 0)
                    {
                        <div class="text-center p-4" style="color: var(--theme-text-muted);">No hay historial previo.</div>
                    }
                    else
                    {
                        @foreach (var h in historialCargado)
                        {
                            <div class="history-item @(h.EsRecordActual ? "current-pr" : "")">
                                <div class="h-info">
                                    <div class="h-date">
                                        <i class="far fa-calendar-alt"></i> @h.Fecha.ToString("dd/MM/yyyy")
                                    </div>
                                    @if (h.EsRecordActual)
                                    {
                                        <span class="badge-pr"><i class="fas fa-trophy"></i> PR ACTUAL</span>
                                    }
                                </div>
                                <div class="h-value">
                                    @h.Valor <span class="unit-small">@h.Unidad</span>
                                </div>
                            </div>
                        }
                    }
                </div>
                
                <div class="modal-footer">
                    <button class="btn-cancel" @onclick="CerrarModalHistorial">CERRAR</button>
                </div>
            </div>
        </div>
    }

    @* ========================================== *@
    @* MODAL 2: REGISTRAR / EDITAR MARCA TEST     *@
    @* ========================================== *@
    @if (mostrarModalRegistro)
    {
        <div class="modal-overlay fade-in">
            <div class="modal-content custom-modal slide-up">
                <div class="modal-header">
                    <h5 style="color:var(--theme-primary); margin:0; font-family:'Oswald'">
                        <i class="fas @(esModoNuevaMarca ? "fa-plus-circle" : "fa-edit")" style="margin-right:8px;"></i> 
                        @(esModoNuevaMarca ? "NUEVA MARCA" : "EDITAR REGISTRO")
                    </h5>
                    <button class="btn-close-custom" @onclick="() => mostrarModalRegistro = false"><i class="fas fa-times"></i></button>
                </div>
                
                <div class="modal-body text-center">
                    <h4 class="test-title-modal">@testSeleccionadoParaRegistro.NombreTest</h4>
                    <label class="lbl-input text-center mb-3">Ingresa tu resultado en:</label>
                    
                    <div class="input-with-unit">
                        <input type="text" @bind="valorInputRegistro" class="form-control input-dark big-input" placeholder="Ej: 100 o 12:30" />
                        <span class="unit-label">@testSeleccionadoParaRegistro.Medida</span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-cancel" @onclick="() => mostrarModalRegistro = false">Cancelar</button>
                    <button class="btn-confirm" @onclick="GuardarMarca">GUARDAR</button>
                </div>
            </div>
        </div>
    }

    @* ========================================== *@
    @* MODAL 3: REGISTRAR MEDIDAS CORPORALES      *@
    @* ========================================== *@
    @if (mostrarModalRegistroMedida)
    {
        <div class="modal-overlay fade-in">
            <div class="modal-content custom-modal slide-up">
                <div class="modal-header">
                    <h5 style="color:var(--theme-primary); margin:0; font-family:'Oswald'">
                        <i class="fas fa-weight" style="margin-right:8px;"></i> REGISTRO CORPORAL
                    </h5>
                    <button class="btn-close-custom" @onclick="() => mostrarModalRegistroMedida = false"><i class="fas fa-times"></i></button>
                </div>
                
                <div class="modal-body scroll-custom">
                    <p class="text-theme-muted text-center" style="font-size: 0.8rem; margin-bottom: 20px;">Llena los datos que entregue tu báscula. Tu coach e IA analizarán el progreso.</p>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="lbl-input">PESO (Obligatorio)</label>
                            <div class="input-group">
                                <input type="number" step="0.1" @bind="nuevaMedidaInput.Peso" class="form-control input-dark" placeholder="0.00" />
                                <span class="input-group-text" style="background:var(--theme-bg); border-color:var(--theme-border); color:var(--theme-primary); font-family:'Oswald';">KG</span>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="lbl-input">ALTURA</label>
                            <div class="input-group">
                                <input type="number" step="0.01" @bind="nuevaMedidaInput.Altura" class="form-control input-dark" placeholder="Ej: 1.75" />
                                <span class="input-group-text" style="background:var(--theme-bg); border-color:var(--theme-border); color:var(--theme-primary); font-family:'Oswald';">M</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="lbl-input">SEXO BIOLÓGICO</label>
                        <select @bind="nuevaMedidaInput.Sexo" class="form-control input-dark">
                            <option value="M">Masculino</option>
                            <option value="F">Femenino</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="lbl-input">% GRASA CORPORAL</label>
                        <div class="input-group">
                            <input type="number" step="0.1" @bind="nuevaMedidaInput.PorcentajeGrasa" class="form-control input-dark" placeholder="Opcional" />
                            <span class="input-group-text" style="background:var(--theme-bg); border-color:var(--theme-border); color:var(--theme-primary); font-family:'Oswald';">%</span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="lbl-input">GRASA VISCERAL</label>
                            <input type="number" step="0.1" @bind="nuevaMedidaInput.GrasaVisceral" class="form-control input-dark" placeholder="Índice" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="lbl-input">MÚSCULO</label>
                            <div class="input-group">
                                <input type="number" step="0.1" @bind="nuevaMedidaInput.Musculo" class="form-control input-dark" placeholder="Opcional" />
                                <span class="input-group-text" style="background:var(--theme-bg); border-color:var(--theme-border); color:var(--theme-primary); font-family:'Oswald';">KG</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-cancel" @onclick="() => mostrarModalRegistroMedida = false">Cancelar</button>
                    <button class="btn-confirm" @onclick="GuardarMedidaCorporal" disabled="@guardandoMedida">
                        @if(guardandoMedida) { <i class="fas fa-spinner fa-spin"></i> } else { <span>GUARDAR Y ANALIZAR</span> }
                    </button>
                </div>
            </div>
        </div>
    }

    @* --- MODAL 4: HISTORIAL FLOTANTE DE MEDIDAS --- *@
    @if (mostrarModalHistorialMedidas)
    {
        <div class="modal-overlay fade-in" @onclick="() => mostrarModalHistorialMedidas = false">
            <div class="modal-content custom-modal slide-up" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h5 style="color:var(--theme-primary); margin:0; font-family:'Oswald'">
                        <i class="fas fa-history" style="margin-right:8px;"></i> HISTORIAL CORPORAL
                    </h5>
                    <button class="btn-close-custom" @onclick="() => mostrarModalHistorialMedidas = false"><i class="fas fa-times"></i></button>
                </div>

                <div class="modal-body scroll-custom" style="padding: 0;">
                    @foreach (var item in historialMedidas)
                    {
                        <div class="history-item" style="flex-direction: column; align-items: stretch; gap: 10px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed var(--theme-border); padding-bottom: 5px;">
                                <span style="font-weight: bold; color: var(--theme-primary);"><i class="far fa-calendar-alt"></i> @item.Fecha.ToString("dd MMM yyyy")</span>

                                @* AQUÍ SE OCULTÓ EL BOTE DE BASURA AL ATLETA *@
                                @if (EsAdminOCoach)
                                {
                                    <button class="btn-delete-mini" @onclick="() => EliminarMedida(item.MedidaID)" title="Borrar registro"><i class="fas fa-trash"></i></button>
                                }
                            </div>

                            <div style="display: flex; justify-content: space-between; text-align: center; font-family: 'Oswald';">
                                <div><div style="font-size:1.2rem; color:var(--theme-text);">@item.Peso</div><div style="font-size:0.7rem; color:var(--theme-text-muted);">PESO</div></div>
                                <div><div style="font-size:1.2rem; color:var(--theme-text);">@(item.PorcentajeGrasa?.ToString() ?? "--")</div><div style="font-size:0.7rem; color:var(--theme-text-muted);">% GRASA</div></div>
                                <div><div style="font-size:1.2rem; color:var(--theme-text);">@(item.GrasaVisceral?.ToString() ?? "--")</div><div style="font-size:0.7rem; color:var(--theme-text-muted);">VISCERAL</div></div>
                                <div><div style="font-size:1.2rem; color:var(--theme-text);">@(item.Musculo?.ToString() ?? "--")</div><div style="font-size:0.7rem; color:var(--theme-text-muted);">MÚSCULO</div></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

</div>

