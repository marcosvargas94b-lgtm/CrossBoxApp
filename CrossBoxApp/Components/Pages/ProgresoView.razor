@page "/progreso-view"
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS

@* ENVOLVEMOS LA VISTA EN EL TEMA GLOBAL *@
<div style="@EstilosTema">

    <div class="main-layout">

        <div class="navbar-container">
            <div class="nav-left" @onclick="Volver">
                <i class="fas fa-arrow-left"></i> VOLVER
            </div>
            <div class="nav-title">MI PROGRESO</div>
            <div class="nav-right"></div>
        </div>

        <div class="scrollable-content">

            @* PESTAÑAS DE NAVEGACIÓN *@
            <div class="filter-tabs fade-in">
                <button class="tab-btn @(pestañaActiva == "HISTORIAL" ? "active" : "")" 
                        @onclick='() => CambiarPestaña("HISTORIAL")'>
                    <i class="fas fa-history"></i> MI HISTORIAL
                </button>
                
                <button class="tab-btn @(pestañaActiva == "REGISTRAR" ? "active" : "")" 
                        @onclick='() => CambiarPestaña("REGISTRAR")'>
                    <i class="fas fa-plus-circle"></i> NUEVA MARCA
                </button>
            </div>

            @if (cargando)
            {
                <div class="text-center mt-5">
                    <div class="spinner-border" style="color: var(--theme-primary);" role="status"></div>
                    <p class="mt-2" style="color: var(--theme-text-muted); font-family: 'Oswald';">CARGANDO...</p>
                </div>
            }
            else
            {
                @* ======================================================= *@
                @* PESTAÑA 1: HISTORIAL DE PROGRESO (La vista original)    *@
                @* ======================================================= *@
                @if (pestañaActiva == "HISTORIAL")
                {
                    @if (gruposProgreso != null && gruposProgreso.Any())
                    {
                        <div class="instruction-banner fade-in">
                            <i class="fas fa-hand-pointer"></i> Toca una marca para ver tus récords anteriores
                        </div>
                    }

                    @if (gruposProgreso == null || !gruposProgreso.Any())
                    {
                        <div class="empty-state fade-in">
                            <i class="fas fa-chart-line"></i>
                            <h3>SIN REGISTROS</h3>
                            <p>Ve a "NUEVA MARCA" para registrar tu primer PR.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var grupo in gruposProgreso)
                        {
                            <div class="category-section fade-in">
                                <div class="category-header">
                                    @grupo.Key.ToUpper()
                                </div>

                                <div class="records-list">
                                    @foreach (var item in grupo)
                                    {
                                        <div class="record-item" @onclick="() => VerHistorial(item.TestBoxId, item.NombreTest)">
                                            <span class="record-name">@item.NombreTest</span>

                                            <div class="record-value-wrapper">
                                                <span class="record-num">@item.Valor</span>
                                                <span class="record-unit">@item.Medida</span>
                                            </div>
                                            <i class="fas fa-chevron-right history-icon"></i>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                }

                @* ======================================================= *@
                @* PESTAÑA 2: REGISTRAR NUEVAS MARCAS (Las Tarjetas)       *@
                @* ======================================================= *@
                @if (pestañaActiva == "REGISTRAR")
                {
                    @if (listaEvaluaciones == null || !listaEvaluaciones.Any())
                    {
                        <div class="empty-state fade-in">
                            <i class="fas fa-clipboard-list" style="opacity: 0.3; font-size: 3rem; margin-bottom: 15px;"></i>
                            <h3>NO HAY TESTS</h3>
                            <p>Tu box no ha configurado pruebas para evaluar.</p>
                        </div>
                    }
                    else
                    {
                        <div class="eval-grid fade-in">
                            @foreach (var item in listaEvaluaciones)
                            {
                                <div class="eval-card">
                                    <div class="card-header-yellow">
                                        <span class="test-cat">@item.Categoria.ToUpper()</span>
                                        <span class="test-unit">@item.Medida</span>
                                    </div>

                                    <div class="card-body-dark">
                                        <div class="test-name">@item.NombreTest</div>

                                        <div class="result-area">
                                            @if (!string.IsNullOrEmpty(item.Valor))
                                            {
                                                <div class="result-display">
                                                    <div class="value-row">
                                                        <span class="result-value">@item.Valor</span>
                                                        <span class="result-unit">@item.Medida</span>
                                                    </div>
                                                    <span class="result-date">@item.Fecha?.ToShortDateString()</span>
                                                </div>
                                                
                                                <div class="action-buttons">
                                                    <button class="btn-icon edit" @onclick="() => AbrirModalRegistro(item, false)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn-icon new-record" @onclick="() => AbrirModalRegistro(item, true)">
                                                        <i class="fas fa-plus-circle"></i> NUEVA
                                                    </button>
                                                    <button class="btn-icon delete" @onclick="() => EliminarRegistro(item.TestUsuarioId)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <button class="btn-ingresar" @onclick="() => AbrirModalRegistro(item, true)">
                                                    <i class="fas fa-plus"></i> INGRESAR MARCA
                                                </button>
                                            }
                                        </div>
                                    </div> @* <-- AQUÍ ESTABA EL ERROR, ¡AHORA SÍ ES UN DIV! *@
                                </div>
                            }
                        </div>
                    }
                }
            }
            
            <div style="height: 40px;"></div>
        </div>
    </div>

    @* ========================================== *@
    @* MODAL 1: VER HISTORIAL DE UN EJERCICIO     *@
    @* ========================================== *@
    @if (mostrarModalHistorial)
    {
        <div class="modal-overlay fade-in" @onclick="CerrarModalHistorial">
            <div class="modal-content custom-modal slide-up" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h5 style="color:var(--theme-primary); margin:0; font-family:'Oswald'">
                        <i class="fas fa-history" style="margin-right:8px;"></i> HISTORIAL
                    </h5>
                    <button class="btn-close-custom" @onclick="CerrarModalHistorial"><i class="fas fa-times"></i></button>
                </div>

                <div class="modal-body history-list">
                    <h4 class="test-title-modal text-center">@nombreEjercicioSeleccionado</h4>

                    @if (historialCargado == null)
                    {
                        <div class="text-center p-4">
                            <div class="spinner-border" style="color: var(--theme-primary);"></div>
                        </div>
                    }
                    else if (historialCargado.Count == 0)
                    {
                        <div class="text-center p-4" style="color: var(--theme-text-muted);">No hay historial previo.</div>
                    }
                    else
                    {
                        @foreach (var h in historialCargado)
                        {
                            <div class="history-item @(h.EsRecordActual ? "current-pr" : "")">
                                <div class="h-info">
                                    <div class="h-date">
                                        <i class="far fa-calendar-alt"></i> @h.Fecha.ToString("dd/MM/yyyy")
                                    </div>
                                    @if (h.EsRecordActual)
                                    {
                                        <span class="badge-pr"><i class="fas fa-trophy"></i> PR ACTUAL</span>
                                    }
                                </div>
                                <div class="h-value">
                                    @h.Valor <span class="unit-small">@h.Unidad</span>
                                </div>
                            </div>
                        }
                    }
                </div>
                
                <div class="modal-footer">
                    <button class="btn-cancel" @onclick="CerrarModalHistorial">CERRAR</button>
                </div>
            </div>
        </div>
    }

    @* ========================================== *@
    @* MODAL 2: REGISTRAR / EDITAR MARCA          *@
    @* ========================================== *@
    @if (mostrarModalRegistro)
    {
        <div class="modal-overlay fade-in">
            <div class="modal-content custom-modal slide-up">
                <div class="modal-header">
                    <h5 style="color:var(--theme-primary); margin:0; font-family:'Oswald'">
                        <i class="fas @(esModoNuevaMarca ? "fa-plus-circle" : "fa-edit")" style="margin-right:8px;"></i> 
                        @(esModoNuevaMarca ? "NUEVA MARCA" : "EDITAR REGISTRO")
                    </h5>
                    <button class="btn-close-custom" @onclick="() => mostrarModalRegistro = false"><i class="fas fa-times"></i></button>
                </div>
                
                <div class="modal-body text-center">
                    <h4 class="test-title-modal">@testSeleccionadoParaRegistro.NombreTest</h4>
                    <label class="lbl-input text-center mb-3">Ingresa tu resultado en:</label>
                    
                    <div class="input-with-unit">
                        <input type="text" @bind="valorInputRegistro" class="form-control input-dark big-input" placeholder="Ej: 100 o 12:30" />
                        <span class="unit-label">@testSeleccionadoParaRegistro.Medida</span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-cancel" @onclick="() => mostrarModalRegistro = false">Cancelar</button>
                    <button class="btn-confirm" @onclick="GuardarMarca">GUARDAR</button>
                </div>
            </div>
        </div>
    }

</div>

<style>
    /* --- ESTRUCTURA BASE --- */
    .main-layout { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--theme-bg); display: flex; flex-direction: column; z-index: 1; }

    .navbar-container { flex-shrink: 0; padding-top: calc(env(safe-area-inset-top) + 10px); padding-bottom: 10px; padding-left: 20px; padding-right: 20px; background-color: var(--theme-bg); border-bottom: 1px solid var(--theme-primary); color: var(--theme-text); display: flex; justify-content: space-between; align-items: center; z-index: 100; font-family: 'Oswald'; min-height: 60px; box-shadow: 0 4px 10px rgba(0,0,0,0.5); }
    .nav-left { color: var(--theme-primary); font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.95rem; }
    .nav-title { font-weight: bold; font-size: 1.2rem; color: var(--theme-text); letter-spacing: 1px; }
    .nav-right { width: 60px; }
    
    .scrollable-content { flex-grow: 1; overflow-y: auto; background-color: var(--theme-bg); padding: 20px 15px; -webkit-overflow-scrolling: touch; display: flex; flex-direction: column; align-items: center; }

    /* --- TABS (PESTAÑAS) --- */
    .filter-tabs { display: flex; gap: 10px; margin-bottom: 25px; background: var(--theme-card); padding: 5px; border-radius: 12px; border: 1px solid var(--theme-border); width: 100%; max-width: 600px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
    .tab-btn { flex: 1; background: transparent; border: none; color: var(--theme-text-muted); padding: 10px 5px; font-family: 'Oswald'; font-size: 0.95rem; border-radius: 8px; transition: all 0.3s; cursor: pointer; display: flex; justify-content: center; align-items: center; gap: 8px; letter-spacing: 1px; }
    .tab-btn.active { background: var(--theme-primary); color: var(--theme-bg); font-weight: bold; box-shadow: 0 2px 8px rgba(0,0,0,0.4); }

    /* --- ESTILOS DE LA PESTAÑA: HISTORIAL --- */
    .instruction-banner { width: 100%; max-width: 600px; text-align: center; color: var(--theme-text-muted); font-size: 0.85rem; margin-bottom: 20px; font-family: 'Roboto', sans-serif; background: rgba(255, 255, 255, 0.05); padding: 8px; border-radius: 20px; border: 1px dashed var(--theme-border); }
    .instruction-banner i { color: var(--theme-primary); margin-right: 5px; animation: bounce 2s infinite; }

    .category-section { margin-bottom: 30px; width: 100%; max-width: 600px; align-self: center; }
    .category-header { color: var(--theme-primary); font-family: 'Oswald'; font-size: 1.2rem; border-bottom: 1px solid var(--theme-primary); padding-bottom: 5px; margin-bottom: 10px; letter-spacing: 1px; }
    .records-list { background-color: var(--theme-card); border-radius: 12px; border: 1px solid var(--theme-border); overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
    
    .record-item { display: flex; justify-content: space-between; align-items: center; padding: 15px; border-bottom: 1px solid var(--theme-border); cursor: pointer; position: relative; background-color: var(--theme-card); transition: background 0.2s; }
    .record-item:last-child { border-bottom: none; }
    .record-item:active { background-color: var(--theme-bg); }

    .record-name { font-family: 'Roboto'; font-size: 1rem; color: var(--theme-text); flex: 1; font-weight: bold; }
    .record-value-wrapper { display: flex; align-items: baseline; gap: 5px; margin-right: 25px; }
    .record-num { font-family: 'Oswald'; font-size: 1.4rem; color: var(--theme-text); font-weight: bold; }
    .record-unit { font-family: 'Oswald'; font-size: 0.8rem; color: var(--theme-primary); font-weight: bold; text-transform: uppercase; }
    .history-icon { color: var(--theme-text-muted); font-size: 0.8rem; position: absolute; right: 15px; }

    /* --- ESTILOS DE LA PESTAÑA: REGISTRAR (Tarjetas) --- */
    .eval-grid { width: 100%; max-width: 600px; display: flex; flex-direction: column; gap: 15px; }
    .eval-card { border: 1px solid var(--theme-border); border-radius: 12px; overflow: hidden; background: var(--theme-card); box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
    .card-header-yellow { background-color: var(--theme-primary); padding: 8px 15px; display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; color: var(--theme-bg); font-family: 'Oswald'; }
    .card-body-dark { padding: 15px; }

    .test-name { color: var(--theme-text); font-family: 'Oswald'; font-size: 1.2rem; margin-bottom: 10px; text-transform: uppercase; }
    .result-area { display: flex; justify-content: space-between; align-items: center; min-height: 40px; }
    .result-display { display: flex; flex-direction: column; }
    .value-row { display: flex; align-items: baseline; gap: 5px; }
    
    .result-value { color: var(--theme-primary); font-size: 1.8rem; font-weight: bold; line-height: 1; font-family: 'Oswald'; }
    .result-unit { color: var(--theme-primary); font-size: 1rem; font-weight: bold; text-transform: uppercase; font-family: 'Oswald'; }
    .result-date { color: var(--theme-text-muted); font-size: 0.75rem; margin-top: 4px; font-family: 'Roboto'; }

    .action-buttons { display: flex; gap: 8px; }
    .btn-icon { background: transparent; border: 1px solid var(--theme-border); color: var(--theme-text-muted); border-radius: 8px; padding: 8px 12px; font-size: 1rem; cursor: pointer; transition: 0.2s; }
    .btn-icon:active { transform: scale(0.95); }
    .btn-icon.edit:hover { color: var(--theme-primary); border-color: var(--theme-primary); background: rgba(255,255,255,0.05); }
    .btn-icon.delete:hover { color: #d9534f; border-color: #d9534f; background: rgba(217,83,79,0.1); }
    
    .btn-icon.new-record { color: #28a745; border-color: #28a745; font-weight: bold; font-family: 'Oswald'; font-size: 0.8rem; display: flex; align-items: center; gap: 5px; }
    .btn-icon.new-record:hover { background-color: rgba(40, 167, 69, 0.1); }

    .btn-ingresar { width: 100%; background: transparent; border: 1px dashed var(--theme-primary); color: var(--theme-primary); padding: 10px; border-radius: 8px; font-weight: bold; font-family: 'Oswald'; transition: 0.2s; }
    .btn-ingresar:active { background: rgba(255,255,255,0.05); }

    .empty-state { text-align: center; margin-top: 60px; color: var(--theme-text-muted); font-family: 'Roboto'; }
    .empty-state i { font-size: 3rem; margin-bottom: 15px; color: var(--theme-border); }

    /* ========================================= */
    /* MODALES GENÉRICOS VIP                     */
    /* ========================================= */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); z-index: 5000; display: flex; justify-content: center; align-items: center; backdrop-filter: blur(8px); padding: 20px; }
    
    .custom-modal { background: var(--theme-bg); width: 100%; max-width: 420px; border-radius: 20px; border: 1px solid var(--theme-border); border-top: 4px solid var(--theme-primary); display: flex; flex-direction: column; color: var(--theme-text); max-height: 85vh; box-shadow: 0 25px 50px rgba(0,0,0,0.9); overflow: hidden; animation: modalBounce 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
    
    .modal-header { padding: 20px 25px; background: var(--theme-card); border-bottom: 1px solid var(--theme-border); display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; }
    .modal-body { padding: 25px 20px; overflow-y: auto; flex-grow: 1; -webkit-overflow-scrolling: touch; }
    .modal-footer { padding: 15px 20px; background: var(--theme-card); border-top: 1px solid var(--theme-border); display: flex; gap: 10px; flex-shrink: 0; }
    
    /* LA CRUZ ROJA ELEGANTE */
    .btn-close-custom { background: rgba(220, 53, 69, 0.1); border: 1px solid #dc3545; color: #dc3545; width: 36px; height: 36px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 1.2rem; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 10px rgba(220, 53, 69, 0.2); }
    .btn-close-custom:hover { background: #dc3545; color: white; transform: scale(1.1); }
    .btn-close-custom:active { transform: scale(0.9); }
    
    /* BOTONES DE ACCIÓN DEL MODAL */
    .btn-confirm { background: var(--theme-primary); color: var(--theme-bg); border: none; padding: 12px; font-family: 'Oswald'; font-weight: bold; font-size: 1.1rem; letter-spacing: 1px; flex: 1; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.3); transition: 0.2s; text-align: center; }
    .btn-confirm:active { transform: scale(0.95); }
    
    .btn-cancel { background: #333333 !important; color: #ffffff !important; border: 1px solid #555555 !important; padding: 12px; font-family: 'Oswald', sans-serif; font-weight: bold; font-size: 1.1rem; letter-spacing: 1px; flex: 1; border-radius: 10px; transition: 0.2s; text-align: center; cursor: pointer; }
    .btn-cancel:active { transform: scale(0.95); background: #222222 !important; }

    /* CAMPOS DE TEXTO ENCAPSULADOS */
    .lbl-input { color: var(--theme-text-muted); font-size: 0.8rem; font-weight: bold; margin-bottom: 8px; display: block; text-transform: uppercase; letter-spacing: 1px; }
    .input-dark { background: rgba(0, 0, 0, 0.4) !important; border: 1px solid var(--theme-border) !important; color: var(--theme-text) !important; border-radius: 10px !important; padding: 12px 15px; font-size: 0.95rem; transition: all 0.3s ease; box-shadow: inset 0 2px 5px rgba(0,0,0,0.5); width: 100%; box-sizing: border-box; }
    .input-dark:focus { border-color: var(--theme-primary) !important; box-shadow: 0 0 10px rgba(255, 255, 255, 0.05) !important; outline: none; }
    .input-dark::placeholder { color: var(--theme-text-muted) !important; opacity: 0.7; }

    /* --- ESPECÍFICOS DE MODALES DE ESTA VISTA --- */
    .test-title-modal { 
    color: var(--theme-text); 
    font-family: 'Oswald'; 
    margin-top: 25px;  
    margin-bottom: 20px; 
    font-size: 1.5rem; 
    text-transform: uppercase; 
    text-shadow: 1px 1px 3px rgba(0,0,0,0.5); 
}
    
    .input-with-unit { display: flex; align-items: center; justify-content: center; gap: 15px; }
    .big-input { text-align: center; font-size: 2.2rem !important; font-weight: bold; width: 150px !important; padding: 10px !important; font-family: 'Oswald'; }
    .big-input::placeholder { font-size: 1.2rem !important; font-weight: normal; vertical-align: middle; }
    .unit-label { color: var(--theme-primary); font-size: 1.6rem; font-family: 'Oswald'; font-weight: bold; text-transform: uppercase; }

    /* Historial List */
    .history-list { padding: 0 !important; }
    .history-item { display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; border-bottom: 1px solid var(--theme-border); color: var(--theme-text-muted); background: var(--theme-bg); }
    .history-item.current-pr { background: rgba(255, 255, 255, 0.05); border-left: 4px solid var(--theme-primary); color: var(--theme-text); }
    .h-info { display: flex; flex-direction: column; gap: 4px; }
    .h-date { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--theme-text-muted); font-family: 'Roboto'; }
    .current-pr .h-date { color: var(--theme-primary); font-weight: bold; }
    .h-value { font-family: 'Oswald'; font-size: 1.5rem; font-weight: bold; color: var(--theme-text); }
    .unit-small { font-size: 0.8rem; color: var(--theme-text-muted); font-weight: normal; margin-left: 2px; }
    .badge-pr { background: var(--theme-primary); color: var(--theme-bg); font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; font-weight: bold; width: fit-content; display: flex; align-items: center; gap: 4px; font-family: 'Oswald'; }

    /* SCROLLBAR PREMIUM */
    .modal-body::-webkit-scrollbar, .scroll-custom::-webkit-scrollbar { width: 6px; }
    .modal-body::-webkit-scrollbar-track, .scroll-custom::-webkit-scrollbar-track { background: transparent; border-radius: 10px; }
    .modal-body::-webkit-scrollbar-thumb, .scroll-custom::-webkit-scrollbar-thumb { background: var(--theme-border); border-radius: 10px; }
    .modal-body::-webkit-scrollbar-thumb:hover, .scroll-custom::-webkit-scrollbar-thumb:hover { background: var(--theme-primary); }

    /* ANIMACIONES */
    .fade-in { animation: fadeIn 0.4s ease; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes modalBounce { from { transform: scale(0.8) translateY(30px); opacity: 0; } to { transform: scale(1) translateY(0); opacity: 1; } }
    @@keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
</style>

@code {
    // --- ESTADO INICIAL NEUTRAL (PLATA MATE) ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    private bool cargando = true;
    private string pestañaActiva = "HISTORIAL"; // HISTORIAL o REGISTRAR

    // Variables Pestaña Historial
    private IEnumerable<IGrouping<string, EvaluacionVisualDto>> gruposProgreso = new List<IGrouping<string, EvaluacionVisualDto>>();
    private bool mostrarModalHistorial = false;
    private string nombreEjercicioSeleccionado = "";
    private List<HistorialDto> historialCargado;

    // Variables Pestaña Registrar
    private List<EvaluacionVisualDto> listaEvaluaciones = new List<EvaluacionVisualDto>();
    private bool mostrarModalRegistro = false;
    private bool esModoNuevaMarca = false;
    private EvaluacionVisualDto testSeleccionadoParaRegistro;
    private string valorInputRegistro;

    protected override async Task OnInitializedAsync()
    {
        // LEER EL CACHÉ LOCAL AL INSTANTE
        try 
        {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) 
            { 
                EstilosTema = cache; 
                StateHasChanged(); 
            }
        } 
        catch { }

        if (Sesion.Usuario == null) { Nav.NavigateTo("/"); return; }

        await CargarDatosUniversales();
    }

    private void CambiarPestaña(string tab)
    {
        pestañaActiva = tab;
    }

    private async Task CargarDatosUniversales()
    {
        try
        {
            cargando = true;
            var boxId = Sesion.Usuario.BoxID;
            var userId = Sesion.Usuario.UsuarioID;

            // La API de evaluaciones nos trae TODOS los tests configurados en el box.
            // Si el usuario ya tiene una marca, el campo "Valor" viene lleno. Si no, viene nulo.
            var response = await Http.GetAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/evaluacionesapi/usuario/{boxId}/{userId}");

            if (response.IsSuccessStatusCode)
            {
                var todosLosTests = await response.Content.ReadFromJsonAsync<List<EvaluacionVisualDto>>();

                // Llenar Lista para la pestaña REGISTRAR (Muestra absolutamente todos los tests)
                listaEvaluaciones = todosLosTests;

                // Llenar Grupos para la pestaña HISTORIAL (Solo muestra los que sí tienen algún valor)
                gruposProgreso = todosLosTests
                    .Where(x => !string.IsNullOrEmpty(x.Valor))
                    .GroupBy(x => x.Categoria)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error", "No se pudo conectar con el servidor", "OK");
        }
        finally
        {
            cargando = false;
        }
    }

