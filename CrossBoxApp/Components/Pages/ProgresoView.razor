@code {
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    private bool cargando = true;
    private string pestañaActiva = "HISTORIAL"; 

    // Variables de Permisos y Selector de Atletas
    private bool EsAdminOCoach = false;
    private string filtroAtleta = "";
    private List<UsuarioListDto> listaTodosAtletas;
    private List<UsuarioListDto> listaAtletasFiltrada;
    
    private Guid usuarioObjetivoId; 
    private UsuarioListDto atletaActivo = null;

    // Variables Pestaña Historial
    private IEnumerable<IGrouping<string, EvaluacionVisualDto>> gruposProgreso = new List<IGrouping<string, EvaluacionVisualDto>>();
    private bool mostrarModalHistorial = false;
    private string nombreEjercicioSeleccionado = "";
    private List<HistorialDto> historialCargado;

    // Variables Pestaña Registrar
    private List<EvaluacionVisualDto> listaEvaluaciones = new List<EvaluacionVisualDto>();
    private bool mostrarModalRegistro = false;
    private bool esModoNuevaMarca = false;
    private EvaluacionVisualDto testSeleccionadoParaRegistro;
    private string valorInputRegistro;

    // Variables Pestaña Medidas
    private List<MedidaCorporalDto> historialMedidas = new List<MedidaCorporalDto>();
    private bool mostrarModalHistorialMedidas = false;
    private bool mostrarModalRegistroMedida = false;
    private bool guardandoMedida = false;
    private MedidaCorporalDto nuevaMedidaInput = new MedidaCorporalDto();
    
    public class MedidaCorporalDto
    {
        public Guid MedidaID { get; set; }
        public Guid UsuarioID { get; set; }
        public DateTime Fecha { get; set; }
        public decimal Peso { get; set; }
        public decimal? PorcentajeGrasa { get; set; }
        public decimal? GrasaVisceral { get; set; }
        public decimal? Musculo { get; set; }
        public decimal Altura { get; set; }
        public string? Sexo { get; set; } = "M";
        public string? MensajeIA { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) { EstilosTema = cache; StateHasChanged(); }
        } 
        catch { }

        if (Sesion.Usuario == null) { Nav.NavigateTo("/"); return; }

        EsAdminOCoach = Sesion.Usuario.TipoUsuarioID == 1 || Sesion.Usuario.TipoUsuarioID == 3;
        usuarioObjetivoId = Sesion.Usuario.UsuarioID;

        // Cargamos la lista de atletas siempre, por si el admin se pasa a la pestaña MEDIDAS luego
        if (EsAdminOCoach)
        {
            await CargarListaAtletasGym();
        }

        // Cargamos por defecto los RM del Coach/Atleta que acaba de entrar
        await CargarDatosUniversales();
    }

    // --- LÓGICA SELECTOR ATLETA (COACH) ---
    private async Task CargarListaAtletasGym()
    {
        try
        {
            var boxId = Sesion.Usuario.BoxID;
            listaTodosAtletas = await Http.GetFromJsonAsync<List<UsuarioListDto>>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/usuariosapi/buscador/{boxId}");
            listaAtletasFiltrada = listaTodosAtletas;
        }
        catch { listaTodosAtletas = new List<UsuarioListDto>(); listaAtletasFiltrada = new List<UsuarioListDto>(); }
    }

    // EL ONINPUT HACE QUE BUSQUE LETRA POR LETRA
    private void FiltrarAtletas(ChangeEventArgs e)
    {
        filtroAtleta = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(filtroAtleta)) listaAtletasFiltrada = listaTodosAtletas;
        else listaAtletasFiltrada = listaTodosAtletas.Where(x => x.NombreCompleto != null && x.NombreCompleto.Contains(filtroAtleta, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task SeleccionarAtleta(UsuarioListDto atleta)
    {
        atletaActivo = atleta;
        usuarioObjetivoId = atleta.UsuarioId;
        await CargarMedidasCorporales(); // Cargamos SOLO las medidas corporales del cliente
    }

    private void CambiarDeAtleta()
    {
        atletaActivo = null;
        usuarioObjetivoId = Sesion.Usuario.UsuarioID; // Regresamos al id del coach por si cambia de pestaña
        historialMedidas = new List<MedidaCorporalDto>();
        filtroAtleta = "";
        listaAtletasFiltrada = listaTodosAtletas;
    }

    // --- LÓGICA NAVEGACIÓN Y CARGA ---
    private async Task CambiarPestaña(string tab)
    {
        pestañaActiva = tab;

        if (tab == "MEDIDAS" && !historialMedidas.Any())
        {
            if (!EsAdminOCoach || (EsAdminOCoach && atletaActivo != null))
            {
                await CargarMedidasCorporales();
            }
        }
    }

    private async Task CargarDatosUniversales()
    {
        try
        {
            cargando = true;
            var boxId = Sesion.Usuario.BoxID;

            // Se carga la info del USUARIO LOGUEADO (porque esto es para la pestaña 1 y 2)
            var response = await Http.GetAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/evaluacionesapi/usuario/{boxId}/{Sesion.Usuario.UsuarioID}");

            if (response.IsSuccessStatusCode)
            {
                var todosLosTests = await response.Content.ReadFromJsonAsync<List<EvaluacionVisualDto>>();
                listaEvaluaciones = todosLosTests;
                gruposProgreso = todosLosTests.Where(x => !string.IsNullOrEmpty(x.Valor)).GroupBy(x => x.Categoria).ToList();
            }
        }
        catch { await App.Current.MainPage.DisplayAlert("Error", "No se pudo conectar con el servidor", "OK"); }
        finally { cargando = false; }
    }

    // --- LÓGICA MODAL HISTORIAL TESTS ---
    private async Task VerHistorial(Guid testBoxId, string nombreTest)
    {
        nombreEjercicioSeleccionado = nombreTest;
        mostrarModalHistorial = true;
        historialCargado = null; 

        try { historialCargado = await Http.GetFromJsonAsync<List<HistorialDto>>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/Evaluacionesapi/historial/{Sesion.Usuario.UsuarioID}/{testBoxId}"); }
        catch { }
    }
    private void CerrarModalHistorial() => mostrarModalHistorial = false;

    // --- LÓGICA MODAL REGISTRO/EDICIÓN TESTS ---
    private void AbrirModalRegistro(EvaluacionVisualDto item, bool esNuevaMarca)
    {
        testSeleccionadoParaRegistro = item;
        esModoNuevaMarca = esNuevaMarca;
        valorInputRegistro = esNuevaMarca ? "" : (item.Valor ?? "");
        mostrarModalRegistro = true;
    }

    private async Task GuardarMarca()
    {
        if (string.IsNullOrWhiteSpace(valorInputRegistro)) { await App.Current.MainPage.DisplayAlert("Aviso", "No puedes guardar una marca vacía.", "OK"); return; }
        try 
        {
            var dto = new GuardarResultadoDto { TestUsuarioId = testSeleccionadoParaRegistro.TestUsuarioId, TestBoxId = testSeleccionadoParaRegistro.TestBoxId, UsuarioId = Sesion.Usuario.UsuarioID, Valor = valorInputRegistro, EsNuevaMarca = esModoNuevaMarca };
            var r = await Http.PostAsJsonAsync("https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/evaluacionesapi/guardar", dto);
            if (r.IsSuccessStatusCode) { mostrarModalRegistro = false; await CargarDatosUniversales(); await App.Current.MainPage.DisplayAlert("¡Felicidades!", "Marca guardada con éxito.", "OK"); }
            else { await App.Current.MainPage.DisplayAlert("Error", "No se pudo guardar la marca.", "OK"); }
        } 
        catch(Exception ex) { await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK"); }
    }

    private async Task EliminarRegistro(Guid? testUsuarioId)
    {
        bool c = await App.Current.MainPage.DisplayAlert("Eliminar", "¿Borrar esta marca del historial?", "Sí, borrar", "Cancelar");
        if (!c) return;
        try {
            var r = await Http.PostAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/evaluacionesapi/eliminar-registro/{testUsuarioId}", null);
            if (r.IsSuccessStatusCode) await CargarDatosUniversales();
        } catch { }
    }

    private async Task CargarMedidasCorporales()
    {
        try
        {
            historialMedidas = await Http.GetFromJsonAsync<List<MedidaCorporalDto>>($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/evaluacionesapi/medidas/{usuarioObjetivoId}");

            StateHasChanged();
        }
        catch { }
    }

    private void AbrirModalNuevaMedida()
    {
        decimal alturaPrevia = 0;
        string sexoPrevio = "M";
        if(historialMedidas != null && historialMedidas.Any())
        {
            alturaPrevia = historialMedidas.First().Altura;
            sexoPrevio = historialMedidas.First().Sexo ?? "M";
        }

        // Le asignamos la medida al usuarioObjetivoId (El seleccionado o el propio atleta)
        nuevaMedidaInput = new MedidaCorporalDto { UsuarioID = usuarioObjetivoId, Altura = alturaPrevia, Sexo = sexoPrevio };
        mostrarModalRegistroMedida = true;
    }

    private async Task GuardarMedidaCorporal()
    {
        if (nuevaMedidaInput.Peso <= 0 || nuevaMedidaInput.Altura <= 0)
        {
            await App.Current.MainPage.DisplayAlert("Dato faltante", "El peso y la altura son obligatorios (mayores a cero).", "OK");
            return;
        }

        guardandoMedida = true;
        try
        {
            var r = await Http.PostAsJsonAsync("https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/evaluacionesapi/medidas/guardar", nuevaMedidaInput);
            if (r.IsSuccessStatusCode)
            {
                mostrarModalRegistroMedida = false;
                await CargarMedidasCorporales();
            }
            else await App.Current.MainPage.DisplayAlert("Error", "No se pudo guardar la medida.", "OK");
        }
        catch (Exception ex) { await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK"); }
        finally { guardandoMedida = false; }
    }

    private async Task EliminarMedida(Guid id)
    {
        bool confirmar = await App.Current.MainPage.DisplayAlert("Eliminar", "¿Borrar esta lectura de composición corporal?", "Sí", "Cancelar");
        if(!confirmar) return;
        try {
            var r = await Http.DeleteAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/evaluacionesapi/medidas/eliminar/{id}");
            if(r.IsSuccessStatusCode) { await CargarMedidasCorporales(); mostrarModalHistorialMedidas = false; }
        } catch {}
    }

    // --- UTILIDADES GRÁFICAS IMC ---
    private double CalcularIMC(decimal peso, decimal altura)
    {
        if (altura <= 0) return 0;
        return (double)peso / (double)(altura * altura);
    }

    private (string Categoria, string Color) ObtenerCategoriaIMC(double imc)
    {
        if (imc < 18.5) return ("BAJO PESO", "#3498db");
        if (imc < 25) return ("SALUDABLE", "#2ecc71");
        if (imc < 30) return ("SOBREPESO", "#f1c40f");
        return ("OBESIDAD", "#e74c3c");
    }

    private double CalcularPosicionIMC(double imc)
    {
        if (imc < 15) return 5;
        if (imc > 40) return 95;
        return ((imc - 15) / 25) * 100;
    }

    private double CalcularAlturaBarra(decimal peso)
    {
        if (historialMedidas == null || !historialMedidas.Any()) return 0;
        decimal maxPeso = historialMedidas.Max(m => m.Peso);
        if (maxPeso == 0) return 0;
        return (double)((peso / maxPeso) * 90);
    }

    private void Volver() {
        if(pestañaActiva == "MEDIDAS" && EsAdminOCoach && atletaActivo != null) 
        {
            CambiarDeAtleta();
        }
        else 
        {
            Nav.NavigateTo("/home");
        }
    }
