    private void CerrarModalHistorial() => mostrarModalHistorial = false;

    // --- LÓGICA MODAL REGISTRO/EDICIÓN ---
    private void AbrirModalRegistro(EvaluacionVisualDto item, bool esNuevaMarca)
    {
        testSeleccionadoParaRegistro = item;
        esModoNuevaMarca = esNuevaMarca;
        // Si es nuevo, vacío. Si es editar, ponemos el último valor que tenga.
        valorInputRegistro = esNuevaMarca ? "" : (item.Valor ?? "");
        mostrarModalRegistro = true;
    }

    private async Task GuardarMarca()
    {
        if (string.IsNullOrWhiteSpace(valorInputRegistro))
        {
            await App.Current.MainPage.DisplayAlert("Aviso", "No puedes guardar una marca vacía.", "OK");
            return;
        }

        try 
        {
            var dto = new GuardarResultadoDto 
            { 
                TestUsuarioId = testSeleccionadoParaRegistro.TestUsuarioId, 
                TestBoxId = testSeleccionadoParaRegistro.TestBoxId, 
                UsuarioId = Sesion.Usuario.UsuarioID, 
                Valor = valorInputRegistro, 
                EsNuevaMarca = esModoNuevaMarca 
            };

            var r = await Http.PostAsJsonAsync("https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/evaluacionesapi/guardar", dto);
            
            if (r.IsSuccessStatusCode) 
            { 
                mostrarModalRegistro = false; 
                await CargarDatosUniversales(); // Recargamos para que se actualicen ambas pestañas
                await App.Current.MainPage.DisplayAlert("¡Felicidades!", "Marca guardada con éxito.", "OK");
            }
            else 
            { 
                await App.Current.MainPage.DisplayAlert("Error", "No se pudo guardar la marca. Intenta de nuevo.", "OK"); 
            }
        } 
        catch(Exception ex) 
        { 
            await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK"); 
        }
    }

    private async Task EliminarRegistro(Guid? testUsuarioId)
    {
        bool c = await App.Current.MainPage.DisplayAlert("Eliminar Marca", "¿Estás seguro que deseas borrar esta marca de tu historial? Esta acción no se puede deshacer.", "Sí, borrar", "Cancelar");
        if (!c) return;
        
        try 
        {
            var r = await Http.PostAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/evaluacionesapi/eliminar-registro/{testUsuarioId}", null);
            if (r.IsSuccessStatusCode) 
            {
                await CargarDatosUniversales();
            }
            else 
            {
                await App.Current.MainPage.DisplayAlert("Error", "No se pudo eliminar.", "OK");
            }
        } 
        catch(Exception ex) 
        { 
            await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK"); 
        }
    }

    private void Volver() => Nav.NavigateTo("/home");
}