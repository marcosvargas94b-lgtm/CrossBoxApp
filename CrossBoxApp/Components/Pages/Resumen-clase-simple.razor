@page "/resumen-clase-simple"
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@inject LiveSessionState LiveState
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS

@* ENVOLVEMOS LA VISTA EN EL TEMA GLOBAL *@
<div style="@EstilosTema">

    <div class="resumen-container">
        <div class="resumen-card">
            
            <div class="header-resumen">
                <h2>CLASE FINALIZADA</h2>
                <p style="color:var(--theme-text-muted); font-size:0.8rem;">Asigna reconocimientos y guarda la asistencia.</p>
            </div>

            <div class="attendance-list scroll-custom">
                @if (listaLocal.Count == 0)
                {
                    <div class="text-theme-muted text-center mt-4">Nadie hizo check-in.</div>
                }
                else
                {
                    @foreach (var atleta in listaLocal)
                    {
                        <div class="user-row-wrapper mb-2">
                            <div class="user-row" style="background:var(--theme-bg); border-radius:10px; padding:10px; display:flex; align-items:center; justify-content:space-between; border: 1px solid var(--theme-border);">
                                
                                <div class="user-left" style="display:flex; align-items:center; gap:12px;">
                                    @if (!string.IsNullOrEmpty(atleta.FotoUrl))
                                    {
                                        <img src="@atleta.FotoUrl" class="avatar-list-img" style="width:40px; height:40px; border-radius:50%; border:2px solid var(--theme-primary); object-fit:cover;" @onerror="@(e => atleta.FotoUrl = null)" />
                                    }
                                    else
                                    {
                                        <div class="avatar-list-letter" style="width:40px; height:40px; border-radius:50%; background:var(--theme-card); color:var(--theme-primary); border:2px solid var(--theme-primary); display:flex; justify-content:center; align-items:center; font-weight:bold; font-family:'Oswald'; font-size:1.2rem;">
                                            @(atleta.NombreCompleto?.Substring(0, 1).ToUpper() ?? "A")
                                        </div>
                                    }
                                    
                                    <div style="display:flex; flex-direction:column; align-items:flex-start;">
                                        <span style="font-size:1rem; font-weight:bold; color: var(--theme-text);">@atleta.NombreCompleto</span>
                                        
                                        @* MARCA DE AGUA DE MEDALLAS *@
                                        <span @onclick="() => AbrirModalMedallas(atleta)" style="color:var(--theme-text-muted); font-size:0.75rem; cursor:pointer; font-style:italic; text-decoration:underline;">
                                            @if(atleta.Medallas.Any())
                                            {
                                                <span style="color:var(--theme-primary); font-weight:bold;">@(atleta.Medallas.Count) Medallas asignadas</span>
                                            }
                                            else
                                            {
                                                <span>Medallas (+)</span>
                                            }
                                        </span>
                                    </div>
                                </div>

                                <i class="fas fa-check-circle" style="color:#28a745; font-size:1.5rem;"></i>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="footer-actions mt-3">
                <button class="btn-close-session w-100" style="background:var(--theme-primary); color:var(--theme-bg); font-family:'Oswald'; font-weight:bold; padding:15px; border-radius:10px; border:none;" @onclick="GuardarAsistencia" disabled="@guardando">
                    @if (guardando) { <span><i class="fas fa-spinner fa-spin"></i> GUARDANDO...</span> }
                    else { <span>FINALIZAR CLASE</span> }
                </button>
            </div>
        </div>
    </div>

    @* --- MODAL MULTIPLE MEDALLAS --- *@
    @if (mostrarModalMedallas)
    {
        <div class="modal-overlay" style="position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.9); z-index:5000; display:flex; justify-content:center; align-items:center;" @onclick="CerrarModalMedallas">
            <div class="modal-content custom-modal" style="background:var(--theme-card); width:90%; max-width:350px; border-radius:15px; border:1px solid var(--theme-primary); overflow:hidden;" @onclick:stopPropagation="true">
                <div class="modal-header" style="background:var(--theme-bg); padding:15px; border-bottom:1px solid var(--theme-border); display:flex; justify-content:space-between; align-items:center;">
                    <h5 style="margin:0; color:var(--theme-primary); font-family:'Oswald';">OTORGAR MEDALLAS</h5>
                    <button style="background:none; border:none; color:var(--theme-text-muted); font-size:1.2rem;" @onclick="CerrarModalMedallas"><i class="fas fa-times"></i></button>
                </div>
                
                <div class="modal-body" style="padding:20px; display:flex; flex-direction:column; gap:10px;">
                    <p style="color:var(--theme-text-muted); font-size:0.8rem; text-align:center; margin-bottom:10px;">Selecciona los logros para @(atletaEditando?.NombreCompleto?.Split(' ')[0]):</p>
                    
                    @foreach (var opcion in opcionesMedallas)
                    {
                        bool seleccionado = atletaEditando != null && atletaEditando.Medallas.Contains(opcion);
                        <div style="background:@(seleccionado ? "rgba(255,255,255,0.05)" : "var(--theme-bg)"); border:1px solid @(seleccionado ? "var(--theme-primary)" : "var(--theme-border)"); padding:12px; border-radius:8px; display:flex; justify-content:space-between; align-items:center; cursor:pointer;" 
                             @onclick="() => ToggleMedalla(opcion)">
                            <span style="color:var(--theme-text); font-family:'Oswald'; letter-spacing:1px; font-size:0.9rem;">@opcion.ToUpper()</span>
                            @if(seleccionado){ <i class="fas fa-check-circle" style="color:var(--theme-primary);"></i> }
                        </div>
                    }
                </div>
                
                <div class="modal-footer" style="padding:15px; background:var(--theme-bg); border-top:1px solid var(--theme-border);">
                    <button style="width:100%; background:var(--theme-primary); color:var(--theme-bg); font-family:'Oswald'; font-weight:bold; border:none; padding:10px; border-radius:8px;" @onclick="CerrarModalMedallas">LISTO</button>
                </div>
            </div>
        </div>
    }

</div>

<style>
    .resumen-container { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: var(--theme-bg); display: flex; justify-content: center; align-items: center; padding: 15px; }
    .resumen-card { background: var(--theme-card); width: 100%; max-width: 500px; border-radius: 20px; padding: 20px; border: 2px solid var(--theme-primary); display: flex; flex-direction: column; max-height: 90vh; box-shadow: 0 0 30px rgba(0,0,0,0.5); }
    .header-resumen { text-align: center; margin-bottom: 20px; }
    .header-resumen h2 { font-family: 'Oswald'; color: var(--theme-text); margin:0; }
    .attendance-list { flex: 1; overflow-y: auto; padding-right: 5px; }
    .scroll-custom::-webkit-scrollbar { width: 4px; } .scroll-custom::-webkit-scrollbar-thumb { background: var(--theme-border); border-radius: 4px; }
    .text-theme-muted { color: var(--theme-text-muted); }
</style>

@code {
    // --- ESTADO INICIAL NEUTRAL (PLATA MATE) ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    class AtletaSimple { 
        public Guid UsuarioId; 
        public string NombreCompleto; 
        public string FotoUrl; 
        public List<string> Medallas = new List<string>(); 
    }

    private List<AtletaSimple> listaLocal = new();
    private bool guardando = false;

    // Lógica del Modal
    private bool mostrarModalMedallas = false;
    private AtletaSimple atletaEditando;
    private List<string> opcionesMedallas = new List<string> { 
        "Semana Completa", 
        "Mes Completo", 
        "Atleta Destacado", 
        "Mejor de la Clase" 
    };

    protected override async Task OnInitializedAsync()
    {
        // LEER EL CACHÉ LOCAL AL INSTANTE
        try 
        {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) 
            { 
                EstilosTema = cache; 
                StateHasChanged(); 
            }
        } 
        catch { }

        // Cargamos los que hicieron check-in
        listaLocal = LiveState.AtletasEnClase.Select(a => new AtletaSimple { 
            UsuarioId = a.UsuarioId, 
            NombreCompleto = a.NombreCompleto, 
            FotoUrl = a.FotoUrl 
        }).ToList();
    }

    private void AbrirModalMedallas(AtletaSimple atleta)
    {
        atletaEditando = atleta;
        mostrarModalMedallas = true;
    }

    private void CerrarModalMedallas()
    {
        mostrarModalMedallas = false;
        atletaEditando = null;
    }

    private void ToggleMedalla(string medalla)
    {
        if (atletaEditando == null) return;
        
        if (atletaEditando.Medallas.Contains(medalla))
            atletaEditando.Medallas.Remove(medalla);
        else
            atletaEditando.Medallas.Add(medalla);
    }

    // DTO para mandar al backend
    public class GuardarClaseSimpleDto
    {
        public Guid BoxId { get; set; }
        public List<AtletaResultSimple> Resultados { get; set; } = new();
    }

    public class AtletaResultSimple
    {
        public Guid UsuarioId { get; set; }
        public List<string> Medallas { get; set; } = new();
    }

    private async Task GuardarAsistencia()
    {
        guardando = true;
        StateHasChanged();

        var payload = new GuardarClaseSimpleDto { BoxId = Sesion.Usuario.BoxID };

        foreach (var item in listaLocal)
        {
            payload.Resultados.Add(new AtletaResultSimple
            {
                UsuarioId = item.UsuarioId,
                Medallas = item.Medallas
            });
        }

        try
        {
            // Llamamos al nuevo endpoint
            var url = "https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/scoresapi/guardar-clase-simple";
            await Http.PostAsJsonAsync(url, payload);
        }
        catch { }

        // Limpiamos y nos vamos al home (cero podio)
        LiveState.AtletasEnClase.Clear();
        Nav.NavigateTo("/home");
    }
}