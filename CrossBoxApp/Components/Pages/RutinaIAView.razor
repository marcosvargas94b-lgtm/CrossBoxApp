    private async Task ReemplazarEjercicioUI(DiaEntrenoDto diaDto, EjercicioDto ejercicioActual)
    {
        bool confirmar = await App.Current.MainPage.DisplayAlert("¿Cambiar Ejercicio?", 
            $"La IA buscará una alternativa para '{ejercicioActual.NombreEspanol}' que trabaje lo mismo.", 
            "Sí, cambiar", "Cancelar");

        if (!confirmar) return;

        cargandoInicial = true; 
        StateHasChanged();

        try
        {
            var dto = new 
            {
                RutinaID = rutinaGenerada.IdBaseDatos,
                UsuarioID = Sesion.Usuario.UsuarioID,
                Semana = semanaActiva,
                Dia = diaDto.Dia,
                NombreEjercicio = ejercicioActual.NombreEspanol
            };

            var response = await Http.PostAsJsonAsync("https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/IAEntrenador/reemplazar-ejercicio", dto);

            if (response.IsSuccessStatusCode)
            {
                var nuevoEjercicio = await response.Content.ReadFromJsonAsync<EjercicioDto>();
                
                var indice = diaDto.Ejercicios.IndexOf(ejercicioActual);
                if (indice != -1)
                {
                    diaDto.Ejercicios[indice] = nuevoEjercicio;
                }
                
                await App.Current.MainPage.DisplayAlert("Hecho", "Ejercicio actualizado por el Coach IA.", "OK");
            }
            else
            {
                await App.Current.MainPage.DisplayAlert("Error", "El Coach no pudo encontrar un reemplazo en este momento.", "OK");
            }
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK");
        }
        finally
        {
            cargandoInicial = false;
            StateHasChanged();
        }
    }

    private async Task IniciarProcesoCierre()
    {
        cargandoResumen = true;
        try {
            var response = await Http.GetAsync($"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/IAEntrenador/resumen-cierre/{rutinaGenerada.IdBaseDatos}");
            if (response.IsSuccessStatusCode) {
                resumenCierre = await response.Content.ReadFromJsonAsync<ResumenCierreDto>();
