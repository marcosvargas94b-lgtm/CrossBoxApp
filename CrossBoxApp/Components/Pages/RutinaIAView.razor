@page "/rutina-ia"
@using System.Net.Http.Json
@using CrossBoxApp.Models.IA 
@using static CrossBoxApp.Models.IA.RutinaIA_Dtos
@using CrossBoxApp.Models.Services
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS

@* ENVOLVEMOS TODA LA VISTA EN EL TEMA GLOBAL *@
<div style="@EstilosTema">

    <div class="main-layout">

        <div class="navbar-container">
            <div class="nav-left" @onclick='() => Nav.NavigateTo("/home")'>
                <i class="fas fa-arrow-left"></i> VOLVER
            </div>
            <div class="nav-title">COACH IA PRO</div>
            <div class="nav-right"></div>
        </div>

        <div class="scrollable-content">

            @if (cargandoInicial || generando)
            {
                <div class="loading-screen text-center mt-5 fade-in" style="width: 100%; max-width: 400px; margin: 0 auto; padding: 20px;">
                    <i class="fas fa-brain fa-fade mb-3" style="font-size: 3rem; color: var(--theme-primary);"></i>
                    <h4 style="color:var(--theme-primary); font-family:'Oswald'; letter-spacing: 1px;">@textoCarga</h4>

                    <div class="progress mt-4 mb-2" style="height: 12px; background-color: var(--theme-bg); border-radius: 10px; overflow: hidden; border: 1px solid var(--theme-border);">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar"
                             style="width: @(progresoCarga)%; background-color: var(--theme-primary); transition: width 0.5s ease;"></div>
                    </div>

                    <p style="color:var(--theme-text-muted); font-size: 0.8rem; font-family:'Roboto';">
                        <i class="fas fa-info-circle"></i> La IA está creando un plan complejo de 4 semanas. Esto puede tomar un par de minutos.
                    </p>
                </div>
            }
            else if (rutinaGenerada == null)
            {
                <div class="welcome-section fade-in">
                    @if (modoContinuacion)
                    {
                        <div style="background: rgba(40, 167, 69, 0.1); border: 1px solid #28a745; padding: 15px; border-radius: 10px; margin-bottom: 15px;">
                            <h1 style="color: #28a745; font-family: 'Oswald'; text-align: center; font-size: 1.5rem; margin-bottom: 5px;"><i class="fas fa-level-up-alt"></i> ¡SIGUIENTE NIVEL DESBLOQUEADO!</h1>
                            <p style="text-align:center; color:var(--theme-text); font-size: 0.85rem; margin: 0;">Tu historial ha sido analizado. Ajusta tus parámetros si lo necesitas y el Coach diseñará tu nuevo ciclo basándose en tu progreso.</p>
                        </div>
                    }
                    else
                    {
                        <h1 style="color: var(--theme-primary); font-family: 'Oswald'; text-align: center;">PLANIFICACIÓN INTELIGENTE</h1>
                        <p style="text-align:center; color:var(--theme-text-muted); font-size: 0.9rem;">Diseñaré tu próximo ciclo basado en tus objetivos.</p>
                    }
                </div>

                <div class="form-card fade-in">
                    <label class="form-label">Nivel de Experiencia</label>
                    <select class="form-control input-dark mb-3" @bind="perfil.Nivel">
                        <option value="Principiante">Principiante (Adaptación)</option>
                        <option value="Intermedio">Intermedio (Carga Progresiva)</option>
                        <option value="Avanzado">Avanzado (Especialización)</option>
                    </select>

                    <label class="form-label">Objetivo Principal</label>
                    <select class="form-control input-dark mb-3" @bind="perfil.Objetivo">
                        <option value="Hipertrofia">Hipertrofia (Ganar Músculo)</option>
                        <option value="Fuerza">Fuerza Máxima</option>
                        <option value="Resistencia">Resistencia / Quema de Grasa</option>
                    </select>

                    <label class="form-label">Días por Semana: <span style="color:var(--theme-primary)">@perfil.DiasPorSemana</span></label>
                    <div class="range-container mb-3">
                        <input type="range" class="form-range w-100" min="2" max="6" step="1" @bind="perfil.DiasPorSemana" style="accent-color: var(--theme-primary);" />
                        <div class="d-flex justify-content-between small text-muted"><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span></div>
                    </div>

                    <label class="form-label">Equipo Disponible</label>
                    <select class="form-control input-dark mb-3" @bind="perfil.Equipo">
                        <option value="Gym Comercial Completo">Gym Completo</option>
                        <option value="Mancuernas y Banco">Solo Mancuernas y Banco</option>
                        <option value="Peso Corporal">Solo Peso Corporal</option>
                    </select>

                    <label class="form-label">Lesiones o Molestias</label>
                    <input type="text" @bind="perfil.Lesiones" class="form-control input-dark mb-4" placeholder="Ej: Dolor lumbar, rodilla..." />

                    <button class="btn-confirm w-100 py-3" @onclick="GenerarRutina" disabled="@generando">
                        @if (generando) { <span><i class="fas fa-brain fa-spin"></i> ANALIZANDO DATOS...</span> }
                        else { <span><i class="fas fa-bolt"></i> GENERAR PLAN</span> }
                    </button>
                    
                    @if (!string.IsNullOrEmpty(errorMensaje)) { <div class="alert alert-danger mt-3">@errorMensaje</div> }
                </div>
            }
            else
            {
                <div class="rutina-view fade-in">
                    <div class="header-rutina">
                        <h2 style="font-size: 1.4rem; color: var(--theme-text); font-family: 'Oswald'; margin-bottom: 5px;">@rutinaGenerada.NombreRutina</h2>
                        <div class="badge-obj">@rutinaGenerada.Explicacion</div>
                        
                        <div class="progress-container mt-3">
                            <div class="d-flex justify-content-between small mb-1" style="color: var(--theme-text-muted);">
                                <span>Progreso del Mesociclo</span>
                                <span>@diasCompletados.Count / @(rutinaGenerada.Semanas.Count * perfil.DiasPorSemana) Sesiones</span>
                            </div>
                            <div class="progress" style="height: 6px; background-color: var(--theme-bg);">
                                <div class="progress-bar" role="progressbar" style="width: @(CalcularPorcentaje())%; background-color: var(--theme-primary);"></div>
                            </div>
                        </div>
                    </div>

                    <div class="week-tabs-container">
                        <div class="week-tabs">
                            @foreach (var sem in rutinaGenerada.Semanas)
                            {
                                <button class="tab-btn @(semanaActiva == sem.NumeroSemana ? "active" : "")" @onclick="() => semanaActiva = sem.NumeroSemana">
                                    SEM @sem.NumeroSemana
                                </button>
                            }
                        </div>
                    </div>

                    <div class="info-semana">
                        <i class="fas fa-crosshairs" style="color: var(--theme-primary);"></i> 
                        <span><strong>Enfoque:</strong> @GetSemanaActual().Enfoque</span>
                    </div>

                    @foreach (var dia in GetSemanaActual().Dias)
                    {
                        string claveDia = $"{semanaActiva}-{dia.Dia}";
                        bool completado = diasCompletados.Contains(claveDia);

                        <div class="day-card @(completado ? "border-success" : "")">
                            <div class="day-header @(completado ? "bg-success-dim" : "")">
                                <div>
                                    <span class="day-title">@dia.Dia.ToUpper()</span>
                                    <span class="muscle-tag"> // @dia.GrupoMuscular</span>
                                </div>
                                @if(completado) { <span class="badge bg-success"><i class="fas fa-check"></i> HECHO</span> }
                            </div>
                            
                            <div class="exercises-list @(completado ? "opacity-50" : "")">
                                @foreach (var ej in dia.Ejercicios)
                                {
                                    <div class="ex-row">
                                        <div class="ex-info-vertical">

                                            <div class="ex-name-row">
                                                <span class="ex-name">@ej.NombreEspanol</span>
                                            </div>

                                            <div class="ex-notes">@ej.NotaTecnica</div>

                                            <div class="ex-actions-meta-row">

                                                <div class="action-buttons-group">
                                                    @* Youtube se mantiene rojo semántico *@
                                                    <button class="btn-icon-ia btn-video" @onclick="() => VerEnYoutube(ej.NombreEspanol)">
                                                        <i class="fas fa-play-circle"></i>
                                                    </button>

                                                    @if (!completado)
                                                    {
                                                        @* Botón de swap azul informativo *@
                                                        <button class="btn-ia btn-swap-text" @onclick="() => ReemplazarEjercicioUI(dia, ej)">
                                                            <i class="fas fa-sync-alt"></i>
                                                            <span>Cambiar</span>
                                                        </button>
                                                    }
                                                </div>

                                                <div class="ex-meta-inline">
                                                    <div class="meta-pill">
                                                        <span class="meta-val">@ej.Series</span>
                                                        <span class="meta-label">SETS</span>
                                                    </div>
                                                    <div class="meta-pill">
                                                        <span class="meta-val">@ej.Repeticiones</span>
                                                        <span class="meta-label">REPS</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="day-footer">
                                @if (completado) { <button class="btn-feedback disabled-btn" disabled>ENTRENAMIENTO GUARDADO</button> }
                                else { <button class="btn-feedback" @onclick="() => AbrirFeedback(dia.Dia)"><i class="fas fa-clipboard-check"></i> REGISTRAR SESIÓN</button> }
                            </div>
                        </div>
                    }

                    <div class="footer-actions mt-4">
                        <button class="btn-finalize" @onclick="IniciarProcesoCierre" disabled="@cargandoResumen">
                            @if(cargandoResumen) { <span><i class="fas fa-spinner fa-spin"></i> ANALIZANDO TU MES...</span> }
                            else { <span><i class="fas fa-flag-checkered"></i> FINALIZAR MESOCICLO</span> }
                        </button>
                    </div>
                </div>
            }
            
            <div style="height: 60px;"></div>
        </div>
    </div>

    @* MODALES *@
    @if (mostrarFeedback)
    {
        <div class="modal-overlay fade-in">
            <div class="modal-content custom-modal slide-up">
                <h4 class="text-center mb-3" style="font-family:'Oswald'; color: var(--theme-primary);">REPORTE: @diaFeedback</h4>
                
                <label class="form-label">Nivel de Cansancio (1-10)</label>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <input type="range" class="form-range flex-grow-1" min="1" max="10" @bind="inputCansancio" style="accent-color: var(--theme-primary);" />
                    <span class="badge" style="font-size:1rem; width:40px; background-color: var(--theme-primary); color: var(--theme-bg);">@inputCansancio</span>
                </div>
                
                <label class="form-label">Sensación / Dolor</label>
                <select @bind="inputDolor" class="form-control input-dark mb-3">
                    <option value="Sin Dolor">Todo bien / Fuerte 💪</option>
                    <option value="Molestia Leve">Molestia leve 😐</option>
                    <option value="Dolor Articular">Dolor articular 😫</option>
                    <option value="Agotado">Muy agotado 😴</option>
                </select>
                
                <label class="form-label">Comentarios</label>
                <textarea @bind="inputComentarios" class="form-control input-dark mb-3" rows="3" placeholder="Ej: Me costó la última serie..."></textarea>
                
                <div class="d-flex gap-2">
                    <button class="btn btn-secondary flex-fill" @onclick="() => mostrarFeedback = false">Cancelar</button>
                    <button class="btn flex-fill fw-bold" style="background-color: var(--theme-primary); color: var(--theme-bg);" @onclick="GuardarFeedback">GUARDAR DATOS</button>
                </div>
            </div>
        </div>
    }

    @if (mostrandoResumen && resumenCierre != null)
    {
        <div class="modal-overlay fade-in">
            <div class="modal-content custom-modal slide-up" style="border: 2px solid var(--theme-primary); max-width: 400px;">
                <div class="text-center mb-3">
                    <h2 style="font-family:'Oswald'; color:var(--theme-primary); text-transform:uppercase; margin-bottom:5px; font-size:1.8rem;">@resumenCierre.Titulo</h2>
                    <div class="score-circle" style="border-color: var(--theme-primary);"><span>@resumenCierre.CalificacionGeneral</span><small>PUNTOS</small></div>
                </div>
                <div class="analysis-section" style="max-height: 300px; overflow-y:auto;">
                    <div class="analysis-item"><i class="fas fa-calendar-check" style="color: var(--theme-primary);"></i><div><strong>Constancia:</strong><p>@resumenCierre.AnalisisAdherencia</p></div></div>
                    <div class="analysis-item"><i class="fas fa-dumbbell" style="color: var(--theme-primary);"></i><div><strong>Rendimiento:</strong><p>@resumenCierre.AnalisisRendimiento</p></div></div>
                    <div class="analysis-item highlight-box" style="background-color: var(--theme-primary);"><i class="fas fa-arrow-up" style="color: var(--theme-bg);"></i><div><strong style="color: var(--theme-bg);">PRÓXIMO OBJETIVO:</strong><p style="color: var(--theme-bg);">@resumenCierre.EstrategiaSiguiente</p></div></div>
                </div>
                <button class="btn-confirm mt-4" @onclick="MostrarOpcionesContinuidad">VER OPCIONES DE CONTINUIDAD</button>
            </div>
        </div>
    }
</div>

<style>
    /* --- ESTRUCTURA BASE --- */
    .main-layout { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--theme-bg); display: flex; flex-direction: column; z-index: 1; }
    .navbar-container { flex-shrink: 0; padding-top: calc(env(safe-area-inset-top) + 5px); padding-bottom: 10px; padding-left: 20px; padding-right: 20px; background-color: var(--theme-bg); border-bottom: 1px solid var(--theme-primary); color: var(--theme-text); display: flex; justify-content: space-between; align-items: center; z-index: 100; font-family: 'Oswald'; min-height: 60px; }
    .nav-left { color: var(--theme-primary); font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
    .nav-title { font-weight: bold; font-size: 1.1rem; color: var(--theme-text); letter-spacing: 1px; }
    .nav-right { width: 60px; }
    .scrollable-content { flex-grow: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; -webkit-overflow-scrolling: touch; padding-bottom: 40px; }
    
    /* --- FORMULARIOS Y BOTONES --- */
    .form-card { background: var(--theme-card); padding: 20px; border-radius: 10px; border: 1px solid var(--theme-border); margin-top: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); width: 100%; max-width: 600px; align-self: center; }
    .input-dark { background: var(--theme-bg) !important; border: 1px solid var(--theme-border) !important; color: var(--theme-text) !important; margin-bottom: 15px; }
    .input-dark::placeholder { color: var(--theme-text-muted); }
    .form-label { color: var(--theme-primary); font-size: 0.9rem; font-weight: bold; margin-bottom: 5px; display:block; }
    .btn-confirm { background: var(--theme-primary); border: none; padding: 15px; font-weight: bold; border-radius: 8px; width: 100%; color: var(--theme-bg); font-family: 'Oswald'; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 1px; }
    
    /* --- ESTRUCTURA RUTINA --- */
    .header-rutina { text-align: center; margin-bottom: 20px; width: 100%; max-width: 600px; align-self: center; }
    .badge-obj { display: inline-block; background: var(--theme-card); color: var(--theme-text-muted); padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; margin-top: 5px; border: 1px solid var(--theme-border); }
    .week-tabs-container { width: 100vw; margin-left: -20px; padding: 0 20px; overflow-x: auto; -webkit-overflow-scrolling: touch; margin-bottom: 15px; }
    .week-tabs { display: flex; gap: 8px; padding-bottom: 5px; min-width: max-content; }
    .tab-btn { background: var(--theme-card); border: 1px solid var(--theme-border); color: var(--theme-text-muted); padding: 10px 15px; border-radius: 8px; white-space: nowrap; font-family: 'Oswald'; flex-shrink: 0; }
    .tab-btn.active { background: var(--theme-primary); color: var(--theme-bg); border-color: var(--theme-primary); font-weight: bold; }
    .info-semana { width: 100%; max-width: 600px; align-self: center; background: rgba(255,255,255,0.05); border-left: 3px solid var(--theme-primary); padding: 12px; font-size: 0.9rem; margin-bottom: 20px; border-radius: 4px; color: var(--theme-text); display: flex; align-items: center; gap: 10px; }
    
    /* --- DAY CARD --- */
    .day-card { width: 100%; max-width: 600px; align-self: center; background: var(--theme-card); border-radius: 12px; border: 1px solid var(--theme-border); margin-bottom: 20px; overflow: hidden; }
    .day-header { background: var(--theme-bg); padding: 12px 15px; display: flex; justify-content: space-between; align-items: center; color: var(--theme-primary); font-family: 'Oswald'; border-bottom: 1px solid var(--theme-border); }
    .day-title { font-size: 1.1rem; }
    .muscle-tag { color: var(--theme-text-muted); font-size: 0.8rem; margin-left: 5px; font-family: 'Roboto'; }
    .border-success { border: 1px solid #28a745 !important; }
    .bg-success-dim { background: rgba(40, 167, 69, 0.15) !important; color: #28a745 !important; }
    .opacity-50 { opacity: 0.6; pointer-events: none; }
    
    /* --- TARJETA DE EJERCICIO --- */
    .ex-row { padding: 15px; border-bottom: 1px solid var(--theme-border); background: var(--theme-bg); }
    .ex-info-vertical { display: flex; flex-direction: column; width: 100%; gap: 8px; }
    .ex-name { font-weight: bold; font-size: 1.1rem; color: var(--theme-text); line-height: 1.2; }
    .ex-notes { font-size: 0.85rem; color: var(--theme-text-muted); line-height: 1.4; }
    .ex-actions-meta-row { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; flex-wrap: wrap; gap: 10px; }
    .action-buttons-group { display: flex; gap: 12px; align-items: center; }
    .ex-meta-inline { display: flex; gap: 8px; margin-left: auto; }
    .meta-pill { background: var(--theme-card); border: 1px solid var(--theme-border); border-radius: 6px; padding: 4px 10px; text-align: center; min-width: 50px; display: flex; flex-direction: column; justify-content: center; }
    .meta-val { font-weight: bold; color: var(--theme-primary); font-size: 1rem; line-height: 1; font-family: 'Oswald'; }
    .meta-label { font-size: 0.6rem; color: var(--theme-text-muted); text-transform: uppercase; margin-top: 2px; }

    /* BOTONES IA */
    .btn-icon-ia { border: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s ease; }
    .btn-ia { border: none; border-radius: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s ease; font-family: 'Oswald'; font-weight: bold;}
    .btn-video { background: rgba(255, 68, 68, 0.15); color: #ff4444; border: 1px solid #ff4444; font-size: 1.2rem; width: 38px; height: 38px; }
    .btn-swap-text { background: rgba(13, 202, 240, 0.1); color: #0dcaf0; border: 1px solid #0dcaf0; padding: 0 14px; gap: 6px; height: 36px; }
    .btn-swap-text span { font-size: 0.8rem; }
    
    /* FOOTER CARD */
    .day-footer { padding: 12px; text-align: center; background: var(--theme-card); border-top: 1px solid var(--theme-border); }
    .btn-feedback { background: transparent; border: 1px solid var(--theme-border); color: var(--theme-text); padding: 10px; border-radius: 25px; font-size: 0.85rem; width: 100%; font-weight: bold; }
    .disabled-btn { background: var(--theme-card) !important; color: #28a745 !important; border: 1px solid #28a745 !important; opacity: 1; }
    .btn-finalize { width: 100%; max-width: 600px; align-self: center; background: #dc3545; color: white; border: none; padding: 15px; font-weight: bold; border-radius: 10px; font-family: 'Oswald'; margin-top: 20px; font-size: 1.1rem; }
    
    /* MODALES */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 2000; display: flex; justify-content: center; align-items: center; backdrop-filter: blur(5px); }
    .custom-modal { background: var(--theme-card); width: 90%; max-width: 350px; padding: 25px; border-radius: 15px; border: 1px solid var(--theme-primary); }
    .score-circle { width: 80px; height: 80px; border-radius: 50%; border: 4px solid var(--theme-primary); display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 0 auto; background: rgba(255,255,255,0.05); }
    .score-circle span { font-size: 1.8rem; font-weight: bold; color: var(--theme-text); line-height: 1; }
    .score-circle small { font-size: 0.6rem; color: var(--theme-text-muted); }
    .analysis-item { display: flex; gap: 15px; margin-bottom: 15px; align-items: flex-start; }
    .analysis-item p { color: var(--theme-text-muted); font-size: 0.9rem; margin: 0; }
    .highlight-box { padding: 15px; border-radius: 8px; }
    .highlight-box strong { text-transform: uppercase; font-family: 'Oswald'; }
    .fade-in { animation: fadeIn 0.5s ease; }
    .slide-up { animation: slideUp 0.4s ease; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp { from { transform: translateY(50px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
</style>

@code {
    // --- ESTADO INICIAL NEUTRAL (PLATA MATE) ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    private bool cargandoInicial = true, generando = false, mostrarFeedback = false, mostrandoResumen = false, cargandoResumen = false;
    private string errorMensaje, diaFeedback;
    private RutinaGeneradaDto rutinaGenerada;
    private ResumenCierreDto resumenCierre;
    private PerfilAtletaDto perfil = new PerfilAtletaDto { Nivel = "Intermedio", Objetivo = "Hipertrofia", DiasPorSemana = 4, Equipo = "Gym Comercial Completo", Lesiones = "Ninguna" };
    private int semanaActiva = 1;
    private HashSet<string> diasCompletados = new HashSet<string>();
    private int inputCansancio = 7;
    private string inputDolor = "Sin Dolor";
    private string inputComentarios = "";
    private bool modoContinuacion = false;   
    private int progresoCarga = 0;
    private string textoCarga = "INICIANDO...";

    protected override async Task OnInitializedAsync()
    {
        // LEER EL CACHÉ LOCAL AL INSTANTE
        try 
        {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) 
            { 
                EstilosTema = cache; 
                StateHasChanged(); 
            }
        } 
        catch { }

        if (Sesion.Usuario == null) { Nav.NavigateTo("/"); return; }
        await CargarRutinaActiva();
    }

    private async Task SimularProgresoIA()
    {
        progresoCarga = 5;
        var frases = new[] {
            "ANALIZANDO TU PERFIL FÍSICO...",
            "DISEÑANDO MESOCICLO DE 4 SEMANAS...",
            "CALCULANDO VOLUMEN E INTENSIDAD...",
            "SELECCIONANDO EJERCICIOS ÓPTIMOS...",
            "AJUSTANDO DETALLES FINALES...",
            "YA CASI LO TENEMOS..."
        };

        int i = 0;
        textoCarga = frases[0];

        while (generando || cargandoInicial)
        {
            await Task.Delay(2500); 

            if (progresoCarga < 95) progresoCarga += 10; 

            if (i < frases.Length - 1 && progresoCarga % 20 == 0) i++;
            textoCarga = frases[i];

            StateHasChanged(); 
        }
    }

    private async Task CargarRutinaActiva()
    {
        cargandoInicial = true;
        try {
            var response = await Http.GetAsync($"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/IAEntrenador/activa/{Sesion.Usuario.UsuarioID}");
            if (response.StatusCode == System.Net.HttpStatusCode.OK) {
                rutinaGenerada = await response.Content.ReadFromJsonAsync<RutinaGeneradaDto>();
                semanaActiva = 1; 
                await CargarProgreso();
            } else { rutinaGenerada = null; }
        } catch { rutinaGenerada = null; } finally { cargandoInicial = false; }
    }

    private async Task CargarProgreso()
    {
        if(rutinaGenerada == null) return;
        try {
            var lista = await Http.GetFromJsonAsync<List<string>>($"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/IAEntrenador/progreso/{rutinaGenerada.IdBaseDatos}");
            diasCompletados = new HashSet<string>(lista ?? new List<string>());
        } catch {}
    }

    private async Task GenerarRutina()
    {
        if (string.IsNullOrWhiteSpace(perfil.Lesiones)) perfil.Lesiones = "Ninguna";
        generando = true; errorMensaje = null;
        _ = SimularProgresoIA();
        try {
            var response = await Http.PostAsJsonAsync($"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/IAEntrenador/generar-rutina/{Sesion.Usuario.UsuarioID}", perfil);
            if (response.IsSuccessStatusCode) {
                rutinaGenerada = await response.Content.ReadFromJsonAsync<RutinaGeneradaDto>();
                semanaActiva = 1;
                diasCompletados.Clear();
            } else { 
                errorMensaje = "Ocurrió un error. Intenta nuevamente."; }
        } catch (Exception ex) { errorMensaje = ex.Message; } finally { generando = false; }
    }

    private void AbrirFeedback(string dia) { diaFeedback = dia; inputCansancio = 7; inputDolor = "Sin Dolor"; inputComentarios = ""; mostrarFeedback = true; }

    private async Task GuardarFeedback()
    {
        if (rutinaGenerada == null) return;
        
        string claveDia = $"{semanaActiva}-{diaFeedback}";

        var datos = new 
        { 
            RutinaID = rutinaGenerada.IdBaseDatos, 
            DiaSemana = claveDia, 
            NivelCansancio = inputCansancio, 
            DolorLesion = inputDolor, 
            Comentarios = inputComentarios 
        };

        try 
        {
            var response = await Http.PostAsJsonAsync("https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/IAEntrenador/feedback", datos);
            
            if (response.IsSuccessStatusCode)
            {
                diasCompletados.Add(claveDia);
                mostrarFeedback = false;
                await App.Current.MainPage.DisplayAlert("¡Guardado!", "Progreso registrado.", "OK");
            }
            else 
            {
                var error = await response.Content.ReadAsStringAsync();
                await App.Current.MainPage.DisplayAlert("Error Servidor", error, "OK");
            }
        } 
        catch (Exception ex) 
        { 
            await App.Current.MainPage.DisplayAlert("Error Conexión", ex.Message, "OK"); 
        }
    }

