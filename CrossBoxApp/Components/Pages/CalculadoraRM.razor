@page "/calculadora-rm"
@inject NavigationManager Nav
@inject IJSRuntime JS
<div style="@EstilosTema">
<div class="main-layout" >
    @* NAVBAR *@
    <div class="navbar-container">
        <div class="nav-left" @onclick='() => Nav.NavigateTo("/home")'>
            <i class="fas fa-arrow-left"></i> VOLVER
        </div>
        <div class="nav-title">
            <i class="fas fa-calculator" style="color:var(--theme-primary); margin-right:5px;"></i> CALCULADORA %
        </div>
        <div class="nav-right"></div>
    </div>

    <div class="content-area scroll-custom">
        <div class="calc-card slide-in-up">
            
            @* SWITCH LBS / KG *@
            <div class="unit-switch-container">
                <span class="@(esLibras ? "active" : "")" @onclick="() => CambiarUnidad(true)">LBS</span>
                <div class="switch-track" @onclick="ToggleUnidad">
                    <div class="switch-thumb @(esLibras ? "left" : "right")"></div>
                </div>
                <span class="@(!esLibras ? "active" : "")" @onclick="() => CambiarUnidad(false)">KGS</span>
            </div>

            <div class="inputs-grid mt-4">
                @* 1RM INPUT *@
                <div class="input-box">
                    <label>TU 1RM (Máximo)</label>
                    <div class="input-wrapper">
                        <input type="number" @bind="peso1RM" @bind:event="oninput" placeholder="Ej. 225" />
                        <span class="unit-label">@(esLibras ? "LB" : "KG")</span>
                    </div>
                </div>

                @* % DESEADO INPUT *@
                <div class="input-box">
                    <label>PORCENTAJE</label>
                    <div class="input-wrapper">
                        <input type="number" @bind="porcentaje" @bind:event="oninput" placeholder="Ej. 75" />
                        <span class="unit-label">%</span>
                    </div>
                </div>
            </div>

            @* RULETA DE LA BARRA *@
            <div class="input-box mt-3">
                <label>PESO DE LA BARRA</label>
                <div class="select-wrapper">
                    <select @bind="pesoBarra">
                        @if (esLibras)
                        {
                            <option value="45">Barra Olímpica (45 lbs)</option>
                            <option value="35">Barra Femenil (35 lbs)</option>
                            <option value="15">Barra Técnica (15 lbs)</option>
                        }
                        else
                        {
                            <option value="20">Barra Olímpica (20 kgs)</option>
                            <option value="15">Barra Femenil (15 kgs)</option>
                            <option value="10">Barra Técnica (10 kgs)</option>
                        }
                    </select>
                    <i class="fas fa-chevron-down select-icon"></i>
                </div>
            </div>

            <button class="btn-calcular mt-4" @onclick="Calcular">CALCULAR DISCOS</button>

            @* RESULTADOS *@
            @if (calculoRealizado)
            {
                <div class="results-section fade-in mt-4">
                    <div class="total-weight-box">
                        <h3>VAS A LEVANTAR</h3>
                        <div class="big-number">
                            @pesoReal <small>@(esLibras ? "LBS" : "KGS")</small>
                        </div>
                        <p class="target-info">Objetivo exacto: @pesoObjetivo.ToString("0.#") @(esLibras ? "lbs" : "kgs")</p>
                    </div>

                    @if (discosIdeales.Count > 0)
                    {
                        <div class="plate-suggestion mt-3">
                            <label><i class="fas fa-check-circle text-success"></i> CARGA ÓPTIMA (Por Lado):</label>
                            <div class="plates-row">
                                @foreach(var disco in discosIdeales)
                                {
                                    <div class="plate badge-optimal">@disco.ToString("0.##")</div>
                                }
                            </div>
                        </div>
                    }
                    else if (pesoReal <= pesoBarra)
                    {
                        <div class="alert-bar-only mt-3">
                            Solo la barra bro, calienta bien. 🔥
                        </div>
                    }

                    @if (discosAlternativos.Count > 0)
                    {
                        <div class="plate-suggestion mt-3 alternate-box">
                            <label><i class="fas fa-sync-alt" style="color: var(--theme-primary);"></i> VARIANTE (Sin discos grandes):</label>
                            <div class="plates-row">
                                @foreach(var disco in discosAlternativos)
                                {
                                    <div class="plate badge-alt">@disco.ToString("0.##")</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
</div>
<style>
    /* VARIABLES INYECTADAS Y ESTRUCTURA BASE */
    .main-layout { position: fixed; top:0; left:0; width:100vw; height:100vh; background: var(--theme-bg); display:flex; flex-direction:column; z-index:1; }
    .navbar-container { flex-shrink:0; padding-top: calc(env(safe-area-inset-top) + 10px); padding-bottom:10px; padding-left:20px; padding-right:20px; background: var(--theme-bg); border-bottom:1px solid var(--theme-primary); display:flex; justify-content:space-between; align-items:center; z-index:100; font-family:'Oswald'; color: var(--theme-text); }
    .nav-left { color: var(--theme-primary); font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
    .nav-title { font-weight: bold; font-size: 1.1rem; color: var(--theme-text); letter-spacing: 1px; display: flex; align-items: center; }
    .scroll-custom { flex:1; overflow-y:auto; padding: 20px; -webkit-overflow-scrolling: touch; }

    /* TARJETA PRINCIPAL */
    .calc-card { background: var(--theme-card); border: 1px solid var(--theme-border); border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }

    /* SWITCH CUSTOM */
    .unit-switch-container { display: flex; justify-content: center; align-items: center; gap: 15px; margin-bottom: 10px; font-family: 'Oswald'; font-size: 1.2rem; color: var(--theme-text-muted); }
    .unit-switch-container span { transition: 0.3s; cursor: pointer; }
    .unit-switch-container span.active { color: var(--theme-primary); font-weight: bold; text-shadow: 0 0 10px var(--theme-primary); }
    .switch-track { width: 60px; height: 30px; background: var(--theme-bg); border-radius: 50px; position: relative; cursor: pointer; border: 1px solid var(--theme-border); }
    .switch-thumb { width: 24px; height: 24px; background: var(--theme-primary); border-radius: 50%; position: absolute; top: 2px; transition: 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55); box-shadow: 0 0 10px var(--theme-primary); }
    .switch-thumb.left { left: 3px; }
    .switch-thumb.right { left: 31px; }

    /* INPUTS */
    .inputs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    .input-box { display: flex; flex-direction: column; gap: 5px; }
    .input-box label { font-family: 'Roboto'; font-size: 0.75rem; color: var(--theme-text-muted); font-weight: bold; letter-spacing: 1px; }
    .input-wrapper { position: relative; width: 100%; }
    .input-wrapper input { width: 100%; background: var(--theme-bg); border: 1px solid var(--theme-border); color: var(--theme-text); font-family: 'Oswald'; font-size: 1.5rem; padding: 10px 40px 10px 15px; border-radius: 10px; text-align: center; }
    .input-wrapper input:focus { border-color: var(--theme-primary); outline: none; }
    .unit-label { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: var(--theme-text-muted); font-family: 'Oswald'; font-size: 0.9rem; }

    /* SELECT NATIVO (RULETA MÓVIL) */
    .select-wrapper { position: relative; width: 100%; }
    .select-wrapper select { width: 100%; background: var(--theme-bg); border: 1px solid var(--theme-border); color: var(--theme-primary); font-family: 'Oswald'; font-size: 1.1rem; padding: 15px; border-radius: 10px; appearance: none; -webkit-appearance: none; cursor: pointer; }
    .select-wrapper select:focus { border-color: var(--theme-primary); outline: none; }
    .select-icon { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: var(--theme-text-muted); pointer-events: none; }

    /* BOTÓN */
    .btn-calcular { width: 100%; background: var(--theme-primary); color: var(--theme-bg); border: none; padding: 15px; border-radius: 12px; font-family: 'Oswald'; font-weight: bold; font-size: 1.2rem; cursor: pointer; transition: 0.2s; box-shadow: 0 5px 15px rgba(0,0,0,0.3); }
    .btn-calcular:active { transform: scale(0.97); }

    /* RESULTADOS */
    .results-section { background: var(--theme-bg); border: 1px dashed var(--theme-border); border-radius: 15px; padding: 20px; }
    .total-weight-box { text-align: center; border-bottom: 1px solid var(--theme-border); padding-bottom: 15px; }
    .total-weight-box h3 { font-family: 'Roboto'; font-size: 0.8rem; color: var(--theme-text-muted); margin: 0; letter-spacing: 2px; }
    .big-number { font-family: 'Oswald'; font-size: 3.5rem; color: var(--theme-text); font-weight: 900; line-height: 1.1; text-shadow: 0 5px 15px rgba(0,0,0,0.5); }
    .big-number small { font-size: 1.5rem; color: var(--theme-primary); }
    .target-info { font-family: 'Roboto'; font-size: 0.8rem; color: var(--theme-text-muted); margin: 0; font-style: italic; }

    /* DISCOS (PLATES) */
    .plate-suggestion label { font-family: 'Roboto'; font-size: 0.8rem; color: var(--theme-text-muted); margin-bottom: 8px; display: block; font-weight: bold; }
    .plates-row { display: flex; flex-wrap: wrap; gap: 8px; }
    .plate { display: flex; justify-content: center; align-items: center; width: 45px; height: 45px; border-radius: 50%; font-family: 'Oswald'; font-weight: bold; font-size: 1rem; box-shadow: inset 0 0 10px rgba(0,0,0,0.5), 0 4px 6px rgba(0,0,0,0.3); }
    
    /* El badge verde lo mantenemos porque significa "Correcto/Óptimo" independientemente del tema */
    .badge-optimal { background: var(--theme-bg); color: var(--theme-text); border: 2px solid #28a745; }
    
    .badge-alt { background: var(--theme-card); color: var(--theme-text-muted); border: 2px solid var(--theme-primary); }

    .alternate-box { background: var(--theme-card); padding: 15px; border-radius: 10px; border: 1px dashed var(--theme-primary); }
    .alert-bar-only { background: rgba(255,255,255,0.05); color: var(--theme-text); text-align: center; padding: 15px; border-radius: 10px; font-style: italic; font-family: 'Roboto'; }

    .fade-in { animation: fadeIn 0.4s ease; }
    .slide-in-up { animation: slideInUp 0.4s ease; }
    @@keyframes fadeIn { from { opacity:0; } to { opacity:1; } }
    @@keyframes slideInUp { from { opacity:0; transform: translateY(30px); } to { opacity:1; transform: translateY(0); } }
</style>

@code {
    // --- ESTADO INICIAL NEUTRAL (PLATA MATE) ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    private bool esLibras = true;
    private decimal? peso1RM;
    private decimal? porcentaje;
    private decimal pesoBarra = 45;
    
    private bool calculoRealizado = false;
    private decimal pesoObjetivo = 0;
    private decimal pesoReal = 0; 
    
    private List<decimal> discosIdeales = new();
    private List<decimal> discosAlternativos = new();

    private readonly decimal[] discosLbs = { 45m, 35m, 25m, 15m, 10m, 5m, 2.5m };
    private readonly decimal[] discosKgs = { 25m, 20m, 15m, 10m, 5m, 2.5m, 1.25m };

    protected override async Task OnInitializedAsync()
    {
        // LEER EL CACHÉ LOCAL AL INSTANTE
        try 
        {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) 
            { 
                EstilosTema = cache; 
                StateHasChanged(); 
            }
        } 
        catch { }
    }

    private void ToggleUnidad() => CambiarUnidad(!esLibras);

    private void CambiarUnidad(bool aLibras)
    {
        if (esLibras == aLibras) return;
        esLibras = aLibras;
        pesoBarra = esLibras ? 45m : 20m; 
        calculoRealizado = false;
    }

    private void Calcular()
    {
        if (!peso1RM.HasValue || !porcentaje.HasValue || peso1RM <= 0 || porcentaje <= 0) return;

        pesoObjetivo = (peso1RM.Value * porcentaje.Value) / 100m;
        
        var discosDisponibles = esLibras ? discosLbs : discosKgs;
        decimal saltoMinimo = discosDisponibles.Last() * 2; 

        if (pesoObjetivo <= pesoBarra)
        {
            pesoReal = pesoBarra;
            discosIdeales.Clear();
            discosAlternativos.Clear();
            calculoRealizado = true;
            return;
        }

        decimal pesoFaltante = pesoObjetivo - pesoBarra;
        decimal faltanteRedondeado = Math.Round(pesoFaltante / saltoMinimo) * saltoMinimo;
        
        pesoReal = pesoBarra + faltanteRedondeado;
        decimal targetPorLado = faltanteRedondeado / 2m;

        discosIdeales = ObtenerCombinacion(targetPorLado, discosDisponibles);

        discosAlternativos.Clear();
        if (discosIdeales.Count > 0)
        {
            var discoMayorUsado = discosIdeales.First();
            var discosSinElMayor = discosDisponibles.Where(d => d < discoMayorUsado).ToArray();
            
            if (discosSinElMayor.Length > 0)
            {
                discosAlternativos = ObtenerCombinacion(targetPorLado, discosSinElMayor);
                
                if (discosAlternativos.SequenceEqual(discosIdeales))
                {
                    discosAlternativos.Clear();
                }
            }
        }

        calculoRealizado = true;
    }

    private List<decimal> ObtenerCombinacion(decimal objetivo, decimal[] discos)
    {
        var combinacion = new List<decimal>();
        decimal restante = objetivo;

        foreach (var disco in discos)
        {
            while (restante >= disco)
            {
                combinacion.Add(disco);
                restante -= disco;
            }
        }
        return combinacion;
    }
}