@page "/recuperar-password"
@inject NavigationManager Nav
@inject HttpClient Http
@using System.Net.Http.Json

<div class="auth-layout">
    <div class="auth-card fade-in">
        
        <button class="btn-back" @onclick="Volver">
            <i class="fas fa-arrow-left"></i> VOLVER AL LOGIN
        </button>

        <div class="text-center mb-4">
            <i class="fas fa-shield-alt auth-icon"></i>
            <h2 class="auth-title">RECUPERAR ACCESO</h2>
            <p class="auth-subtitle">
                @(pasoActual == 1 ? "Ingresa tu correo para recibir un código de seguridad." : "Ingresa el código que te enviamos y tu nueva contraseña.")
            </p>
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger custom-alert bounce-in">
                <i class="fas fa-exclamation-circle"></i> @mensajeError
            </div>
        }

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert alert-success custom-alert bounce-in">
                <i class="fas fa-check-circle"></i> @mensajeExito
            </div>
        }

        @if (pasoActual == 1)
        {
            @* --- PASO 1: SOLICITAR CORREO --- *@
            <div class="input-group-modern">
                <i class="fas fa-envelope input-icon"></i>
                <input type="email" @bind="emailInput" class="form-control auth-input" placeholder="Correo Electrónico" />
            </div>

            <button class="btn-auth mt-4" @onclick="SolicitarCodigo" disabled="@cargando">
                @if (cargando) { <i class="fas fa-spinner fa-spin"></i> } else { <span>ENVIAR CÓDIGO</span> }
            </button>
        }
        else
        {
            @* --- PASO 2: INGRESAR CÓDIGO Y NUEVA CLAVE --- *@
            <div class="input-group-modern mb-3">
                <i class="fas fa-key input-icon" style="color: #F8C545;"></i>
                <input type="text" @bind="codigoInput" class="form-control auth-input" placeholder="Código de 6 dígitos" maxlength="6" style="letter-spacing: 5px; font-size: 1.2rem; text-align: center; font-weight: bold;" />
            </div>

            <div class="input-group-modern mb-3">
                <i class="fas fa-lock input-icon"></i>
                <input type="password" @bind="nuevaPassword" class="form-control auth-input" placeholder="Nueva Contraseña" />
            </div>

            <div class="input-group-modern mb-3">
                <i class="fas fa-check-double input-icon"></i>
                <input type="password" @bind="confirmarPassword" class="form-control auth-input" placeholder="Confirmar Contraseña" />
            </div>

            <button class="btn-auth mt-4" @onclick="ValidarYCambiar" disabled="@cargando">
                @if (cargando) { <i class="fas fa-spinner fa-spin"></i> } else { <span>RESTABLECER</span> }
            </button>
        }
    </div>
</div>

<style>
    .auth-layout {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: #121212;
        display: flex;
        flex-direction: column; /* Cambio clave para permitir el flujo */
        overflow-y: auto; /* Habilita el scroll mágico */
        -webkit-overflow-scrolling: touch; /* Scroll suave en iOS */
        padding: 20px;
    }

    .auth-card {
        background: rgba(35, 35, 35, 0.5);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        width: 100%;
        max-width: 400px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        padding: 30px 25px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.8);
        position: relative;
        margin: auto; /* Centra la tarjeta dinámicamente sin romper el scroll */
    }
    
    .btn-back { position: absolute; top: 15px; left: 15px; background: transparent; border: none; color: #888; font-family: 'Oswald'; font-size: 1rem; cursor: pointer; transition: 0.2s; }
    .btn-back:active { color: white; transform: scale(0.95); }

    .auth-icon { font-size: 3rem; color: #A9A9A9; margin-bottom: 10px; margin-top: 15px; }
    .auth-title { font-family: 'Oswald'; color: white; font-weight: bold; letter-spacing: 1px; margin: 0; }
    .auth-subtitle { font-family: 'Roboto'; color: #888; font-size: 0.85rem; margin-top: 5px; }

    .input-group-modern { position: relative; display: flex; align-items: center; }
    .input-icon { position: absolute; left: 20px; color: #A9A9A9; z-index: 10; }
    .auth-input { width: 100%; background: rgba(0,0,0,0.4) !important; border: 1px solid #555 !important; color: white !important; border-radius: 50px !important; padding: 15px 15px 15px 50px; font-family: 'Roboto'; transition: all 0.3s; }
    .auth-input:focus { border-color: #A9A9A9 !important; box-shadow: 0 0 15px rgba(169, 169, 169, 0.3) !important; outline: none; }
    .auth-input::placeholder { color: #555 !important; }

    .btn-auth { width: 100%; background: linear-gradient(90deg, #E0E0E0, #A9A9A9); color: black; border: none; padding: 15px; font-family: 'Oswald'; font-weight: 900; font-size: 1.1rem; border-radius: 50px; cursor: pointer; transition: 0.2s; box-shadow: 0 0 20px rgba(169, 169, 169, 0.4); }
    .btn-auth:active { transform: scale(0.95); box-shadow: none; }
    .btn-auth:disabled { background: #555; color: #888; cursor: not-allowed; box-shadow: none; }

    .custom-alert { font-size: 0.85rem; font-family: 'Roboto'; font-weight: bold; border: none; border-radius: 8px; padding: 10px; text-align: left; }
    .alert-danger { background: rgba(220, 53, 69, 0.2); color: #ff6b6b; border: 1px solid #ff6b6b; }
    .alert-success { background: rgba(40, 167, 69, 0.2); color: #28a745; border: 1px solid #28a745; }

    .fade-in { animation: fadeIn 0.4s ease; }
    .bounce-in { animation: bounceIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes bounceIn { 0% { transform: scale(0.8); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
</style>

@code {
    private int pasoActual = 1;
    private bool cargando = false;
    private string mensajeError = "";
    private string mensajeExito = "";

    // Inputs
    private string emailInput = "";
    private string codigoInput = "";
    private string nuevaPassword = "";
    private string confirmarPassword = "";

    private async Task SolicitarCodigo()
    {
        if (string.IsNullOrWhiteSpace(emailInput) || !emailInput.Contains("@"))
        {
            mensajeError = "Ingresa un correo válido.";
            return;
        }

        cargando = true;
        mensajeError = "";
        mensajeExito = "";

        try
        {
            var req = new { Email = emailInput.Trim() };
            var response = await Http.PostAsJsonAsync("https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/authapi/solicitar-recuperacion", req);

            if (response.IsSuccessStatusCode)
            {
                pasoActual = 2; // Cambiamos la vista a la de ingresar código
                mensajeExito = "Código enviado. Revisa tu bandeja de entrada o SPAM.";
            }
            else
            {
                mensajeError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error de conexión: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ValidarYCambiar()
    {
        if (string.IsNullOrWhiteSpace(codigoInput) || codigoInput.Length != 6)
        {
            mensajeError = "El código debe tener 6 dígitos."; return;
        }
        if (string.IsNullOrWhiteSpace(nuevaPassword) || nuevaPassword != confirmarPassword)
        {
            mensajeError = "Las contraseñas no coinciden o están vacías."; return;
        }

        cargando = true;
        mensajeError = "";

        try
        {
            var req = new { 
                Email = emailInput.Trim(), 
                Codigo = codigoInput.Trim(),
                NuevaPassword = nuevaPassword,
                ConfirmarPassword = confirmarPassword
            };

            var response = await Http.PostAsJsonAsync("https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/authapi/validar-y-cambiar", req);

            if (response.IsSuccessStatusCode)
            {
                await App.Current.MainPage.DisplayAlert("¡Éxito!", "Tu contraseña ha sido actualizada. Ya puedes iniciar sesión.", "OK");
                Nav.NavigateTo("/");
            }
            else
            {
                mensajeError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error de conexión: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/");
    }
}