</style>

@code {
   private string EstilosTema = @"--theme-primary: #A9A9A9; --theme-secondary: #808080; --theme-bg: #0d0d0d; --theme-card: #1a1a1a; --theme-border: #333333; --theme-text: #ffffff; --theme-text-muted: #888888;";

   private bool cargandoConfiguracion = true;
    private bool? tienePlanGlobal = null;

    private DateTime fechaActual = DateTime.Today;
    private List<RunningLogs> logsDelMes = new List<RunningLogs>();
    private int diasEnMes;
    private int diasVaciosInicio;

    // Lógica del Día de Hoy
    private RunningLogs logDeHoy;

    // Modal Normal (Feedback)
    private bool mostrarModal = false;
    private bool guardando = false;
    private bool mostrarExitoAnimacion = false; 
    private RunningLogs logSeleccionado;
    private DateTime fechaSeleccionada;

    private List<FileResult> archivosEvidencia = new();
    private List<string> previewsEvidencia = new();

    // ==========================================
    // VARIABLES DEL CREADOR DE HISTORIAS (IA)
    // ==========================================
    private bool mostrarModalHistoria = false;
    private bool generandoHistoria = false;
    private string historiaGeneradaBase64 = null;
    
    // Foto 1: Mapa Strava
    private FileResult mapaHistoria = null;
    private string previewMapaHistoria = null;
    
    // Foto 2: Selfie / Atleta
    private FileResult fotoAtleta = null;
    private string previewFotoAtleta = null;

    private bool incluirTituloHistoria = true;
    private bool incluirDescHistoria = true;
    private string tituloHistoria = "";
    private string descripcionHistoria = "";

    public class RunningLogs
    {
        public Guid RunningLogID { get; set; }
        public Guid UsuarioID { get; set; }
        public DateTime Fecha { get; set; }
        public string Titulo { get; set; }
        public string Descripcion { get; set; }
        public string Tipo { get; set; }
        public bool? Realizado { get; set; }
        public int? RPE { get; set; }
        public string ComentariosAtleta { get; set; }
        public string EvidenciaUrl { get; set; } 
    }

    public class ImagenRespuesta { public string imagenUrl { get; set; } }

    class TipoEntreno { public string Nombre { get; set; } public string Color { get; set; } }

    private List<TipoEntreno> TiposEntreno = new List<TipoEntreno>
    {
        new TipoEntreno { Nombre = "Acumulativo", Color = "#00BFFF" },
        new TipoEntreno { Nombre = "Intensidad", Color = "#FF4500" },
        new TipoEntreno { Nombre = "Tempo", Color = "#FF8C00" },
        new TipoEntreno { Nombre = "Cuestas", Color = "#9370DB" },
        new TipoEntreno { Nombre = "Fuerza", Color = "#808080" },
        new TipoEntreno { Nombre = "Regenerativo", Color = "#32CD32" },
        new TipoEntreno { Nombre = "Otro", Color = "#FFFFFF" }
    };

protected override async Task OnInitializedAsync()
    {
        try { var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box"); if (!string.IsNullOrEmpty(cache)) { EstilosTema = cache; StateHasChanged(); } } catch { }
        if (Sesion.Usuario == null) { Nav.NavigateTo("/"); return; }

        try 
        { 
            tienePlanGlobal = await Http.GetFromJsonAsync<bool>($"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/runningapi/tiene-plan/{Sesion.Usuario.UsuarioID}"); 
        } 
        catch { tienePlanGlobal = false; }

        if (tienePlanGlobal == true)
        {
            await CargarCalendario();
        }
        
        cargandoConfiguracion = false;
    }

    private async Task CargarCalendario()
    {
        if (Sesion.Usuario == null) return;

        diasEnMes = DateTime.DaysInMonth(fechaActual.Year, fechaActual.Month);
        var primerDiaMes = new DateTime(fechaActual.Year, fechaActual.Month, 1);
        diasVaciosInicio = (int)primerDiaMes.DayOfWeek;

        try
        {
            logsDelMes = await Http.GetFromJsonAsync<List<RunningLogs>>($"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/runningapi/plan/{Sesion.Usuario.UsuarioID}/{fechaActual.Month}/{fechaActual.Year}");
            
            // Calculamos el log de hoy para saber si mostrar la tarjeta de Historia
            logDeHoy = logsDelMes.FirstOrDefault(l => l.Fecha.Date == DateTime.Today.Date);
        }
        catch { logsDelMes = new List<RunningLogs>(); }
    }

    private RunningLogs ObtenerLog(int dia) => logsDelMes.FirstOrDefault(l => l.Fecha.Day == dia);

    private string ObtenerColorTipo(string tipo)
    {
        var t = TiposEntreno.FirstOrDefault(x => x.Nombre == tipo);
        return t != null ? t.Color : "var(--theme-primary)";
    }

    private async Task MesAnterior() { fechaActual = fechaActual.AddMonths(-1); await CargarCalendario(); }
    private async Task MesSiguiente() { fechaActual = fechaActual.AddMonths(1); await CargarCalendario(); }

    private void AbrirModal(int dia)
    {
        var log = ObtenerLog(dia);
        if (log != null)
        {
            // CREAMOS UN CLON PARA NO AFECTAR LA UI DE ATRÁS HASTA QUE SE GUARDE
            logSeleccionado = new RunningLogs
            {
                RunningLogID = log.RunningLogID,
                UsuarioID = log.UsuarioID,
                Fecha = log.Fecha,
                Titulo = log.Titulo,
                Descripcion = log.Descripcion,
                Tipo = log.Tipo,
                Realizado = log.Realizado ?? false,
                RPE = log.RPE,
                ComentariosAtleta = log.ComentariosAtleta,
                EvidenciaUrl = log.EvidenciaUrl
            };
            
            fechaSeleccionada = new DateTime(fechaActual.Year, fechaActual.Month, dia);
            
            archivosEvidencia.Clear();
            previewsEvidencia.Clear();
            
            mostrarModal = true;
        }
    }

    private void ToggleRealizado()
    {
        bool estadoActual = logSeleccionado.Realizado ?? false;
        logSeleccionado.Realizado = !estadoActual;
    }

    private void SeleccionarRPE(int valor) => logSeleccionado.RPE = valor;

    private async Task AgregarFotoEvidencia()
    {
        try
        {
            FileResult resultado = null;
            await MainThread.InvokeOnMainThreadAsync(async () =>
            {
                try { resultado = await MediaPicker.Default.PickPhotoAsync(); } catch { }
            });

            if (resultado != null)
            {
                archivosEvidencia.Add(resultado);

                using var stream = await resultado.OpenReadAsync();
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                previewsEvidencia.Add($"data:image/jpeg;base64,{base64}");
                
                StateHasChanged();
            }
        }
        catch { await App.Current.MainPage.DisplayAlert("Aviso", "No se pudo cargar la imagen.", "OK"); }
    }

    private void QuitarFoto(int index)
    {
        archivosEvidencia.RemoveAt(index);
        previewsEvidencia.RemoveAt(index);
    }

    private async Task GuardarFeedback()
    {
        if (logSeleccionado.Realizado == true && archivosEvidencia.Count == 0 && string.IsNullOrEmpty(logSeleccionado.EvidenciaUrl))
        {
            await App.Current.MainPage.DisplayAlert("Evidencia Requerida", "Debes subir al menos una foto de tus parciales para guardar el reporte.", "ENTENDIDO");
            return;
        }

        guardando = true;
        StateHasChanged();

        try
        {
            using var form = new MultipartFormDataContent();
            form.Add(new StringContent(logSeleccionado.RunningLogID.ToString()), "RunningLogID");
            form.Add(new StringContent((logSeleccionado.Realizado ?? false).ToString().ToLower()), "Realizado");
            form.Add(new StringContent((logSeleccionado.RPE ?? 0).ToString()), "RPE");
            form.Add(new StringContent(logSeleccionado.ComentariosAtleta ?? ""), "ComentariosAtleta");

            foreach (var archivo in archivosEvidencia)
            {
                var s = await archivo.OpenReadAsync();
                var content = new StreamContent(s);
                content.Headers.ContentType = new MediaTypeHeaderValue(archivo.ContentType);
                form.Add(content, "fotos", archivo.FileName);
            }

            var resp = await Http.PostAsync("https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/runningapi/guardar-feedback-con-fotos", form);
            
            if (resp.IsSuccessStatusCode)
            {
                mostrarModal = false;
                await CargarCalendario();
                
                // MUESTRA LA ANIMACIÓN EN LUGAR DEL DISPLAY ALERT FEO
                mostrarExitoAnimacion = true;
                StateHasChanged();
                
                await Task.Delay(1800); // Lo dejamos visible por casi 2 segundos
                
                mostrarExitoAnimacion = false;
                StateHasChanged();
            }
            else
            {
                await App.Current.MainPage.DisplayAlert("Error", "No se pudo guardar la evidencia.", "OK");
            }
        }
        catch (Exception ex) 
        { 
            await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK"); 
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private string ObtenerColorRPE(int valor)
    {
        if (valor <= 2) return "#32CD32"; 
        if (valor <= 4) return "#ADFF2F"; 
        if (valor <= 6) return "#FFD700"; 
        if (valor <= 8) return "#FF8C00"; 
        return "#FF0000";                  
    }

    private void CerrarModal() => mostrarModal = false;
    private void Volver() => Nav.NavigateTo("/home");

    // =========================================================================
    // MÉTODOS DEL CREADOR DE HISTORIAS EXTREMO (IA)
    // =========================================================================

    private void AbrirModalHistoria()
    {
        mapaHistoria = null;
        previewMapaHistoria = null;
        fotoAtleta = null;
        previewFotoAtleta = null;
        historiaGeneradaBase64 = null;
        incluirTituloHistoria = true;
        incluirDescHistoria = true;
        
        // --- CARGAMOS LOS DATOS ORIGINALES PARA QUE PUEDAN EDITARLOS ---
        tituloHistoria = logDeHoy?.Titulo ?? "";
        descripcionHistoria = logDeHoy?.Descripcion ?? ""; 
        
        mostrarModalHistoria = true;
    }

    private void CerrarModalHistoria()
    {
        mostrarModalHistoria = false;
    }

    private async Task SeleccionarMapaHistoria()
    {
        try
        {
            FileResult resultado = null;
            await MainThread.InvokeOnMainThreadAsync(async () =>
            {
                try { resultado = await MediaPicker.Default.PickPhotoAsync(); } catch { }
            });

            if (resultado != null)
            {
                mapaHistoria = resultado;
                using var stream = await resultado.OpenReadAsync();
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                previewMapaHistoria = $"data:image/jpeg;base64,{base64}";
                StateHasChanged();
            }
        }
        catch { await App.Current.MainPage.DisplayAlert("Aviso", "No se pudo cargar el mapa.", "OK"); }
    }

    private async Task SeleccionarFotoAtleta()
    {
        try
        {
            FileResult resultado = null;
            await MainThread.InvokeOnMainThreadAsync(async () =>
            {
                try { resultado = await MediaPicker.Default.PickPhotoAsync(); } catch { }
            });

            if (resultado != null)
            {
                fotoAtleta = resultado;
                using var stream = await resultado.OpenReadAsync();
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                previewFotoAtleta = $"data:image/jpeg;base64,{base64}";
                StateHasChanged();
            }
        }
        catch { await App.Current.MainPage.DisplayAlert("Aviso", "No se pudo cargar tu foto.", "OK"); }
    }

    private async Task GenerarHistoriaApi()
    {
        if (mapaHistoria == null || fotoAtleta == null || logDeHoy == null) return;

        generandoHistoria = true;
        StateHasChanged();

        try
        {
            using var form = new MultipartFormDataContent();
            form.Add(new StringContent(Sesion.Usuario.UsuarioID.ToString()), "UsuarioId");
            form.Add(new StringContent(DateTime.Today.ToString("dd MMMM yyyy").ToUpper()), "Fecha");
            form.Add(new StringContent((logDeHoy.RPE ?? 0).ToString()), "RPE");
            
            // --- AQUÍ MANDAMOS LO QUE EL USUARIO ESCRIBIÓ ---
            string tituloFinal = incluirTituloHistoria ? (string.IsNullOrWhiteSpace(tituloHistoria) ? " " : tituloHistoria) : " ";
            string descFinal = incluirDescHistoria ? (string.IsNullOrWhiteSpace(descripcionHistoria) ? " " : descripcionHistoria) : " ";
            string rpeString = string.IsNullOrWhiteSpace(logDeHoy.RPE.ToString()) ? "0" : logDeHoy.RPE.ToString();

            form.Add(new StringContent(tituloFinal), "Titulo");
            form.Add(new StringContent(descFinal), "Descripcion"); 
            form.Add(new StringContent(rpeString), "RPE"); 

            var sMap = await mapaHistoria.OpenReadAsync();
            var contentMap = new StreamContent(sMap);
            contentMap.Headers.ContentType = new MediaTypeHeaderValue(mapaHistoria.ContentType);
            form.Add(contentMap, "mapaImagen", mapaHistoria.FileName);

            var sFoto = await fotoAtleta.OpenReadAsync();
            var contentFoto = new StreamContent(sFoto);
            contentFoto.Headers.ContentType = new MediaTypeHeaderValue(fotoAtleta.ContentType);
            form.Add(contentFoto, "fotoAtleta", fotoAtleta.FileName);

            var resp = await Http.PostAsync("https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/runningapi/generar-historia-extrema", form);
            
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<ImagenRespuesta>();
                historiaGeneradaBase64 = result.imagenUrl;
            }
            else
            {
                var error = await resp.Content.ReadAsStringAsync();
                await App.Current.MainPage.DisplayAlert("Error", "La IA no pudo procesar la imagen: " + error, "OK");
            }
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK");
        }
        finally
        {
            generandoHistoria = false;
            StateHasChanged();
        }
    }

    private async Task CompartirHistoria()
    {
        try
        {
            if (string.IsNullOrEmpty(historiaGeneradaBase64)) return;

            var base64Data = historiaGeneradaBase64.Substring(historiaGeneradaBase64.IndexOf(",") + 1);
            var imageBytes = Convert.FromBase64String(base64Data);
            
            var cacheFile = Path.Combine(FileSystem.CacheDirectory, "historia_ia.jpg");
            File.WriteAllBytes(cacheFile, imageBytes);

            await Share.Default.RequestAsync(new ShareFileRequest
            {
                Title = "Mi Entrenamiento IA",
                File = new ShareFile(cacheFile)
            });
        }
        catch { await App.Current.MainPage.DisplayAlert("Error", "No se pudo abrir el menú de compartir.", "OK"); }
    }
}