    private string ObtenerClaseMedalla(int semanas)
    {
        if (semanas >= 32) return "badge-elite";
        if (semanas >= 20) return "badge-pro";
        if (semanas >= 12) return "badge-avanzado";
        if (semanas >= 4) return "badge-intermedio";
        return "badge-novato";
    }

