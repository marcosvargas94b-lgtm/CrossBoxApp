    private void TogglePR(FichaPRDto pr)
    {
        if (pr.Seleccionado) pr.Seleccionado = false;
        else
        {
            if (ficha.PRs.Count(p => p.Seleccionado) < 6) pr.Seleccionado = true;
            else App.Current.MainPage.DisplayAlert("Límite", "Solo puedes mostrar 6 récords en tu tarjeta.", "OK");
        }
    }

    private async Task GuardarPRs()
    {
        guardandoPRs = true;
        try
        {
            var seleccionados = ficha.PRs.Where(p => p.Seleccionado).Select(p => p.Ejercicio).ToList();
            var payload = new { UsuarioId = Sesion.Usuario.UsuarioID, Ejercicios = seleccionados };
            var response = await Http.PostAsJsonAsync("https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/fichaapi/guardar-prs", payload);
            if (response.IsSuccessStatusCode) mostrarModalPRs = false;
        }
        catch (Exception ex) { await App.Current.MainPage.DisplayAlert("Error", ex.Message, "OK"); }
        finally { guardandoPRs = false; }
    }

