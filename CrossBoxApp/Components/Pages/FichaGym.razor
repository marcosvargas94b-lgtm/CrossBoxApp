@code {
    // --- ESTADO INICIAL NEUTRAL (PLATA MATE) ---
    private string EstilosTema = @"
        --theme-primary: #A9A9A9; 
        --theme-secondary: #808080;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    [Parameter] public Guid? TargetUserId { get; set; }
    private bool EsMiFicha => !TargetUserId.HasValue || TargetUserId.Value == Sesion.Usuario.UsuarioID;
    private bool cargando = true;
    private bool solicitandoFoto = false;
    private FichaAtletaDto ficha;
    private bool boxTieneMedallas = false;
    // --- VARIABLES DE MODALES ---
    private bool mostrarModalSubtitulos = false;
    private string tabActiva = "Comedia";
    private List<SubtituloDto> listaSubtitulos = new();

    private bool mostrarModalColores = false;
    private bool guardandoColores = false;
    private bool subiendoFondo = false;
    private bool mostrarModalInfo = false;

    private bool mostrarModalPRs = false;
    private bool guardandoPRs = false;

    // --- DTOs ---
    public class FichaAtletaDto
    {
        public string Nombre { get; set; }
        public string Apellidos { get; set; }
        public string FotoUrl { get; set; }
        public string BoxNombre { get; set; }
        public string LogoBoxUrl { get; set; }
        public int DiasEntrenadosAnio { get; set; }
        public int SemanasRunning { get; set; }
        public string Subtitulo { get; set; }
        public string ColorPrimario { get; set; }
        public string ColorTexto { get; set; }
        public string ColorNumeros { get; set; }
        public string ColorFondo1 { get; set; }
        public string ColorFondo2 { get; set; }
        public int SemanasGym { get; set; }
        public string Textura { get; set; }
        public string FiltroFoto { get; set; }
        public string FiltroFondo { get; set; }
        public double OpacidadFondo { get; set; }
        public string FondoCustomUrl { get; set; }
        public string ColorDetalles { get; set; }
        public double OpacidadMedallas { get; set; }
        public List<FichaPRDto> PRs { get; set; } = new();
    }

    public class FichaPRDto { public string Ejercicio { get; set; } public string Marca { get; set; } public string Unidad { get; set; } public bool Seleccionado { get; set; } }
    public class SubtituloDto { public int SubtituloID { get; set; } public string Texto { get; set; } public string Categoria { get; set; } }
    public class RespuestaFondoDto { public string url { get; set; } }
    private bool mostrarMenuConfig = false;

    private void ToggleMenuConfig()
    {
        mostrarMenuConfig = !mostrarMenuConfig;
    }

    protected override async Task OnInitializedAsync()
    {
        // LEER EL CACHÉ LOCAL AL INSTANTE
        try 
        {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) 
            { 
                EstilosTema = cache; 
                StateHasChanged(); 
            }
        } 
        catch { }

        if (Sesion.Usuario == null) { Nav.NavigateTo("/"); return; }

        try
        {
            boxTieneMedallas = await Http.GetFromJsonAsync<bool>($"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/medallasapi/tiene-medallas/{Sesion.Usuario.BoxID}");
        }
        catch { boxTieneMedallas = false; }

        try
        {
            Guid idConsulta = TargetUserId ?? Sesion.Usuario.UsuarioID;

            var url = $"https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/api/fichaapi/gym/{idConsulta}";
            ficha = await Http.GetFromJsonAsync<FichaAtletaDto>(url);

            // ==============================================================
            // CORRECCIÓN DE LA FOTO DE PERFIL (Igual a ficha-atleta y mi-perfil)
            // ==============================================================
            string baseUrlPerfiles = "https://api-aftrack-linux-dkawb7h7f9dxeff7.canadacentral-01.azurewebsites.net/imagenes/perfiles/";
            
            // if (!string.IsNullOrWhiteSpace(ficha?.FotoUrl))
            // {
            //     // Validamos si ya trae HTTP o si solo es el nombre del archivo
            //     string urlReal = ficha.FotoUrl.StartsWith("http") 
            //         ? ficha.FotoUrl 
            //         : baseUrlPerfiles + ficha.FotoUrl;
                    
            //     ficha.FotoUrl = $"{urlReal}?t={DateTime.Now.Ticks}";
            // }
            // // ==============================================================

            if (string.IsNullOrEmpty(ficha.ColorDetalles)) ficha.ColorDetalles = "#aaaaaa";
            if (string.IsNullOrEmpty(ficha.ColorTexto)) ficha.ColorTexto = "#FFFFFF";
            if (string.IsNullOrEmpty(ficha.ColorNumeros)) ficha.ColorNumeros = "#FFFFFF";
            if (string.IsNullOrEmpty(ficha.Textura)) ficha.Textura = "";
            if (string.IsNullOrEmpty(ficha.FiltroFoto)) ficha.FiltroFoto = "none";
            if (string.IsNullOrEmpty(ficha.FiltroFondo)) ficha.FiltroFondo = "none";
            if (ficha.OpacidadFondo <= 0) ficha.OpacidadFondo = 1.0;
        }
        catch { }
        finally { cargando = false; }
    }

    private void IrALogros()
    {
        Guid idNavegar = TargetUserId ?? Sesion.Usuario.UsuarioID;
        if (idNavegar == Sesion.Usuario.UsuarioID)
        {
            Nav.NavigateTo("/logrodesbloqueado");
        }
        else
        {
            Nav.NavigateTo($"/logrodesbloqueado/{idNavegar}");
        }
    }

