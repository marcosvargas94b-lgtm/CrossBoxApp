    private void AjustarTiempo(int segs)
    {
        if (timerCorriendo) return;
        segundosDescansoDefecto += segs;
        if (segundosDescansoDefecto < 10) segundosDescansoDefecto = 10;
        if (segundosDescansoDefecto > 600) segundosDescansoDefecto = 600;
    }

    private async Task ToggleCompletado(BloqueGymDto bloque)
    {
        bloque.Completado = !bloque.Completado;
        StateHasChanged();

        try
        {
            if (bloque.BloqueID.HasValue)
            {
                string url = $"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/rutinasgym/toggle-bloque/{bloque.BloqueID.Value}?completado={bloque.Completado}";
                await Http.PostAsync(url, null);
            }
        }
        catch { }
    }

    private async Task TerminarRutina()
    {
        guardando = true;
        try
        {
            string url = $"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/rutinasgym/terminar-dia/{RutinaDiaId}";
            var res = await Http.PostAsync(url, null);
            if (res.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/rutina-semanal");
            }
