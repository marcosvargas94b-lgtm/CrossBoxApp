        {
            string url = $"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/rutinasgym/pausar-dia/{RutinaDiaId}";
            await Http.PostAsync(url, null);
        }
        catch { }
        Nav.NavigateTo("/rutina-semanal");
    }

