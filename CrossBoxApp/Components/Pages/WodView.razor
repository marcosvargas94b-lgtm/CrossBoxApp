@page "/wod-view"
@using CrossBoxApp.Models
@using CrossBoxApp.Models.Services
@inject NavigationManager Nav
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS

<div style="@EstilosTema">
    <div class="main-layout">
        <div class="navbar-container">
            <div class="nav-left" @onclick="Volver">
                <i class="fas fa-arrow-left"></i> VOLVER
            </div>
            <div class="nav-title">WOD DEL DÍA</div>
            <div class="nav-right"></div>
        </div>

        <div class="scrollable-content">
            @* --- NAVEGACIÓN DE FECHAS (ESTILO PREMIUM) --- *@
            <div class="date-navigator fade-in">
                <button class="btn-date-nav" @onclick='() => CambiarFecha(-1)'>
                    <i class="fas fa-chevron-left"></i>
                </button>
                <div class="date-display">
                    <h2 class="date-header">@fechaSeleccionada.ToString("dddd, dd MMMM").ToUpper()</h2>
                </div>
                <button class="btn-date-nav" @onclick='() => CambiarFecha(1)'>
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>

            @if (cargando)
            {
                <div class="loading-state">
                    <div class="spinner-border" style="color: var(--theme-primary);" role="status"></div>
                    <p style="color: var(--theme-text-muted); margin-top: 10px; font-family:'Oswald';">CARGANDO...</p>
                </div>
            }
            else if (wodData == null || wodData.Segmentos.Count == 0)
            {
                <div class="empty-state fade-in">
                    <i class="fas fa-bed" style="opacity: 0.3; font-size: 3rem; margin-bottom: 15px; color: var(--theme-text-muted);"></i>
                    <h3 style="color: var(--theme-text-muted); font-family:'Oswald';">DÍA DE DESCANSO</h3>
                    <p style="color: var(--theme-text-muted);">No hay programación para esta fecha.</p>
                </div>
            }
            else
            {
                <div class="wod-segments fade-in">
                    @foreach (var segmento in wodData.Segmentos)
                    {
                        <div class="segment-card">
                            <div class="segment-header">@segmento.Titulo.ToUpper()</div>
                            
                            @if (segmento.EsTextoLibre)
                            {
                                <div class="segment-body-free">
                                    @foreach (var ejercicio in segmento.Ejercicios)
                                    {
                                        <div class="exercise-row-free">
                                            <span class="text-desc">@ejercicio.Descripcion</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="segment-body">
                                    @foreach (var ejercicio in segmento.Ejercicios)
                                    {
                                        <div class="exercise-row-unified">
                                            <span class="text-desc">@ejercicio.Descripcion</span>
                                            @if (!string.IsNullOrEmpty(ejercicio.PesoRepeticiones))
                                            {
                                                <span class="text-reps"> - @ejercicio.PesoRepeticiones</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            <div style="height: 40px;"></div>
        </div>
    </div>
</div>

<style>
    /* Estructura Base unificada con el Home */
    .main-layout { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--theme-bg); display: flex; flex-direction: column; z-index: 1; }
    .navbar-container { flex-shrink: 0; padding-top: calc(env(safe-area-inset-top) + 5px); padding-bottom: 10px; padding-left: 20px; padding-right: 20px; background-color: var(--theme-bg); border-bottom: 1px solid var(--theme-primary); color: var(--theme-text); display: flex; justify-content: space-between; align-items: center; z-index: 100; font-family: 'Oswald'; min-height: 60px; }
    .nav-left { color: var(--theme-primary); font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
    .nav-title { font-weight: bold; font-size: 1.1rem; color: var(--theme-text); letter-spacing: 1px; }
    .nav-right { width: 60px; }
    .scrollable-content { flex-grow: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; -webkit-overflow-scrolling: touch; padding-bottom: 40px; }

    /* Estilos del Navegador de Fechas */
    .date-navigator { display: flex; align-items: center; justify-content: center; gap: 15px; width: 100%; max-width: 500px; margin-bottom: 25px; align-self: center; }
    .btn-date-nav { background: var(--theme-card); border: 1px solid var(--theme-border); color: var(--theme-primary); width: 45px; height: 45px; border-radius: 50%; display: flex; justify-content: center; align-items: center; cursor: pointer; transition: 0.2s; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
    .btn-date-nav:active { transform: scale(0.9); background: var(--theme-primary); color: var(--theme-bg); }
    .date-display { flex: 1; }
    .date-header { font-family: 'Oswald'; font-size: 1.3rem; text-align: center; color: var(--theme-text); margin: 0; letter-spacing: 1px; border-bottom: 1px solid var(--theme-border); padding-bottom: 5px; }

    /* Tarjetas del WOD */
    .wod-segments { width: 100%; max-width: 600px; align-self: center; }
    .segment-card { background-color: var(--theme-card); border: 1px solid var(--theme-border); border-radius: 12px; margin-bottom: 25px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
    .segment-header { background-color: var(--theme-primary); color: var(--theme-bg); font-family: 'Oswald'; font-size: 1.1rem; font-weight: bold; padding: 10px 15px; letter-spacing: 1px; }
    
    /* MODO NORMAL */
    .segment-body { padding: 10px 20px; }
    .exercise-row-unified { padding: 12px 0; border-bottom: 1px solid var(--theme-border); color: var(--theme-text); line-height: 1.4; }
    .exercise-row-unified:last-child { border-bottom: none; }
    .text-reps { font-family: 'Oswald'; color: var(--theme-primary); font-weight: bold; margin-left: 6px; }

    /* MODO TEXTO LIBRE (TIPO BLOC DE NOTAS) */
    .segment-body-free { padding: 15px 20px; background: rgba(0, 0, 0, 0.2); }
    .exercise-row-free { padding: 2px 0; color: var(--theme-text); line-height: 1.5; font-family: 'Roboto', sans-serif;}

    .loading-state, .empty-state { text-align: center; margin-top: 50px; }
    .fade-in { animation: fadeIn 0.5s ease; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    private string EstilosTema = @"
        --theme-primary: #A9A9A9;
        --theme-bg: #0d0d0d;
        --theme-card: #1a1a1a;
        --theme-border: #333333;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    ";

    public class WodDiaDto
    {
        public DateTime Fecha { get; set; }
        public List<SegmentoVisualDto> Segmentos { get; set; } = new List<SegmentoVisualDto>();
    }

    public class SegmentoVisualDto
    {
        public string Titulo { get; set; }
        public bool EsTextoLibre { get; set; } // <--- NUEVO: BANDERA PARA EL CSS
        public List<EjercicioVisualDto> Ejercicios { get; set; } = new List<EjercicioVisualDto>();
    }

    public class EjercicioVisualDto
    {
        public string Descripcion { get; set; }
        public string PesoRepeticiones { get; set; }
    }


    private WodDiaDto wodData;
    private bool cargando = true;
    private DateTime fechaSeleccionada = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        try {
            var cache = await JS.InvokeAsync<string>("localStorage.getItem", "tema_box");
            if (!string.IsNullOrEmpty(cache)) { EstilosTema = cache; StateHasChanged(); }
        } catch { }

        await CargarWod();
    }

   private async Task CargarWod()
    {
        if (Sesion.Usuario == null) { Nav.NavigateTo("/"); return; }
        
        cargando = true;
        wodData = null; // Limpiamos para mostrar el spinner
        StateHasChanged();

        try {
            var boxId = Sesion.Usuario.BoxID;
            var fechaStr = fechaSeleccionada.ToString("yyyy-MM-dd");
            var response = await Http.GetAsync($"https://api-aftrack-mx-fphnazfmahdedtcj.canadacentral-01.azurewebsites.net/api/wodapi/obtener/{boxId}/{fechaStr}");

            if (response.IsSuccessStatusCode) {
                var data = await response.Content.ReadFromJsonAsync<ProgramacionWodViewModel>();
                if (data != null) {
                    wodData = new WodDiaDto {
                        Fecha = data.FechaProgramacion,
                        Segmentos = data.Bloques.Select(b => {
                            // MAGIA: Evaluar si es Texto Libre o Normal
                            var listaEjerciciosVisuales = new List<EjercicioVisualDto>();

                            if (b.EsTextoLibre)
                            {
                                // Si es libre, el primer ejercicio trae todo el párrafo. 
                                // Lo partimos por saltos de línea (\n).
                                var textoCompleto = b.Ejercicios.FirstOrDefault()?.Descripcion ?? "";
                                var lineas = textoCompleto.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);

                                foreach (var linea in lineas)
                                {
                                    listaEjerciciosVisuales.Add(new EjercicioVisualDto {
                                        Descripcion = linea,
                                        PesoRepeticiones = "" // En texto libre el peso ya viene escrito en la línea
                                    });
                                }
                            }
                            else
                            {
                                // Si es por bloques (normal), lo pasamos tal cual
                                listaEjerciciosVisuales = b.Ejercicios.Select(e => new EjercicioVisualDto {
                                    Descripcion = e.Descripcion,
                                    PesoRepeticiones = e.PesoRepeticiones
                                }).ToList();
                            }

                            return new SegmentoVisualDto {
                                Titulo = b.EsTextoLibre ? b.TiempoFormato : b.NombreSegmento,
                                EsTextoLibre = b.EsTextoLibre, // <--- ASIGNAMOS LA BANDERA
                                Ejercicios = listaEjerciciosVisuales
                            };
                        }).ToList()
                    };
                }
            }
        } catch { } 
        finally { cargando = false; StateHasChanged(); }
    }

    private async Task CambiarFecha(int dias)
    {
        fechaSeleccionada = fechaSeleccionada.AddDays(dias);
        await CargarWod();
    }

    private void Volver() => Nav.NavigateTo("/home");
}